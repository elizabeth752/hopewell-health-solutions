---
import HeroCreds from "../../components/hw/HeroCreds.astro";
// About, 2026 redesign. Rebuilt 2026-11-16 to the "Hopewell About Us Page: Content Brief" (12-section outline), keeping every
// sentence of the previous page. Sitewide order at the bottom: Reviews, As featured in, FAQ, careers strip, closing CTA.
// Left out until TJ confirms (brief [confirm] items): founding FAQ, clinician count in the numbers row, leadership titles from
// the brief (Joy Burchell is not on the site; leaders and titles below are the live ones from providers.js), licences beyond
// LegitScript, extra provider types, hiring status. Brief "never include": the old "14 years" and "50,000+ lives helped"
// stat tiles are dropped from the numbers row.
import "../../styles/pages/about.css";
import "../../styles/pages/hubs.css";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import PhoneVideo from "../../components/hw/PhoneVideo.astro";
import LeadForm from "../../components/LeadForm.astro";
import LegitScriptSeal from "../../components/LegitScriptSeal.astro";
import Creds from "../../components/hw/Creds.astro";
import Team from "../../components/hw/Team.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Locations from "../../components/hw/Locations.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import Faq from "../../components/hw/Faq.astro";
import { STORIES, VIDEOS, PODCAST } from "../../data/videos.js";
const tour = VIDEOS.find((v) => v.yt === "ZsyYzk9epww");
import { providers } from "../../data/providers.js";
import { locations, OFFERS, OFFER_ORDER } from "../../data/locations.js";
import { socials } from "../../data/socials.ts";
import { SITE, PHONE, GOOGLE } from "../../data/site.js";

const canonical = "https://www.hopewellhealthsolutions.com/about-us/";
const P = "/Assets/hhs-2026/";
const heroBullets = ["Board-certified specialists for ages 4 and up", "Six offices: Glastonbury, Westbrook, West Hartford &amp; East Hampton", "Therapy first. Medication second. Transformation third.", "Joint Commission accredited"];

const offer = [
  { t: "Therapy that works", d: "DBT, CBT, play therapy, solution-focused therapy, the Gottman Method for couples, and trauma-informed care.", href: "/programs/counseling/", img: P + "westbrook-therapy-office.webp" },
  { t: "Therapeutic & mind-body treatments", d: "Accelerated Resolution Therapy (ART), mindfulness, yoga therapy, and other wellness-based methods.", href: "/treatment-methods/therapeutic-treatments/", img: P + "group-room-bright.webp" },
  { t: "EMDR & eye-movement therapy", d: "Evidence-based trauma therapy that helps the mind heal what words can’t reach.", href: "/treatment-methods/emdr/", img: "/Assets/service/trauma-informed-individual.webp" },
  { t: "Medication management", d: "Personalized psychiatric medication plans that help clients flourish, for ages 4 and up.", href: "/programs/medication-management/", img: P + "south-glastonbury-waiting-room.webp" },
  { t: "Intensive Outpatient Program", d: "Structured group and individual support several days a week, without putting life on hold.", href: "/programs/intensive-outpatient-program/", img: P + "adult-evening-iop-group.webp" },
  { t: "Neuropsychological testing", d: "Comprehensive neuropsychological testing for clarity, diagnosis, and a real plan.", href: "/treatment-methods/neuropsychological-testing/", img: P + "tx-east-hampton-play-room.webp" },
];
const offerMore = {
  "/programs/counseling/": "Weekly sessions with a licensed therapist for individuals, couples and families, at all six offices or by telehealth.",
  "/treatment-methods/therapeutic-treatments/": "Whole-person approaches that work alongside talk therapy, from ART for <a class='inl' href='/what-we-treat/trauma-ptsd/'>trauma</a> to mindfulness and yoga therapy for stress.",
  "/treatment-methods/emdr/": "A structured trauma therapy that helps distressing memories lose their charge, used across our trauma programs.",
  "/programs/medication-management/": "Board-certified prescribers build personalized plans and follow up closely, with <a class='inl' href='/treatment-methods/genesight-testing/'>GeneSight® testing</a> available.",
  "/programs/intensive-outpatient-program/": "Tracks for tweens, teens, women, adults, first responders and addiction, about three hours a day, four days a week.",
  "/treatment-methods/neuropsychological-testing/": "Detailed evaluation of attention, memory and learning, with a written report and clear next steps.",
};
const milestones = [
  ["2013", "Hopewell Health Solutions is founded in Glastonbury by Dr. Kristine Schlichting."],
  ["50+", "Licensed clinicians today: psychologists, prescribers, social workers and counselors."],
  ["2026", `LegitScript certification for <a class="inl" href="/what-we-treat/substance-use-disorder/">addiction treatment</a>, alongside Joint Commission accreditation.`],
  ["Sept 2026", `Our <a class="inl" href="/post/hopewell-health-solutions-westbrook-campus/">Westbrook office</a> opens on the shoreline, the sixth Hopewell location.`],
];
// Mantra (live copy), shown as one panel split by thin rules.
const how = [
  ["Therapy first", "Most plans start with evidence-based therapy such as CBT, DBT and EMDR, because skills are what last."],
  ["Medication second", "When medication helps, our prescribers build a careful, personalized plan, never one-size-fits-all."],
  ["Transformation third", "The goal is a life that feels like yours again: confidence, clarity and the conviction to keep going."],
];
// Brief section 4: what makes us different (one sentence + a fact each).
const different = [
  ["In-person care with clinicians who know your name", "While others go all-virtual, our programs happen face to face, with telehealth when you need it.", "Six Connecticut offices"],
  ["Every level of care with one team", `<a class="inl" href="/programs/counseling/">Counseling</a>, <a class="inl" href="/programs/medication-management/">medication management</a>, <a class="inl" href="/programs/intensive-outpatient-program/">IOP</a> and <a class="inl" href="/programs/partial-hospitalization-program/">PHP</a> are coordinated by one team as your needs change.`, "Four levels of care"],
  ["Mental health and addiction treated together", `People who need both get care for mental health and <a class="inl" href="/programs/addiction-iop/">addiction</a> together, from the same team.`, "Addiction care at 300 Hebron Ave and Westbrook"],
  ["Children, teens and adults", `Care starts at age 4, with programs for <a class="inl" href="/programs/tween-iop/">tweens</a>, <a class="inl" href="/programs/teen-iop/">teens</a>, women, adults and first responders.`, "Ages 4 and up"],
];
// Brief section 5: verified figures only.
const numbers = [
  ["6", "Connecticut offices"],
  ["4", "Levels of care, from counseling to PHP"],
  ["4+", "Ages we care for, from children to adults"],
  [GOOGLE.rating, `Google rating from ${GOOGLE.count} reviews`],
];
const serve = [
  ["Children & families", `Play therapy, parent guidance and <a class="inl" href="/programs/medication-management/">medication management</a> from age 4.`],
  ["Tweens & teens", `After-school support in the <a class="inl" href="/programs/teen-iop/">Teen &amp; Tween IOP</a>.`],
  ["Women", `The <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a> and <a class="inl" href="/programs/womens-trauma-iop/">Women’s Trauma IOP</a>.`],
  ["First responders", `A dedicated <a class="inl" href="/programs/first-responder-iop/">First Responder IOP</a>.`],
  ["Adults", `Day and evening care, from <a class="inl" href="/programs/counseling/">counseling</a> to <a class="inl" href="/programs/partial-hospitalization-program/">PHP</a>.`],
  ["People facing addiction", `The <a class="inl" href="/programs/addiction-iop/">Addiction and Substance Use IOP</a> at 300 Hebron Ave and Westbrook.`],
];
// Brief section 6: leadership, in the site's existing leadership order; titles and credentials from providers.js.
const leadLines = {
  "kristine-a-schlichting-ph-d": "Licensed psychologist with a doctorate in psychology from the University of Connecticut, known to clients and staff as Dr. K.",
  "teesha-huertas-lcsw": "Licensed clinical social worker with a decade in behavioral health, from crisis work to clinical direction.",
  "colleen-callaway-mba": "Manages the treatment schedule, benefits and insurance, and client relations.",
  "tj-aitken-cpsrp": "Certified Peer Support and Recovery Professional with 10 years in the substance use field.",
};
const leaders = Object.keys(leadLines).map((s) => providers.find((p) => p.slug === s)).filter(Boolean);

// Gallery (user, 2026-11-16: "add a gallery as the first section with images from the locations, groups, everything").
// Real Hopewell people and places only. Spans make a full 4 x 4 mosaic with no gaps.
const gallery = [
  [P + "full-team-lawn.webp", "The Hopewell team together on the lawn", "Our team", "is-big"],
  [P + "iop-room-group-photo.webp", "A Women's Trauma IOP group meeting in a Hopewell group room", "IOP group room", "is-tall"],
  [P + "tms-neurostar-room.webp", "The TMS treatment room at Hopewell", "TMS room", ""],
  ["/Assets/locations/westbrook/beach-walk.webp", "A walk on the beach near the Westbrook office", "Westbrook shoreline", ""],
  [P + "group-room-feelings-wheel.webp", "A Hopewell group room with a feelings wheel on the wall", "Group room", ""],
  [P + "sg-tween-group-room.webp", "The tween group room at the South Glastonbury office", "Tween group room", ""],
  [P + "east-hampton-waiting-room.webp", "The waiting room at the East Hampton office", "East Hampton", ""],
  [P + "womens-wellness-team.webp", "The Women's Wellness IOP team", "Women's Wellness team", ""],
  [P + "team-with-dr-k-lawn.webp", "Dr. Kristine Schlichting with the Hopewell team", "Dr. K and the team", "is-wide"],
  [P + "php-group-room.webp", "The PHP group room at Downtown Glastonbury", "PHP group room", ""],
  [P + "west-hartford-office.webp", "The West Hartford office", "West Hartford", ""],
];
// Office photo gallery above the office cards (user: "and same with the locations section").
const officeShots = {
  "glastonbury-ct": ["/Assets/locations/glastonbury/therapy-space.webp", "Living-room-style therapy space at the Pratt St office"],
  "glastonbury-ct-2": ["/Assets/locations/downtown-glastonbury/entrance.webp", "Entrance to the Downtown Glastonbury office at 300 Hebron Ave"],
  "glastonbury-ct-3": ["/Assets/locations/1420-main/sg-waiting-room.webp", "Waiting room at the South Glastonbury office"],
  "west-hartford-ct": ["/Assets/locations/west-hartford/therapy-office.webp", "Therapy office in West Hartford"],
  "east-hampton-ct": ["/Assets/locations/east-hampton/lobby.webp", "Lobby of the East Hampton office"],
  "westbrook-ct": ["/Assets/locations/westbrook/sitting-room.webp", "Sitting room with a window view in Westbrook"],
};
const faqs = [
  ["Who is Hopewell Health Solutions?", `An outpatient mental health and addiction treatment provider with six offices in Connecticut, offering <a class="inl" href="/programs/counseling/">counseling</a>, <a class="inl" href="/programs/medication-management/">medication management</a>, <a class="inl" href="/programs/intensive-outpatient-program/">IOP</a>, <a class="inl" href="/programs/partial-hospitalization-program/">PHP</a>, <a class="inl" href="/treatment-methods/tms/">TMS</a> and testing for children, teens and adults.`],
  ["Who founded Hopewell Health Solutions?", `Hopewell was founded in Glastonbury in 2013 by <a class="inl" href="/provider/kristine-a-schlichting-ph-d/">Dr. Kristine Schlichting, PhD</a>, a licensed psychologist who still leads the practice as Director.`],
  ["Where are your offices?", `<p>Pratt St and Downtown (Hebron Ave) in Glastonbury, South Glastonbury, West Hartford, East Hampton and Westbrook. See <a class="inl" href="/locations/">our locations</a>.</p> <p>Six Connecticut offices: three in Glastonbury (Pratt St, 300 Hebron Ave and 1420 Main St), plus West Hartford, East Hampton and Westbrook.</p>`],
  ["Is care in person or online?", `<p>Our care is built around in-person visits and groups, with telehealth available for some services.</p> <p>Care happens in person across our Connecticut offices, with telehealth when you need it.</p>`],
  ["Who provides care at Hopewell?", `Licensed therapists and psychiatric providers. Meet them on <a class="inl" href="/about-us/team/">our team page</a>.`],
  ["Are you licensed and certified?", `<p>Hopewell is LegitScript-certified.</p> <p>Hopewell is accredited by The Joint Commission, holds LegitScript certification for addiction treatment, and is a BBB Accredited Business.</p>`],
  ["Do you treat both mental health and addiction?", `Yes, including <a class="inl" href="/what-we-treat/co-occurring/">both together</a> for people who need it. See our <a class="inl" href="/what-we-treat/">conditions we treat</a>.`],
  ["What ages do you see?", `We care for clients aged 4 and older, from young children and teens to adults.`],
  ["What insurance do you accept?", `Most major commercial plans. We <a class="inl" href="/rates-and-insurance-coverage/">check your benefits</a> for free. We don't accept Medicare or Medicaid.`],
  ["How is my privacy protected?", `We follow federal privacy laws, including the stricter rules for substance use treatment records. Read our <a class="inl" href="/privacy/">privacy policy</a>.`],
  ["Are you hiring?", `<p>See current openings on <a class="inl" href="/about-us/careers/">our careers page</a>.</p> <p>We’re always glad to meet clinicians who share our approach.</p>`],
];

const org = {
  "@type": "MedicalOrganization",
  "@id": SITE + "/#organization",
  name: "Hopewell Health Solutions",
  url: SITE + "/",
  logo: SITE + "/Assets/logo/hopewell-wave-logo.webp",
  foundingDate: "2013",
  sameAs: [...socials.map((s) => s.href), "https://www.psychologytoday.com/us/treatment-rehab/hopewell-health-solutions-iop-glastonbury-ct/1084012", "https://www.google.com/maps?cid=14566101802764545088", "https://www.google.com/maps?cid=5599854262951941274"],
  subOrganization: locations.map((l) => ({
    "@type": "MedicalClinic", "@id": `${SITE}/location/${l.slug}/#clinic`, name: `Hopewell Health Solutions, ${l.name}`, url: `${SITE}/location/${l.slug}/`,
    telephone: l.phone, openingHours: l.hours,
    address: { "@type": "PostalAddress", streetAddress: l.street, addressLocality: l.city, addressRegion: "CT", postalCode: l.zip, addressCountry: "US" },
    availableService: OFFER_ORDER.filter((k) => l.offers?.includes(k)).map((k) => ({ "@type": "MedicalTherapy", name: OFFERS[k].t, url: SITE + OFFERS[k].href })),
  })),
  employee: leaders.map((p) => ({
    "@type": "Person", name: p.name.split(",")[0].trim(), honorificSuffix: p.credentials, jobTitle: p.role,
    url: `${SITE}/provider/${p.slug}/`, image: `${SITE}/Assets/Team%20Members/${encodeURIComponent(p.photo)}.webp`,
  })),
};
const schema = { "@context": "https://schema.org", "@type": "AboutPage", url: canonical, name: "About Hopewell Health Solutions", mainEntity: org, about: { "@id": SITE + "/#organization" } };
---

<Base title="About Hopewell | Connecticut Mental Health & Addiction Care" description="Meet Hopewell Health Solutions: an in-person Connecticut team treating mental health and addiction for all ages across six offices. Our story and leaders." canonical={canonical} image={P + "team-300-hebron.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main class="hw">
    <!-- 1. Hero + form (Corner Canyon navy hub hero) -->
    <section class="wq-hero">
      <div class="container wq-hero-grid ab-hero-grid">
        <div>
          <nav class="wq-crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>About Us</span></nav>
          <h1 class="text-balance">About Hopewell Health Solutions</h1>
          <p class="ab-tag">There is <em>hope</em> to <em>heal</em>.</p>
          <p class="lede">A Connecticut team of clinicians you meet in person, caring for mental health and addiction at every level.</p>
          <p class="lede ab-lede2">A multidisciplinary mental health practice helping clients across Connecticut become the best version of themselves, in person and by telehealth.</p>
          <ul class="ab-hero-list">{heroBullets.map((b) => <li><span class="sv-tick"><Icon name="check" class="h-4 w-4" /></span><span set:html={b} /></li>)}</ul>
          <ul class="wq-facts">
            <li><Icon name="calendar" class="h-[18px] w-[18px]" />Serving Connecticut since 2013</li>
            <li><Icon name="star" class="h-[18px] w-[18px]" />{GOOGLE.rating} · {GOOGLE.count} Google reviews</li>
          </ul>
          <div class="wq-ctas"><a href={PHONE.href} class="btn btn-blue only-d"><Icon name="phone" />Call {PHONE.display}</a><a href="/about-us/team/" class="btn wq-ghost">Meet our team</a></div>
          <HeroCreds />
        </div>
        <div class="ab-hero-form" id="verify"><LeadForm variant="card" formId="hhs-hero" /></div>
      </div>
    </section>
    <Creds />

    <!-- Welcome to Hopewell + tour video (user 2026-11-17) -->
    <section class="section is-stone" id="welcome">
      <div class="container">
        <div class="lh-visit-top" style="margin:0">
          <div class="sec-head" style="margin:0">
            <h2>Welcome to Hopewell</h2>
            <p class="lede">Hopewell Health Solutions has cared for Connecticut families since 2013, from children as young as four to adults of every age. Our offices are designed to feel more like a living room than a clinic, with warm light, comfortable seats and rooms built for real conversation. Whether you come in for weekly therapy, medication management or an <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program</a>, you’ll be welcomed by a team that knows your name.</p>
            <p class="lh-visit-note"><Icon name="play" class="h-5 w-5" />A 16-second look inside our Glastonbury spaces. Tap the phone for sound.</p>
          </div>
          {tour && <PhoneVideo yt={tour.yt} title={tour.title} poster={`/Assets/videos/${tour.img}.webp`} />}
        </div>
      </div>
    </section>

    <!-- Gallery: real people, groups and offices -->
    <section class="section is-white" id="gallery">
      <div class="container">
        <div class="sec-head"><h2>Inside Hopewell</h2><p class="lede">Our people, our groups and our six Connecticut offices. Every photo here is a real Hopewell person or place.</p></div>
        <ul class="ab-gal">
          {gallery.map(([src, alt, cap, cls]) => <li class={cls}><img src={src} alt={alt} loading="lazy" /><span>{cap}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- 3. Who we are + our story -->
    <section class="section is-white" id="mission">
      <div class="container ab-story">
        <figure class="ab-story-media" style="margin:0">
          <img src={P + "team-300-hebron.webp"} alt="The Hopewell Health Solutions team at the Downtown Glastonbury office" width="1200" height="900" loading="lazy" />
          <figcaption>Our team at the Downtown Glastonbury office, 300 Hebron Ave</figcaption>
        </figure>
        <div class="ab-copy">
          <h2>Welcome to Hopewell Health Solutions</h2>
          <div style="margin-top:20px">
            <p>Welcome to Hopewell Health Solutions, a multidisciplinary mental health practice with <a class="inl" href="/locations/">locations in Glastonbury and West Hartford</a>, Connecticut. Our board-certified specialists take an innovative, multi-disciplinary approach to mental health treatments for clients aged 4 and older in a compassionate, safe environment, whether in person or via telehealth.</p>
            <p>Our mental health experts provide practical solutions, empowerment, and instruction. We’re committed to achieving outstanding client results. Our mission at Hopewell Health Solutions is to help clients become the best version of themselves by providing exceptional, effective treatments and cutting-edge medications that transform lives.</p>
            <p>We offer <a class="inl" href="/treatment-methods/dbt/">dialectical behavioral therapy (DBT)</a>, cognitive-behavioral therapy (CBT), play therapy, solution-focused therapy, trauma treatments, <a class="inl" href="/programs/counseling/">counseling</a>, and mind-body therapies. Additional mental health solutions include accelerated resolution therapy (ART), <a class="inl" href="/treatment-methods/emdr/">eye-movement therapies</a>, the Gottman Method for couples, and other <a class="inl" href="/treatment-methods/therapeutic-treatments/">therapeutic treatments</a>. We provide mindfulness therapy, yoga therapy, and numerous other wellness-based methods to ease depression, anxiety, and other mental health concerns.</p>
            <p>Our skilled staff creates personalized psychiatric <a class="inl" href="/programs/medication-management/">medication management</a> plans that help clients flourish and empower them to make lifestyle changes and live their best lives. We offer an <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program</a> and <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a>.</p>
          </div>
          <div class="pf-card is-navy" style="margin-top:24px">
            <p style="font-family:var(--hw-head);font-weight:800;font-size:22px;color:#fff;line-height:1.3">Therapy first. Medication second. Transformation third.</p>
            <p style="margin-top:10px;font-size:16px">Our mantra guides a diverse team that collaborates to provide five-star treatment plans, giving clients the confidence, clarity, and conviction to create the life they long for and deserve.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section is-stone" id="story">
      <div class="container">
        <div class="sec-head"><h2>Our story</h2><p class="lede">From one Glastonbury office to six across Connecticut, Hopewell has grown around a single idea: there is hope to heal.</p></div>
        <ul class="hb-timeline">{milestones.map(([n, t]) => <li><strong>{n}</strong><span set:html={t} /></li>)}</ul>
      </div>
    </section>

    <!-- 4. What makes us different (navy split: heading left, divided list right) + 5. by the numbers -->
    <section class="section is-navy" id="different">
      <div class="container ab-diff">
        <div>
          <h2>What makes Hopewell different</h2>
          <p class="lede" style="margin-top:16px">A local team you meet in person, with every level of care under one roof. See <a class="inl" href="/programs/">all programs</a> and <a class="inl" href="/treatment-methods/">treatments</a>.</p>
        </div>
        <dl class="ab-diff-list">
          {different.map(([t, d, f]) => <div><dt>{t}</dt><dd><span set:html={d} /><small>{f}</small></dd></div>)}
        </dl>
      </div>
      <div class="container">
        <h2 class="ab-num-h">Hopewell by the numbers</h2>
        <ul class="ab-nums">{numbers.map(([n, l]) => <li><strong>{n}</strong><span>{l}</span></li>)}</ul>
      </div>
    </section>

    <!-- How we work: the mantra as one panel split by thin rules -->
    <section class="section is-white" id="how">
      <div class="container">
        <div class="sec-head"><h2>How we work</h2><p class="lede">Our mantra is simple, and it shapes every treatment plan we build.</p></div>
        <div class="ab-panel">{how.map(([t, d]) => <div><h3>{t}</h3><p>{d}</p></div>)}</div>
      </div>
    </section>

    <!-- Who we serve: divided two-column list -->
    <section class="section is-stone" id="serve">
      <div class="container">
        <div class="sec-head"><h2>Who we serve</h2><p class="lede">Programs shaped around who you are, for clients aged 4 and older.</p></div>
        <dl class="ab-serve">{serve.map(([t, d]) => <div><dt>{t}</dt><dd set:html={d} /></div>)}</dl>
      </div>
    </section>

    <!-- What we offer -->
    <section class="section is-mist" id="offer">
      <div class="container">
        <div class="sec-head"><h2>What we offer</h2><p class="lede">From talk therapy to advanced treatments, everything is coordinated by one team, and tailored to each client. See <a class="inl" href="/programs/">all programs</a> and <a class="inl" href="/what-we-treat/">what we treat</a>.</p></div>
        <div class="hb-groups"><section class="hb-group t-blue"><div class="hb-group-head"><span class="hb-group-icon"><Icon name="heart" /></span><div><h3>Care under one roof</h3><small>Therapy, psychiatry, intensive programs and testing</small></div></div>
          <div class="hb-cards">
            {offer.map((c) => (
              <article class="hb-card">
                <img src={c.img} alt={`${c.t} at Hopewell Health Solutions`} width="300" height="300" loading="lazy" />
                <div><h4><a href={c.href}>{c.t}</a></h4><p>{c.d}</p><p set:html={offerMore[c.href]} /></div>
              </article>
            ))}
          </div>
        </section></div>
      </div>
    </section>

    <!-- 6. Leadership -->
    <section class="section is-white" id="leadership">
      <div class="container">
        <div class="sec-head"><h2>Our leadership</h2><p class="lede">The people who guide Hopewell's care, operations and programs. Each name links to a full bio.</p></div>
        <ul class="ab-leaders">
          {leaders.map((p) => (
            <li>
              <img src={`/Assets/Team%20Members/${encodeURIComponent(p.photo)}.webp`} alt={p.name} width="600" height="750" loading="lazy" />
              <div>
                <h3><a href={`/provider/${p.slug}/`}>{p.name}</a></h3>
                <p class="ab-role">{p.role}</p>
                <p>{leadLines[p.slug]}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Our clinical team -->
    <Team heading="The people behind the care" lede="50+ licensed clinicians, psychologists, psychiatric nurse practitioners, social workers, and trauma specialists, collaborating on every plan. <a class='inl' href='/about-us/team/'>Meet our clinicians by office</a>." tone="stone" />

    <!-- 8. Certifications and standards: one panel split by thin rules -->
    <section class="section is-white" id="standards">
      <div class="container">
