---
// About — 2026 redesign. All copy kept; "superior" (unsourced superlative, KB §1) now reads "multidisciplinary".
import "../../styles/pages/about.css";
import "../../styles/pages/hubs.css";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import Team from "../../components/hw/Team.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import Faq from "../../components/hw/Faq.astro";
import { STORIES } from "../../data/videos.js";

const canonical = "https://www.hopewellhealthsolutions.com/about-us/";
const P = "/Assets/hhs-2026/";
const stats = [
  ["14", "Years serving Central Connecticut", "calendar"],
  ["50+", "Clinicians on our team", "users"],
  ["6", "Connecticut locations", "pin"],
  ["50,000+", "Lives helped", "heart"],
];
const offer = [
  { t: "Therapy that works", d: "DBT, CBT, play therapy, solution-focused therapy, the Gottman Method for couples, and trauma-informed care.", href: "/programs/counseling/", img: P + "westbrook-therapy-office.webp", bar: "#2f76c4", facts: [["brain", "Individual, couples & family"]] },
  { t: "Therapeutic & mind-body treatments", d: "Accelerated Resolution Therapy (ART), mindfulness, yoga therapy, and other wellness-based methods.", href: "/treatment-methods/therapeutic-treatments/", img: P + "group-room-bright.webp", bar: "#5c7c6b", facts: [["heart", "ART, mindfulness, yoga therapy"]] },
  { t: "EMDR & eye-movement therapy", d: "Evidence-based trauma therapy that helps the mind heal what words can’t reach.", href: "/treatment-methods/emdr/", img: "/Assets/service/trauma-informed-individual.webp", bar: "#b6863c", facts: [["refresh", "Trauma-focused"]] },
  { t: "Medication management", d: "Personalized psychiatric medication plans that help clients flourish — for ages 4 and up.", href: "/programs/medication-management/", img: P + "south-glastonbury-waiting-room.webp", bar: "#265489", facts: [["pill", "Ages 4 and up"]] },
  { t: "Intensive Outpatient Program", d: "Structured group and individual support several days a week, without putting life on hold.", href: "/programs/intensive-outpatient-program/", img: P + "adult-evening-iop-group.webp", bar: "#2f76c4", facts: [["calendar", "Mon–Thu · day or evening"]] },
  { t: "Neuropsychological testing", d: "Comprehensive neuropsychological testing for clarity, diagnosis, and a real plan.", href: "/treatment-methods/neuropsychological-testing/", img: P + "tx-east-hampton-play-room.webp", bar: "#b6863c", facts: [["clipboard", "Testing & diagnosis"]] },
];

// Corner Canyon hub pattern (user, 2026-11-16: "we need content for SEO"): fuller offer cards, milestones, how we work,
// who we serve, accreditation and an About FAQ. Facts from the site and the client knowledge base only.
const offerMore = {
  "/programs/counseling/": "Weekly sessions with a licensed therapist for individuals, couples and families, at all six offices or by telehealth.",
  "/treatment-methods/therapeutic-treatments/": "Whole-person approaches that work alongside talk therapy, from ART for trauma to mindfulness and yoga therapy for stress.",
  "/treatment-methods/emdr/": "A structured trauma therapy that helps distressing memories lose their charge, used across our trauma programs.",
  "/programs/medication-management/": "Board-certified prescribers build personalized plans and follow up closely, with GeneSight® testing available.",
  "/programs/intensive-outpatient-program/": "Tracks for tweens, teens, women, adults, first responders and addiction, about three hours a day, four days a week.",
  "/treatment-methods/neuropsychological-testing/": "Detailed evaluation of attention, memory and learning, with a written report and clear next steps.",
};
const milestones = [
  ["2013", "Hopewell Health Solutions is founded in Glastonbury by Dr. Kristine Schlichting."],
  ["50+", "Licensed clinicians today: psychologists, prescribers, social workers and counselors."],
  ["2026", "LegitScript certification for addiction treatment, alongside Joint Commission accreditation."],
  ["Sept 2026", "Our Westbrook office opens on the shoreline, the sixth Hopewell location."],
];
const how = [
  { icon: "chat", t: "Therapy first", d: "Most plans start with evidence-based therapy such as CBT, DBT and EMDR, because skills are what last." },
  { icon: "pill", t: "Medication second", d: "When medication helps, our prescribers build a careful, personalized plan, never one-size-fits-all." },
  { icon: "sparkles", t: "Transformation third", d: "The goal is a life that feels like yours again: confidence, clarity and the conviction to keep going." },
  { icon: "users", t: "In person, with telehealth", d: "While others go all-virtual, our programs happen face to face, with telehealth when you need it." },
];
const serve = [
  { icon: "sparkles", t: "Children & families", d: `Play therapy, parent guidance and <a class="inl" href="/programs/medication-management/">medication management</a> from age 4.` },
  { icon: "users", t: "Tweens & teens", d: `After-school support in the <a class="inl" href="/programs/teen-iop/">Teen &amp; Tween IOP</a>.` },
  { icon: "heart", t: "Women", d: `The <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a> and <a class="inl" href="/programs/womens-trauma-iop/">Women’s Trauma IOP</a>.` },
  { icon: "shield", t: "First responders", d: `A dedicated <a class="inl" href="/programs/first-responder-iop/">First Responder IOP</a>.` },
  { icon: "compass", t: "Adults", d: `Day and evening care, from <a class="inl" href="/programs/counseling/">counseling</a> to <a class="inl" href="/programs/partial-hospitalization-program/">PHP</a>.` },
  { icon: "link", t: "People facing addiction", d: `The <a class="inl" href="/programs/addiction-iop/">Addiction and Substance Use IOP</a> at 300 Hebron Ave and Westbrook.` },
];
const faqs = [
  ["Who founded Hopewell Health Solutions?", `Hopewell was founded in Glastonbury in 2013 by <a class="inl" href="/provider/kristine-a-schlichting-ph-d/">Dr. Kristine Schlichting, PhD</a>, a licensed psychologist who still leads the practice as Director.`],
  ["Where are your offices?", `Six Connecticut offices: three in Glastonbury (Pratt St, 300 Hebron Ave and 1420 Main St), plus West Hartford, East Hampton and Westbrook. See <a class="inl" href="/locations/">all locations</a>.`],
  ["Is Hopewell accredited?", `Yes. Hopewell is accredited by The Joint Commission, holds LegitScript certification for addiction treatment, and is a BBB Accredited Business.`],
  ["What ages do you see?", `We care for clients aged 4 and older, from young children and teens to adults.`],
  ["Do you offer telehealth?", `Yes. Care happens in person across our Connecticut offices, with telehealth when you need it.`],
  ["Are you hiring?", `We’re always glad to meet clinicians who share our approach. See <a class="inl" href="/about-us/careers/">careers at Hopewell</a>.`],
];
const org = {
  "@context": "https://schema.org", "@type": "AboutPage", url: canonical, name: "About Hopewell Health Solutions",
  about: { "@type": "MedicalOrganization", "@id": "https://www.hopewellhealthsolutions.com/#organization", name: "Hopewell Health Solutions", foundingDate: "2013" },
};
---

<Base title="About Hopewell Health Solutions | Mental Health & Psychiatry in CT" description="Hopewell Health Solutions is a multidisciplinary mental health & psychiatry practice in Glastonbury, Westbrook & West Hartford, CT — board-certified specialists, a multidisciplinary approach, and care for ages 4 and up. Therapy first, medication second, transformation third." canonical={canonical} image={P + "team-celebrating-outside.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "About Us" }]}
      title="About Hopewell Health Solutions"
      lede="A multidisciplinary mental health practice helping clients across Connecticut become the best version of themselves — in person and by telehealth."
      bullets={["Board-certified specialists for ages 4 and up", "Six offices: Glastonbury, Westbrook, West Hartford &amp; East Hampton", "Therapy first. Medication second. Transformation third.", "Joint Commission accredited"]}
      facts={[{ icon: "calendar", text: "Serving Connecticut since 2013" }, { icon: "star", text: "4.8 · 368 Google reviews" }]}
      image={P + "team-celebrating-outside.webp"}
      imagePos="center 40%"
    />
    <Creds />

    <!-- Welcome / mission -->
    <section class="section is-white" id="mission">
      <div class="container ab-story">
        <figure class="ab-story-media" style="margin:0">
          <img src="/Assets/service/team-dedicated.webp" alt="The Hopewell Health Solutions team in Connecticut" width="1200" height="900" loading="lazy" />
        </figure>
        <div class="ab-copy">
          <h2>Welcome to Hopewell Health Solutions</h2>
          <div style="margin-top:20px">
            <p>Welcome to Hopewell Health Solutions, a multidisciplinary mental health practice with locations in Glastonbury and West Hartford, Connecticut. Our board-certified specialists take an innovative, multi-disciplinary approach to mental health treatments for clients aged 4 and older in a compassionate, safe environment, whether in person or via telehealth.</p>
            <p>Our mental health experts provide practical solutions, empowerment, and instruction. We’re committed to achieving outstanding client results. Our mission at Hopewell Health Solutions is to help clients become the best version of themselves by providing exceptional, effective treatments and cutting-edge medications that transform lives.</p>
            <p>We offer <a class="inl" href="/treatment-methods/dbt/">dialectical behavioral therapy (DBT)</a>, cognitive-behavioral therapy (CBT), play therapy, solution-focused therapy, trauma treatments, <a class="inl" href="/programs/counseling/">counseling</a>, and mind-body therapies. Additional mental health solutions include accelerated resolution therapy (ART), <a class="inl" href="/treatment-methods/emdr/">eye-movement therapies</a>, the Gottman Method for couples, and other <a class="inl" href="/treatment-methods/therapeutic-treatments/">therapeutic treatments</a>. We provide mindfulness therapy, yoga therapy, and numerous other wellness-based methods to ease depression, anxiety, and other mental health concerns.</p>
            <p>Our skilled staff creates personalized psychiatric <a class="inl" href="/programs/medication-management/">medication management</a> plans that help clients flourish and empower them to make lifestyle changes and live their best lives. We offer an <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program</a> and <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a>.</p>
          </div>
          <div class="pf-card is-navy" style="margin-top:24px">
            <p style="font-family:var(--hw-head);font-weight:800;font-size:22px;color:#fff;line-height:1.3">Therapy first. Medication second. Transformation third.</p>
            <p style="margin-top:10px;font-size:16px">Our mantra guides a diverse team that collaborates to provide five-star treatment plans — giving clients the confidence, clarity, and conviction to create the life they long for and deserve.</p>
          </div>
        </div>
      </div>
      <div class="container">
        <ul class="usp-more is-stats" style="margin-top:44px">
          {stats.map(([n, l, icon]) => <li><span class="usp-more-icon"><Icon name={icon} /></span><span><strong>{n}</strong>{l}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- What we offer -->
    <section class="section is-mist" id="offer">
      <div class="container">
        <div class="sec-head"><h2>What we offer</h2><p class="lede">From talk therapy to advanced treatments, everything is coordinated by one team — and tailored to each client. See <a class="inl" href="/programs/">all programs</a> and <a class="inl" href="/what-we-treat/">what we treat</a>.</p></div>
        <div class="hb-groups"><section class="hb-group t-blue"><div class="hb-group-head"><span class="hb-group-icon"><Icon name="heart" /></span><div><h3>Care under one roof</h3><small>Therapy, psychiatry, intensive programs and testing</small></div></div>
          <div class="hb-cards">
            {offer.map((c) => (
              <article class="hb-card">
                <img src={c.img} alt={`${c.t} at Hopewell Health Solutions`} width="300" height="300" loading="lazy" />
                <div><h4><a href={c.href}>{c.t}</a></h4><p>{c.d}</p><p>{offerMore[c.href]}</p></div>
              </article>
            ))}
          </div>
        </section></div>
      </div>
    </section>

    <section class="section is-white" id="how">
      <div class="container">
        <div class="sec-head"><h2>How we work</h2><p class="lede">Our mantra is simple, and it shapes every treatment plan we build.</p></div>
        <div class="hb-tiles cols-4">{how.map((h, i) => <div class:list={["hb-tile", i === 0 && "is-dark"]}><span class="hb-tile-icon"><Icon name={h.icon} /></span><h3>{h.t}</h3><p>{h.d}</p></div>)}</div>
      </div>
    </section>

    <section class="section is-stone" id="story">
      <div class="container">
        <div class="sec-head"><h2>Our story</h2><p class="lede">From one Glastonbury office to six across Connecticut, Hopewell has grown around a single idea: there is hope to heal.</p></div>
        <ul class="hb-timeline">{milestones.map(([n, t]) => <li><strong>{n}</strong><span>{t}</span></li>)}</ul>
      </div>
    </section>

    <section class="section is-white" id="serve">
      <div class="container">
        <div class="sec-head"><h2>Who we serve</h2><p class="lede">Programs shaped around who you are, for clients aged 4 and older.</p></div>
        <div class="hb-tiles">{serve.map((w) => <div class="hb-tile"><span class="hb-tile-icon"><Icon name={w.icon} /></span><h3>{w.t}</h3><p set:html={w.d} /></div>)}</div>
      </div>
    </section>

    <Team heading="The people behind the care" lede="50+ licensed clinicians — psychologists, psychiatric nurse practitioners, social workers, and trauma specialists — collaborating on every plan." />

    <VideoCarousel videos={STORIES} heading="Stories of Hope, in Their Own Words" lede="Clients and families share what treatment at Hopewell was like. Listen to the full conversations on the <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a>." />

    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" />
    <Reviews tone="stone" />
    <Insurance tone="white" />
    <Locations />
    <Faq faqs={faqs} heading="About Hopewell — common questions" tone="white" />
    <ClosingCta heading="Ready to Discover Your Path to Healing?" lede="Schedule an in-person or virtual mental health evaluation today — call our office or get in touch with our experts, confidentially and with no pressure."/>
  </main>
  <Footer />
</Base>
