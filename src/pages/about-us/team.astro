---
import Reviews from "../../components/hw/Reviews.astro";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import "../../styles/pages/about.css";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Insurance from "../../components/hw/Insurance.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import { providers } from "../../data/providers.js";
import { clinicalRoster } from "../../data/clinicalRoster.js";
import Prose from "../../components/seo/Prose.astro";
import Faq from "../../components/hw/Faq.astro";
import "../../styles/pages/seo.css";

const TM = "/Assets/Team%20Members/";
const initials = (name) => {
  const w = name.split(",")[0].trim().split(" ").filter(Boolean);
  return (w[0][0] + (w.length > 1 ? w[w.length - 1][0] : "")).toUpperCase();
};
// Single source of truth: providers.js. Each card links to /provider/[slug]/.
// Medical Staff: one group in providers.js order (category "medical" plus alsoMedicalStaff), as before 2026-11-11.
// Clinical order and location groups follow the client's "Staff List for Website" PDF
// (ClickUp 1dfm34y3p64, 2026-11-11). Someone listed at more than one location appears in each.
// Name on one line, credentials under it; hyphens non-breaking so "ATR-P" never splits (2026-11-16).
const nameOf = (n) => n.split(",")[0].trim();
const credsOf = (n) => n.split(",").slice(1).map((c) => c.trim()).filter(Boolean).join(", ").replace(/-/g, "\u2011");
const isMedical = (p) => p.category === "medical" || p.alsoMedicalStaff;
const roster = clinicalRoster;
const bySlug = Object.fromEntries(providers.map((p) => [p.slug, p]));
const pick = (slugs) => slugs.map((s) => {
  if (!bySlug[s]) throw new Error(`team.astro roster: unknown provider slug "${s}"`);
  return bySlug[s];
}).filter((p) => !p.hideFromTeam);
const clinicalCols = "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4";
const sections = [
  { title: "Leadership", people: providers.filter((p) => p.category === "leadership" && !p.hideFromTeam), cols: "sm:grid-cols-2 lg:grid-cols-3" },
  { title: "Medical Staff", people: providers.filter((p) => isMedical(p) && !p.hideFromTeam), cols: "sm:grid-cols-2 lg:grid-cols-3" },
  { title: "Clinical Staff – Glastonbury", people: pick(roster.glastonbury), cols: clinicalCols },
  { title: "Clinical Staff – Westbrook", people: pick(roster.westbrook), cols: clinicalCols },
  { title: "Clinical Staff – East Hampton", people: pick(roster.eastHampton), cols: clinicalCols },
  { title: "Clinical Staff – West Hartford", people: pick(roster.westHartford), cols: clinicalCols },
];
// Guard: every clinical provider shown on the team page must be in the client's list.
const listed = new Set(Object.values(roster).flat());
const unlisted = providers.filter((p) => !p.hideFromTeam && p.category !== "leadership" && p.category !== "medical" && !listed.has(p.slug));
if (unlisted.length) throw new Error(`team.astro roster: not placed in a location group: ${unlisted.map((p) => p.slug).join(", ")}`);
const L = "/Assets/Media%20Appearances/";
const press = [
  { outlet: "Hartford Courant", logo: L + "hartford.webp", date: "Feb 2023", title: "Hopewell opens first privately owned IOP mental health clinic in Glastonbury", href: "https://www.courant.com/2023/02/24/hopewell-solutions-opens-first-privately-owned-iop-mental-health-clinic-in-glastonbury/" },
  { outlet: "Hartford Business Journal", logo: L + "hbj-logo-v3.webp", date: "Honoree", title: "Kristine Schlichting, recognized leader in behavioral health", href: "https://hartfordbusiness.com/honoree/kristine-schlichting/" },
  { outlet: "FOX61", logo: L + "fox61.webp", date: "2023", title: "Glastonbury psychologist is helping teen girls and new moms find support", href: "https://www.fox61.com/article/news/local/outreach/awareness-months/glastonbury-psychologist-is-helping-teen-girls-and-new-moms-find-support/520-84d3fd3f-1cec-40bc-9d4c-65f7b6a4d2e9" },
  { outlet: "WFSB · Kara’s Cures", logo: L + "wfsb.avif", date: "Feb 2023", title: "Teen mental health crisis", href: "https://www.wfsb.com/video/2023/02/27/karas-cures-teen-mental-health-crisis/" },
  { outlet: "WFSB · Kara’s Cures", logo: L + "wfsb.avif", date: "Feb 2023", title: "How to help improve your teen’s mental health", href: "https://www.wfsb.com/video/2023/02/27/karas-cures-how-help-improve-your-teens-mental-health/" },
  { outlet: "IssueWire", logo: L + "issuewire.webp", date: "Feature", title: "Dr. Bido Aguessy: holistic approaches in psychology & spiritual care at Hopewell", href: "https://www.issuewire.com/dr-bido-aguessy-pioneering-holistic-approaches-in-psychology-and-spiritual-care-at-hopewell-health-solutions-1809193551604743" },
];
const services = [
  { t: "Intensive Outpatient Program", href: "/programs/intensive-outpatient-program/", icon: "users" },
  { t: "Medication Management", href: "/programs/medication-management/", icon: "pill" },
  { t: "Counseling", href: "/programs/counseling/", icon: "heart" },
  { t: "HHS Therapeutic Treatments", href: "/treatment-methods/therapeutic-treatments/", icon: "refresh" },
  { t: "Neuropsychological Testing", href: "/treatment-methods/neuropsychological-testing/", icon: "clipboard" },
  { t: "Addiction Treatment (S.U.D.)", href: "/what-we-treat/substance-use-disorder/", icon: "swap" },
  { t: "ADHD Testing", href: "/treatment-methods/adhd-testing/", icon: "bolt" },
  { t: "TMS", href: "/treatment-methods/tms/", icon: "brain" },
  { t: "Alcohol Addiction Treatment", href: "/what-we-treat/alcohol/", icon: "shield" },
  { t: "Drug Addiction Treatment", href: "/what-we-treat/drug/", icon: "compass" },
  { t: "Prescription Drug Addiction Treatment", href: "/what-we-treat/prescription-drugs/", icon: "alert" },
];
// Long-form SEO copy (2026-11-16). Primary keyword: "therapists and psychiatric providers in Glastonbury, CT";
// variants: psychiatric nurse practitioner Glastonbury, psychologist West Hartford, therapist Westbrook CT.
// Facts from providers.js (roles, credentials, counts) and the site. Hopewell's prescribers are PMHNPs and PAs.
const nPrescribers = providers.filter((p) => p.prescribes && !p.hideFromTeam).length;
const blocks = [
  { id: "our-team", h2: "Therapists and psychiatric providers in Glastonbury, CT and beyond",
    paras: [
      `Hopewell Health Solutions brings therapists, psychiatric nurse practitioners, physician assistants and psychologists together in one practice, so the people treating you talk to each other. Our team of 50+ clinicians works from <a class="inl" href="/locations/">six offices</a>: three in Glastonbury (Pratt St, Hebron Ave and Main St in South Glastonbury), plus West Hartford, East Hampton and Westbrook.`,
      `Every profile on this page links to a full bio with credentials, education and areas of focus. Licensed clinical social workers (LCSW, LMSW), professional counselors (LPC, LPC-A), marriage and family therapists (LMFT, LMFT-A), psychologists and board-certified prescribers each bring different training, and we match clients to the clinician whose experience fits what they are facing.`,
      `Our approach is the same across the team: therapy first, medication second, transformation third. That means evidence-based therapy such as <a class="inl" href="/treatment-methods/dbt/">DBT</a>, CBT and <a class="inl" href="/treatment-methods/emdr/">EMDR</a> at the centre of care, with <a class="inl" href="/programs/medication-management/">medication management</a> added when it helps.`,
    ],
    aside: { type: "points", title: "Our team at a glance", items: [["users", "50+ clinicians across six offices"], ["pill", `${nPrescribers} board-certified prescribers`], ["brain", "Psychologists &amp; a neuropsychologist"], ["heart", "Therapists for ages 4 and up"]] } },
  { id: "leadership-team", h2: "Leadership and clinical team leads",
    paras: [
      `Hopewell was founded by <a class="inl" href="/provider/kristine-a-schlichting-ph-d/">Dr. Kristine Schlichting</a>, a licensed psychologist who earned her doctorate and master’s in psychology at the University of Connecticut. Clinic Director <a class="inl" href="/provider/teesha-huertas-lcsw/">Teesha Huertas, LCSW</a> oversees clinical care, Executive Director Colleen Callaway manages operations, and TJ Aitken, CPSRP leads business development and hosts the <a class="inl" href="/podcast/">Hope, Health &amp; Healing podcast</a>.`,
      `Team leads keep care consistent from office to office, including <a class="inl" href="/provider/kaitlyn-czapiga-lmsw/">Kaitlyn Czapiga, LMSW</a>, Clinical Team Lead in Westbrook, and Chelsey Micciche, LPC, Team Lead for therapy. Clinical leadership also includes board-certified prescriber Tracy Sibley, PMHNP-BC, and Dr. Eric Schwartz, a licensed psychologist board certified in clinical child and adolescent psychology.`,
    ] },
  { id: "prescribers", h2: "Psychiatric nurse practitioners and physician assistants",
    paras: [
      `Our medical staff are board-certified psychiatric mental health nurse practitioners (PMHNP-BC, APRN) and physician assistants (PA-C). They evaluate symptoms, prescribe and adjust psychiatric medication, and follow up closely, for children from age 4, teens and adults. Medication management is offered at all six offices, in person or by telehealth.`,
      `Prescribers work alongside each client’s therapist and program team. When it helps, they use <a class="inl" href="/treatment-methods/genesight-testing/">GeneSight® genetic testing</a> to guide medication choices, and they coordinate <a class="inl" href="/treatment-methods/tms/">TMS therapy</a> for treatment-resistant depression and OCD. At our 300 Hebron Ave and Westbrook offices, prescribers also provide <a class="inl" href="/treatment-methods/medication-assisted-treatment/">medication-assisted treatment (MAT)</a> as part of addiction care.`,
    ],
    aside: { type: "img", src: "/Assets/hhs-2026/south-glastonbury-med-waiting-room.webp", alt: "The waiting room at Hopewell's South Glastonbury office", cap: "South Glastonbury office" } },
  { id: "psychologists", h2: "Psychologists and testing specialists",
    paras: [
      `Hopewell’s psychologists provide therapy for children, teens and adults, and lead our testing services. <a class="inl" href="/provider/laura-miller-ph-d/">Dr. Laura Miller</a> leads our <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a>, and our psychologists also provide <a class="inl" href="/treatment-methods/adhd-testing/">ADHD testing</a> for children and adults.`,
      `Testing gives families a clearer diagnosis and a practical plan. Because results stay inside the same practice, they can shape therapy, <a class="inl" href="/post/secrets-from-a-504-insider-a-parents-guide-to-academic-accommodations/">school accommodations</a> and medication decisions without starting over somewhere new.`,
    ] },
  { id: "by-location", h2: "Therapists near you: Glastonbury, West Hartford, East Hampton and Westbrook",
    paras: [
      `Our clinical staff are listed above by office so you can find a therapist near you. The largest group works from our three Glastonbury offices, which also host our intensive programs: PHP, adult IOP and the Women’s Wellness IOP at <a class="inl" href="/location/glastonbury-ct-2/">300 Hebron Ave</a>, and the Teen &amp; Tween IOP at <a class="inl" href="/location/glastonbury-ct-3/">1420 Main St in South Glastonbury</a>.`,
      `In <a class="inl" href="/location/west-hartford-ct/">West Hartford</a> and <a class="inl" href="/location/east-hampton-ct/">East Hampton</a>, clinicians offer one-on-one therapy and medication management. Our <a class="inl" href="/location/westbrook-ct/">Westbrook</a> team, which opened in September 2026, runs an adult IOP and the Women’s Wellness IOP alongside therapy and medication management, and offers addiction treatment.`,
      `Some clinicians see clients at more than one office, and many also offer telehealth. When you call, our <a class="inl" href="/admissions/">admissions team</a> will match you with someone at the office and time that works for you.`,
    ],
    aside: { type: "table", title: "Clinicians by office", head: ["Office", "Services"], rows: [["Glastonbury (3)", "Therapy, meds, PHP, IOPs"], ["West Hartford", "Therapy &amp; meds"], ["East Hampton", "Therapy &amp; meds"], ["Westbrook", "Therapy, meds, IOPs, addiction care"]] } },
  { id: "choosing", h2: "How we match you with the right clinician",
    paras: [
      `You don’t have to choose a clinician on your own. When you reach out, our admissions team asks about what you’re facing, your schedule, your insurance and which office is closest. After a clinical assessment, we recommend a <a class="inl" href="/programs/">level of care</a> and a clinician whose focus areas fit, whether that is <a class="inl" href="/what-we-treat/anxiety/">anxiety</a>, depression, trauma, addiction, ADHD or something else.`,
      `If you already know who you’d like to see, mention their name when you call. And if the fit isn’t right after a few sessions, tell us; changing clinicians is a normal part of finding the right relationship. Read <a class="inl" href="/admissions/#what-to-expect">what to expect at your first visit</a>.`,
    ],
    aside: { type: "steps", title: "Getting matched", items: [["Call or request a callback", "(860) 735-1448"], ["Free insurance check", "Before your first visit"], ["Clinical assessment", "To recommend a level of care"], ["Meet your clinician", "In person or by telehealth"]] } },
];
const faqs = [
  ["Does Hopewell have psychiatrists?", `Our prescribers are board-certified psychiatric mental health nurse practitioners and physician assistants. They provide psychiatric evaluation and <a class="inl" href="/programs/medication-management/">medication management</a> for ages 4 and up.`],
  ["Can I choose my therapist?", "Yes. If you have someone in mind, ask for them by name when you call. Otherwise our admissions team will match you based on your needs, schedule and office."],
  ["Do your clinicians see children?", `Yes. We care for clients aged 4 and older, and our <a class="inl" href="/programs/teen-iop/">Teen &amp; Tween IOP</a> serves ages 8–17 after school.`],
  ["Which therapists offer telehealth?", "Many of our clinicians offer telehealth as well as in-person sessions. Ask our admissions team when you call."],
  ["Do your clinicians treat addiction?", `Yes. Addiction treatment, including the <a class="inl" href="/programs/addiction-iop/">Addiction and Substance Use IOP</a> and MAT, is offered at our <a class="inl" href="/location/glastonbury-ct-2/">300 Hebron Ave office in Glastonbury</a> and in <a class="inl" href="/location/westbrook-ct/">Westbrook</a>.`],
  ["How do I book with a specific clinician?", `Call <a class="inl" href="tel:8607351448">(860) 735-1448</a> or request a callback and mention the clinician’s name.`],
];
const short = (r) => r.replace(/^Board-Certified /, "");
const tones = ["is-white", "is-stone"];

---

<Base title="Therapists & Psychiatric Providers in Connecticut | Hopewell" description="Meet Hopewell's psychiatric nurse practitioners, PAs, psychologists, counselors and social workers in Glastonbury, Westbrook and West Hartford, CT." image="/Assets/hopewell-team.webp">
  <Header />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "About", href: "/about-us/" }, { label: "Our Team" }]}
      title="Meet our clinical team"
      lede="Innovative, holistic mental health care in one place: medication management, <a class='inl' href='/programs/counseling/'>counseling</a> and <a class='inl' href='/programs/intensive-outpatient-program/'>intensive outpatient programming</a>, to help clients change and live well."
      image="/Assets/hhs-2026/full-team-lawn.webp"
      imagePos="center 40%"
    >
      <ol class="ab-motto" aria-label="Our approach">
        <li><b>1</b>Therapy first</li>
        <li><b>2</b>Medication second</li>
        <li><b>3</b>Transformation third</li>
      </ol>
    </ServiceHero>


    {sections.map((sec, i) => (
      <section class={`section ${tones[i % 2]}`} id={sec.title.toLowerCase().replace(/[^a-z]+/g, "-")}>
        <div class="container">
          <div class="ab-roster-head">
            <h2>{sec.title}</h2>
            <span class="ab-roster-count"><b>{sec.people.length}</b>{sec.people.length === 1 ? "clinician" : "team members"}</span>
          </div>
          <ul class:list={["ab-roster", i < 2 && "is-lead"]}>
            {sec.people.map((m) => (
              <li><a class="tm-card" href={`/provider/${m.slug}/`}>
                {m.prescribes && <span class="ab-rx"><Icon name="pill" class="h-3.5 w-3.5" />Prescriber</span>}
                {m.photo
                  ? <img src={`${TM}${m.photo}.webp`} alt={m.name} width="600" height="750" loading="lazy" style={m.photoPos ? `object-position:${m.photoPos.replace(/^object-\[|\]$/g, "").replace(/_/g, " ")}` : undefined} />
                  : <span class="ab-init" aria-hidden="true">{initials(m.name)}</span>}
                <span class="tm-cap"><strong>{nameOf(m.name)}</strong>{credsOf(m.name) && <em class="tm-creds">{credsOf(m.name)}</em>}<span>{short(m.role)}</span></span>
              </a></li>
            ))}
          </ul>
        </div>
      </section>
    ))}

    

    <Prose blocks={blocks} />
    <Reviews tone="stone" />
    <MediaStrip bg="crema" heading="Our clinicians, featured across Connecticut" />
    <Faq faqs={faqs} heading="Our team, common questions" tone="white" />

    <!-- Conditions & treatments -->
    <section class="section is-white" id="services">
      <div class="container">
        <div class="sec-head"><h2>Conditions &amp; Treatments</h2><p class="lede">What our clinicians treat and offer across our Connecticut offices.</p></div>
        <div class="ab-svc">
          {services.map((s) => <a href={s.href}><span class="icon-badge"><Icon name={s.icon} /></span>{s.t}<Icon name="arrow" class="h-5 w-5" /></a>)}
        </div>
      </div>
    </section>

    <Insurance />
    <ClosingCta heading="Care from people who truly listen" lede="Our team is here to walk alongside you. Reach out to Hopewell Health Solutions today, confidentially, with no pressure, and we’ll match you with the right clinician." />
  </main>
  <Footer />
</Base>
