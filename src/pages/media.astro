---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import MediaStrip from "../components/MediaStrip.astro";
import "../styles/pages/about.css";
import ServiceHero from "../components/hw/ServiceHero.astro";
import VideoCarousel from "../components/hw/VideoCarousel.astro";
import ClosingCta from "../components/hw/ClosingCta.astro";
import Insurance from "../components/hw/Insurance.astro";
import { VIDEOS } from "../data/videos.js";

const videos = [
  { id: "aff5Xfy9CfE", t: "The Loneliness Crisis in Adults", outlet: "Hopewell Health Solutions" },
  { id: "GJeVqHhooBA", t: "Mommy Monday: Helping Children", outlet: "WFSB Channel 3" },
  { id: "uDy-K1dO0Fw", t: "CT Live!: Trauma in Women", outlet: "NBC Connecticut" },
  { id: "P3cmQMf3WoM", t: "Teen Mental Health Interview", outlet: "WFSB Channel 3" },
];
const L = "/Assets/Media%20Appearances/";
const press = [
  { outlet: "Hartford Courant", logo: L + "hartford.webp", date: "Feb 2023", title: "Hopewell opens first privately owned IOP mental health clinic in Glastonbury", href: "https://www.courant.com/2023/02/24/hopewell-solutions-opens-first-privately-owned-iop-mental-health-clinic-in-glastonbury/" },
  { outlet: "Hartford Business Journal", logo: L + "hbj-logo-v3.webp", date: "Honoree", title: "Kristine Schlichting — recognized leader in behavioral health", href: "https://hartfordbusiness.com/honoree/kristine-schlichting/" },
  { outlet: "FOX61", logo: L + "fox61.webp", date: "2023", title: "Glastonbury psychologist is helping teen girls and new moms find support", href: "https://www.fox61.com/article/news/local/outreach/awareness-months/glastonbury-psychologist-is-helping-teen-girls-and-new-moms-find-support/520-84d3fd3f-1cec-40bc-9d4c-65f7b6a4d2e9" },
  { outlet: "WFSB · Kara’s Cures", logo: L + "wfsb.avif", date: "Feb 2023", title: "Teen mental health crisis", href: "https://www.wfsb.com/video/2023/02/27/karas-cures-teen-mental-health-crisis/" },
  { outlet: "WFSB · Kara’s Cures", logo: L + "wfsb.avif", date: "Feb 2023", title: "How to help improve your teen’s mental health", href: "https://www.wfsb.com/video/2023/02/27/karas-cures-how-help-improve-your-teens-mental-health/" },
  { outlet: "IssueWire", logo: L + "issuewire.webp", date: "Feature", title: "Dr. Bido Aguessy: holistic approaches in psychology & spiritual care at Hopewell", href: "https://www.issuewire.com/dr-bido-aguessy-pioneering-holistic-approaches-in-psychology-and-spiritual-care-at-hopewell-health-solutions-1809193551604743" },
];
const more = VIDEOS.filter((v) => v.yt !== "aff5Xfy9CfE" && (v.type.startsWith("Podcast") || v.type.startsWith("Clinician")));

---

<Base title="In the News & Media | Hopewell Health Solutions" description="Hopewell Health Solutions in the news — featured on WFSB Eyewitness News, FOX61, the Hartford Courant & Hartford Business Journal for behavioral health and teen mental health in Connecticut.">
  <Header />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Media" }]}
      title="Hopewell Health Solutions in the Media"
      lede="Connecticut’s news outlets turn to our clinicians for expertise on teen mental health, women’s wellness, and the future of outpatient care. Here’s where you’ve seen us."
      bullets={["WFSB Eyewitness News 3 &amp; NBC Connecticut", "FOX61 &amp; the Hartford Courant", "Hartford Business Journal", "The <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a>"]}
      image="/Assets/hhs-2026/iop-team-hallway.webp"
      form={false}
    />
    <MediaStrip showLink={false} />

    <!-- TV segments -->
    <section class="section is-white" id="watch">
      <div class="container">
        <div class="sec-head"><h2>Interviews &amp; TV segments</h2><p class="lede">Press play to watch our clinicians on Connecticut TV.</p></div>
        <div class="ab-tv">
          {videos.map((v) => (
            <button type="button" class="vc-card" data-yt={v.id} data-title={v.t} aria-label={`Play: ${v.t}`}>
              <span class="vc-poster"><img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" /><span class="vc-play"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="#fff"/></svg></span></span>
              <span class="ab-tv-body"><small>{v.outlet}</small><strong>{v.t}</strong></span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Press -->
    <section class="section is-stone" id="press">
      <div class="container">
        <div class="sec-head"><h2>Press &amp; features</h2></div>
        <div class="ab-press">
          {press.map((p) => (
            <a href={p.href} target="_blank" rel="noopener">
              <span class="ab-press-top">{p.logo ? <img src={p.logo} alt={p.outlet} loading="lazy" /> : <b>{p.outlet}</b>}<span>{p.date}</span></span>
              <strong>{p.title}</strong>
              <em>Read the feature <Icon name="arrow" class="h-4 w-4" /></em>
            </a>
          ))}
        </div>
      </div>
    </section>

    <VideoCarousel videos={more} mode="grid" heading="More From the Hopewell Team" lede="Our podcast and short videos from Hopewell clinicians." link={{ href: "/podcast/", label: "All podcast episodes" }} />

    <Insurance tone="white" />
    <ClosingCta heading="Trusted by Connecticut — and here for you" lede="The same team the news turns to is ready to help you or your loved one heal." verifyHref="/admissions/#verify" />
  </main>
  <Footer />
</Base>
