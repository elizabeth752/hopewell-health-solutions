---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import ServiceHero from "../components/hw/ServiceHero.astro";
import "../styles/pages/admissions.css";
const links = [
  ["home", "Go home", "Start at the homepage", "/"],
  ["sparkles", "Programs", "IOP, PHP, counseling & more", "/programs/"],
  ["heart", "What we treat", "Depression, anxiety, addiction & more", "/what-we-treat/"],
  ["brain", "Treatments", "TMS, EMDR, testing", "/treatment-methods/"],
  ["pin", "Locations", "Six Connecticut offices", "/locations/"],
  ["shield", "Admissions", "Verify your insurance", "/admissions/"],
];
---

<Base
  title="Page Not Found | Hopewell Health Solutions"
  description="The page you’re looking for doesn’t exist or has moved. Find Hopewell Health Solutions programs, treatments, and locations in Connecticut."
  canonical="https://www.hopewellhealthsolutions.com/"
  robots="noindex, follow"
>
  <Header />
  <main id="main" tabindex="-1" class="hw">
    <ServiceHero crumbs={[{ label: "Page not found" }]} title="Page not found" lede="This page doesn’t exist or may have moved. Use the links below to get where you need to go." image="/Assets/hhs-2026/downtown-glastonbury-entrance.webp" form={false} />
    <section class="section is-stone">
      <div class="container">
        <div class="nf-links">
          {links.map(([icon, t, d, href]) => <a href={href}><span class="icon-badge"><Icon name={icon} /></span><span>{t}<small>{d}</small></span></a>)}
        </div>
        <p class="lede" style="margin-top:26px">Prefer to talk? Call <a class="inl" href="tel:8607351448">(860) 735-1448</a>.</p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
