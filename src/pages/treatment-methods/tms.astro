---
// TMS — 2026 redesign (Corner Canyon layout, Hopewell brand). All live copy kept; layout rebuilt.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import RelatedTreatments from "../../components/tx/RelatedTreatments.astro";
import "../../styles/pages/treatments.css";

const canonical = "https://www.hopewellhealthsolutions.com/treatment-methods/tms/";
const P = "/Assets/hhs-2026/";
const heroUsps = [
  "FDA-cleared, drug-free &amp; non-invasive",
  "NeuroStar® Advanced TMS for depression &amp; OCD",
  "18–45 minute sessions · no downtime · resume your day",
  "For treatment-resistant depression — a safer alternative to ECT",
];
const uses = [
  { icon: "cloud", t: "Treatment-Resistant Major Depression", d: "Nearly half of people with clinical depression are labeled “non-responsive” at some point — not improving on antidepressants or talk therapy alone. TMS is a safer alternative to ECT, with fewer side effects and higher success rates.", href: "/what-we-treat/depression/", link: "depression treatment" },
  { icon: "refresh", t: "Treatment-Resistant OCD", d: "NeuroStar TMS is FDA-cleared to treat OCD — a series of short outpatient sessions that stimulate neural activity in the prefrontal cortex, with high success and few to no side effects.", href: "/what-we-treat/ocd/", link: "OCD treatment" },
];
const steps = [
  ["Mapping", "You stay awake and alert while we perform a motor-threshold test to find your ideal magnetic field strength — a gentle pulse causes a small movement in your thumb, which lets us tailor the treatment to you."],
  ["Treatment", "Your first session runs 18–45 minutes. Many patients describe the sensation as light tapping on the scalp; if anything feels uncomfortable, we adjust it for you."],
  ["After treatment", "There’s no downtime — you can drive yourself home and resume work, family, or whatever your day holds, right away."],
];
const expect = [
  ["calendar", "Treatment frequency", "5 days a week for 30–36 sessions"],
  ["clock", "Duration", "6–9 weeks"],
  ["sun", "Session length", "18–45 minutes per session"],
];
const rightFor = [
  "You have depression and haven’t found relief with medication or therapy",
  "You want a non-medicated, non-invasive treatment option",
  "You want to avoid the common side effects of medications",
  "You’re ready for a treatment plan with multiple sessions",
  "You want a personalized approach with no downtime",
];
const L = "/Assets/Media%20Appearances/";
const press = [
  { outlet: "Hartford Courant", logo: L + "hartford.webp", date: "Feb 2023", title: "Hopewell opens first privately owned IOP mental health clinic in Glastonbury", href: "https://www.courant.com/2023/02/24/hopewell-solutions-opens-first-privately-owned-iop-mental-health-clinic-in-glastonbury/" },
  { outlet: "Hartford Business Journal", logo: L + "hbj-logo-v3.webp", date: "Honoree", title: "Kristine Schlichting — recognized leader in behavioral health", href: "https://hartfordbusiness.com/honoree/kristine-schlichting/" },
  { outlet: "FOX61", logo: L + "fox61.webp", date: "2023", title: "Glastonbury psychologist is helping teen girls and new moms find support", href: "https://www.fox61.com/article/news/local/outreach/awareness-months/glastonbury-psychologist-is-helping-teen-girls-and-new-moms-find-support/520-84d3fd3f-1cec-40bc-9d4c-65f7b6a4d2e9" },
  { outlet: "WFSB · Kara’s Cures", logo: L + "wfsb.avif", date: "Feb 2023", title: "Teen mental health crisis", href: "https://www.wfsb.com/video/2023/02/27/karas-cures-teen-mental-health-crisis/" },
  { outlet: "WFSB · Kara’s Cures", logo: L + "wfsb.avif", date: "Feb 2023", title: "How to help improve your teen’s mental health", href: "https://www.wfsb.com/video/2023/02/27/karas-cures-how-help-improve-your-teens-mental-health/" },
  { outlet: "IssueWire", logo: L + "issuewire.webp", date: "Feature", title: "Dr. Bido Aguessy: holistic approaches in psychology & spiritual care at Hopewell", href: "https://www.issuewire.com/dr-bido-aguessy-pioneering-holistic-approaches-in-psychology-and-spiritual-care-at-hopewell-health-solutions-1809193551604743" },
];
const faqs = [
  ["What is TMS?", "Transcranial Magnetic Stimulation is a safe, outpatient treatment that uses targeted magnetic pulses (similar to an MRI) to stimulate the brain areas that regulate mood. In depression those areas are often underactive — TMS gently “awakens” those connections to help restore healthy function. We use NeuroStar® Advanced TMS."],
  ["Does it hurt?", "No. You stay awake and alert; most people describe the feeling as light tapping on the scalp. If anything is uncomfortable, we adjust it."],
  ["How many sessions will I need?", "A typical course is 5 days a week for 30–36 sessions over about 6–9 weeks, with each session lasting 18–45 minutes."],
  ["Is there downtime?", "None — no anesthesia or sedation. You can drive yourself home and resume your normal activities immediately."],
  ["What does TMS treat?", `NeuroStar TMS is FDA-cleared for treatment-resistant major depression and OCD. Learn more about our <a class="inl" href="/what-we-treat/depression/">depression treatment</a> and <a class="inl" href="/what-we-treat/ocd/">OCD treatment</a>.`],
  ["Will my insurance cover it?", `We accept most major PPO plans (we don’t accept Medicaid / HUSKY) and will <a class="inl" href="#verify">verify your benefits for free</a>.`],
];
// Week-by-week course grid: weeks 1–6 always, weeks 7–9 when the plan runs longer (30–36 sessions, 6–9 weeks).
const weeks = Array.from({ length: 9 }, (_, i) => i + 1);
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: "TMS Therapy for Depression & OCD in Connecticut",
  url: canonical,
  about: { "@type": "MedicalTherapy", name: "Transcranial Magnetic Stimulation (TMS)", alternateName: "NeuroStar Advanced TMS", relevantSpecialty: "Psychiatric" },
  publisher: { "@type": "MedicalOrganization", name: "Hopewell Health Solutions" },
};
---

<Base title="TMS Therapy for Depression & OCD in CT | Hopewell Health Solutions" description="NeuroStar® Advanced TMS at Hopewell Health Solutions, Glastonbury, Westbrook & West Hartford CT — FDA-cleared, drug-free relief for treatment-resistant depression & OCD. No downtime. Most insurance accepted." canonical={canonical} image={P + "tms-chair.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Treatments", href: "/treatment-methods/" }, { label: "TMS" }]}
      title="TMS Therapy for Depression &amp; OCD in Connecticut"
      lede="A safe, non-invasive, FDA-cleared treatment for people with depression and OCD who haven’t found relief with medication or talk therapy — a cutting-edge way to regain control of your mental health."
      bullets={heroUsps}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "pin", text: "TMS · NeuroStar® Advanced TMS · Glastonbury, CT" }]}
      image={P + "tms-neurostar-session.webp"} imagePos="center 30%"
      imagePos="center 35%"
    />
    <Creds />

    <!-- What is TMS -->
    <section class="section is-white">
      <div class="container tx-split">
        <figure class="tx-photo">
          <img src={P + "tms-neurostar-chair.webp"} alt="A TMS session in the NeuroStar Advanced Therapy chair at Hopewell Health Solutions" width="1200" height="1600" loading="lazy" style="object-position:center 30%" />
          <figcaption>NeuroStar® Advanced TMS<span>Our TMS room in Glastonbury</span></figcaption>
        </figure>
        <div class="tx-copy">
          <h2>What is TMS?</h2>
          <p class="lede" style="margin-top:16px">TMS is part of our suite of state-of-the-art treatments — a breakthrough technology for mental health conditions that don’t respond to conventional treatment. Transcranial Magnetic Stimulation is a safe, painless, non-invasive outpatient treatment that uses magnetic pulses to stimulate the brain areas affected by depression and OCD, reducing long-term symptoms. It begins with a psychiatric evaluation and brain mapping to target the right area precisely.</p>
          <p class="lede" style="margin-top:14px">Antidepressants work indirectly through the body. <strong>NeuroStar® Advanced TMS targets the root cause — your brain.</strong> When synapses in the mood-regulating regions become underactive, connections are disrupted and depression sets in. TMS stimulates those inactive synapses, “awakening” the brain to restore its natural function. It can sit alongside <a class="inl" href="/programs/medication-management/">medication management</a> and therapy in one coordinated plan.</p>
        </div>
      </div>
    </section>

    <!-- What TMS treats -->
    <section class="section is-stone">
      <div class="container">
        <div class="sec-head"><h2>A breakthrough for treatment-resistant conditions</h2><p class="lede">When other treatments haven’t worked, TMS is FDA-cleared for two conditions.</p></div>
        <div class="tx-cards" style="--cols:2">
          {uses.map((u, i) => (
            <div class:list={["tx-card", i === 0 && "is-navy"]} style={i === 1 ? "--bar:#b6863c" : undefined}>
              <span class="icon-badge"><Icon name={u.icon} /></span>
              <h3>{u.t}</h3>
              <p>{u.d}</p>
              <p>Read more about our <a class="inl" href={u.href}>{u.link}</a>.</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Empathy band -->
    <section class="tx-band">
      <img src="/Assets/TMS/2757534.webp" alt="" aria-hidden="true" loading="lazy" />
      <div class="container">
        <h2>Medication after medication — and still no relief?</h2>
        <p class="lede">Treatment-resistant depression is more common than you think — and it isn’t the end of the road. TMS offers a drug-free path forward, with no downtime.</p>
        <div class="sv-ctas"><a href="#verify" class="btn btn-blue only-d">See if TMS is right for you</a><a href="#verify-m" class="btn btn-blue only-m">See if TMS is right for you</a><a href="tel:8607351448" class="btn btn-ghost"><Icon name="phone" />(860) 735-1448</a></div>
      </div>
    </section>

    <!-- Process -->
    <section class="section is-white">
      <div class="container">
        <div class="tx-split" style="margin-bottom:36px">
          <div class="sec-head" style="margin:0"><h2>The TMS treatment process</h2><p class="lede">A simple, comfortable process, from your first mapping session to getting on with your day. You stay awake and alert in a reclining chair while the NeuroStar® device delivers the pulses.</p></div>
          <figure class="tx-photo"><img src={P + "tms-neurostar-room.webp"} alt="The NeuroStar TMS device and treatment room at Hopewell Health Solutions" width="1200" height="900" loading="lazy" style="object-position:center 30%" /><figcaption>In the NeuroStar® chair<span>Glastonbury TMS room</span></figcaption></figure>
        </div>
        <ol class="tx-steps">
          {steps.map(([t, d], i) => (
            <li class="tx-step"><span class="tx-step-n">{i + 1}</span><h3>{t}</h3><p>{d}</p>{i < steps.length - 1 && <span class="step-arrow" aria-hidden="true"><Icon name="arrow" class="h-4 w-4" /></span>}</li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Results -->
    <section class="section is-navy">
      <svg class="hero-arcs" style="left:auto;right:-360px;top:-420px;bottom:auto" viewBox="0 0 800 800" aria-hidden="true"><circle cx="400" cy="400" r="390" /><circle cx="400" cy="400" r="300" /></svg>
      <div class="container">
        <div class="sec-head"><h2>Real, measurable relief</h2><p class="lede">Proven results from NeuroStar® Advanced TMS — FDA-cleared, with no downtime, drug-free &amp; non-invasive.</p></div>
        <div class="tx-stats" style="--cols:2">
          <div class="tx-stat"><strong>83<em>%</em></strong><span>of patients who completed TMS experienced relief from depression</span></div>
          <div class="tx-stat"><strong>62<em>%</em></strong><span>achieved full remission — complete relief from depression</span></div>
        </div>
        <p class="tx-source">Source: NeuroStar® published clinical data.</p>
      </div>
    </section>

    <!-- Schedule -->
    <section class="section is-stone">
      <div class="container tx-split">
        <div>
          <h2>Your TMS schedule</h2>
          <p class="lede" style="margin-top:14px">A full course of NeuroStar® Advanced TMS is delivered in short, consistent sessions — right here at our Glastonbury office.</p>
          <div class="tx-facts3" style="grid-template-columns:1fr">
            {expect.map(([icon, t, d]) => <div class="tx-fact"><span class="icon-badge"><Icon name={icon} /></span><span><strong>{t}</strong><span>{d}</span></span></div>)}
          </div>
          <img src="/Assets/TMS/neurostar-tms.webp" alt="NeuroStar Advanced TMS at Hopewell Health Solutions — treatment frequency, duration & session length" loading="lazy" style="margin-top:18px;width:100%;border-radius:18px;border:1px solid var(--hw-line)" />
        </div>
        <div class="tx-course" aria-label="A typical TMS course: five sessions a week for six to nine weeks">
          <div class="tx-course-grid" aria-hidden="true">
            <span></span>{["Mon", "Tue", "Wed", "Thu", "Fri"].map((d) => <span class="day">{d}</span>)}
            {weeks.map((w) => (<><span class="wk">Week {w}</span>{[0, 1, 2, 3, 4].map(() => <i class:list={[w > 6 && "opt"]}></i>)}</>))}
          </div>
          <p class="tx-course-key"><span><b></b>Weeks 1–6: 30 sessions</span><span><b class="opt"></b>Up to week 9 if your plan needs it (36 sessions)</span></p>
        </div>
      </div>
    </section>

    <!-- Is TMS right for you -->
    <section class="section is-white">
      <div class="container tx-split is-flip">
        <figure class="tx-photo"><img src="/Assets/guy%20thinking%20worried.webp" alt="Someone considering whether TMS is right for them" width="1200" height="900" loading="lazy" /></figure>
        <div>
          <h2>Is TMS treatment right for you?</h2>
          <p class="lede" style="margin-top:14px">Make the right choice. TMS may be a great fit if any of these resonate:</p>
          <ul class="tx-checks">{rightFor.map((r) => <li><span class="sv-tick"><Icon name="check" class="h-4 w-4" /></span><span>{r}</span></li>)}</ul>
          <div class="hero-ctas" style="margin-top:26px"><a href="#verify" class="btn btn-navy only-d">See if TMS is right for you</a><a href="#verify-m" class="btn btn-navy only-m">See if TMS is right for you</a></div>
        </div>
      </div>
    </section>

    <!-- Press -->
    <section class="section is-stone">
      <div class="container">
        <div class="sec-head"><h2>Press &amp; features</h2><p class="lede">Our clinicians, featured across Connecticut. <a class="inl" href="/media/">See all press &amp; interviews</a>.</p></div>
        <div class="tx-cards">
          {press.map((p) => (
            <a href={p.href} target="_blank" rel="noopener" class="tx-card" style="text-decoration:none">
              <span style="display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:34px"><img src={p.logo} alt={p.outlet} loading="lazy" style="height:28px;width:auto;max-width:60%;object-fit:contain" /><small style="color:var(--hw-slate);font-size:13px">{p.date}</small></span>
              <h3>{p.title}</h3>
              <span class="pc-go" style="font-family:var(--hw-head);font-weight:800;color:var(--hw-blue);display:inline-flex;gap:6px;align-items:center">Read the feature <Icon name="arrow" class="h-4 w-4" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" />
    <Reviews tone="stone" />
    <Insurance heading="Most major PPO plans accepted" lede="We’re in-network with most major PPO plans (we don’t accept Medicaid / HUSKY). Our team verifies your benefits at no cost — before you commit to anything." />
    <Locations heading="Our locations" lede="TMS is delivered at our Glastonbury office, with care across Connecticut. Reach us at <a class='inl' href='tel:8607351448'>(860) 735-1448</a> · <a class='inl' href='mailto:hhs4help@gmail.com'>hhs4help@gmail.com</a>." />
    <Faq faqs={faqs} heading="TMS — common questions" tone="white" />
    <RelatedTreatments current="/treatment-methods/tms/" />
    <ClosingCta heading="Find out if TMS is right for you" lede="If medication and talk therapy haven’t been enough, there’s another path. Reach out to Hopewell Health Solutions today — confidentially, with no pressure — and we’ll help you take the next step." image={P + "tms-chair.webp"} imageAlt="The TMS chair at Hopewell Health Solutions" />
  </main>
  <Footer />
</Base>
