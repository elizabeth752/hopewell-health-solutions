---
import Team from "../../components/hw/Team.astro";
// TMS, 2026 redesign (Corner Canyon layout, Hopewell brand). All live copy kept; layout rebuilt.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import RelatedTreatments from "../../components/tx/RelatedTreatments.astro";
import "../../styles/pages/treatments.css";

const canonical = "https://www.hopewellhealthsolutions.com/treatment-methods/tms/";
const P = "/Assets/hhs-2026/";
const heroUsps = [
  "Drug-free, no downtime",
  "NeuroStar® Advanced TMS",
  "18–45 minute sessions",
];
const uses = [
  { icon: "cloud", t: "Treatment-Resistant Major Depression", d: "Nearly half of people with clinical depression are labeled “non-responsive” at some point, not improving on antidepressants or talk therapy alone. TMS is a safer alternative to ECT, with fewer side effects and higher success rates.", href: "/what-we-treat/depression/", link: "depression treatment" },
  { icon: "refresh", t: "Treatment-Resistant OCD", d: "NeuroStar TMS is FDA-cleared to treat OCD, a series of short outpatient sessions that stimulate neural activity in the prefrontal cortex, with high success and few to no side effects.", href: "/what-we-treat/ocd/", link: "OCD treatment" },
];
const steps = [
  ["Mapping", "You stay awake and alert while we perform a motor-threshold test to find your ideal magnetic field strength: a gentle pulse causes a small movement in your thumb, which lets us tailor the treatment to you."],
  ["Treatment", "Your first session runs 18–45 minutes. Many patients describe the sensation as light tapping on the scalp; if anything feels uncomfortable, we adjust it for you."],
  ["After treatment", "There’s no downtime, you can drive yourself home and resume work, family, or whatever your day holds, right away."],
];
const expect = [
  ["calendar", "Treatment frequency", "5 days a week for 30–36 sessions"],
  ["clock", "Duration", "6–9 weeks"],
  ["sun", "Session length", "18–45 minutes per session"],
];
const rightFor = [
  "You have depression and haven’t found relief with medication or therapy",
  "You want a non-medicated, non-invasive treatment option",
  "You want to avoid the common side effects of medications",
  "You’re ready for a treatment plan with multiple sessions",
  "You want a personalized approach with no downtime",
];
const L = "/Assets/Media%20Appearances/";
const press = [
  { outlet: "Hartford Courant", logo: L + "hartford.webp", date: "Feb 2023", title: "Hopewell opens first privately owned IOP mental health clinic in Glastonbury", href: "https://www.courant.com/2023/02/24/hopewell-solutions-opens-first-privately-owned-iop-mental-health-clinic-in-glastonbury/" },
  { outlet: "Hartford Business Journal", logo: L + "hbj-logo-v3.webp", date: "Honoree", title: "Kristine Schlichting, recognized leader in behavioral health", href: "https://hartfordbusiness.com/honoree/kristine-schlichting/" },
  { outlet: "FOX61", logo: L + "fox61.webp", date: "2023", title: "Glastonbury psychologist is helping teen girls and new moms find support", href: "https://www.fox61.com/article/news/local/outreach/awareness-months/glastonbury-psychologist-is-helping-teen-girls-and-new-moms-find-support/520-84d3fd3f-1cec-40bc-9d4c-65f7b6a4d2e9" },
  { outlet: "WFSB · Kara’s Cures", logo: L + "wfsb.avif", date: "Feb 2023", title: "Teen mental health crisis", href: "https://www.wfsb.com/video/2023/02/27/karas-cures-teen-mental-health-crisis/" },
  { outlet: "WFSB · Kara’s Cures", logo: L + "wfsb.avif", date: "Feb 2023", title: "How to help improve your teen’s mental health", href: "https://www.wfsb.com/video/2023/02/27/karas-cures-how-help-improve-your-teens-mental-health/" },
  { outlet: "IssueWire", logo: L + "issuewire.webp", date: "Feature", title: "Dr. Bido Aguessy: holistic approaches in psychology & spiritual care at Hopewell", href: "https://www.issuewire.com/dr-bido-aguessy-pioneering-holistic-approaches-in-psychology-and-spiritual-care-at-hopewell-health-solutions-1809193551604743" },
];
const faqs = [
  ["What is TMS?", "<a class='inl' href='/post/tms-what-is-it/'>Transcranial magnetic stimulation</a> uses magnetic pulses to stimulate parts of the brain involved in mood. It's a non-medication treatment for depression. Transcranial Magnetic Stimulation is a safe, outpatient treatment that uses targeted magnetic pulses (similar to an MRI) to stimulate the brain areas that regulate mood. In depression those areas are often underactive; TMS gently “awakens” those connections to help restore healthy function. We use NeuroStar® Advanced TMS."],
  ["Is TMS FDA-cleared?", `Yes, for major depression that hasn't improved with medication, and for some other conditions. See the <a class="inl" href="https://www.fda.gov/news-events/press-announcements/fda-permits-marketing-transcranial-magnetic-stimulation-treatment-obsessive-compulsive-disorder" target="_blank" rel="noopener">FDA's announcement on TMS clearances</a>.`],
  ["Who is a good candidate?", `Adults with <a class="inl" href="/what-we-treat/depression/">depression</a> who haven't had enough relief from antidepressants, or who can't tolerate their side effects.`],
  ["What does a session feel like?", "You sit in a chair, awake, while a coil rests against your head. Most people feel a tapping sensation. You can return to normal activities right after. No. You stay awake and alert; most people describe the feeling as light tapping on the scalp. If anything is uncomfortable, we adjust it."],
  ["How many sessions will I need?", "A typical course is several sessions a week for several weeks. A typical course is 5 days a week for 30–36 sessions over about 6–9 weeks, with each session lasting 18–45 minutes."],
  ["What are the side effects?", `The most common are scalp discomfort and headache, which usually ease over time. Seizures are rare. Source: <a class="inl" href="https://www.nimh.nih.gov/health/topics/brain-stimulation-therapies/brain-stimulation-therapies" target="_blank" rel="noopener">NIMH, brain stimulation therapies</a>.`],
  ["Can I keep taking my medication?", `Usually yes. Your provider will review your medications before you start, and TMS can sit alongside <a class="inl" href="/programs/medication-management/">medication management</a>.`],
  ["Is there downtime?", "None: no anesthesia or sedation. You can drive yourself home and resume your normal activities immediately."],
  ["What does TMS treat?", `NeuroStar TMS is FDA-cleared for treatment-resistant major depression and OCD. Learn more about our <a class="inl" href="/what-we-treat/depression/">depression treatment</a> and <a class="inl" href="/what-we-treat/ocd/">OCD treatment</a>.`],
  ["Does insurance cover TMS?", `Many commercial plans cover TMS for depression after other treatments haven't worked, often with prior authorization. We check your benefits for you. We don't accept Medicare or Medicaid. We accept all major insurance providers and will <a class="inl" href="#verify">verify your benefits for free</a>.`],
  ["Can TMS be combined with therapy or IOP?", `Yes. Many people do TMS alongside <a class="inl" href="/programs/counseling/">counseling</a> or an <a class="inl" href="/programs/adult-mental-health-iop/">Adult Mental Health IOP</a>.`],
  ["Who can refer me?", "You can call us directly, or your doctor or therapist can refer you."],
];
// Week-by-week course grid: weeks 1–6 always, weeks 7–9 when the plan runs longer (30–36 sessions, 6–9 weeks).
const weeks = Array.from({ length: 9 }, (_, i) => i + 1);
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: "TMS Therapy for Depression in Connecticut",
  url: canonical,
  about: { "@type": "MedicalTherapy", name: "Transcranial Magnetic Stimulation (TMS)", alternateName: "NeuroStar Advanced TMS", relevantSpecialty: "Psychiatric" },
  publisher: { "@type": "MedicalOrganization", name: "Hopewell Health Solutions" },
};
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import { STORIES } from "../../data/videos.js";
const clientStories = ["uIlSCS7clwE", "S_CyYMDqEio", "x6R6XOZmxUQ"].map((id) => STORIES.find((v) => v.yt === id)).filter(Boolean); // client stories only, no podcast (user 2026-11-18)
---

<Base title="TMS Therapy for Depression &amp; OCD in Glastonbury, CT" description="TMS is a non-medication, FDA-cleared treatment for depression that hasn't improved with antidepressants, and for OCD. Offered at Hopewell in Glastonbury, CT." canonical={canonical} image={P + "tms-chair.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main id="main" tabindex="-1" class="hw">
    <ServiceHero
      crumbs={[{ label: "Treatments", href: "/treatment-methods/" }, { label: "TMS" }]}
      title="TMS Therapy for Depression &amp; OCD in Glastonbury, CT"
      lede="A safe, non-invasive, FDA-cleared treatment for depression and OCD when medication or talk therapy hasn’t brought relief."
      bullets={heroUsps}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "pin", text: "TMS · NeuroStar® Advanced TMS · Glastonbury, CT" }]}
      image={P + "tms-neurostar-session.webp"}
      imagePos="center 52%"
    />
    <Creds />

    <!-- What is TMS -->
    <section class="section is-white">
      <div class="container tx-split">
        <figure class="tx-photo">
          <img src="/Assets/Blogs/a-new-dawn-in-depression-treatment-introducing-tms-at-hopewell-health-solutions.webp" alt="The NeuroStar Advanced Therapy TMS system: treatment chair, coil arm and screen" width="768" height="757" loading="lazy" />
          <figcaption>NeuroStar® Advanced TMS<span>Offered at our Glastonbury office</span></figcaption>
        </figure>
        <div class="tx-copy">
          <h2>What is TMS?</h2>
          <p class="lede" style="margin-top:16px">TMS is part of our <a class="inl" href="/treatment-methods/">suite of state-of-the-art treatments</a>, a breakthrough technology for mental health conditions that don’t respond to conventional treatment. Transcranial Magnetic Stimulation is a safe, painless, non-invasive outpatient treatment that uses magnetic pulses to stimulate the brain areas affected by depression and OCD, reducing long-term symptoms. It begins with a psychiatric evaluation and brain mapping to target the right area precisely.</p>
          <p class="lede" style="margin-top:14px">Antidepressants work indirectly through the body. <strong>NeuroStar® Advanced TMS targets the root cause: your brain.</strong> When synapses in the mood-regulating regions become underactive, connections are disrupted and depression sets in. TMS stimulates those inactive synapses, “awakening” the brain to restore its natural function. It can sit alongside <a class="inl" href="/programs/medication-management/">medication management</a> and therapy in one coordinated plan.</p>
        </div>
      </div>
    </section>

    <!-- What TMS treats -->
    <section class="section is-stone">
      <div class="container">
        <div class="sec-head"><h2>A breakthrough for treatment-resistant conditions</h2><p class="lede">When other treatments haven’t worked, TMS is FDA-cleared for two conditions.</p></div>
        <div class="tx-cards" style="--cols:2">
          {uses.map((u, i) => (
            <div class:list={["tx-card", i === 0 && "is-navy"]} style={i === 1 ? "--bar:#b6863c" : undefined}>
              <span class="icon-badge"><Icon name={u.icon} /></span>
              <h3>{u.t}</h3>
              <p>{u.d}</p>
              <p>Read more about our <a class="inl" href={u.href}>{u.link}</a>.</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Empathy band -->
    <section class="tx-band">
      <img src="/Assets/TMS/2757534.webp" alt="" aria-hidden="true" loading="lazy" />
      <div class="container">
        <h2>Medication after medication, and still no relief?</h2>
        <p class="lede"><a class="inl" href="/post/a-new-dawn-in-depression-treatment-introducing-tms-at-hopewell-health-solutions/">Treatment-resistant depression</a> is more common than you think, and it isn’t the end of the road. TMS offers a drug-free path forward, with no downtime.</p>
        <div class="sv-ctas"><a href="#verify" class="btn btn-blue only-d">See if TMS is right for you</a><a href="#verify-m" class="btn btn-blue only-m">See if TMS is right for you</a><a href="tel:8607351448" class="btn btn-ghost"><Icon name="phone" />(860) 735-1448</a></div>
      </div>
    </section>

    <!-- Process -->
    <section class="section is-white">
      <div class="container">
        <div class="tx-split" style="margin-bottom:36px">
          <div class="sec-head" style="margin:0"><h2>The TMS treatment process</h2><p class="lede">A simple, comfortable process, from your first mapping session to getting on with your day. You stay awake and alert in a reclining chair while the NeuroStar® device delivers the pulses.</p></div>
          <figure class="tx-photo"><img src={P + "tms-chair.webp"} alt="The NeuroStar TMS device and treatment room at Hopewell Health Solutions" width="1200" height="900" loading="lazy" style="object-position:center 30%" /><figcaption>In the NeuroStar® chair<span>Glastonbury TMS room</span></figcaption></figure>
        </div>
        <ol class="tx-steps">
          {steps.map(([t, d], i) => (
            <li class="tx-step"><span class="tx-step-n">{i + 1}</span><h3>{t}</h3><p>{d}</p>{i < steps.length - 1 && <span class="step-arrow" aria-hidden="true"><Icon name="arrow" class="h-4 w-4" /></span>}</li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Results: ring charts beside the real NeuroStar device -->
    <section class="section is-navy">
      <div class="container tms-res">
        <div>
          <div class="sec-head"><h2>Real, measurable relief</h2><p class="lede">Evidence-based results from NeuroStar® Advanced TMS, FDA-cleared, with no downtime, drug-free &amp; non-invasive.</p></div>
          <ul class="tms-perks">
            <li><Icon name="shield" class="h-5 w-5" />FDA-cleared</li>
            <li><Icon name="clock" class="h-5 w-5" />No downtime</li>
            <li><Icon name="pill" class="h-5 w-5" />Drug-free</li>
            <li><Icon name="heart" class="h-5 w-5" />Non-invasive</li>
          </ul>
          <div class="tms-rings">
            {[[83, "of patients who completed TMS experienced relief from depression"], [62, "achieved full remission: complete relief from depression"]].map(([n, t], i) => (
              <figure class="tms-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="12" /><circle cx="60" cy="60" r="50" fill="none" stroke={i ? "#b6863c" : "#9cc3ea"} stroke-width="12" stroke-linecap="round" stroke-dasharray={`${(n / 100) * 314.16} 314.16`} transform="rotate(-90 60 60)" /></svg>
                <strong>{n}<em>%</em></strong>
                <figcaption>{t}</figcaption>
              </figure>
            ))}
          </div>
          <p class="tx-source">Source: NeuroStar® published clinical data.</p>
        </div>
        <figure class="tms-res-photo"><img src={P + "tms-neurostar-device-only.webp"} alt="The NeuroStar Advanced Therapy device at Hopewell Health Solutions" width="1200" height="1600" loading="lazy" /><figcaption>NeuroStar® Advanced Therapy · Glastonbury</figcaption></figure>
      </div>
    </section>

    <!-- Schedule -->
    <section class="section is-stone">
      <div class="container tms-sched">
        <div>
          <h2>Your TMS schedule</h2>
          <p class="lede" style="margin-top:14px">A full course of NeuroStar® Advanced TMS is delivered in short, consistent sessions, right here at our Glastonbury office.</p>
          <div class="tms-facts">
            {expect.map(([icon, t, d]) => <div class="tx-fact"><span class="icon-badge"><Icon name={icon} /></span><span><strong>{t}</strong><span>{d}</span></span></div>)}
          </div>
        </div>
        <div class="tx-course" aria-label="A typical TMS course: five sessions a week for six to nine weeks">
          <div class="tx-course-grid" aria-hidden="true">
            <span></span>{["Mon", "Tue", "Wed", "Thu", "Fri"].map((d) => <span class="day">{d}</span>)}
            {weeks.map((w) => (<><span class="wk">Week {w}</span>{[0, 1, 2, 3, 4].map(() => <i class:list={[w > 6 && "opt"]}></i>)}</>))}
          </div>
          <p class="tx-course-key"><span><b></b>Weeks 1–6: 30 sessions</span><span><b class="opt"></b>Up to week 9 if your plan needs it (36 sessions)</span></p>
        </div>
      </div>
    </section>

    <!-- Is TMS right for you -->
    <section class="section is-white">
      <div class="container tx-split is-flip">
        <figure class="tx-photo"><img src="/Assets/Blogs/what-is-seasonal-affective-disorder-sad.webp" alt="A woman sitting by a window, weighing her options for depression treatment" width="1200" height="900" loading="lazy" /></figure>
        <div>
          <h2>Is TMS treatment right for you?</h2>
          <p class="lede" style="margin-top:14px">Make the right choice. TMS may be a great fit if any of these resonate:</p>
          <ul class="tx-checks">{rightFor.map((r) => <li><span class="sv-tick"><Icon name="check" class="h-4 w-4" /></span><span>{r}</span></li>)}</ul>
          <div class="hero-ctas" style="margin-top:26px"><a href="#verify" class="btn btn-navy only-d">See if TMS is right for you</a><a href="#verify-m" class="btn btn-navy only-m">See if TMS is right for you</a></div>
        </div>
      </div>
    </section>

    <!-- Safety, side effects, who it's not for (brief): one panel split by thin rules -->
    <section class="section is-stone">
      <div class="container">
        <div class="sec-head"><h2>Safety, side effects and who TMS isn’t for</h2><p class="lede">You’re awake the whole time, there’s no anesthesia, and you can drive yourself home. Your evaluation checks that TMS is safe for you before you start.</p></div>
        <div class="tms-rule-panel">
          <div>
            <h3>Side effects</h3>
            <p>The most common side effects are mild scalp discomfort or headache, which usually ease over time. Seizures are rare.</p>
            <p class="tx-source" style="margin-top:12px">Source: <a class="inl" href="https://www.nimh.nih.gov/health/topics/brain-stimulation-therapies/brain-stimulation-therapies" target="_blank" rel="noopener">NIMH, brain stimulation therapies</a>.</p>
          </div>
          <div>
            <h3>Who it’s not for</h3>
            <p>TMS isn’t right for people with certain metal implants in or near the head, or a history of seizures. The evaluation screens for this, along with conditions such as <a class="inl" href="/what-we-treat/bipolar/">bipolar disorder</a>.</p>
          </div>
          <div>
            <h3>Your medications</h3>
            <p>You can usually keep taking your medication. Your provider will review your medications before you start.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TMS alongside other care (brief): heading left, divided list right -->
    <section class="section is-white">
      <div class="container tx-split" style="align-items:start">
        <div class="sec-head" style="margin:0">
          <h2>TMS alongside your other care</h2>
          <p class="lede">TMS is a non-medication treatment for <a class="inl" href="/what-we-treat/depression/">depression</a> that hasn’t improved with antidepressants. Many people do TMS alongside therapy, medication or an intensive program.</p>
        </div>
        <ul class="tms-dl">
          <li><strong>Medication management</strong><span>Your prescriber reviews your medications before you start, and TMS can sit alongside ongoing <a class="inl" href="/programs/medication-management/">medication management</a>.</span></li>
          <li><strong>Counseling</strong><span>Many people continue <a class="inl" href="/programs/counseling/">one-on-one counseling</a> during their TMS course.</span></li>
          <li><strong>Adult IOP</strong><span>TMS can be combined with our <a class="inl" href="/programs/adult-mental-health-iop/">adult intensive outpatient program</a> when you need more support.</span></li>
          <li><strong>GeneSight® testing</strong><span>If finding the right medication has been hard, <a class="inl" href="/treatment-methods/genesight-testing/">GeneSight® testing</a> can help guide your treatment plan.</span></li>
          <li><strong>Referrals</strong><span>You can call us directly, or your doctor or therapist can refer you.</span></li>
        </ul>
      </div>
    </section>

    <Team tone="white" />
    <Insurance heading="Most major PPO plans accepted" lede="We’re in-network with most major PPO plans (we don’t accept Medicaid / HUSKY). Our team verifies your benefits at no cost, before you commit to anything." />
    <Locations heading="Our locations" lede="TMS is delivered at our Glastonbury office, with care across Connecticut. Reach us at <a class='inl' href='tel:8607351448'>(860) 735-1448</a> · <a class='inl' href='mailto:hhs4help@gmail.com'>hhs4help@gmail.com</a>." />
    <VideoCarousel videos={clientStories} mode="grid" tone="navy" heading="Client Stories, in Their Own Words" lede="Clients share what care at Hopewell was like, in their own words." link={{ href: "/testimonials/", label: "Read more patient stories" }} />
    <Reviews tone="stone" />
    <Faq faqs={faqs} heading="TMS: common questions" tone="white" />
    <RelatedTreatments current="/treatment-methods/tms/" />
    <ClosingCta heading="Find out if TMS is right for you" lede="If medication and talk therapy haven’t been enough, there’s another path. Reach out to Hopewell Health Solutions today, confidentially, with no pressure, and we’ll help you take the next step." image={P + "tms-chair.webp"} imageAlt="The TMS chair at Hopewell Health Solutions" />
  </main>
  <Footer />
</Base>

<style>
  .hw .tms-rule-panel { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); background: #fff; border: 1px solid var(--hw-line); border-radius: 22px; align-items: start; }
  .hw .tms-rule-panel > div { padding: 28px 28px 30px; }
  .hw .tms-rule-panel > div + div { border-left: 1px solid var(--hw-line); }
  .hw .tms-rule-panel h3 { font-size: 20px; color: var(--hw-navy); }
  .hw .tms-rule-panel p { margin-top: 8px; font-size: 16px; line-height: 1.55; }
  .hw .tms-dl { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hw-line); }
  .hw .tms-dl li { display: grid; grid-template-columns: 200px 1fr; gap: 18px; padding: 18px 0; border-bottom: 1px solid var(--hw-line); font-size: 16px; line-height: 1.55; }
  .hw .tms-dl strong { font-family: var(--hw-head); color: var(--hw-navy); font-size: 17px; }
  @media (max-width: 860px) {
    .hw .tms-rule-panel { grid-template-columns: minmax(0, 1fr); }
    .hw .tms-rule-panel > div + div { border-left: 0; border-top: 1px solid var(--hw-line); }
    .hw .tms-dl li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
