---
// MAT — 2026 redesign. All live copy kept. Added (KB): addiction services run at Downtown Glastonbury (300 Hebron Ave)
// and Westbrook only (locations.js `addiction`), addiction wording, links to the addiction IOP and condition pages.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import Team from "../../components/hw/Team.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import RelatedTreatments from "../../components/tx/RelatedTreatments.astro";
import { VIDEOS } from "../../data/videos.js";
import { locations } from "../../data/locations.js";
import "../../styles/pages/treatments.css";

const canonical = "https://www.hopewellhealthsolutions.com/treatment-methods/medication-assisted-treatment/";
const P = "/Assets/hhs-2026/";
const heroUsps = [
  "FDA-approved medications combined with counseling",
  "Eases cravings and withdrawal so recovery can take hold",
  "Medically supervised by our licensed prescribers",
  "An evidence-based, whole-person approach to recovery",
];
const meds = [
  ["Opioid use disorder", "Buprenorphine and naltrexone are commonly used."],
  ["Alcohol use disorder", "Options include naltrexone, acamprosate and disulfiram."],
];
const addictionOffices = locations.filter((l) => l.addiction);
const faq = [
  ["What is medication-assisted treatment?", "Medication-assisted treatment (MAT) is the use of FDA-approved medications, in combination with counseling and behavioral therapy, to treat substance use disorders — most often opioid use disorder and alcohol use disorder. SAMHSA describes it as a 'whole-patient' approach, because the medication and the therapy work together rather than alone."],
  ["Isn't MAT just replacing one drug with another?", "No. This is one of the most common myths about MAT. When taken as prescribed under medical supervision, these medications do not produce a high — they stabilize brain chemistry, reduce cravings, and ease withdrawal so a person can focus on recovery. MAT is a legitimate, evidence-based medical treatment endorsed by leading health authorities."],
  ["Which medications are used?", "It depends on the substance and the individual. For opioid use disorder, medications such as buprenorphine and naltrexone are commonly used. For alcohol use disorder, options include naltrexone, acamprosate and disulfiram. Your Hopewell prescriber determines what is appropriate for you based on a full evaluation."],
  ["How long does someone stay on MAT?", "There is no single timeline. Some people benefit from medication for months, others for years. The right duration is a clinical decision made between you and your prescriber, based on your progress and goals. Stopping is always done gradually and under medical guidance — never abruptly on your own."],
  ["Where is MAT offered?", `Addiction treatment, including MAT and our <a class="inl" href="/programs/substance-use-iop/">addiction IOP</a>, is offered at our <a class="inl" href="/location/glastonbury-ct-2/">Downtown Glastonbury</a> (300 Hebron Ave) and <a class="inl" href="/location/westbrook-ct/">Westbrook</a> offices.`],
];
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: "Medication-Assisted Treatment (MAT)",
  url: canonical,
  about: { "@type": "MedicalTherapy", name: "Medication-Assisted Treatment" },
  publisher: { "@type": "MedicalOrganization", name: "Hopewell Health Solutions" },
};
const vids = VIDEOS.filter((v) => ["1NnnRKONzhg", "vlKx8J6hykA", "uIlSCS7clwE"].includes(v.yt));
---

<Base title="Medication-Assisted Treatment (MAT) | Hopewell Health Solutions" description="Medication-assisted treatment (MAT) combines FDA-approved medications with counseling to treat opioid and alcohol use disorders. Medically supervised at Hopewell Health Solutions in Connecticut." canonical={canonical} image={P + "iop-group-session.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Treatments", href: "/treatment-methods/" }, { label: "Medication-Assisted Treatment" }]}
      title="Medication-Assisted Treatment (MAT)"
      lede="Addiction recovery is rarely a matter of willpower alone. MAT eases the physical pull of a substance and clears space for the deeper work of recovery — under careful medical supervision."
      bullets={heroUsps}
      facts={[{ icon: "pin", text: "Downtown Glastonbury & Westbrook" }, { icon: "pill", text: "Licensed prescribers" }]}
      image="/Assets/Blogs/psychiatric-medications-for-addiction-how-they-support-recovery.webp"
    />
    <Creds />

    <section class="section is-white">
      <div class="container tx-split">
        <div class="tx-copy">
          <h2>Addiction recovery, with medical support</h2>
          <p style="margin-top:16px">Recovery from addiction is rarely a matter of willpower alone. Substances like opioids and alcohol change the chemistry of the brain, and those changes can drive powerful cravings and painful withdrawal long after a person decides they want to stop. Medication-assisted treatment exists for exactly this reason. By easing the physical pull of a substance, MAT clears space for the deeper work of recovery — the counseling, the skill-building, and the rebuilding of a life. At Hopewell Health Solutions, MAT is delivered under careful medical supervision as part of a complete, compassionate approach to healing.</p>
        </div>
        <figure class="tx-photo"><img src={P + "downtown-glastonbury-entrance.webp"} alt="The entrance to Hopewell's Downtown Glastonbury office, where addiction treatment is offered" width="1200" height="900" loading="lazy" /><figcaption>Downtown Glastonbury<span>300 Hebron Ave · addiction treatment</span></figcaption></figure>
      </div>
    </section>

    <section class="section is-stone">
      <div class="container tx-split">
        <div class="tx-venn" aria-label="Medication and therapy work together: the whole-patient approach">
          <div>Medication<span>Normalizes brain chemistry, relieves cravings and withdrawal</span></div>
          <div>Therapy<span>Individual and group counseling, coping skills</span></div>
          <b>Whole-patient<br />approach</b>
        </div>
        <div class="tx-copy">
          <h2>What MAT is</h2>
          <p style="margin-top:16px">Medication-assisted treatment is the use of FDA-approved medications, combined with counseling and behavioral therapies, to treat substance use disorders — most commonly opioid use disorder and alcohol use disorder. The Substance Abuse and Mental Health Services Administration (SAMHSA) calls it a "whole-patient" approach, and that phrase captures the point: the medication is never the entire treatment. It works hand in hand with therapy to address both the body and the mind. Used together, the two are more effective than either one on its own.</p>
        </div>
      </div>
    </section>

    <section class="section is-white">
      <div class="container tx-split" style="align-items:start">
        <div class="tx-copy">
          <h2>How the medications help</h2>
          <p style="margin-top:16px">The medications used in MAT are not a high in disguise. When taken as prescribed under medical supervision, they normalize brain chemistry, reduce or block the euphoric effects of the substance, relieve cravings, and ease withdrawal symptoms. For opioid use disorder, medications such as buprenorphine and naltrexone are commonly used. For alcohol use disorder, options include naltrexone, acamprosate and disulfiram. The right choice depends on your history, your health, and your goals — which is why every MAT plan at Hopewell begins with a thorough evaluation by a licensed prescriber, not a one-size-fits-all prescription.</p>
        </div>
        <div>
          <div class="tx-table">
            <div class="tx-row is-head"><span>Substance</span><span>Common medications</span></div>
            {meds.map(([s, m]) => <div class="tx-row"><strong>{s}</strong><span>{m}</span></div>)}
            <div class="tx-row"><strong>Your plan</strong><span>Chosen by your prescriber after a full evaluation.</span></div>
          </div>
          <p style="margin-top:14px;font-size:15.5px;color:var(--hw-slate)">Learn more about <a class="inl" href="/what-we-treat/alcohol/">alcohol addiction treatment</a>, <a class="inl" href="/what-we-treat/drug/">drug addiction treatment</a> and <a class="inl" href="/what-we-treat/prescription-drugs/">prescription drug addiction treatment</a>.</p>
        </div>
      </div>
    </section>

    <section class="section is-navy">
      <svg class="hero-arcs" style="left:auto;right:-360px;top:-420px;bottom:auto" viewBox="0 0 800 800" aria-hidden="true"><circle cx="400" cy="400" r="390" /><circle cx="400" cy="400" r="300" /></svg>
      <div class="container tx-split" style="align-items:start">
        <div>
          <h2>Clearing up a common myth</h2>
          <p class="lede" style="margin-top:16px">Perhaps the most damaging myth about MAT is the idea that it simply "replaces one drug with another." It doesn't. Decades of research, and the consensus of organizations like SAMHSA and the National Institute on Drug Abuse, support MAT as a safe, effective, evidence-based medical treatment. Taking a prescribed medication to stabilize a chronic condition is no different in principle from taking medication for diabetes or high blood pressure. The goal is not dependence — it's freedom: the ability to think clearly, stay engaged in therapy, hold onto relationships and work, and dramatically lower the risk of relapse and overdose.</p>
        </div>
        <ol class="tx-phases" style="grid-template-columns:1fr">
          <li class="tx-phase"><b><Icon name="brain" class="h-5 w-5" /></b><span><strong>Think clearly</strong><span>Stable brain chemistry instead of cravings and withdrawal.</span></span></li>
          <li class="tx-phase"><b><Icon name="users" class="h-5 w-5" /></b><span><strong>Stay engaged in therapy</strong><span>Space for counseling and skill-building.</span></span></li>
          <li class="tx-phase"><b><Icon name="heart" class="h-5 w-5" /></b><span><strong>Hold onto relationships and work</strong><span>Recovery that fits around your life.</span></span></li>
          <li class="tx-phase"><b><Icon name="shield" class="h-5 w-5" /></b><span><strong>Lower the risk</strong><span>Of relapse and overdose.</span></span></li>
        </ol>
      </div>
    </section>

    <section class="section is-mist">
      <div class="container tx-split">
        <div class="tx-copy">
          <h2>MAT at Hopewell Health Solutions</h2>
          <p style="margin-top:16px">At Hopewell, medication-assisted treatment is always paired with the human side of recovery. Your prescriber manages your medication and monitors your progress closely, while individual and group therapy help you understand the roots of your substance use, build coping skills, and create a life that supports staying well. Care is coordinated, confidential, and judgment-free, and it can be integrated with our <a class="inl" href="/programs/substance-use-iop/">addiction IOP</a> and other programs so the level of support matches where you are. If you or someone you love is struggling, MAT may be an important part of the path forward — and our Connecticut team is ready to help you take the first step.</p>
        </div>
        <div class="tx-cards" style="--cols:1">
          {addictionOffices.map((o) => (
            <a class="tx-card" href={`/location/${o.slug}/`} style="--bar:#b6863c;text-decoration:none">
              <span class="icon-badge"><Icon name="pin" /></span>
              <h3>{o.name}</h3>
              <p>{o.street}, {o.city}, CT {o.zip} · Mental health &amp; addiction care</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <VideoCarousel videos={vids} mode="grid" tone="navy" heading="Stories of Recovery" lede="Hope, Health &amp; Healing podcast guests and clients share their own experiences with treatment and recovery." link={{ href: "/podcast/", label: "All podcast episodes" }} />
    <Team heading="Your MAT Prescribers and Recovery Team" lede="Licensed prescribers and recovery professionals on our team. <a class='inl' href='/about-us/team/'>Meet the full team</a>." slugs={["linda-scillia-pmhnp-bc-aprn", "katrin-moskowitz-dnp-pmhnp-bc-fnp", "tracy-sibley-pmhnp-bc-aprn", "ana-arroyo-aprn-pmhnp-bc", "katherine-salvador-pa-c", "tj-aitken-cpsrp", "teesha-huertas-lcsw"]} feature={null} tone="white" />
    <Reviews tone="stone" />
    <Insurance heading="MAT is often covered by insurance" lede="In-network with most major plans. We'll verify your benefits before you start." tone="white" />
    <Faq faqs={faq} heading="Frequently asked questions" />
    <RelatedTreatments current="/treatment-methods/medication-assisted-treatment/" tone="white" />
    <ClosingCta heading="Recovery is possible — and you don't have to do it alone" lede="Talk with our Connecticut team about whether MAT is right for you — confidentially, with no pressure." />
  </main>
  <Footer />
</Base>
