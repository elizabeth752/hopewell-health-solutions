---
// ADHD Testing — 2026 redesign. All live copy kept. Testing-room photo still needed from the client; a real Hopewell
// office photo stands in.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import Team from "../../components/hw/Team.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import RelatedTreatments from "../../components/tx/RelatedTreatments.astro";
import { VIDEOS } from "../../data/videos.js";
import "../../styles/pages/treatments.css";

const canonical = "https://www.hopewellhealthsolutions.com/treatment-methods/adhd-testing/";
const P = "/Assets/hhs-2026/";
const heroUsps = [
  "Personalized evaluation for children, teens &amp; adults",
  "A detailed interview with a Licensed PA/NP",
  "Rating scales + a remote computerized assessment",
  "Clear, personalized treatment recommendations",
];
const combine = [
  { t: "A detailed clinical interview", d: "A one-on-one interview with a Licensed PA/NP to understand your history and how symptoms show up in daily life.", icon: "clipboard", bar: "#265489" },
  { t: "Validated rating scales", d: "Standardized rating scales that capture how symptoms present across different settings.", icon: "star", bar: "#b6863c" },
  { t: "Remote computerized assessment", d: "An objective, computerized measure of attention you complete securely from home.", icon: "brain", bar: "#5c7c6b" },
];
const whoFor = [
  { img: P + "tween-group-room.webp", t: "Children", d: "Clarity around focus, behavior, and learning — with recommendations for home and school." },
  { img: P + "tx-east-hampton-office.webp", t: "Teens", d: "Understand what’s behind the struggles and build a plan that fits this stage of life." },
  { img: P + "tx-westbrook-office-3.webp", t: "Adults", d: "Answers after years of questions — and a clear, data-backed path forward." },
];
const steps = [
  ["In-office appointment with your provider", "Your evaluation begins with an in-office appointment with your provider to review your history and concerns."],
  ["Computerized assessment from home", "You’ll receive a secure link by email and can complete the computerized portion from the comfort of your home. The computerized portion is $99, paid by the patient."],
  ["Results & next steps", "One of our team members will call you to schedule a follow-up with your provider to review your results and discuss next steps."],
];
const faqs = [
  ["What ages do you evaluate?", "Our ADHD evaluations are designed for children, teens, and adults."],
  ["What’s the first step?", "An in-office appointment with your provider to review your history and concerns."],
  ["Where does the computerized portion take place?", "You’ll receive a secure link by email and can complete it from the comfort of your home."],
  ["How much does the computerized portion cost?", "The computerized portion is $99, paid by the patient."],
  ["What happens after the test?", `One of our team members will call you to schedule a follow-up with your provider to review your results and discuss next steps, which may include <a class="inl" href="/programs/medication-management/">medication management</a> or <a class="inl" href="/programs/counseling/">counseling</a>.`],
  ["How is this different from a checklist?", `Our evaluations go beyond a simple checklist — combining a detailed clinical interview, rating scales, and a computerized assessment to understand how symptoms affect daily life and distinguish ADHD from other conditions with similar signs. For a broader picture of learning and memory, see <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a>.`],
];
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: "ADHD Testing & Evaluation in Connecticut",
  url: canonical,
  about: { "@type": "MedicalTest", name: "ADHD Evaluation" },
  publisher: { "@type": "MedicalOrganization", name: "Hopewell Health Solutions" },
};
const tips = VIDEOS.filter((v) => ["LInMQYyZSmY", "cb3SsebwGiA"].includes(v.yt));
---

<Base title="ADHD Testing & Evaluation in CT | Hopewell Health Solutions" description="ADHD testing at Hopewell Health Solutions in Glastonbury, Westbrook & West Hartford, CT — personalized evaluations for children, teens & adults. Clinical interview, rating scales & a computerized assessment. Clear, tailored recommendations." canonical={canonical} image={P + "tx-east-hampton-office.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Treatments", href: "/treatment-methods/" }, { label: "ADHD Testing" }]}
      title="ADHD Testing &amp; Evaluation in Connecticut"
      lede="Get clarity — and a clear path forward. Personalized ADHD evaluations for children, teens and adults in Glastonbury, Westbrook and West Hartford."
      bullets={heroUsps}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "users", text: "Children, teens & adults" }]}
      image={P + "tx-east-hampton-office.webp"}
    />
    <Creds />

    <section class="section is-white">
      <div class="container tx-split">
        <figure class="tx-photo"><img src="/Assets/service/adhd-assessment.webp" alt="A provider and patient during an ADHD evaluation at Hopewell Health Solutions, Connecticut" width="1200" height="900" loading="lazy" /><figcaption>Beyond a simple checklist<span>Interview, rating scales &amp; a computerized test</span></figcaption></figure>
        <div class="tx-copy">
          <h2>ADHD assessment &amp; treatment</h2>
          <p class="lede" style="margin-top:16px">At Hopewell Health Solutions, we know that getting the right ADHD diagnosis is the first step toward effective treatment. Our evaluations are designed for children, teens, and adults — and go beyond a simple checklist.</p>
          <p class="lede">This thorough process helps us understand how symptoms affect daily life and distinguish ADHD from other conditions with similar signs. The result? Clear, personalized treatment recommendations for you or your loved one. Learn more about <a class="inl" href="/what-we-treat/adhd/">ADHD treatment</a>.</p>
        </div>
      </div>
    </section>

    <section class="section is-stone">
      <div class="container">
        <div class="sec-head"><h2>What our evaluation combines</h2><p class="lede">A complete picture, from three sources.</p></div>
        <div class="tx-cards">{combine.map((c) => <div class="tx-card" style={`--bar:${c.bar}`}><span class="icon-badge"><Icon name={c.icon} /></span><h3>{c.t}</h3><p>{c.d}</p></div>)}</div>
      </div>
    </section>

    <section class="section is-white">
      <div class="container">
        <div class="sec-head"><h2>Who ADHD testing is for</h2><p class="lede">At every age.</p></div>
        <div class="tx-who">{whoFor.map((w) => <div class="tx-who-card"><img src={w.img} alt="" loading="lazy" width="1200" height="900" /><div><h3>{w.t}</h3><p>{w.d}</p></div></div>)}</div>
      </div>
    </section>

    <section class="tx-band">
      <img src={P + "full-team-lawn.webp"} alt="" aria-hidden="true" loading="lazy" />
      <div class="container"><p class="tx-quote">“Getting the right ADHD diagnosis is the first step toward effective treatment.”</p></div>
    </section>

    <section class="section is-mist">
      <div class="container">
        <div class="sec-head"><h2>How it works</h2><p class="lede">Simple &amp; clear. The computerized portion is a $99 cost to the patient.</p></div>
        <ol class="tx-steps">{steps.map(([t, d], i) => <li class="tx-step"><span class="tx-step-n">{i + 1}</span><h3>{t}</h3><p>{d}</p>{i < steps.length - 1 && <span class="step-arrow" aria-hidden="true"><Icon name="arrow" class="h-4 w-4" /></span>}</li>)}</ol>
        <div class="hero-ctas" style="margin-top:28px"><a href="#verify" class="btn btn-navy only-d">Schedule your ADHD evaluation</a><a href="#verify-m" class="btn btn-navy only-m">Schedule your ADHD evaluation</a><a href="tel:8607351448" class="btn btn-outline"><Icon name="phone" />(860) 735-1448</a></div>
      </div>
    </section>

    <VideoCarousel videos={tips} mode="grid" tone="navy" heading="Tips for Families" lede="Viviana, one of our clinicians, on supporting neurodivergent tweens and a grounding skill for stressful moments." link={{ href: "/podcast/", label: "More videos" }} />
    <Team heading="Your ADHD Evaluation Team" lede="Licensed PAs and NPs who lead our ADHD evaluations, with therapists who support ADHD care. <a class='inl' href='/about-us/team/'>Meet the full team</a>." slugs={["christina-lindsay-pmhnp-bc-aprn", "katrin-moskowitz-dnp-pmhnp-bc-fnp", "chris-patenaude-pa", "katherine-salvador-pa-c", "chelsey-micciche-lpc", "viviana-alvarado-lpc-a", "madeline-blinderman-lpc-a"]} feature={null} tone="white" />
    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" showLink={false} />
    <Reviews tone="stone" />
    <Insurance heading="Most major PPO plans accepted" lede="We’re in-network with most major PPO plans (we don’t accept Medicaid / HUSKY). Our team verifies your benefits at no cost — and will let you know what your evaluation coverage looks like before you commit. (The computerized portion is a $99 cost to the patient.)" tone="white" />
    <Locations heading="Our locations" lede="In person at six Connecticut offices — plus virtual visits statewide. Reach us at <a class='inl' href='tel:8607351448'>(860) 735-1448</a> · <a class='inl' href='mailto:hhs4help@gmail.com'>hhs4help@gmail.com</a>." />
    <Faq faqs={faqs} heading="ADHD testing — common questions" tone="white" />
    <RelatedTreatments current="/treatment-methods/adhd-testing/" />
    <ClosingCta heading="Take the first step today" lede="If you or your loved one are struggling with focus, attention, or daily challenges that may be ADHD, our team is here to help. With clear testing and tailored treatment, you can move forward with confidence." />
  </main>
  <Footer />
</Base>
