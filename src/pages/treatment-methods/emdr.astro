  @media (max-width: 860px) {
    .hw .emdr-cols, .hw .emdr-rule-panel { grid-template-columns: 1fr; }
    .hw .emdr-cols > div + div, .hw .emdr-rule-panel > div + div { border-left: 0; border-top: 1px solid var(--hw-line); }
  }
</style>
