import ClosingCta from "../../components/hw/ClosingCta.astro";
import RelatedTreatments from "../../components/tx/RelatedTreatments.astro";
import "../../styles/pages/treatments.css";

const canonical = "https://www.hopewellhealthsolutions.com/treatment-methods/emdr/";
const P = "/Assets/hhs-2026/";
const heroUsps = [
  "Eye Movement Desensitization &amp; Reprocessing",
  "Recognized by the APA, WHO &amp; Department of Defense",
  "An eight-phase, evidence-based trauma therapy",
  "Healing that once took years, often in far less time",
];
const stats = [
  ["84–90", "%", "of single-trauma victims no longer had PTSD after three 90-minute sessions"],
  ["100", "%", "of single-trauma victims PTSD-free after six 50-minute sessions (Kaiser Permanente study)"],
  ["77", "%", "of combat veterans free of PTSD in 12 sessions"],
];
// The standard eight phases of the EMDR protocol (EMDR International Association).
const phases = [
  ["History & planning", "Your clinician learns your history and chooses which memories to target first."],
  ["Preparation", "You learn grounding and calming skills so you feel steady before any memory work."],
  ["Assessment", "Together you identify the image, belief, feelings and body sensations tied to the memory."],
  ["Desensitization", "Eye movements or other bilateral stimulation while you hold the memory in mind."],
  ["Installation", "A positive belief, such as “I survived it and I am strong,” is strengthened."],
  ["Body scan", "You notice and clear any tension that remains in your body."],
  ["Closure", "Each session ends with you feeling settled, using the skills from preparation."],
  ["Reevaluation", "The next session checks progress and decides what to work on next."],
];
const faqs = [
  ["What is EMDR therapy?", `A structured therapy that helps you process distressing memories using guided eye movements or tapping, so they feel less intense. EMDR (Eye Movement Desensitization and Reprocessing) is a psychotherapy that enables people to heal from the symptoms and emotional distress that are the result of disturbing life experiences. It is often used in our <a class="inl" href="/what-we-treat/trauma-ptsd/">trauma and PTSD treatment</a>.`],
  ["What does EMDR help with?", `It's best known for <a class="inl" href="/what-we-treat/trauma-ptsd/">trauma and PTSD</a>. Clinicians sometimes use it for <a class="inl" href="/what-we-treat/anxiety/">anxiety</a> and other concerns.`],
  ["What happens in a session?", `You recall a memory briefly while following your therapist's hand movements or tapping. Your therapist guides the pace and checks in throughout. EMDR therapy is an eight-phase treatment. Eye movements (or other bilateral stimulation) are used during one part of the session, while you hold a disturbing memory in mind and your brain begins to process it.`],
  ["Do I have to talk about my trauma in detail?", `Not in detail. EMDR focuses on processing the memory, and you stay in control of what you share. No. As a natural outcome of the EMDR therapeutic process, clients reach emotional resolution without speaking in detail or doing homework used in other therapies.`],
  ["How many sessions will I need?", "It varies. Some people need a few sessions, others more, depending on what's being treated."],
  ["What are the side effects of EMDR?", `Some people have vivid dreams or feel emotional between sessions. Your therapist will help you prepare and cope. Read more in our guide to <a class="inl" href="/post/emdr-therapy-what-it-is-side-effects-and-what-to-expect/">EMDR therapy side effects and what to expect</a>.`],
  ["Does insurance cover EMDR?", `Many commercial plans cover it as therapy. We check your benefits; we don't accept Medicare or Medicaid. EMDR is often covered by insurance. We’re in-network with most major plans and will verify your benefits before you start. See <a class="inl" href="/rates-and-insurance-coverage/">rates &amp; insurance</a>.`],
  ["Is there a shorter trauma therapy?", `Accelerated Resolution Therapy (ART), a briefer version of EMDR, is one of our <a class="inl" href="/treatment-methods/therapeutic-treatments/">HHS therapeutic treatments</a>.`],
];
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: "EMDR Therapy in Connecticut",
  url: canonical,
  about: { "@type": "MedicalTherapy", name: "Eye Movement Desensitization and Reprocessing (EMDR)" },
  publisher: { "@type": "MedicalOrganization", name: "Hopewell Health Solutions" },
};
---

<Base title="EMDR Therapy for Trauma &amp; PTSD in Connecticut | Hopewell" description="EMDR therapy helps people process trauma and PTSD with a trained Hopewell clinician in Connecticut. Learn what sessions are like and check your coverage." canonical={canonical} image={P + "tx-westbrook-office-2.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Treatments", href: "/treatment-methods/" }, { label: "EMDR" }]}
      title="EMDR Therapy in Connecticut"
      lede="An evidence-based, eight-phase trauma therapy that helps people heal from the symptoms and emotional distress of disturbing life experiences, offered by our clinicians across Connecticut."
      bullets={heroUsps}
      facts={[{ icon: "heart", text: "Trauma therapy" }, { icon: "users", text: "In person across Connecticut" }]}
      image={P + "tx-westbrook-office-2.webp"}
    />
    <Creds />

    <section class="section is-white">
      <div class="container tx-read">
        <div class="tx-copy">
          <h2>What is EMDR therapy?</h2>
          <p style="margin-top:16px">EMDR (Eye Movement Desensitization and Reprocessing) is a psychotherapy that enables people to heal from the symptoms and emotional distress that are the result of disturbing life experiences. Repeated studies show that by using EMDR therapy people can experience the benefits of psychotherapy that once took years to make a difference. It is widely assumed that severe emotional pain requires a long time to heal. EMDR therapy shows that the mind can in fact heal from <a class="inl" href="/what-we-treat/trauma-ptsd/">psychological trauma</a> much as the body recovers from physical trauma.</p>
          <p>When you cut your hand, your body works to close the wound. If a foreign object or repeated injury irritates the wound, it festers and causes pain. Once the block is removed, healing resumes. EMDR therapy demonstrates that a similar sequence of events occurs with mental processes. The brain’s information processing system naturally moves toward mental health. If the system is blocked or imbalanced by the impact of a disturbing event, the emotional wound festers and can cause intense suffering. Once the block is removed, healing resumes. Using the detailed protocols and procedures learned in EMDR therapy training sessions, clinicians help clients activate their natural healing processes.</p>
        </div>
        <aside>
          <img src={P + "tx-westbrook-office-3.webp"} alt="A calm therapy office at Hopewell's Westbrook location" width="1400" height="1050" loading="lazy" />
          <blockquote class="tx-pull">“I survived it and I am strong.”<small>The kind of belief EMDR helps a person reach</small></blockquote>
        </aside>
      </div>
    </section>

    <!-- Who EMDR may help (brief): two-column list divided by a thin rule -->
    <section class="section is-stone">
      <div class="container">
        <div class="sec-head"><h2>Who EMDR may help</h2><p class="lede">EMDR, eye movement desensitization and reprocessing, uses guided eye movements or tapping while you recall a memory, so it feels less overwhelming.</p></div>
        <div class="emdr-cols">
          <div>
            <h3>Best known for</h3>
            <ul>
              <li><a class="inl" href="/what-we-treat/trauma-ptsd/">Trauma and PTSD</a>, the main use of EMDR</li>
              <li>Distressing memories that still feel overwhelming</li>
            </ul>
          </div>
          <div>
            <h3>Sometimes used for</h3>
            <ul>
              <li><a class="inl" href="/what-we-treat/anxiety/">Anxiety</a></li>
              <li><a class="inl" href="/post/fear-of-flying-or-fear-of-leaving-home/">Phobias</a></li>
            </ul>
          </div>
        </div>
        <p style="margin-top:22px;font-size:15.5px;color:var(--hw-slate)">EMDR is one of several approaches our clinicians use, alongside <a class="inl" href="/programs/counseling/">counseling</a> and <a class="inl" href="/treatment-methods/dbt/">DBT</a>. For more structured trauma support, see our <a class="inl" href="/programs/womens-trauma-iop/">Women’s Trauma IOP</a> and <a class="inl" href="/programs/first-responder-iop/">First Responder IOP</a>.</p>
      </div>
    </section>

    <section class="section is-navy">
      <div class="container">
        <div class="sec-head"><h2>The research</h2></div>
        <div class="tx-stats">{stats.map(([n, u, d]) => <div class="tx-stat"><strong>{n}<em>{u}</em></strong><span>{d}</span></div>)}</div>
        <p class="lede" style="margin-top:28px;max-width:none">More than 30 positive controlled outcome studies have been done on EMDR therapy. Some of the studies show that 84%–90% of single-trauma victims no longer have post-traumatic stress disorder after only three 90-minute sessions. Another study, funded by the HMO Kaiser Permanente, found that 100% of the single-trauma victims and 77% of multiple trauma victims no longer were diagnosed with PTSD after only six 50-minute sessions. In another study, 77% of combat veterans were free of PTSD in 12 sessions. There has been so much research on EMDR therapy that it is now recognized as an effective form of treatment for trauma and other disturbing experiences by organizations such as the American Psychiatric Association, the World Health Organization and the Department of Defense. Given the worldwide recognition as an effective treatment of trauma, you can easily see how EMDR therapy would be effective in treating the “everyday” memories that are the reason people have low self-esteem, feelings of powerlessness, and all the myriad problems that bring them in for therapy. Over 100,000 clinicians throughout the world use the therapy. Millions of people have been treated successfully over the past 25 years.</p>
        <p class="tx-source">Figures as reported in published EMDR outcome studies, including the Kaiser Permanente study cited above.</p>
      </div>
    </section>

    <section class="section is-stone">
      <div class="container">
        <div class="tx-split" style="align-items:start">
          <div class="tx-copy">
            <h2>How EMDR works</h2>
            <p style="margin-top:16px">EMDR therapy is an eight-phase treatment. Eye movements (or other bilateral stimulation) are used during one part of the session. After the clinician has determined which memory to target first, he asks the client to hold different aspects of that event or thought in mind and to use his eyes to track the therapist’s hand as it moves back and forth across the client’s field of vision. As this happens, for reasons believed by a Harvard researcher to be connected with the biological mechanisms involved in Rapid Eye Movement (REM) sleep, internal associations arise and the clients begin to process the memory and disturbing feelings.</p>
            <figure class="tx-photo" style="margin-top:28px"><img src={P + "east-hampton-counseling-room.webp"} alt="A private therapy room with a sofa and armchair at Hopewell's East Hampton office" width="1200" height="1200" loading="lazy" /><figcaption>One-on-one sessions<span>EMDR is done individually with your clinician</span></figcaption></figure>
          </div>
          <div class="tx-copy">
            <p>In successful EMDR therapy, the meaning of painful events is transformed on an emotional level. For instance, a rape victim shifts from feeling horror and self-disgust to holding the firm belief that, “I survived it and I am strong.” Unlike <a class="inl" href="/programs/counseling/">talk therapy</a>, the insights clients gain in EMDR therapy result not so much from clinician interpretation, but from the client’s own accelerated intellectual and emotional processes.</p>
            <p>The net effect is that clients conclude EMDR therapy feeling empowered by the very experiences that once debased them. Their wounds have not just closed, they have transformed. As a natural outcome of the EMDR therapeutic process, the clients’ thoughts, feelings and behavior are all robust indicators of emotional health and resolution, all without speaking in detail or doing homework used in other therapies.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section is-navy">
      <div class="container">
        <div class="sec-head"><h2>The eight phases of EMDR</h2><p class="lede">Every course follows the same eight phases. Your first sessions focus on history and preparation, then processing sessions follow. Eye movements happen in phase 4; the phases around it keep you prepared and steady.</p></div>
        <ol class="tx-phases">
          {phases.map(([t, d], i) => <li class:list={["tx-phase", i === 3 && "is-hl"]}><b>{i + 1}</b><span><strong>{t}</strong><span>{d}</span></span></li>)}
        </ol>
      </div>
    </section>

    <!-- Side effects (brief): one panel split by thin rules -->
    <section class="section is-stone">
      <div class="container">
        <div class="sec-head"><h2>Side effects and staying steady</h2><p class="lede">EMDR can stir things up between sessions. Your clinician plans for this with you from the start.</p></div>
        <div class="emdr-rule-panel">
          <div><h3>What you might notice</h3><p>Some people have vivid dreams or feel emotional or upset for a while after a session.</p><p class="tx-source" style="margin-top:12px">Source: <a class="inl" href="https://my.clevelandclinic.org/health/treatments/22641-emdr-therapy" target="_blank" rel="noopener">Cleveland Clinic, EMDR therapy</a>.</p></div>
          <div><h3>How your clinician helps</h3><p>Your therapist will help you prepare and cope, guides the pace and checks in throughout. You stay in control of what you share.</p></div>
          <div><h3>Learn more first</h3><p>Curious before you book? Our guide to <a class="inl" href="/post/emdr-therapy-what-it-is-side-effects-and-what-to-expect/">EMDR therapy side effects and what a session feels like</a> covers it in more detail.</p></div>
        </div>
      </div>
    </section>

    <Team heading="EMDR-Trained Clinicians" lede="Clinicians on our team who list EMDR and trauma among their focus areas. <a class='inl' href='/about-us/team/'>Meet the full team</a>." slugs={["teesha-huertas-lcsw", "meagan-carr-ph-d", "joanne-malinka-lcsw"]} feature={null} tone="white" />
    <Insurance heading="EMDR is often covered by insurance" lede="In-network with most major plans. We'll verify your benefits before you start, free, in minutes." />
    <Reviews tone="stone" />
    <Faq faqs={faqs} heading="EMDR: common questions" tone="white" />
    <RelatedTreatments current="/treatment-methods/emdr/" />
    <ClosingCta heading="Ready to start healing?" lede="Talk with our Connecticut team about whether EMDR is right for you, confidentially, with no pressure." verifyHref="#verify" />
  </main>
  <Footer />
</Base>

<style>
  .hw .emdr-cols { display: grid; grid-template-columns: 1fr 1fr; background: #fff; border: 1px solid var(--hw-line); border-radius: 22px; align-items: start; }
  .hw .emdr-cols > div { padding: 26px 30px 28px; }
  .hw .emdr-cols > div + div { border-left: 1px solid var(--hw-line); }
  .hw .emdr-cols h3 { font-size: 20px; color: var(--hw-navy); }
  .hw .emdr-cols ul { list-style: none; margin: 10px 0 0; padding: 0; }
  .hw .emdr-cols li { padding: 12px 0; font-size: 16.5px; line-height: 1.5; }
  .hw .emdr-cols li + li { border-top: 1px solid var(--hw-line); }
  .hw .emdr-rule-panel { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); background: #fff; border: 1px solid var(--hw-line); border-radius: 22px; align-items: start; }
  .hw .emdr-rule-panel > div { padding: 28px 28px 30px; }
  .hw .emdr-rule-panel > div + div { border-left: 1px solid var(--hw-line); }
  .hw .emdr-rule-panel h3 { font-size: 20px; color: var(--hw-navy); }
