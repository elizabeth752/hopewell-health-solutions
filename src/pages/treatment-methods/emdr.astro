    <RelatedTreatments current="/treatment-methods/emdr/" />
    <ClosingCta heading="Ready to start healing?" lede="Talk with our Connecticut team about whether EMDR is right for you — confidentially, with no pressure." verifyHref="#verify" />
  </main>
