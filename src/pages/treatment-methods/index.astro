---
import HeroCreds from "../../components/hw/HeroCreds.astro";
// Treatments hub — 2026 redesign, Corner Canyon content-rich hub pattern (user, 2026-11-16: "we need content for SEO").
// Live copy kept; all nine treatment pages now listed (DBT, Group Therapy, GeneSight and
// MAT were missing from the old hub), grouped as treatments and testing.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import Team from "../../components/hw/Team.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import { TREATMENTS } from "../../components/tx/treatments.js";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import { STORIES } from "../../data/videos.js";
import "../../styles/pages/treatments.css";
import "../../styles/pages/hubs.css";

const canonical = "https://www.hopewellhealthsolutions.com/treatment-methods/";
const P = "/Assets/hhs-2026/";
const testingHrefs = ["/treatment-methods/genesight-testing/", "/treatment-methods/neuropsychological-testing/", "/treatment-methods/adhd-testing/"];
const advanced = TREATMENTS.filter((t) => !testingHrefs.includes(t.href));
const testing = TREATMENTS.filter((t) => testingHrefs.includes(t.href));

const B = "/Assets/Blogs/";
const groups = [
  { key: "advanced", name: "Advanced & brain-based treatments", note: "When medication and therapy aren’t enough on their own", icon: "brain", tone: "t-blue", items: [
    { t: "TMS Therapy", href: "/treatment-methods/tms/", img: P + "tms-neurostar-session.webp",
      d: "FDA-cleared magnetic stimulation for treatment-resistant depression and OCD, drug-free, with no downtime.",
      more: `Transcranial magnetic stimulation uses focused magnetic pulses to activate areas of the brain involved in mood. Sessions happen in our NeuroStar® chair while you’re awake, and you can drive yourself home and return to your day. Learn more about <a class="inl" href="/treatment-methods/tms/">TMS therapy in Connecticut</a>.`,
      helps: ["Depression that hasn’t responded to medication", "OCD", "People who want a drug-free option"] },
    { t: "GeneSight® Testing", href: "/treatment-methods/genesight-testing/", img: B + "exploring-genesight-testing-personalizing-mental-health-treatment-at-hopewell-health-solutions.webp",
      d: "A cheek-swab pharmacogenomic test that helps reduce medication trial-and-error.",
      more: `A simple cheek swab shows how your genes may affect the way you process common psychiatric medications. Your prescriber uses the report, alongside your history, to choose and dose medication more confidently. Read about <a class="inl" href="/treatment-methods/genesight-testing/">GeneSight® testing</a>.`,
      helps: ["Medications that caused side effects", "Several medications tried without relief", "Families planning care for a child or teen"] },
  ] },
  { key: "therapy", name: "Therapy approaches", note: "Evidence-based therapy, individually and in groups", icon: "chat", tone: "t-sky", items: [
    { t: "EMDR", href: "/treatment-methods/emdr/", img: P + "tx-westbrook-office-2.webp",
      d: "Evidence-based trauma therapy that helps the mind heal what words can’t reach.",
      more: `Eye Movement Desensitization and Reprocessing helps the brain reprocess distressing memories so they lose their charge. It’s structured, it doesn’t require retelling every detail, and it’s part of our <a class="inl" href="/what-we-treat/trauma-ptsd/">trauma care</a> across programs. Learn about <a class="inl" href="/treatment-methods/emdr/">EMDR therapy</a>.`,
      helps: ["Trauma and PTSD", "Distressing or intrusive memories", "Anxiety rooted in past experiences"] },
    { t: "Dialectical Behavior Therapy (DBT)", href: "/treatment-methods/dbt/", img: P + "tx-group-room-2.webp",
      d: "Four core skills for intense emotions, distress and relationships.",
      more: `DBT teaches mindfulness, distress tolerance, emotion regulation and interpersonal effectiveness, practical skills you use the same day. It’s the backbone of our <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient programs</a>. See how <a class="inl" href="/treatment-methods/dbt/">DBT at Hopewell</a> works.`,
      helps: ["Emotions that feel too big to manage", "Self-harm urges or impulsive behavior", "Conflict in close relationships"] },
    { t: "Group Therapy", href: "/treatment-methods/group-therapy/", img: P + "group-room-feelings-wheel.webp",
      d: "Therapist-led process, skills and support groups in a confidential setting.",
      more: `Small, clinician-led groups where you practice new skills in real time, hear how others handle similar challenges, and learn you are not alone. Groups run at the heart of our IOP and PHP. Read about <a class="inl" href="/treatment-methods/group-therapy/">group therapy</a>.`,
      helps: ["Isolation and loneliness", "Practicing coping skills with peers", "Social anxiety"] },
    { t: "HHS Therapeutic Treatments", href: "/treatment-methods/therapeutic-treatments/", img: P + "tx-team-with-therapy-dog.webp",
      d: "ART, the Gottman Method, mindfulness, yoga therapy and other mind-body approaches.",
      more: `Accelerated resolution therapy (ART), the Gottman Method for couples, play therapy for children, mindfulness and yoga therapy round out care with whole-person approaches. Explore our <a class="inl" href="/treatment-methods/therapeutic-treatments/">therapeutic treatments</a>.`,
      helps: ["Couples and family stress", "Children who express feelings through play", "Stress, burnout and body-based symptoms"] },
  ] },
  { key: "addiction", name: "Addiction treatment", note: "At 300 Hebron Ave (Glastonbury) and Westbrook", icon: "link", tone: "t-gold", items: [
    { t: "Medication-Assisted Treatment (MAT)", href: "/treatment-methods/medication-assisted-treatment/", img: B + "psychiatric-medications-for-addiction-how-they-support-recovery.webp",
      d: "FDA-approved medications plus counseling for opioid and alcohol use disorders.",
      more: `MAT pairs medications that ease cravings and withdrawal with counseling, inside the <a class="inl" href="/programs/addiction-iop/">Addiction and Substance Use IOP</a>. It’s medically supervised and offered at our Downtown Glastonbury and Westbrook offices. Learn about <a class="inl" href="/treatment-methods/medication-assisted-treatment/">medication-assisted treatment</a>.`,
      helps: ["Opioid use disorder", "Alcohol use disorder", "Step-down care after detox or rehab"] },
  ] },
  { key: "testing", name: "Testing & evaluation", note: "Get the full picture", icon: "clipboard", tone: "t-sage", items: [
    { t: "Neuropsychological Testing", href: "/treatment-methods/neuropsychological-testing/", img: "/Assets/12.webp",
      d: "Comprehensive evaluation for clarity, diagnosis, and a real plan.",
      more: `Comprehensive evaluation of attention, memory, and learning, for clarity, diagnosis, and a real plan. A detailed look at language and emotional functioning too, with a written report and clear recommendations for home, school or work. See <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a>.`,
      helps: ["Learning or memory concerns", "Questions about autism or ADHD", "School accommodations and 504 plans"] },
    { t: "ADHD Testing", href: "/treatment-methods/adhd-testing/", img: B + "inpatient-vs-intensive-outpatient-programs-understanding-the-right-fit-for-your-child.webp",
      d: "Thorough, compassionate assessment for children, teens & adults.",
      more: `Thorough, compassionate assessment for children, teens, and adults. Interviews, rating scales and testing that separate <a class="inl" href="/what-we-treat/adhd/">ADHD</a> from anxiety, depression or learning differences, so treatment fits. Learn about <a class="inl" href="/treatment-methods/adhd-testing/">ADHD testing</a>.`,
      helps: ["Focus and attention concerns", "Adults who suspect lifelong ADHD", "Kids struggling at school"] },
  ] },
];
// Brief grouping (Treatments briefs, 2026-11-16): Therapies · Medical treatments · Testing. Card copy is the previous hub's.
const all = Object.fromEntries(groups.flatMap((g) => g.items).map((c) => [c.href, c]));
const medMgmt = { t: "Medication Management", short: "Medication management", href: "/programs/medication-management/", d: "Psychiatric evaluations and follow-up with our board-certified prescribers.", more: `Board-certified prescribers who build personalized plans, never one-size-fits-all, for ages 4 and up. See <a class="inl" href="/programs/medication-management/">psychiatry and medication management</a>.`, helps: ["Depression and anxiety", "ADHD", "Bipolar disorder"] };
const pick = (hrefs) => hrefs.map((h) => all[h]);
const briefGroups = [
  { key: "therapies", name: "Therapies", note: "Talk-based and skills-based approaches, in person, one-on-one or in groups", icon: "chat", tone: "navy", img: "/Assets/hhs-2026/group-room-feelings-wheel.webp", alt: "A Hopewell group therapy room", items: pick(["/treatment-methods/emdr/", "/treatment-methods/dbt/", "/treatment-methods/group-therapy/", "/treatment-methods/therapeutic-treatments/"]) },
  { key: "medical", name: "Medical treatments", note: "Treatments led by psychiatric and medical providers", icon: "brain", tone: "blue", img: "/Assets/hhs-2026/tms-neurostar-room.webp", alt: "The NeuroStar TMS room at Hopewell", items: [...pick(["/treatment-methods/tms/", "/treatment-methods/medication-assisted-treatment/"]), medMgmt] },
  { key: "testing", name: "Testing", note: "Clear answers that guide the treatment plan", icon: "clipboard", tone: "sage", img: "/Assets/hhs-2026/tx-east-hampton-play-room.webp", alt: "A testing and play room at our East Hampton office", items: pick(["/treatment-methods/adhd-testing/", "/treatment-methods/neuropsychological-testing/", "/treatment-methods/genesight-testing/"]) },
];
const steps = [
  ["phone", "Reach out", "Call or request a confidential callback. We check your insurance for free."],
  ["clipboard", "Assessment", "A clinician learns your symptoms, history and goals, and what you’ve already tried."],
  ["compass", "Your plan", "We recommend a mix of therapy, medication and, when it helps, an advanced treatment or testing."],
  ["refresh", "Adjust as you heal", "Your team reviews progress and steps care up or down, without switching providers."],
];
const compare = [
  ["brain", "TMS", "Depression or OCD that hasn’t responded to medication and therapy", "/treatment-methods/tms/"],
  ["refresh", "EMDR", "Trauma, PTSD and distressing memories", "/treatment-methods/emdr/"],
  ["compass", "DBT", "Emotions that feel too big to manage", "/treatment-methods/dbt/"],
  ["users", "Group therapy", "Feeling isolated; practicing skills with peers", "/treatment-methods/group-therapy/"],
  ["pill", "MAT", "Opioid or alcohol addiction, with counseling", "/treatment-methods/medication-assisted-treatment/"],
  ["dna", "GeneSight®", "Medication trial-and-error or side effects", "/treatment-methods/genesight-testing/"],
  ["clipboard", "Neuropsychological testing", "Questions about learning, memory, autism or mood", "/treatment-methods/neuropsychological-testing/"],
  ["bolt", "ADHD testing", "Focus and attention concerns at any age", "/treatment-methods/adhd-testing/"],
];
const faqs = [
  ["What treatments do you offer?", `<a class="inl" href="/treatment-methods/tms/">TMS</a>, <a class="inl" href="/treatment-methods/emdr/">EMDR</a>, <a class="inl" href="/treatment-methods/dbt/">DBT</a>, <a class="inl" href="/treatment-methods/group-therapy/">group therapy</a>, <a class="inl" href="/treatment-methods/medication-assisted-treatment/">medication-assisted treatment</a>, <a class="inl" href="/programs/medication-management/">medication management</a>, other <a class="inl" href="/treatment-methods/therapeutic-treatments/">therapeutic treatments</a>, and <a class="inl" href="/treatment-methods/adhd-testing/">ADHD</a>, <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological</a> and <a class="inl" href="/treatment-methods/genesight-testing/">GeneSight®</a> testing.`],
  ["How do I know which treatment is right for me?", `You don’t need to choose. Your assessment looks at what’s going on and builds a plan, which often combines therapy, medication and sometimes testing. Most people start with <a class="inl" href="/admissions/what-to-expect/">an assessment</a>. Our team looks at your symptoms, history and goals, then recommends a plan, often a mix of therapy, <a class="inl" href="/programs/medication-management/">medication management</a> and, when helpful, an advanced option like <a class="inl" href="/treatment-methods/tms/">TMS</a>. Call <a class="inl" href="tel:8607351448">(860) 735-1448</a> to start.`],
  ["Do you offer telehealth?", "Many therapies are available in person and by telehealth. TMS, testing sessions and our intensive programs happen in person at our <a class='inl' href='/locations/'>Connecticut offices</a>."],
  ["Are treatments covered by insurance?", `Most are covered by commercial plans, though some, like TMS and testing, may need prior authorization. We check your benefits first. We don’t accept Medicare or Medicaid. We accept all major insurance providers and check your benefits at no cost before you commit. See <a class="inl" href="/rates-and-insurance-coverage/">rates &amp; insurance</a>.`],
  ["How long does TMS take?", `A typical course of <a class="inl" href="/treatment-methods/tms/">TMS</a> runs several weeks of short, daily weekday sessions. Your clinician will walk you through your schedule at the consultation.`],
  ["Do I have to talk about my trauma in detail for EMDR?", `No. <a class="inl" href="/treatment-methods/emdr/">EMDR</a> is structured so you don’t have to retell every detail. Your therapist helps you build calming skills first and moves at a pace you can manage.`],
  ["Can my child be tested for ADHD or learning differences?", `Yes. We offer <a class="inl" href="/treatment-methods/adhd-testing/">ADHD testing</a> and <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a> for children, teens and adults, with recommendations you can share with schools.`],
  ["Can I combine treatments?", `Yes. Many people do therapy alongside medication, or TMS alongside counseling. Often, yes. Many plans combine therapy such as <a class="inl" href="/treatment-methods/dbt/">DBT</a> or <a class="inl" href="/treatment-methods/group-therapy/">group therapy</a> with <a class="inl" href="/programs/medication-management/">medication management</a>, and sometimes TMS or GeneSight® testing. One team coordinates everything.`],
  ["Where is addiction treatment offered?", `Addiction treatment, including <a class="inl" href="/treatment-methods/medication-assisted-treatment/">medication-assisted treatment</a> and our <a class="inl" href="/programs/addiction-iop/">addiction IOP</a>, is offered at our <a class="inl" href="/location/glastonbury-ct-2/">Downtown Glastonbury</a> (300 Hebron Ave) and <a class="inl" href="/location/westbrook-ct/">Westbrook</a> offices.`],
];
const faqTail = [["What if I’m in crisis?", `Call or text <a class="inl" href="tel:988">988</a>, call 911, or go to the nearest emergency room.`]];
faqs.push(...faqTail);
const list = { "@context": "https://schema.org", "@type": "ItemList", name: "Treatments & Therapies at Hopewell Health Solutions", itemListElement: briefGroups.flatMap((g) => g.items).map((t, i) => ({ "@type": "ListItem", position: i + 1, name: t.t, url: "https://www.hopewellhealthsolutions.com" + t.href })) };
---

<Base title="Types of Therapy & Treatment in CT: TMS, EMDR, DBT" description="TMS, EMDR, DBT, group therapy, medication-assisted treatment and ADHD, neuropsychological and GeneSight® testing at Hopewell’s Connecticut offices." canonical={canonical} image="/Assets/Blogs/mood-swings-vs-a-mood-disorder-and-what-iop-does-about-it.webp">
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(list)} />
  <main id="main" tabindex="-1" class="hw">
    <!-- Hero (Corner Canyon hub pattern, same as What We Treat): navy, H1 + facts, jump links -->
    <section class="wq-hero has-photo">
      <img class="sv-bg" src="/Assets/Blogs/mood-swings-vs-a-mood-disorder-and-what-iop-does-about-it.webp" alt="" width="1024" height="529" fetchpriority="high" />
      <div class="sv-scrim" aria-hidden="true"></div>
      <div class="container wq-hero-grid">
        <div>
          <nav class="wq-crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>Treatments</span></nav>
          <h1>Types of Therapy, Treatment &amp; Testing in Connecticut</h1>
          <p class="lede">Beyond talk therapy, Hopewell Health Solutions offers advanced, research-backed treatments most outpatient practices can’t, from FDA-cleared TMS to EMDR and comprehensive testing, all coordinated by one team, in person across Connecticut and by telehealth.</p>
          <ul class="wq-facts">
            <li><Icon name="sparkles" class="h-[18px] w-[18px]" />Advanced &amp; evidence-based</li>
            <li><Icon name="users" class="h-[18px] w-[18px]" />Ages 4 and up</li>
            <li><Icon name="pin" class="h-[18px] w-[18px]" />In person across Connecticut</li>
          </ul>
          <div class="wq-ctas"><a href="tel:8607351448" class="btn btn-blue only-d"><Icon name="phone" />Call (860) 735-1448</a><a href="#verify" class="btn wq-ghost only-d">Check my coverage</a><a href="#verify-m" class="btn wq-ghost only-m">Check my coverage</a></div>
          <HeroCreds />
        </div>
        <nav class="wq-jump" aria-label="Treatment groups">
          {briefGroups.map((g) => (
            <a class={`wq-chip t-${g.tone}`} href={`#${g.key}`}>
              <span class="wq-chip-icon"><Icon name={g.icon} /></span>
              <span><strong>{g.name}</strong><small>{g.items.map((i) => i.short ?? i.t).join(", ")}</small></span>
              <Icon name="arrow" class="h-[18px] w-[18px]" />
            </a>
          ))}
          <a class="wq-chip t-stone" href="#plan"><span class="wq-chip-icon"><Icon name="compass" /></span><span><strong>Not sure which treatment?</strong><small>Your assessment builds the plan</small></span><Icon name="arrow" class="h-[18px] w-[18px]" /></a>
        </nav>
      </div>
    </section>
    <Creds />

    <section class="section is-stone" id="treatments">
      <div class="container">
        <div class="sec-head"><h2>Treatments beyond talk therapy</h2><p class="lede">For when medication and therapy aren’t enough on their own, evidence-based options that help the brain and body heal. Grouped by what they do, from talk-therapy modalities to brain-based treatments. Each has its own page with how it works and who it helps.</p></div>
        <div class="wq-groups">
          {briefGroups.map((g) => (
            <section class={`wq-group t-${g.tone}`} id={g.key} aria-labelledby={`h-${g.key}`}>
              <div class="wq-group-head">
                <span class="wq-group-icon"><Icon name={g.icon} /></span>
                <div><h3 id={`h-${g.key}`}>{g.name}</h3><span>{g.note}</span></div>
              </div>
              <div class="wq-cards">
                {g.items.map((c) => (
                  <article class="wq-card">
                    <h4><a href={c.href}>{c.t}</a></h4>
                    <p>{c.d}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
        <p class="sec-foot">An accurate diagnosis is where good treatment begins. Our testing clarifies what’s going on, and what to do about it.</p>
      </div>
    </section>

    <section class="section is-white" id="plan">
      <div class="container">
        <div class="sec-head"><h2>Not sure which treatment?</h2><p class="lede">Therapy first, medication second, transformation third. Every plan starts with listening, and most combine more than one approach, coordinated by one team.</p></div>
        <ol class="step-grid">
          {steps.map(([icon, t, d], i) => <li class="step"><span class="step-dot"><Icon name={icon} /></span><span class="step-num">Step {i + 1}</span><h3>{t}</h3><p>{d}</p>{i < steps.length - 1 && <span class="step-arrow" aria-hidden="true"><Icon name="arrow" class="h-4 w-4" /></span>}</li>)}
        </ol>
      </div>
    </section>

    <section class="section is-stone" id="where">
      <div class="container hb-split">
        <div class="hb-photo"><img src={P + "tms-neurostar-room.webp"} alt="The NeuroStar TMS device and treatment room at Hopewell Health Solutions" width="1200" height="1600" loading="lazy" style="aspect-ratio:4/3.4;object-position:center 30%" /></div>
        <div>
          <h2>Treatment inside our programs, or on its own</h2>
          <p class="lede" style="margin-top:14px">Many of these treatments are woven into our programs. DBT, group therapy and EMDR are part of the <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program</a> and <a class="inl" href="/programs/partial-hospitalization-program/">partial hospitalization program</a>; others, like TMS and testing, can be scheduled on their own alongside weekly <a class="inl" href="/programs/counseling/">counseling</a>.</p>
          <ul class="hb-check">
            <li><span class="sv-tick"><Icon name="check" class="h-4 w-4" /></span>Clients aged 4 and up, depending on the treatment</li>
            <li><span class="sv-tick"><Icon name="check" class="h-4 w-4" /></span>In person across our Connecticut offices, with telehealth for many therapies</li>
            <li><span class="sv-tick"><Icon name="check" class="h-4 w-4" /></span>MAT and addiction care at 300 Hebron Ave (Glastonbury) and Westbrook</li>
            <li><span class="sv-tick"><Icon name="check" class="h-4 w-4" /></span>Your prescriber, therapist and testing clinician share one plan</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section is-navy">
      <div class="container">
        <div class="sec-head"><h2>Which types of mental health treatment fit what you’re facing?</h2><p class="lede">A quick guide. Your clinician will help you decide, many plans combine more than one.</p></div>
        <ul class="tx-phases">
          {compare.map(([icon, t, d, href]) => <li class="tx-phase"><b><Icon name={icon} class="h-5 w-5" /></b><span><strong><a href={href} style="color:#fff;text-decoration:underline;text-decoration-color:rgba(156,195,234,.6);text-underline-offset:3px">{t}</a></strong><span>{d}</span></span></li>)}
        </ul>
      </div>
    </section>

    <VideoCarousel videos={STORIES} heading="Stories of Hope, in Their Own Words" lede="Hopewell clients and families share what therapy, medication and testing were like." />
    <Team tone="white" heading="One Team Coordinates Every Treatment" lede="Prescribers, psychologists and therapists who work together on your plan. <a class='inl' href='/about-us/team/'>Meet the full team</a>." />
    <Insurance heading="Most major PPO plans accepted" lede="We’re in-network with most major PPO plans (we don’t accept Medicaid / HUSKY). Our team verifies your benefits at no cost, before you commit to anything. <a class='inl' href='/rates-and-insurance-coverage/'>See rates &amp; insurance</a>." tone="white" />
    <Locations />
    <Reviews tone="stone" heading="Clients describe feeling genuinely heard" />
    <Faq faqs={faqs} heading="Treatment questions" tone="white" />
    <ClosingCta heading="Wondering what’s right for you?" lede="From advanced treatments to comprehensive testing, our Connecticut team will help you find the right path, confidentially, with no pressure." />
  </main>
  <Footer />
</Base>
