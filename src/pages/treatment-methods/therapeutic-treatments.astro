---
// HHS Therapeutic Treatments — 2026 redesign. Every modality and its live copy kept; regrouped into talk therapies,
// trauma therapies, experiential & mind-body, and relationships.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import Team from "../../components/hw/Team.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import RelatedTreatments from "../../components/tx/RelatedTreatments.astro";
import { VIDEOS } from "../../data/videos.js";
import "../../styles/pages/treatments.css";

const canonical = "https://www.hopewellhealthsolutions.com/treatment-methods/therapeutic-treatments/";
const T = "/Assets/therapeutic-treatments/";
const P = "/Assets/hhs-2026/";
const heroUsps = [
  "An array of evidence-based &amp; holistic therapies",
  "For clients aged 4 and older",
  "Tailored to you — never one-size-fits-all",
  "In person &amp; via telehealth across Connecticut",
];
const apps = [["Buddhify", T + "budify.webp"], ["Calm", T + "calm.webp"], ["Insight Timer", T + "insight.webp"], ["Headspace", T + "headspace.webp"]];
const talk = [
  { icon: "brain", t: "Cognitive Behavioral Therapy", sub: "CBT", d: "A psycho-social intervention that aims to improve mental health by challenging and changing unhelpful cognitive distortions and behaviors, improving emotional regulation, and developing personal coping strategies that target solving current problems.", bar: "#265489" },
  { icon: "compass", t: "Solutions-Focused Therapy", sub: "We assist clients by", d: "A goal-directed, collaborative approach to psychotherapeutic change, conducted through direct observation of clients’ responses to a series of precisely constructed questions.", bar: "#5c7c6b" },
  { icon: "sparkles", t: "Video Self-Modeling", sub: "Observational learning", d: "A form of observational learning in which individuals watch themselves performing a behavior successfully on video, then imitate the targeted behavior. Example cases: behavior video self-monitoring and restrictive-eating video self-monitoring.", bar: "#b6863c" },
];
const mods = [
  ["Outdoor Nature-Assisted Therapy", "An intervention to treat, hasten recovery, and rehabilitate, with the core principle that therapy involves plants, natural materials, and/or the outdoor environment."],
  ["Play Therapy", "Primarily used to help children ages 3–12 explore their lives and express repressed thoughts and emotions through play, in a safe playroom — learning healthier self-expression, empathy, and positive problem-solving."],
  ["Yoga Therapy", "The specific application of yogic tools — postures, breath work, and meditation techniques — to address physical, mental, and emotional needs."],
  ["Exposure Therapy", "A behavior-therapy technique for anxiety disorders — gradually exposing you to the anxiety source (without danger) to help you overcome distress."],
  ["Biofeedback", "Gaining greater awareness of your body’s physiological functions using instruments, with the goal of learning to regulate them at will."],
  ["Systematic Desensitization", "A behavioral therapy based on classical conditioning that replaces a phobia’s fear response with a relaxation response, gradually, through counter-conditioning."],
];
const tips = VIDEOS.filter((v) => ["cb3SsebwGiA", "LInMQYyZSmY", "aff5Xfy9CfE"].includes(v.yt));
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: "HHS Therapeutic Treatments",
  url: canonical,
  reviewedBy: { "@type": "Person", name: "Kristine Schlichting, PhD", url: "https://www.hopewellhealthsolutions.com/provider/kristine-a-schlichting-ph-d/" },
  about: ["Dialectical Behavior Therapy", "Cognitive Behavioral Therapy", "Solutions-Focused Therapy", "Video Self-Modeling", "Pet-Assisted Therapy", "Accelerated Resolution Therapy", "Walk-Talk Therapy", "Outdoor Nature-Assisted Therapy", "Play Therapy", "Telehealth", "Meditation", "Mindfulness", "Yoga Therapy", "Exposure Therapy", "Biofeedback", "Systematic Desensitization", "Gottman Method", "Trauma-Informed Individual Therapy", "Trauma Focus Group Therapy"].map((name) => ({ "@type": "MedicalTherapy", name })),
  publisher: { "@type": "MedicalOrganization", name: "Hopewell Health Solutions" },
};
---

<Base title="HHS Therapeutic Treatments in CT | Hopewell Health Solutions" description="An array of therapeutic treatments at Hopewell Health Solutions, Glastonbury, Westbrook & West Hartford CT — DBT, CBT, EMDR/ART, pet & nature therapy, play therapy, telehealth, mindfulness & more, for ages 4+." canonical={canonical} image={P + "tx-team-with-therapy-dog.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Treatments", href: "/treatment-methods/" }, { label: "HHS Therapeutic Treatments" }]}
      title="HHS Therapeutic Treatments"
      lede="Nearly 20% of adults receive treatment for mental health conditions — and many children and teens do, too. We offer a wide array of evidence-based and holistic therapies for clients aged 4 and older, matched to what each person needs."
      bullets={heroUsps}
      facts={[{ icon: "pin", text: "HHS Therapeutic Treatments · Glastonbury, CT · Ages 4+" }]}
      image={P + "tx-team-with-therapy-dog.webp"}
    >
      <p style="margin-top:18px;font-size:15px;color:#c3d2e2">Medically reviewed by <a class="inl" href="/provider/kristine-a-schlichting-ph-d/">Kristine Schlichting, PhD</a></p>
    </ServiceHero>
    <Creds />

    <!-- Talk therapies -->
    <section class="section is-white">
      <div class="container">
        <div class="tx-split">
          <div class="tx-copy">
            <h2>Dialectical Behavior Therapy (DBT)</h2>
            <p class="lede" style="margin-top:16px">DBT is a type of psychotherapy — talk therapy — that uses a cognitive-behavioral approach and emphasizes the psychosocial aspects of treatment. <a class="inl" href="/treatment-methods/dbt/">Learn how DBT works at Hopewell</a>.</p>
            <p class="tx-card" style="margin-top:18px;flex-direction:row;align-items:center;--bar:#b6863c"><span class="icon-badge"><Icon name="sparkles" /></span><strong style="font-family:var(--hw-head);color:var(--hw-navy)">SPACE Training with <a class="inl" href="/provider/eric-schwartz-psy-d-abpp/">Dr. Schwartz</a></strong></p>
          </div>
          <figure class="tx-photo"><img src="/Assets/service/dbt.webp" alt="Dialectical Behavior Therapy at Hopewell Health Solutions" width="1200" height="900" loading="lazy" /><figcaption>Talk therapy<span>DBT, CBT &amp; solutions-focused</span></figcaption></figure>
        </div>
        <div class="tx-cards" style="margin-top:36px">
          {talk.map((c) => <div class="tx-card" style={`--bar:${c.bar}`}><span class="icon-badge"><Icon name={c.icon} /></span><h3>{c.t}</h3><p style="font-family:var(--hw-head);font-weight:700;font-size:13.5px;color:var(--hw-slate)">{c.sub}</p><p>{c.d}</p></div>)}
        </div>
      </div>
    </section>

    <!-- Trauma therapies -->
    <section class="section is-navy">
      <svg class="hero-arcs" style="left:auto;right:-360px;top:-420px;bottom:auto" viewBox="0 0 800 800" aria-hidden="true"><circle cx="400" cy="400" r="390" /><circle cx="400" cy="400" r="300" /></svg>
      <div class="container">
        <div class="sec-head"><h2>Trauma-informed therapies</h2><p class="lede">Approaches that recognize trauma’s role in a person’s outlook, emotions and behavior — individual and group. See our <a class="inl" href="/what-we-treat/trauma-ptsd/">trauma and PTSD treatment</a>.</p></div>
        <div class="tx-cards">
          <div class="tx-card is-navy" style="--bar:#b6863c;background-color:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14)">
            <span class="icon-badge"><Icon name="bolt" /></span>
            <h3>Accelerated Resolution Therapy (ART)</h3>
            <p style="font-family:var(--hw-head);font-weight:700;font-size:13.5px;color:var(--hw-sky)">A briefer version of <a class="inl" href="/treatment-methods/emdr/">EMDR</a></p>
            <p>ART was created to help people who have experienced trauma. The protocol brings up original traumatic experiences and actually changes the way that information is ultimately stored.</p>
            <p><a class="inl" href="/media/">Watch helpful videos</a></p>
          </div>
          <div class="tx-card is-navy" style="--bar:#2f76c4;background-color:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14)">
            <img src="/Assets/service/trauma-informed-individual.webp" alt="Trauma-informed individual therapy at Hopewell Health Solutions" loading="lazy" style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:14px" />
            <h3>Trauma-Informed Individual Therapy</h3>
            <p style="font-family:var(--hw-head);font-weight:700;font-size:13.5px;color:var(--hw-sky)">EMDR &amp; PC</p>
            <p>A trauma-informed approach seeks awareness of the widespread impact of trauma on life experience and relationships. It recognizes trauma’s role in the outlook, emotions, and behavior of a person with a trauma history.</p>
          </div>
          <div class="tx-card is-navy" style="--bar:#5c7c6b;background-color:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14)">
            <img src="/Assets/service/trauma-informed-group.webp" alt="Trauma-informed group therapy at Hopewell Health Solutions" loading="lazy" style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:14px" />
            <h3>Trauma-Informed Group Therapy</h3>
            <p style="font-family:var(--hw-head);font-weight:700;font-size:13.5px;color:var(--hw-sky)">TFTG</p>
            <p>Trauma Focus Group Therapy (TFTG) emphasizes two cognitive-behavioral methods — systematic prolonged exposure and cognitive restructuring — to process each member’s trauma. Each member has the opportunity to recount their story as others listen.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pet-assisted + walk-talk -->
    <section class="section is-stone">
      <div class="container">
        <div class="sec-head"><h2>Therapy beyond the office chair</h2><p class="lede">Pairing mental and physical health, and the calm that animals and the outdoors bring.</p></div>
        <div class="tx-feature">
          <img src={T + "dog.webp"} alt="Pet-Assisted Therapy at Hopewell Health Solutions" loading="lazy" />
          <div>
            <span style="font-family:var(--hw-head);font-weight:700;font-size:13.5px;color:var(--hw-gold)">Used in conjunction with traditional therapy</span>
            <h3 style="font-size:26px">Pet-Assisted Therapy</h3>
            <p>Animal-assisted therapy works alongside the traditional work of a licensed clinician. Dogs are the primary animals used, though programs offer different animals for different needs. Animals provide calm, comfort, and safety — diverting attention from stress toward pleasure.</p>
            <p>Building a bond with an animal can help people develop self-worth and trust, stabilize emotions, and improve communication, self-regulation, and socialization.</p>
          </div>
        </div>
        <div class="tx-feature is-flip" style="margin-top:18px">
          <img src={T + "walk.webp"} alt="Walk-Talk Therapy at Hopewell Health Solutions" loading="lazy" />
          <div>
            <span style="font-family:var(--hw-head);font-weight:700;font-size:13.5px;color:var(--hw-gold)">Pairing mental &amp; physical health</span>
            <h3 style="font-size:26px">Walk-Talk Therapy</h3>
            <p>Just like it sounds — the client and therapist are outside walking during therapy instead of sitting in an office. Many clients find it a more relaxed environment than the therapy office, with added mental and physical health benefits.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Mind-body & behavioral tiles -->
    <section class="section is-white">
      <div class="container">
        <div class="sec-head"><h2>Experiential, mind-body &amp; behavioral therapies</h2><p class="lede">From play therapy for young children to biofeedback and exposure work for anxiety — matched to what each person needs.</p></div>
        <div class="tx-mods" style="grid-template-columns:repeat(3,minmax(0,1fr))">
          {mods.map(([t, d]) => <div class="tx-mod"><h3>{t}</h3><p>{d}</p></div>)}
        </div>
        <div class="tx-split" style="margin-top:36px">
          <figure class="tx-photo"><img src={P + "tx-east-hampton-play-room.webp"} alt="A child-friendly therapy room at our East Hampton office" width="1400" height="1400" loading="lazy" /><figcaption>A child-friendly therapy room<span>East Hampton office</span></figcaption></figure>
          <div class="tx-copy">
            <h2>Care for children aged 4 and up</h2>
            <p class="lede" style="margin-top:14px">Play therapy helps children ages 3–12 express thoughts and emotions through play, in a safe playroom. For older children and teens, see our <a class="inl" href="/programs/teen-tween-iop/">Teen &amp; Tween IOP</a> and <a class="inl" href="/programs/counseling/">family counseling</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Telehealth, meditation, mindfulness -->
    <section class="section is-mist">
      <div class="container">
        <div class="sec-head"><h2>Calm, clarity &amp; care from home</h2></div>
        <div class="tx-cards" style="--cols:2">
          <div class="tx-card" style="padding:0;overflow:hidden"><img src={T + "telehealth.webp"} alt="Telehealth therapy at Hopewell Health Solutions" loading="lazy" style="width:100%;aspect-ratio:16/9;object-fit:cover" /><div style="padding:22px 24px 24px;display:grid;gap:8px"><span style="font-family:var(--hw-head);font-weight:700;font-size:13.5px;color:var(--hw-gold)">Online therapy</span><h3>Telehealth</h3><p>Also known as telemental health — a therapist or counselor provides counseling and support over the internet through video conferencing, online chat, email, or a phone call.</p></div></div>
          <div class="tx-card" style="padding:0;overflow:hidden"><img src={T + "meditaiton.webp"} alt="Meditation at Hopewell Health Solutions" loading="lazy" style="width:100%;aspect-ratio:16/9;object-fit:cover" /><div style="padding:22px 24px 24px;display:grid;gap:8px"><span style="font-family:var(--hw-head);font-weight:700;font-size:13.5px;color:var(--hw-gold)">Calm &amp; clarity</span><h3>Meditation</h3><p>A practice that uses a technique — such as mindfulness or focusing the mind on a particular object, thought, or activity — to train attention and awareness and achieve a mentally clear, emotionally calm, and stable state.</p></div></div>
        </div>
        <div class="tx-card" style="margin-top:18px;--bar:#5c7c6b">
          <span class="icon-badge"><Icon name="cloud" /></span>
          <h3>Mindfulness</h3>
          <p>The psychological process of purposely bringing your attention to experiences in the present moment without judgment — developed through the practice of meditation and other training.</p>
          <p style="font-family:var(--hw-head);font-weight:700;color:var(--hw-navy);margin-top:6px">Apps we recommend</p>
          <div class="tx-apps" style="margin-top:4px">{apps.map(([name, img]) => <span class="tx-app"><img src={img} alt="" loading="lazy" />{name}</span>)}</div>
        </div>
      </div>
    </section>

    <!-- Couples -->
    <section class="section is-white">
      <div class="container tx-split is-flip">
        <figure class="tx-photo"><img src={T + "couples%20gott.webp"} alt="Couples therapy — the Gottman Method — at Hopewell Health Solutions" width="1200" height="900" loading="lazy" /></figure>
        <div class="tx-copy">
          <p style="font-family:var(--hw-head);font-weight:700;font-size:14px;color:var(--hw-gold)">Couples therapy</p>
          <h2 style="margin-top:6px">The Gottman Method</h2>
          <p class="lede" style="margin-top:14px">An approach to couples therapy that includes a thorough assessment of the relationship and integrates research-based interventions grounded in the Sound Relationship House Theory. See <a class="inl" href="/programs/counseling/">couples &amp; family counseling</a>.</p>
        </div>
      </div>
    </section>

    <VideoCarousel videos={tips} mode="grid" tone="navy" heading="Try a Skill From Our Clinicians" lede="Short videos from the Hopewell team: grounding, supporting neurodivergent tweens, and why group therapy helps." link={{ href: "/podcast/", label: "More videos & the podcast" }} />
    <Team heading="Therapists Behind These Treatments" lede="Clinicians who list play, art, couples, mindfulness and yoga-based work among their focus areas. <a class='inl' href='/about-us/team/'>Meet the full team</a>." slugs={["eric-schwartz-psy-d-abpp", "traci-schneider-maatc-lpc-a-atr-p", "dori-bessette-crail-lmft", "meagan-carr-ph-d", "erica-schwartz-lcat", "madeline-blinderman-lpc-a", "kelvin-young-cpsrp"]} tone="stone" />
    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" showLink={false} />
    <Reviews tone="stone" />
    <Insurance tone="white" />
    <RelatedTreatments current="/treatment-methods/therapeutic-treatments/" />
    <ClosingCta heading="Find the right therapy for you" lede="Not sure where to start? Our team will help match you — or your child — to the approach that fits best. Reach out to Hopewell Health Solutions today, confidentially and with no pressure." image={P + "tx-team-with-therapy-dog.webp"} />
  </main>
  <Footer />
</Base>
