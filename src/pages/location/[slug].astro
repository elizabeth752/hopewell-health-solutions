---
// Location page — 2026 redesign (Corner Canyon layout, Hopewell brand). Keeps the title, meta description, canonical,
// H1, MedicalClinic + Event schema, map embed, hours, areas served, services and FAQ. Adds a real-photo gallery,
// programs offered at Downtown Glastonbury and Westbrook (KB: client asked for offerings by location), the clinicians
// who work at the office (team roster), FAQPage schema, and the form in the hero (desktop) / above insurance (phones).
import "../../styles/pages/about.css";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import OpenHouse from "../../components/OpenHouse.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import ProgramCards from "../../components/hw/ProgramCards.astro";
import Team from "../../components/hw/Team.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import { locations, OFFERS, OFFER_ORDER } from "../../data/locations.js";

export function getStaticPaths() {
  return locations.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props;
const fullAddress = `${l.street}, ${l.city}, CT ${l.zip}`;
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Hopewell Health Solutions " + fullAddress)}`;
const canonical = `https://www.hopewellhealthsolutions.com/location/${l.slug}/`;
const P = "/Assets/hhs-2026/";

const offers = OFFER_ORDER.filter((k) => l.offers?.includes(k));
const offerNames = offers.map((k) => OFFERS[k].t);
const listText = (a) => a.length > 1 ? a.slice(0, -1).join(", ") + " & " + a[a.length - 1] : a[0];
const heroUsps = [
  `At this office: ${listText(offerNames).replace(/&/g, "&amp;")}`,
  "Daytime &amp; evening appointments",
  "In person at this office or by secure telehealth",
  "Joint Commission accredited · most major PPOs",
];

// Gallery: the office's own photos (locations.js) plus real photos from the client's Drive (no AI images).
const extra = {
  "glastonbury-ct-2": [
    [P + "downtown-glastonbury-entrance.webp", "The walkway to our Downtown Glastonbury office at 300 Hebron Avenue", "Entrance"],
    [P + "php-group-room.webp", "The PHP group room at our Downtown Glastonbury office", "PHP group room"],
    [P + "iop-group-room-lights.webp", "An IOP group room with string lights and comfortable seating", "IOP group room"],
    [P + "group-room-bright.webp", "A bright group therapy room with armchairs", "Group room"],
    [P + "tms-chair.webp", "The TMS therapy chair at our Downtown Glastonbury office", "TMS room"],
  ],
  "glastonbury-ct-3": [
    [P + "south-glastonbury-office.webp", "The South Glastonbury office building at 1420 Main Street", "Building"],
    [P + "south-glastonbury-waiting-room.webp", "The medication management waiting room in South Glastonbury", "Waiting room"],
    [P + "tween-group-room.webp", "The tween group room in South Glastonbury", "Tween group room"],
  ],
  "west-hartford-ct": [[P + "west-hartford-office.webp", "The West Hartford office on Farmington Avenue", "Building"]],
  "east-hampton-ct": [[P + "east-hampton-waiting-room.webp", "The main waiting room at our East Hampton office", "Waiting room"]],
  "westbrook-ct": [
    [P + "westbrook-sign.webp", "The Hopewell Health Solutions sign at 70 Essex Road, Westbrook", "Sign"],
    [P + "westbrook-therapy-office.webp", "A therapy office at our Westbrook location", "Therapy office"],
  ],
};
const LABELS = [["aerial", "Aerial view"], ["sign-entrance", "Entrance sign"], ["sign", "Sign"], ["exterior", "Building"], ["building", "Building"], ["campus", "Campus"], ["front", "Front"], ["entry", "Entry porch"], ["entrance", "Entrance"], ["street", "Street view"], ["lobby", "Lobby"], ["waiting", "Waiting room"], ["sitting", "Sitting room"], ["therapy", "Therapy room"], ["couch", "Therapy space"], ["office", "Office"]];
const label = (file) => (LABELS.find(([k]) => file.includes(k)) || [, "Office"])[1];
const gallery = [
  ...(l.photos || []).map(([f, alt]) => [`${l.photoDir}/${f}`, alt, label(f)]),
  ...(extra[l.slug] || []),
];
const heroImg = l.photos?.length ? `${l.photoDir}/${l.photos.find(([f]) => f.includes("exterior"))?.[0] ?? l.photos[0][0]}` : P + "iop-clinicians-group-room.webp";

// Programs & services at this office: exactly the client-confirmed list (locations.js `offers`, 2026-11-16).
const card = {
  php: { d: "Full-day treatment for when weekly therapy simply isn’t enough.", img: P + "php-group-room.webp", bar: "#265489", facts: [["clock", "About 6 hours a day"], ["calendar", "Monday through Friday"]] },
  iop: { d: "Structured therapy 3–4 days a week, while you live at home, work, and parent.", img: P + "adult-evening-iop-group.webp", bar: "#2f76c4", facts: [["calendar", "Mon–Thu"], ["users", "Adults 18+"]] },
  womens: { d: "Trauma-informed, DBT-based care in a women-only group where it’s safe to be seen.", img: P + (l.slug === "westbrook-ct" ? "womens-wellness-team-2.webp" : "womens-wellness-team.webp"), bar: "#b6863c", facts: [["heart", "Women-only groups"], ["clock", l.slug === "glastonbury-ct-2" ? "Morning and evening groups" : "Adult women"]] },
  "teen-tween": { d: "After-school support for ages 8–18, with the family woven into the work.", img: P + "tween-group-room.webp", bar: "#5c7c6b", facts: [["calendar", "After school"], ["users", "Tweens 8–12 · teens 13–17"]] },
  therapy: { d: "One-on-one sessions with a licensed therapist, in person at this office or by telehealth.", img: gallery.find(([src]) => /therapy|office|couch|sitting/.test(src))?.[0] ?? P + "westbrook-therapy-office.webp", bar: "#2f76c4", facts: [["users", "Individual sessions"], ["compass", "In person or telehealth"]] },
  meds: { d: "Thoughtful psychiatric prescribing for ages 4 and up — never one-size-fits-all.", img: P + "providers-together.webp", bar: "#5c7c6b", facts: [["pill", l.slug === "westbrook-ct" ? "Including MAT" : "Ages 4 and up"], ["compass", "In person or telehealth"]] },
  addiction: { d: "Addiction treatment with mental health care alongside it, in our addiction IOP.", img: P + "iop-group-session.webp", bar: "#0b2f55", facts: [["link", "Co-occurring care"], ["pin", l.name]] },
};
const intro = {
  "glastonbury-ct": "Our Pratt Street office offers 1:1 therapy and medication management in a warm, house-style setting.",
  "glastonbury-ct-2": "300 Hebron Avenue is Hopewell’s main hub for intensive programs: PHP, adult IOP and our Women’s Wellness IOP (morning and evening), plus therapy and medication management — and addiction treatment with mental health care alongside it.",
  "glastonbury-ct-3": "Our 1420 Main Street office is home to the Tween & Teen IOP, plus 1:1 therapy and medication management.",
  "west-hartford-ct": "Our West Hartford office offers 1:1 therapy and medication management.",
  "east-hampton-ct": "Our East Hampton office offers 1:1 therapy and medication management.",
  "westbrook-ct": "Our Westbrook office offers an adult IOP and our Women’s Wellness IOP, plus 1:1 therapy and medication management — and addiction treatment.",
};
const items = offers.map((k) => ({ t: OFFERS[k].t, href: OFFERS[k].href, ...card[k] }));

// Clinicians who work at this office (same roster as /about-us/team/).
const glast = ["jonathan-ficara-lcsw", "madeline-blinderman-lpc-a", "eunice-rivera-miranda-ph-d", "meagan-carr-ph-d", "dashelle-barco-lpc", "viviana-alvarado-lpc-a", "dori-bessette-crail-lmft"];
const prescribers = ["tracy-sibley-pmhnp-bc-aprn", "christina-lindsay-pmhnp-bc-aprn", "linda-scillia-pmhnp-bc-aprn", "katrin-moskowitz-dnp-pmhnp-bc-fnp", "ana-arroyo-aprn-pmhnp-bc", "chris-patenaude-pa", "katherine-salvador-pa-c"];
const roster = {
  "glastonbury-ct": glast,
  "glastonbury-ct-2": ["teesha-huertas-lcsw", ...prescribers.slice(0, 6)],
  "glastonbury-ct-3": glast,
  "westbrook-ct": ["kaitlyn-czapiga-lmsw", "jackie-plagesse-lmfta", "noah-mccarter-lpc-a", "jeff-rapp-lmsw", "kate-henneberry-lmfta"],
  "east-hampton-ct": ["erin-kruse-lmsw", "kate-henneberry-lmfta", "mariah-thomas-lmsw", "ashley-singh-psy-d"],
  "west-hartford-ct": ["kimberly-devine-lcsw", "eric-schwartz-psy-d-abpp", "christina-coelho-lmsw", "amenah-thomas-lpc-a"],
};


const faqs = [
  [`Where is the ${l.name} office?`, `We’re located at ${fullAddress}. You can reach us at <a class="inl" href="tel:8607351448">(860) 735-1448</a> or request an appointment online.`],
  ["Do you offer in-person and telehealth appointments?", "Yes — you can be seen in person at this office or by secure video telehealth across Connecticut, with daytime and evening availability."],
  ["What services are offered at this location?", `At our ${l.name} office we offer ${listText(offers.map((k) => `<a class="inl" href="${OFFERS[k].href}">${OFFERS[k].t}</a>`))}${l.addiction ? "" : ". Addiction treatment is offered at our <a class=\"inl\" href=\"/location/glastonbury-ct-2/\">Downtown Glastonbury</a> and <a class=\"inl\" href=\"/location/westbrook-ct/\">Westbrook</a> offices"}. Providers vary by office — call us and we’ll match you to the right care and location.`],
  ["Do you take my insurance?", `We’re in-network with most major PPO plans (we don’t accept Medicaid / HUSKY). We’ll verify your benefits for free before your first visit. See <a class="inl" href="/rates-and-insurance-coverage/">rates &amp; insurance</a>.`],
  ["How do I book my first appointment?", `Call <a class="inl" href="tel:8607351448">(860) 735-1448</a> or request an appointment online. Our team will help you choose the right provider, service, and location.`],
];
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: `Hopewell Health Solutions — ${l.name}`,
  url: canonical,
  ...(l.phone ? { telephone: l.phone } : {}),
  email: "hhs4help@gmail.com",
  image: gallery.slice(0, 3).map(([src]) => "https://www.hopewellhealthsolutions.com" + src),
  address: { "@type": "PostalAddress", streetAddress: l.street, addressLocality: l.city, addressRegion: "CT", postalCode: l.zip, addressCountry: "US" },
  geo: { "@type": "GeoCoordinates", latitude: l.lat, longitude: l.lng },
  parentOrganization: { "@type": "MedicalOrganization", name: "Hopewell Health Solutions" },
  areaServed: l.areas.map((a) => ({ "@type": "City", name: a })),
  medicalSpecialty: ["Psychiatric", "Behavioral"],
  // Matches the Google Business Profiles: Mon to Thu 9 to 8, Fri 9 to 5, closed weekends.
  ...(l.hours && {
    openingHoursSpecification: [
      { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"], opens: "09:00", closes: "20:00" },
      { "@type": "OpeningHoursSpecification", dayOfWeek: "Friday", opens: "09:00", closes: "17:00" },
    ],
  }),
};

// Optional one-off event (see `event` in locations.js). Hidden after event day at build time;
// the script at the bottom re-checks in the browser so a stale static build can't outlive it.
const ev = l.event && new Date() <= new Date(l.event.end) ? l.event : null;
const eventSchema = ev && {
  "@context": "https://schema.org",
  "@type": "Event",
  name: `${ev.eyebrow} — Hopewell Health Solutions ${l.name}`,
  description: ev.intro,
  startDate: ev.start,
  endDate: ev.end,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  isAccessibleForFree: true,
  location: {
    "@type": "Place",
    name: `Hopewell Health Solutions — ${l.name}`,
    address: { "@type": "PostalAddress", streetAddress: `${l.street}, Building B`, addressLocality: l.city, addressRegion: "CT", postalCode: l.zip, addressCountry: "US" },
  },
  organizer: { "@type": "Organization", name: "Hopewell Health Solutions", url: "https://www.hopewellhealthsolutions.com/" },
  url: `${canonical}#${ev.id}`,
};
---

<Base title={`${l.name} | Mental Health & Psychiatry in ${l.city}, CT | Hopewell Health Solutions`} description={`Hopewell Health Solutions ${l.name} — ${listText(offerNames.map((n) => n.replace(/ \(PHP\)/, "")))} at ${l.street}, ${l.city}, CT. In person & telehealth, most PPOs accepted.`} canonical={canonical} image={gallery[0]?.[0]}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Locations", href: "/locations/" }, { label: l.name }]}
      title={`Mental Health &amp; Psychiatry — ${l.name}`}
      lede={`Compassionate, evidence-based care — close to home, at ${fullAddress}.`}
      bullets={heroUsps}
      facts={[{ icon: "clock", text: l.hours ?? "Daytime & evening appointments" }, { icon: "star", text: "4.8 · 368 Google reviews" }]}
      image={heroImg}
      imagePos="center 45%"
    >
      <p class="hero-where"><Icon name="pin" class="h-[18px] w-[18px]" /><a class="inl" href={directions} target="_blank" rel="noopener">Get directions to {l.name}</a></p>
    </ServiceHero>

    <Creds />

    {ev && <OpenHouse ev={ev} l={l} directions={directions} />}

    <!-- Visit us: map + office details -->
    <section class="section is-white" id="visit">
      <div class="container ab-visit">
        <div class="ab-map"><iframe src={l.map} title={`Map — Hopewell Health Solutions, ${l.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
        <div class="ab-details">
          <h2>The {l.name} office</h2>
          <p>{l.blurb}</p>
          <ul class="ab-facts">
            <li><span class="ab-ico"><Icon name="pin" class="h-5 w-5" /></span><span><strong>Address</strong>{fullAddress}</span></li>
            <li><span class="ab-ico"><Icon name="phone" class="h-5 w-5" /></span><span><strong>Phone</strong><a href="tel:8607351448">(860) 735-1448</a></span></li>
            <li><span class="ab-ico"><Icon name="calendar" class="h-5 w-5" /></span><span><strong>Hours</strong>{l.hours ?? "By appointment — daytime & evening availability"}</span></li>
          </ul>
          <a href={directions} target="_blank" rel="noopener" class="btn btn-blue"><Icon name="pin" />Get directions</a>
        </div>
      </div>
    </section>

    <!-- Gallery: one photo at a time, thumbnails to pick from -->
    {gallery.length > 0 && (
      <section class="section is-stone" id="photos">
        <div class="container gal" data-gallery>
          <div>
            <h2>Inside our {l.name} office</h2>
            <p class="lede" style="margin-top:14px">Real photos of the rooms where therapy, groups and psychiatric care happen at {l.street}. Prefer to meet from home? <a class="inl" href="/programs/counseling/">Telehealth counseling</a> is available statewide.</p>
            <div class="gal-thumbs">
              {gallery.slice(0, 9).map(([src, , lab], i) => (
                <button type="button" class:list={["gal-thumb", i === 0 && "is-active"]} aria-label={`Show photo: ${lab}`} aria-pressed={i === 0 ? "true" : "false"}><img src={src} alt="" width="240" height="160" loading="lazy" /><span>{lab}</span></button>
              ))}
            </div>
          </div>
          <div class="gal-stage">
            {gallery.slice(0, 9).map(([src, alt], i) => <img class:list={["gal-slide", i === 0 && "is-active"]} src={src} alt={alt} width="1200" height="900" loading="lazy" />)}
          </div>
        </div>
      </section>
    )}

    {l.slug === "westbrook-ct" && (
      <section class="section is-white" id="westbrook">
        <div class="container ab-story">
          <figure class="ab-story-media" style="margin:0"><img src="/Assets/locations/westbrook/therapy-room-shore.webp" alt="A sunny therapy room at our Westbrook office" width="1200" height="900" loading="lazy" /></figure>
          <div class="ab-copy">
            <h2>Mental health &amp; addiction care on the Connecticut shoreline</h2>
            <div style="margin-top:18px">
              <p>Hopewell Westbrook opened on September 28, 2026, bringing the same team-based care our Glastonbury offices are known for to the shoreline. We started with our <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a>, <a class="inl" href="/programs/medication-management/">psychiatric medication management</a> and <a class="inl" href="/programs/counseling/">1:1 therapy</a>, and added a co-ed <a class="inl" href="/programs/adult-mental-health-iop/">adult IOP</a> in October.</p>
              <p>Westbrook is one of two Hopewell offices that offer <a class="inl" href="/programs/addiction-iop/">addiction treatment</a>, with mental health care alongside it, so people on the shoreline no longer have to drive to Hartford County for an intensive program. Medication management here includes medication-assisted treatment (MAT).</p>
              <p>The office sits on Essex Road, minutes from I-95, and serves Westbrook, Old Saybrook, Clinton, Essex, Madison, Deep River, Old Lyme and Killingworth, with clients also coming from Guilford, Branford and Niantic. The local clinical team is led by <a class="inl" href="/provider/kaitlyn-czapiga-lmsw/">Kaitlyn Czapiga, LMSW</a>, Clinical Team Lead for Westbrook.</p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Programs & services at this office (client-confirmed list) -->
    <section class="section is-mist" id="services">
      <div class="container">
        <div class="sec-head"><h2>Services &amp; programs we offer</h2><p class="lede">{intro[l.slug]} Compare <a class="inl" href="/locations/#compare">which office offers what</a>.</p></div>
        <ProgramCards items={items} cols={items.length > 3 ? 4 : 3} />
        {/* Cross-links carried over from the live page's Conditions & Treatments grid (2026-11-16 SEO audit). Phrased
            Hopewell-wide so no service is claimed for an office that doesn't offer it. */}
        <p class="sec-foot">Across our Connecticut offices, Hopewell also offers <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient programs</a>, <a class="inl" href="/treatment-methods/tms/">TMS therapy</a>, <a class="inl" href="/treatment-methods/therapeutic-treatments/">HHS therapeutic treatments</a>, <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a> and <a class="inl" href="/treatment-methods/adhd-testing/">ADHD testing</a>.{l.addiction && <Fragment> This office also provides <a class="inl" href="/what-we-treat/substance-use-disorder/">addiction treatment</a> for <a class="inl" href="/what-we-treat/alcohol/">alcohol</a>, <a class="inl" href="/what-we-treat/drug/">drug</a> and <a class="inl" href="/what-we-treat/prescription-drugs/">prescription drug addiction</a>.</Fragment>}</p>
      </div>
    </section>

    <!-- Areas served -->
    <section class="section is-stone" id="areas">
      <div class="container ab-areas">
        <div>
          <h2>Areas we serve from {l.city}</h2>
          <p class="lede" style="margin-top:14px">Clients travel to our {l.city} office from across the surrounding towns — and telehealth is available statewide.</p>
        </div>
        <ul class="ab-towns">{l.areas.map((a) => <li><Icon name="pin" class="h-4 w-4" />{a}</li>)}</ul>
      </div>
    </section>

    <!-- Care team -->
    <div class:list={[l.slug !== "glastonbury-ct" && "ab-team-solo"]}>
      <Team
        heading="Experienced, compassionate clinicians"
        lede="Our psychiatrists, nurse practitioners, psychologists, and licensed therapists work as one team across all of our Connecticut offices. We’ll match you to the provider who best fits your needs and goals."
        tone="white"
        slugs={roster[l.slug]}
        feature={l.slug === "glastonbury-ct" ? "kristine-a-schlichting-ph-d" : null}
      />
    </div>

    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" />
    <Reviews tone="stone" />
    <Insurance heading="Most major PPO plans accepted" lede="We’re in-network with most major PPO plans. Our team verifies your benefits at no cost — before you commit to anything." />
    <Locations heading="Our other locations" lede="Care across Connecticut: six offices from Hartford County to the shoreline, plus telehealth statewide." current={l.slug} />
    <Faq faqs={faqs} heading={`${l.city} office — common questions`} tone="white" />
    <ClosingCta heading={`Get started at ${l.name}`} lede={`Reach out to Hopewell Health Solutions today — confidentially, with no pressure — and we’ll help you book at our ${l.name} office or by telehealth.`} image={gallery[0]?.[0] ?? undefined} imageAlt={`Hopewell Health Solutions ${l.name}`} />
  </main>
  <Footer />
  {ev && (
    <script>
      const el = document.querySelector<HTMLElement>("[data-event-end]");
      if (el && new Date() > new Date(el.dataset.eventEnd!)) el.remove();
    </script>
  )}
  <script>
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((g) => {
      const thumbs = [...g.querySelectorAll<HTMLButtonElement>(".gal-thumb")];
      const imgs = [...g.querySelectorAll<HTMLElement>(".gal-slide")];
      let i = 0, hold = false;
      const pick = (n: number) => { thumbs[i].classList.remove("is-active"); thumbs[i].setAttribute("aria-pressed", "false"); imgs[i].classList.remove("is-active"); i = (n + imgs.length) % imgs.length; thumbs[i].classList.add("is-active"); thumbs[i].setAttribute("aria-pressed", "true"); imgs[i].classList.add("is-active"); };
      thumbs.forEach((t, n) => t.addEventListener("click", () => pick(n)));
      g.addEventListener("mouseenter", () => (hold = true)); g.addEventListener("mouseleave", () => (hold = false));
      g.addEventListener("focusin", () => (hold = true)); g.addEventListener("focusout", () => (hold = false));
      if (!reduce && imgs.length > 1) setInterval(() => { if (!hold && !document.hidden) pick(i + 1); }, 5000);
    });
  </script>
</Base>
