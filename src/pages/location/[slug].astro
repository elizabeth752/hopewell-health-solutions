---
import ConsentMap from "../../components/ConsentMap.astro";
import PhotoSlider from "../../components/hw/PhotoSlider.astro";
import { TRANSIT, OPERATORS } from "../../data/transit.js";
// Location page — 2026 redesign, rebuilt to "Hopewell Locations: Content Briefs" (Claude Docs, 2026-11-16).
// One template for the six offices. Brief titles, metas and H1s (addiction offices use "[Town] Mental Health & Addiction
// Care"); URLs unchanged (the brief's 301 ideas are not applied). Photo-led: the real building in the hero, an office
// intro with real photos, an even "Inside the office" grid. Programs are the client-confirmed `offers` (locations.js),
// plus the Women's Trauma and First Responder IOPs at 300 Hebron (their program pages place them there).
// Every earlier sentence of page copy is kept. [confirm] items from the briefs (parking, accessibility, office tracking
// numbers, per-GBP reviews, testimonials, drive times, ages) are left out until the client confirms them.
// Section order: hero → accreditations → office → (office-specific) → programs → team → photos → directions → towns →
// insurance → other offices → Google reviews → As featured in → FAQ → closing CTA.
import "../../styles/pages/about.css";
import "../../styles/pages/location.css";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import OpenHouse from "../../components/OpenHouse.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import { locations, OFFERS, OFFER_ORDER } from "../../data/locations.js";
import { clinicalRoster, rosterByLocation } from "../../data/clinicalRoster.js";
import { providers } from "../../data/providers.js";

export function getStaticPaths() {
  return locations.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props;
const fullAddress = `${l.street}, ${l.city}, CT ${l.zip}`;
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Hopewell Health Solutions " + fullAddress)}`;
const canonical = `https://www.hopewellhealthsolutions.com/location/${l.slug}/`;
const P = "/Assets/hhs-2026/";
const L = "/Assets/locations/";
const at = (slug) => locations.find((x) => x.slug === slug);
const link = (slug, text) => `<a class="inl" href="/location/${slug}/">${text}</a>`;

const offers = OFFER_ORDER.filter((k) => l.offers?.includes(k));
const offerNames = offers.map((k) => OFFERS[k].t);
const listText = (a) => a.length > 1 ? a.slice(0, -1).join(", ") + " & " + a[a.length - 1] : a[0];
const heroUsps = [
  "Joint Commission accredited",
  "In person or telehealth",
  "All major insurance accepted",
];

// ---- Per-office content from the briefs ----------------------------------------------------------------------------
// title/meta/h1 = brief; lead = the brief's hero line, placed before the page's existing lede.
const PAGE = {
  "glastonbury-ct": {
    title: "Glastonbury Mental Health Care at 33 Pratt St | Hopewell",
    meta: "Individual, family and group therapy plus medication management at Hopewell's Pratt St office in Glastonbury, CT. Real clinicians, in person. Check coverage.",
    h1: "Glastonbury Mental Health Care at Our Pratt St Office",
    lead: "Glastonbury mental health care in a house on Pratt Street: therapy, plus psychiatric medication management with a Hopewell prescriber.",
    hero: [L + "glastonbury/exterior.webp", "center 55%"],
