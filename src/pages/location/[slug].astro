    hero: [L + "downtown-glastonbury/exterior-2.webp", "center 60%"],
    pics: [[L + "downtown-glastonbury/building.webp", "The Medical Arts Center at 300 Hebron Ave, Glastonbury"], [L + "downtown-glastonbury/entrance.webp", "The bright entrance hall at 300 Hebron Ave"]],
    gallery: [
      [P + "php-group-room.webp", "The PHP group room at our Downtown Glastonbury office", "PHP group room"],
      [P + "iop-group-room-lights.webp", "An IOP group room with string lights and comfortable seating", "IOP group room"],
      [P + "group-room-bright.webp", "A bright group therapy room with armchairs", "Group room"],
      [P + "tms-chair.webp", "The TMS therapy chair at our Downtown Glastonbury office", "TMS room"],
      [L + "downtown-glastonbury/entrance.webp", "Welcoming entrance at the Downtown Glastonbury office", "Entrance"],
      [L + "downtown-glastonbury/sign.webp", "Glastonbury Medical Arts Center sign at 300 Hebron Avenue", "Medical Arts Center"],
    ],
    reviewsFirst: ["IOP", "Women’s Wellness IOP"],
  },
  "glastonbury-ct-3": {
    title: "Teen & Tween IOP at 1420 Main St, South Glastonbury, CT",
    meta: "Hopewell's South Glastonbury office runs after-school Teen (13–17) and Tween (8–12) IOPs, plus therapy and medication management for families. Check coverage.",
    h1: "Teen &amp; Tween IOP in South Glastonbury, CT",
    lead: "Home of Hopewell’s Teen and Tween IOPs, with therapy and medication management for the whole family.",
    hero: [L + "1420-main/1420-4.webp", "center 55%"],
    pics: [[P + "south-glastonbury-office.webp", "The South Glastonbury office building at 1420 Main Street"], [L + "1420-main/1420-1.webp", "Hopewell Health Solutions sign at 1420 Main Street"]],
    gallery: [
      [L + "1420-main/1420-2.webp", "Front desk and waiting area at the South Glastonbury office", "Front desk"],
      [L + "1420-main/1420-3.webp", "Welcome window and reception at the South Glastonbury office", "Reception"],
      [L + "1420-main/1420-4.webp", "Waiting room at the South Glastonbury office", "Waiting room"],
      [L + "1420-main/1420-5.webp", "Tween and teen IOP group room at the South Glastonbury office", "Group room"],
      [L + "1420-main/1420-6.webp", "Individual therapy office at the South Glastonbury office", "Therapy office"],
      [L + "1420-main/1420-8.webp", "Therapy room with a green wall at the South Glastonbury office", "Green room"],
      [L + "1420-main/1420-9.webp", "Family therapy room at the South Glastonbury office", "Family room"],
      [P + "south-glastonbury-waiting-room.webp", "The medication management waiting room in South Glastonbury", "Waiting area"],
    ],
    reviewsFirst: ["Therapy", "IOP"],
  },
  "west-hartford-ct": {
    title: "Therapy & Psychiatric Care in West Hartford, CT | Hopewell",
    meta: "Therapy and medication management at Hopewell's Farmington Ave office in West Hartford, CT, with intensive programs nearby in Glastonbury. Check coverage.",
    h1: "Therapy &amp; Psychiatric Care in West Hartford, CT",
    lead: "Therapy and medication management on Farmington Avenue, with intensive programs nearby in Glastonbury.",
    hero: [L + "west-hartford/exterior.webp", "center 50%"],
    pics: [[P + "west-hartford-office.webp", "The West Hartford office on Farmington Avenue"], [L + "west-hartford/entrance.webp", "Entrance to the West Hartford office"]],
    gallery: [
      [L + "west-hartford/therapy-office.webp", "Therapy office in West Hartford", "Therapy office"],
      [L + "west-hartford/office.webp", "Office space at the West Hartford location", "Office"],
      [L + "west-hartford/couch.webp", "Comfortable seating in the West Hartford office", "Seating"],
      [L + "west-hartford/entrance.webp", "Entrance to the West Hartford office", "Entrance"],
    ],
    reviewsFirst: ["Therapy", "Medication management"],
  },
  "east-hampton-ct": {
    title: "Therapist & Psychiatric Care in East Hampton, CT | Hopewell",
    meta: "Therapy and medication management at Hopewell's E. High St office in East Hampton, CT, serving the Middletown area. Teen IOP is nearby in South Glastonbury.",
    h1: "Therapists &amp; Psychiatric Care in East Hampton, CT",
    lead: "Therapy in East Hampton, CT, plus medication management on East High Street, serving East Hampton and the Middletown area.",
    hero: [L + "east-hampton/exterior.webp", "center 55%"],
    pics: [[L + "east-hampton/lobby.webp", "Lobby of the East Hampton office at 151 E. High St"], [L + "east-hampton/sign.webp", "Hopewell Health Solutions sign outside the East Hampton office"]],
    gallery: [
      [P + "east-hampton-waiting-room.webp", "The main waiting room at our East Hampton office", "Waiting room"],
      [P + "east-hampton-waiting-room-2.webp", "A second seating area in the East Hampton waiting room", "Seating area"],
      [P + "east-hampton-counseling-room.webp", "A counseling room at our East Hampton office", "Counseling room"],
      [P + "east-hampton-therapy-office.webp", "A therapy office at our East Hampton office", "Therapy office"],
      [P + "east-hampton-front-office.webp", "A front office at our East Hampton location", "Office"],
      [L + "east-hampton/entry-porch.webp", "The drive up to the East Hampton office on E. High St", "Arriving"],
    ],
    reviewsFirst: ["Therapy", "Medication management"],
  },
  "westbrook-ct": {
    title: "Therapist, IOP & Addiction Care in Westbrook, CT | Hopewell",
    meta: "Hopewell Westbrook offers women's, addiction and co-occurring IOPs, therapy and psychiatry for Old Saybrook, Clinton, Madison, Guilford and Niantic.",
    h1: "IOP &amp; Addiction Treatment in Westbrook, CT",
    lead: "IOP in Westbrook, CT, plus addiction treatment, therapists in Westbrook for weekly sessions, and psychiatry at Hopewell’s shoreline office on Essex Road.",
    hero: [L + "westbrook/sign.webp", "center 50%"],
    pics: [[L + "westbrook/aerial.webp", "Aerial view of the Hopewell Westbrook campus at 70 Essex Road"], [L + "westbrook/sign-entrance.webp", "Front entrance and sign at the Westbrook office"]],
    gallery: [
      [L + "westbrook/waiting-room.webp", "Waiting room and front desk at the Westbrook office", "Waiting room"],
      [L + "westbrook/therapy-room-shore.webp", "Therapy room with shoreline artwork in Westbrook", "Therapy room"],
      [L + "westbrook/therapy-room-garden.webp", "Bright therapy room with plants in Westbrook", "Garden room"],
      [L + "westbrook/therapy-room-sage.webp", "Therapy room with a green sofa in Westbrook", "Sage room"],
      [L + "westbrook/therapy-room.webp", "Therapy room with sofa and armchair in Westbrook", "Therapy room"],
      [L + "westbrook/office.webp", "Clinician office and seating area in Westbrook", "Office"],
      [L + "westbrook/sitting-room.webp", "Sitting room with a window view in Westbrook", "Sitting room"],
