    ],
    reviewsFirst: ["Women’s Wellness IOP", "IOP"],
  },
}[l.slug];

// ---- Programs & services at this office ----------------------------------------------------------------------------
// Card copy kept from the earlier page; brief names used for the IOPs.
const card = {
  php: { t: "Partial Hospitalization (PHP)", d: "Full-day treatment for when weekly therapy simply isn’t enough.", bar: "#265489", icon: "sun", facts: [["clock", "About 6 hours a day"], ["calendar", "Monday through Friday"]] },
  iop: { t: "Adult Mental Health IOP", d: "Structured therapy 3–4 days a week, while you live at home, work, and parent.", bar: "#2f76c4", icon: "users", facts: [["calendar", "Mon–Thu"], ["users", "Adults 18+"]] },
  womens: { t: "Women’s Wellness IOP", d: "Trauma-informed, DBT-based care in a women-only group where it’s safe to be seen.", bar: "#b6863c", icon: "heart", facts: [["heart", "Women-only groups"], ["clock", l.slug === "glastonbury-ct-2" ? "Morning and evening groups" : l.slug === "westbrook-ct" ? "Mornings, Mon–Thu" : "Adult women"]] },
  trauma: { t: "Women’s Trauma IOP", href: "/programs/womens-trauma-iop/", d: "A women-only, trauma-informed program for healing from past trauma, in the evening.", bar: "#8a5a2b", icon: "shield", facts: [["clock", "Mon–Thu, 5–8 PM"], ["heart", "Women-only groups"]] },
  responder: { t: "First Responder IOP", href: "/programs/first-responder-iop/", d: "A confidential IOP for police, firefighters, EMS and dispatchers, with peers who understand the job.", bar: "#0b2f55", icon: "shield", facts: [["clock", "Mon–Thu, 9 AM–12 PM"], ["users", "First responders"]] },
  teen: { t: "Teen IOP", href: "/programs/teen-iop/", d: "After-school DBT skills groups for teens, with parents involved every week.", bar: "#5c7c6b", icon: "sparkles", facts: [["users", "Teens 13–17"], ["clock", "Mon–Thu, 5–8 PM"]] },
  tween: { t: "Tween IOP", href: "/programs/tween-iop/", d: "After-school support for kids, with parent sessions built into the program.", bar: "#7a9a87", icon: "sun", facts: [["users", "Tweens 8–12"], ["clock", "Mon–Thu, 4:30–7:30 PM"]] },
  therapy: { t: "1:1 Therapy", d: "One-on-one sessions with a licensed therapist, in person at this office or by telehealth.", bar: "#2f76c4", icon: "chat", facts: [["users", "Individual sessions"], ["compass", "In person or telehealth"]] },
  meds: { t: "Medication Management", d: "Thoughtful psychiatric prescribing for ages 4 and up, never one-size-fits-all.", bar: "#5c7c6b", icon: "pill", facts: [["pill", l.slug === "westbrook-ct" ? "Including MAT" : "Ages 4 and up"], ["compass", "In person or telehealth"]] },
  addiction: { t: "Addiction IOP", d: "Addiction treatment with mental health care alongside it, in our addiction IOP.", bar: "#0b2f55", icon: "link", facts: [["link", "Co-occurring care"], ["pin", l.name]] },
  mat: { t: "Medication-Assisted Treatment (MAT)", href: "/treatment-methods/medication-assisted-treatment/", d: "Medication for recovery from alcohol or opioid use, prescribed alongside counseling when appropriate.", bar: "#265489", icon: "pill", facts: [["pill", "Through medication management"], ["pin", l.name]] },
};
const ORDER = {
  "glastonbury-ct-2": ["php", "iop", "addiction", "womens", "trauma", "responder", "therapy", "meds"],
  "glastonbury-ct-3": ["teen", "tween", "therapy", "meds"],
  "westbrook-ct": ["womens", "addiction", "iop", "therapy", "meds", "mat"],
};
const keys = ORDER[l.slug] ?? offers;
const items = keys.map((k) => ({ ...card[k], href: card[k].href ?? OFFERS[k].href }));
const anchor = (t) => t.replace(/\s*\(.*?\)/, "");
// Therapy-only offices: a third tile points to where the intensive programs meet (brief "Need more support?" box).
const moreBox = {
  "glastonbury-ct": { icon: "compass", h: "Need more support?", p: `IOP and PHP programs in Glastonbury meet at our ${link("glastonbury-ct-2", "Downtown Glastonbury office at 300 Hebron Ave")}, in the same town. See how an <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program</a> works.` },
  "west-hartford-ct": { icon: "compass", h: "Need more support?", p: `The nearest intensive programs, PHP and IOP, meet at our ${link("glastonbury-ct-2", "Downtown Glastonbury office at 300 Hebron Ave")}. See how an <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program</a> works.` },
  "east-hampton-ct": { icon: "sparkles", h: "Looking for teen IOP?", p: `Our <a class="inl" href="/programs/teen-iop/">Teen IOP</a> and <a class="inl" href="/programs/tween-iop/">Tween IOP</a> meet at our ${link("glastonbury-ct-3", "South Glastonbury office, 1420 Main St")}.` },
}[l.slug];
const nCards = items.length + (moreBox ? 1 : 0);
const cardCols = nCards % 4 === 0 ? 4 : 3;

const intro = {
  "glastonbury-ct": "Our Pratt Street office offers 1:1 therapy and medication management in a warm, house-style setting.",
  "glastonbury-ct-2": "300 Hebron Avenue is Hopewell’s main hub for intensive programs: PHP, adult IOP and our Women’s Wellness IOP (morning and evening), plus therapy and medication management, and addiction treatment with mental health care alongside it.",
  "glastonbury-ct-3": "Our 1420 Main Street office is home to the Tween & Teen IOP, plus 1:1 therapy and medication management. After-school support for ages 8–18, with the family woven into the work.",
  "west-hartford-ct": "Our West Hartford office offers 1:1 therapy and medication management.",
  "east-hampton-ct": "Our East Hampton office offers 1:1 therapy and medication management.",
  "westbrook-ct": "Our Westbrook office offers an adult IOP with an evening group (which includes addiction care) and our Women’s Wellness IOP morning group, plus 1:1 therapy and medication management, and addiction treatment.",
};

// ---- Clinicians (client PDF roster; no medical staff). Glastonbury's three offices share one roster group. ----------
const TEAM_PICK = {
  "glastonbury-ct": ["jonathan-ficara-lcsw", "dori-bessette-crail-lmft", "joanne-malinka-lcsw", "meagan-carr-ph-d", "jessenia-medina-lpc-ncc", "patricia-nogelo-ph-d-lcsw"],
  "glastonbury-ct-2": ["sherrie-gaudet-lcsw", "traci-schneider-maatc-lpc-a-atr-p", "sheryll-waring-lpc-ldac", "bido-aguessy-psy-d-lpc-a", "erica-schwartz-lcat", "kelvin-young-cpsrp"],
  "glastonbury-ct-3": ["eric-schwartz-psy-d-abpp", "chris-barclay-ph-d-bcba-ncsp", "laura-miller-ph-d", "nathan-truong-lmft-a", "eunice-rivera-miranda-ph-d", "dashelle-barco-lpc"],
};
const roster = clinicalRoster[rosterByLocation[l.slug]] ?? [];
const okP = (p) => p && p.photo && !p.photoPlaceholder && !p.removed && !p.hideFromTeam;
const team = (TEAM_PICK[l.slug] ?? roster).filter((s) => roster.includes(s)).map((s) => providers.find((p) => p.slug === s)).filter(okP).slice(0, 6);
const nameOf = (n) => n.split(",")[0].trim();
const credsOf = (n) => n.split(",").slice(1).map((c) => c.trim()).filter(Boolean).join(", ").replace(/-/g, "‑");
const shortRole = (r) => r.replace(/^Board-Certified /, "").replace(/ · .*/, "").replace(/ & Licensed Clinical Social Worker/, "");
const isGlast = rosterByLocation[l.slug] === "glastonbury";
const teamHeading = isGlast ? "Clinicians at our Glastonbury offices" : `Clinicians at our ${l.city} office`;
// One-team sentence restored from the live location pages (2026-11-18 content gap fix).
// Settled 2026-11-18: Hopewell's prescribers are psychiatric nurse practitioners (APRN) and physician assistants (providers.js); no MD/DO.
const oneTeam = "Our psychiatric nurse practitioners, physician assistants, psychologists, and licensed therapists work as one team across all of our Connecticut offices.";
const teamLede = isGlast
  ? `${oneTeam} The psychologists, counselors, social workers and therapists who see clients across our three Glastonbury offices. Our <a class="inl" href="/about-us/team/#medical-staff">medical staff</a> provide medication management, and we’ll match you to the clinician who best fits your needs and goals.`
  : `${oneTeam} The psychologists, counselors, social workers and therapists who see clients in ${l.city}. Our <a class="inl" href="/about-us/team/#medical-staff">medical staff</a> provide medication management, and we’ll match you to the clinician who best fits your needs and goals.`;

// ---- Nearest other offices (straight-line distance from locations.js coordinates) ----------------------------------
const dist = (a, b) => Math.hypot(a.lat - b.lat, (a.lng - b.lng) * Math.cos((a.lat * Math.PI) / 180));
const NEAR_PHOTO = {
  "glastonbury-ct": L + "glastonbury/exterior.webp",
  "glastonbury-ct-2": L + "downtown-glastonbury/exterior-2.webp",
  "glastonbury-ct-3": P + "south-glastonbury-office.webp",
  "west-hartford-ct": L + "west-hartford/exterior.webp",
  "east-hampton-ct": L + "east-hampton/exterior.webp",
  "westbrook-ct": L + "westbrook/exterior.webp",
};
const NEAR_NOTE = {
  "glastonbury-ct": "Therapy and medication management in a house on Pratt Street.",
  "glastonbury-ct-2": "PHP, adult, women’s, first responder and addiction IOPs, plus therapy and medication management.",
  "glastonbury-ct-3": "Teen and Tween IOPs, plus therapy and medication management.",
  "west-hartford-ct": "Therapy and medication management on Farmington Avenue.",
  "east-hampton-ct": "Therapy and medication management on East High Street.",
  "westbrook-ct": "Adult, women’s and addiction IOPs on the shoreline, plus therapy and medication management.",
};
const near = locations.filter((x) => x.slug !== l.slug).sort((a, b) => dist(l, a) - dist(l, b)).slice(0, 2);

// ---- FAQ: the page's earlier questions merged with the brief's (unconfirmed brief answers left out) ---------------
const a = (href, t) => `<a class="inl" href="${href}">${t}</a>`;
const servicesAnswer = `At our ${l.name} office we offer ${listText(offers.map((k) => a(OFFERS[k].href, OFFERS[k].t)))}${l.addiction ? "" : `. Addiction treatment is offered at our ${a("/location/glastonbury-ct-2/", "Downtown Glastonbury")} and ${a("/location/westbrook-ct/", "Westbrook")} offices`}. Providers vary by office, call us and we’ll match you to the right care and location.`;
const faqWhere = [`Where is the ${l.name} office?`, `We’re located at ${fullAddress}. You can reach us at <a class="inl" href="tel:8607351448">(860) 735-1448</a> or request an appointment online.`];
const faqTele = ["Do you offer in-person and telehealth appointments?", "Yes, you can be seen in person at this office or by secure video telehealth across Connecticut, with daytime and evening availability."];
const faqIns = ["Do you take my insurance?", `We accept all major insurance providers, and we’ll check your benefits for free before your first visit. We don’t accept Medicare or Medicaid (HUSKY). See <a class="inl" href="/rates-and-insurance-coverage/">rates &amp; insurance</a>.`];
const faqBook = ["How do I book my first appointment?", `Call <a class="inl" href="tel:8607351448">(860) 735-1448</a> or <a class="inl" href="/admissions/">request an appointment online</a>. Our team will help you choose the right provider, service, and location. We’ll check your insurance first.`];
const faqHours = ["What are the office hours?", `${l.hours.replace(" · ", "; ")}. Appointments are available during the day and into the evening.`];
const faqCrisis = ["What if I’m in crisis?", `Call or text <a class="inl" href="tel:988">988</a>, call 911, or go to the nearest emergency room.`];
const svcLinks = `${a("/programs/counseling/", "Counseling and therapy")}, and ${a("/programs/medication-management/", "medication management")} with a psychiatric provider.`;
const FAQS = {
  "glastonbury-ct": [
    ["What services are offered at the Pratt St office?", `${svcLinks} ${servicesAnswer}`],
    ["Are IOP or PHP programs held here?", `No. Intensive programs in Glastonbury meet at our ${a("/location/glastonbury-ct-2/", "Downtown office, 300 Hebron Ave")}.`],
    faqWhere, faqHours, faqTele, faqIns, faqBook, faqCrisis,
  ],
  "glastonbury-ct-2": [
    ["What programs are at the Hebron Ave office?", `${a("/programs/partial-hospitalization-program/", "PHP")}, the ${a("/programs/adult-mental-health-iop/", "Adult Mental Health IOP")}, ${a("/programs/addiction-iop/", "Addiction IOP")}, ${a("/programs/womens-wellness-iop/", "Women’s Wellness IOP")}, ${a("/programs/womens-trauma-iop/", "Women’s Trauma IOP")} and ${a("/programs/first-responder-iop/", "First Responder IOP")}, plus counseling and medication management. ${servicesAnswer}`],
    ["Is this where the PHP meets?", `Yes. Our ${a("/programs/partial-hospitalization-program/", "partial hospitalization program (PHP)")} meets here, Monday through Friday, about six hours a day.`],
    ["Do you treat addiction at this office?", `Yes, through the Addiction IOP and the Adult Mental Health IOP, which treats co-occurring mental health and substance use together, with ${a("/treatment-methods/medication-assisted-treatment/", "medication-assisted treatment")} available.`],
    ["Where is the teen program?", `At our ${a("/location/glastonbury-ct-3/", "South Glastonbury office, 1420 Main St")}.`],
    faqWhere, faqHours,
    ["How soon can I start?", "It depends on the program. Call or send the form, and admissions will check your insurance and give you a start date."],
    faqTele, faqIns, faqBook, faqCrisis,
  ],
  "glastonbury-ct-3": [
    ["What programs meet at the South Glastonbury office?", `The ${a("/programs/teen-iop/", "Teen IOP")} for ages 13–17 and the ${a("/programs/tween-iop/", "Tween IOP")} for ages 8–12, plus counseling and medication management. ${servicesAnswer}`],
    ["When do the teen and tween groups meet?", "After school, Monday through Thursday: teens from 5:00 to 8:00 PM and tweens from 4:30 to 7:30 PM, so kids don’t miss class."],
    ["How are parents involved?", `Through family sessions and regular updates from the care team. Parents attend once or twice a week to learn the same ${a("/treatment-methods/dbt/", "DBT skills")}, and we host a Parent Support Group on Tuesdays and Parent Night on Thursdays.`],
    ["Can my child see a therapist here without joining IOP?", "Yes, we offer counseling and medication management at this office."],
    faqWhere, faqHours, faqTele,
    ["Does insurance cover the teen and tween IOPs?", "Most commercial plans do. We check benefits for free; we don’t accept Medicaid (HUSKY)."],
    faqIns, faqBook,
    ["What if my teen is in crisis?", `Call or text <a class="inl" href="tel:988">988</a>, call 911, or go to the nearest emergency room.`],
  ],
  "west-hartford-ct": [
    ["What services are offered in West Hartford?", `${svcLinks} ${servicesAnswer}`],
    ["Do you have an IOP in West Hartford?", `Not at this office. Our intensive programs meet in Glastonbury and Westbrook; the nearest is our ${a("/location/glastonbury-ct-2/", "Downtown Glastonbury office")}.`],
    faqWhere, faqHours, faqTele, faqIns, faqBook, faqCrisis,
  ],
  "east-hampton-ct": [
    ["What services are offered in East Hampton?", `${svcLinks} ${servicesAnswer}`],
    ["Is the teen IOP in East Hampton?", `No. Our Teen and Tween IOPs meet at our ${a("/location/glastonbury-ct-3/", "South Glastonbury office")}.`],
    faqWhere, faqHours, faqTele, faqIns, faqBook, faqCrisis,
  ],
  "westbrook-ct": [
    ["What programs are offered at the Westbrook office?", `${a("/programs/womens-wellness-iop/", "Women’s Wellness IOP")}, ${a("/programs/addiction-iop/", "Addiction IOP")} and ${a("/programs/adult-mental-health-iop/", "Adult Mental Health IOP")}, plus counseling and medication management. ${servicesAnswer}`],
    ["When did the Westbrook office open?", "On September 28, 2026."],
    ["Do you treat addiction in Westbrook?", `Yes. Addiction care here is part of the adult co-ed IOP, which meets Monday through Thursday evenings, 5–8 PM, and treats mental health and substance use together (see the ${a("/programs/addiction-iop/", "Addiction IOP")} and ${a("/programs/adult-mental-health-iop/", "Adult Mental Health IOP")}). Medication management here includes ${a("/treatment-methods/medication-assisted-treatment/", "medication-assisted treatment (MAT)")}.`],
    ["Is there a women’s program on the shoreline?", "Yes. Our Women’s Wellness IOP meets here Monday through Thursday mornings, 9 AM–12 PM, and a second group is planned."],
    ["What towns does the Westbrook office serve?", "Shoreline towns including Old Saybrook, Clinton, Madison, Guilford, Branford and Niantic."],
    ["Is there teen care in Westbrook?", `Our ${a("/programs/teen-iop/", "Teen")} and ${a("/programs/tween-iop/", "Tween IOPs")} meet in ${a("/location/glastonbury-ct-3/", "South Glastonbury")}.`],
    faqWhere, faqHours, faqTele, faqIns, faqBook, faqCrisis,
  ],
};
const faqs = FAQS[l.slug];

// ---- Schema ----------------------------------------------------------------------------------------------------------
const gallery = PAGE.gallery;
// Each photo shows once per page (user 2026-11-17): the intro carousel takes the two intro photos,
// the "Inside the office" self-moving gallery takes the rest.
const officePhotos = PAGE.pics.map(([src, alt]) => ({ src, alt }));
const tr = TRANSIT[l.slug];
const introSrcs = new Set(PAGE.pics.map(([src]) => src));
const insidePhotos = gallery.filter(([src]) => !introSrcs.has(src)).map(([src, alt, cap]) => ({ src, alt, cap }));
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  "@id": `${canonical}#clinic`,
  name: `Hopewell Health Solutions, ${l.name}`,
  url: canonical,
  ...(l.phone ? { telephone: l.phone } : {}),
  email: "hhs4help@gmail.com",
  image: [PAGE.hero[0], ...gallery.slice(0, 2).map(([src]) => src)].map((src) => "https://www.hopewellhealthsolutions.com" + src),
  address: { "@type": "PostalAddress", streetAddress: l.street, addressLocality: l.city, addressRegion: "CT", postalCode: l.zip, addressCountry: "US" },
  geo: { "@type": "GeoCoordinates", latitude: l.lat, longitude: l.lng },
  parentOrganization: { "@type": "MedicalOrganization", name: "Hopewell Health Solutions" },
  areaServed: l.areas.map((x) => ({ "@type": "City", name: x })),
  medicalSpecialty: ["Psychiatric", "Behavioral"],
  // Matches the Google Business Profiles: Mon to Thu 9 to 8, Fri 9 to 5, closed weekends.
  ...(l.hours && {
    openingHoursSpecification: [
      { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"], opens: "09:00", closes: "20:00" },
      { "@type": "OpeningHoursSpecification", dayOfWeek: "Friday", opens: "09:00", closes: "17:00" },
    ],
  }),
};

// Optional one-off event (see `event` in locations.js). Hidden after event day at build time;
// the script at the bottom re-checks in the browser so a stale static build can't outlive it.
const ev = l.event && new Date() <= new Date(l.event.end) ? l.event : null;
const eventSchema = ev && {
  "@context": "https://schema.org",
  "@type": "Event",
  name: `${ev.eyebrow}, Hopewell Health Solutions ${l.name}`,
  description: ev.intro,
  startDate: ev.start,
  endDate: ev.end,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  isAccessibleForFree: true,
  location: {
    "@type": "Place",
    name: `Hopewell Health Solutions, ${l.name}`,
    address: { "@type": "PostalAddress", streetAddress: `${l.street}, Building B`, addressLocality: l.city, addressRegion: "CT", postalCode: l.zip, addressCountry: "US" },
  },
  organizer: { "@type": "Organization", name: "Hopewell Health Solutions", url: "https://www.hopewellhealthsolutions.com/" },
  url: `${canonical}#${ev.id}`,
};
---

<Base title={PAGE.title} description={PAGE.meta} canonical={canonical} image={PAGE.hero[0]}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}
  <main class="hw">
    <!-- 1. Hero: the real building, address, hours, coverage form -->
    <div class="lp-hero">
      <ServiceHero
        crumbs={[{ label: "Locations", href: "/locations/" }, { label: l.name }]}
        title={PAGE.h1}
        lede={PAGE.lead}
        bullets={heroUsps}
        facts={[{ icon: "clock", text: l.hours ?? "Daytime & evening appointments" }, { icon: "star", text: "4.8 · 368 Google reviews" }]}
        image={PAGE.hero[0]}
        imagePos={PAGE.hero[1]}
      >
        <p class="hero-where"><Icon name="pin" class="h-[18px] w-[18px]" /><a class="inl" href={directions} target="_blank" rel="noopener">Get directions to {l.name}</a></p>
      </ServiceHero>
    </div>

    <Creds />

    {ev && <OpenHouse ev={ev} l={l} directions={directions} />}

    <!-- 2. The office -->
    <section class="section is-white" id="office">
      <div class="container lp-intro">
        <div class="lp-pics">
          <PhotoSlider photos={officePhotos} label={`Photos of the ${l.name} office`} />
        </div>
        <div class="lp-copy">
          <h2>The {l.name} office</h2>
          <p class="lede" set:html={l.blurb} />
          <ul class="lp-facts">
            <li><strong><Icon name="pin" class="h-5 w-5" />Address</strong><span>{fullAddress}</span></li>
            <li><strong><Icon name="phone" class="h-5 w-5" />Phone</strong><span><a href="tel:8607351448">(860) 735-1448</a></span></li>
            <li><strong><Icon name="calendar" class="h-5 w-5" />Hours</strong><span>{l.hours ? l.hours.split(" · ").map((h, i) => <Fragment>{i > 0 && <br />}{h}</Fragment>) : "By appointment, daytime & evening availability"}</span></li>
            <li><strong><Icon name="check" class="h-5 w-5" />At this office</strong><span>{listText(offerNames)}</span></li>
          </ul>
          <a href={directions} target="_blank" rel="noopener" class="btn btn-blue"><Icon name="pin" />Get directions</a>
        </div>
      </div>
    </section>

    {l.slug === "westbrook-ct" && (
      <section class="section is-stone" id="westbrook">
        <div class="container ab-story">
          <figure class="ab-story-media" style="margin:0"><img src="/Assets/locations/westbrook/therapy-room-shore.webp" alt="A sunny therapy room at our Westbrook office" width="1200" height="900" loading="lazy" /></figure>
          <div class="ab-copy">
            <h2>Mental health &amp; addiction care on the Connecticut shoreline</h2>
            <div style="margin-top:18px">
              <p>Hopewell Westbrook opened on September 28, 2026, bringing the same team-based care our Glastonbury offices are known for to the shoreline. We started with our <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a>, <a class="inl" href="/programs/medication-management/">psychiatric medication management</a> and <a class="inl" href="/programs/counseling/">1:1 therapy</a>, and added a co-ed <a class="inl" href="/programs/adult-mental-health-iop/">Adult Mental Health IOP</a> in October.</p>
              <p>Westbrook is one of two Hopewell offices that offer <a class="inl" href="/programs/addiction-iop/">addiction treatment</a>, with mental health care alongside it, so people on the shoreline no longer have to drive to Hartford County for an intensive program. Medication management here includes <a class="inl" href="/treatment-methods/medication-assisted-treatment/">medication-assisted treatment (MAT)</a>.</p>
              <p>The office sits on Essex Road, minutes from I-95, and serves Westbrook, Old Saybrook, Clinton, Essex, Madison, Deep River, Old Lyme and Killingworth, with clients also coming from Guilford, Branford and Niantic. The local clinical team is led by <a class="inl" href="/provider/kaitlyn-czapiga-lmsw/">Kaitlyn Czapiga, LMSW</a>, Clinical Team Lead for Westbrook.</p>
            </div>
          </div>
        </div>
      </section>
    )}

    {l.slug === "westbrook-ct" && (
      <section class="section is-navy" id="shoreline">
        <div class="container lp-shore">
          <div>
            <h2>Hopewell’s shoreline office</h2>
            <p class="lede">Westbrook is where Hopewell meets the water. These photos were taken along the Westbrook shore near our office on Essex Road, where the shoreline is part of everyday life.</p>
            <div class="lp-shore-note">
              <h3>Open house, October 23, 2026</h3>
              <p>Neighbors and local providers toured the new office at 70 Essex Road, met the team and heard about the programs starting here. A second <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a> group is planned.</p>
            </div>
          </div>
          <div class="lp-shore-pics">
            <img src="/Assets/locations/westbrook/beach-walk.webp" alt="A walk on the beach near our Westbrook office" width="736" height="982" loading="lazy" />
            <img src="/Assets/locations/westbrook/beach-group.webp" alt="The shoreline near our Westbrook office" width="736" height="983" loading="lazy" />
            <img src="/Assets/locations/westbrook/beach-pier.webp" alt="A walk out on the pier along the Westbrook shore" width="736" height="983" loading="lazy" />
          </div>
        </div>
      </section>
    )}

    <!-- 3. Programs & services at this office (client-confirmed list) -->
    <section class="section is-mist" id="services">
      <div class="container">
        <div class="sec-head"><h2>Services &amp; programs we offer</h2><p class="lede">{intro[l.slug]} Compare <a class="inl" href="/locations/#compare">which office offers what</a>.</p></div>
        <div class:list={["lp-cards", nCards % 2 === 1 && "is-odd"]} style={`--n:${cardCols}`}>
          {items.map((p) => (
            <div class="pk" style={`--bar-c:${p.bar}`}>
              <span class="pk-icon"><Icon name={p.icon} class="h-[22px] w-[22px]" /></span>
              <div>
                <h3><a href={p.href}>{p.t}</a></h3>
                <p>{p.d} Learn about our <a class="inl" href={p.href}>{anchor(p.t)}</a>.</p>
                {p.facts && <ul class="pk-facts">{p.facts.map(([icon, t]) => <li><Icon name={icon} class="h-4 w-4" />{t}</li>)}</ul>}
              </div>
            </div>
          ))}
          {moreBox && (
            <div class="lp-more">
              <span class="lp-more-icon"><Icon name={moreBox.icon} class="h-[22px] w-[22px]" /></span>
              <h3>{moreBox.h}</h3>
              <p set:html={moreBox.p} />
            </div>
          )}
        </div>
        {/* Cross-links carried over from the live page's Conditions & Treatments grid (2026-11-16 SEO audit). Phrased
            Hopewell-wide so no service is claimed for an office that doesn't offer it. */}
        <p class="sec-foot">Across our Connecticut offices, Hopewell also offers <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient programs</a>, <a class="inl" href="/treatment-methods/tms/">TMS therapy</a>, <a class="inl" href="/treatment-methods/therapeutic-treatments/">HHS therapeutic treatments</a>, <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a> and <a class="inl" href="/treatment-methods/adhd-testing/">ADHD testing</a>.{l.addiction && <Fragment> This office also provides <a class="inl" href="/what-we-treat/substance-use-disorder/">addiction treatment</a> for <a class="inl" href="/what-we-treat/alcohol/">alcohol</a>, <a class="inl" href="/what-we-treat/drug/">drug</a> and <a class="inl" href="/what-we-treat/prescription-drugs/">prescription drug addiction</a>.</Fragment>}</p>
      </div>
    </section>

    {l.slug === "glastonbury-ct-2" && (
      <section class="section is-white" id="schedule">
        <div class="container lp-split">
          <div>
            <h2>A day at 300 Hebron Avenue</h2>
            <p class="lede">Most people in PHP spend about six hours a day here, Monday through Friday. IOP groups meet three hours a day, Monday through Thursday, in the morning or the evening, so many people keep working while they attend.</p>
            <div class="lp-table-wrap">
              <table class="lp-table">
                <thead><tr><th scope="col">Program</th><th scope="col">Days</th><th scope="col">Times</th></tr></thead>
                <tbody>
                  <tr><th scope="row"><a href="/programs/partial-hospitalization-program/">Partial Hospitalization (PHP)</a></th><td>Mon–Fri</td><td>About 6 hours a day</td></tr>
                  <tr><th scope="row"><a href="/programs/adult-mental-health-iop/">Adult Mental Health IOP</a></th><td>Mon–Thu</td><td>9 AM–12 PM or 5–8 PM</td></tr>
                  <tr><th scope="row"><a href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a></th><td>Mon–Thu</td><td>9 AM–12 PM or 5–8 PM</td></tr>
                  <tr><th scope="row"><a href="/programs/womens-trauma-iop/">Women’s Trauma IOP</a></th><td>Mon–Thu</td><td>5–8 PM</td></tr>
                  <tr><th scope="row"><a href="/programs/first-responder-iop/">First Responder IOP</a></th><td>Mon–Thu</td><td>9 AM–12 PM</td></tr>
                </tbody>
              </table>
            </div>
            <p class="lp-note">Call <a class="inl" href="tel:8607351448">(860) 735-1448</a> for current <a class="inl" href="/programs/addiction-iop/">Addiction IOP</a> group times.</p>
          </div>
          <figure>
            <img src={P + "team-300-hebron.webp"} alt="Members of the Hopewell team outside the 300 Hebron Avenue office" width="1200" height="900" loading="lazy" />
            <figcaption>Part of the team at 300 Hebron Ave</figcaption>
          </figure>
        </div>
      </section>
    )}

    {l.slug === "glastonbury-ct-3" && (
      <section class="section is-white" id="parents">
        <div class="container lp-split is-flip">
          <figure>
            <img src={L + "1420-main/1420-9.webp"} alt="The family therapy room at the South Glastonbury office" width="1448" height="1086" loading="lazy" />
            <figcaption>Family therapy room · 1420 Main St, Suite 124</figcaption>
          </figure>
          <div>
            <h2>For parents: how the Teen and Tween IOPs work</h2>
            <p class="lede">When your child is struggling, the whole family feels it. Here is what to expect at our South Glastonbury office.</p>
            <ul class="lp-list">
              <li><span class="lp-ico"><Icon name="phone" class="h-5 w-5" /></span><div><h3>The first step</h3><p>Call or send the form. Our <a class="inl" href="/admissions/">admissions team</a> checks your insurance and sets up an assessment, which recommends the right level of care for your child.</p></div></li>
              <li><span class="lp-ico"><Icon name="clock" class="h-5 w-5" /></span><div><h3>After school, four days a week</h3><p>The <a class="inl" href="/programs/teen-iop/">Teen IOP</a> (13–17) meets Monday through Thursday, 5:00 to 8:00 PM, and the <a class="inl" href="/programs/tween-iop/">Tween IOP</a> (8–12) from 4:30 to 7:30 PM, so most kids stay in school.</p></div></li>
              <li><span class="lp-ico"><Icon name="users" class="h-5 w-5" /></span><div><h3>Parents are part of it</h3><p>Parents attend once or twice a week to learn the same <a class="inl" href="/treatment-methods/dbt/">DBT skills</a>, so they carry into the home, and get regular updates from the care team.</p></div></li>
              <li><span class="lp-ico"><Icon name="heart" class="h-5 w-5" /></span><div><h3>Support for you, too</h3><p>A Parent Support Group meets on Tuesdays and Parent Night is on Thursdays. We can <a class="inl" href="/post/secrets-from-a-504-insider-a-parents-guide-to-academic-accommodations/">coordinate with your child’s school</a> when it helps.</p></div></li>
            </ul>
          </div>
        </div>
      </section>
    )}

    <!-- 4. Clinicians at this office (no medical staff) -->
    {team.length > 0 && (
      <section class="section is-stone lp-team" id="team">
        <div class="container">
          <div class="vc-head">
            <div class="sec-head" style="margin:0"><h2>{teamHeading}</h2><p class="lede" set:html={teamLede} /></div>
            <a class="vc-all" href="/about-us/team/">Meet our full team <span aria-hidden="true">&rarr;</span></a>
          </div>
          <ul class:list={["tt-grid", team.length === 4 && "is-4"]} style={`--n:${team.length}`}>
            {team.map((p) => (
              <li><a class="tm-card" href={`/provider/${p.slug}/`}><img src={`/Assets/Team%20Members/${encodeURIComponent(p.photo)}.webp`} alt={p.name} width="600" height="750" loading="lazy" /><span class="tm-cap"><strong>{nameOf(p.name)}</strong>{credsOf(p.name) && <em class="tm-creds">{credsOf(p.name)}</em>}<span>{shortRole(p.role)}</span></span></a></li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- 5. Inside the office: real photos -->
    <section class="section is-white" id="photos">
      <div class="container">
        <div class="sec-head">
          <h2>Inside our {l.name} office</h2>
          <p class="lede">Real photos of the rooms where therapy, groups and psychiatric care happen at {l.street}. Prefer to meet from home? <a class="inl" href="/programs/counseling/">Telehealth counseling</a> is available statewide.</p>
        </div>
        <PhotoSlider mode="marquee" photos={insidePhotos} label={`Inside the ${l.name} office`} />
      </div>
    </section>

    <!-- 6. Directions -->
    <section class="section is-stone" id="visit">
      <div class="container lp-visit">
        <div class="lp-map"><ConsentMap src={l.map} title={`Map, Hopewell Health Solutions, ${l.name}`} address={`${l.street}, ${l.city}, CT ${l.zip}`} class="lp-map-frame" /></div>
        <div>
          <h2>Directions to the {l.name} office</h2>
          <p class="lede">Find us at {fullAddress}. Call <a class="inl" href="tel:8607351448">(860) 735-1448</a> and our team will help you plan your first visit.</p>
          <ul class="lp-facts">
            <li><strong><Icon name="pin" class="h-5 w-5" />Address</strong><span>{fullAddress}</span></li>
            <li><strong><Icon name="calendar" class="h-5 w-5" />Hours</strong><span>{l.hours.split(" · ").map((h, i) => <Fragment>{i > 0 && <br />}{h}</Fragment>)}</span></li>
          </ul>
          <a href={directions} target="_blank" rel="noopener" class="btn btn-navy"><Icon name="pin" />Open in Google Maps</a>
        </div>
      </div>
      {tr && (
        <div class="container lp-go">
          <h3 class="lp-go-h">Getting here by car, bus or train</h3>
          <div class="lp-route" role="img" aria-label={`Driving route ${tr.from.toLowerCase()}: ${tr.signs.map((g) => `${g.k === "i" ? "I-" : g.k === "ct" ? "CT-" : g.k === "exit" ? "Exit " : ""}${g.n}${g.s ? " " + g.s : ""}`).join(", then ")}`}>
            <span class="lp-route-from">{tr.from}</span>
            {tr.signs.map((g, i) => (
              <Fragment>
                {i > 0 && <span class="lp-route-arrow" aria-hidden="true"><Icon name="arrow" class="h-4 w-4" /></span>}
                <span class={`lp-sign is-${g.k}`} aria-hidden="true">
                  {g.k === "i" && <svg viewBox="0 0 40 42"><path d="M3 3c6 2 11 2 17 0 6 2 11 2 17 0 2 9 2 15 0 21-3 9-9 14-17 17C12 38 6 33 3 24 1 18 1 12 3 3z" fill="#fff"/><path d="M5.5 5.6c5 1.4 9.5 1.4 14.5-.2 5 1.6 9.5 1.6 14.5.2.3 2.4.5 4.6.5 6.4H5c0-1.8.2-4 .5-6.4z" fill="#c8102e"/><path d="M5 13.4h30c0 3.4-.3 6.4-1 9.2-2.6 7.6-7.6 12-14 14.8C13.6 34.6 8.6 30.2 6 22.6c-.7-2.8-1-5.8-1-9.2z" fill="#003f87"/><text x="20" y="30" text-anchor="middle" font-size="13" font-weight="800" fill="#fff" font-family="Urbanist, sans-serif">{g.n}</text></svg>}
                  {g.k === "ct" && <span class="lp-sign-ct">{g.n}</span>}
                  {g.k === "exit" && <span class="lp-sign-exit"><small>EXIT</small>{g.n}</span>}
                  {g.k === "st" && <span class="lp-sign-st">{g.n}</span>}
                  {g.k === "home" && <span class="lp-sign-home"><Icon name="pin" class="h-4 w-4" />{g.n}</span>}
                  {g.s && g.k !== "st" && <small class="lp-sign-sub">{g.s}</small>}
                  {g.s && g.k === "st" && <small class="lp-sign-sub">{g.s}</small>}
                </span>
              </Fragment>
            ))}
          </div>
          <div class="lp-modes">
            <article class="lp-mode">
              <span class="lp-mode-ico"><Icon name="pin" class="h-6 w-6" /></span>
              <h4>By car</h4>
              <p>{tr.car}</p>
              <a class="inl" href={directions} target="_blank" rel="noopener">Directions in Google Maps</a>
            </article>
            <article class="lp-mode">
              <span class="lp-mode-ico is-bus"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><rect x="4" y="3" width="16" height="15" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 11h16M8 21v-3M16 21v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="8" cy="14.5" r="1.2" fill="currentColor"/><circle cx="16" cy="14.5" r="1.2" fill="currentColor"/></svg></span>
              <h4>By bus {tr.bus.routes.map((r) => <span class="lp-chip-route">{r}</span>)}</h4>
              <p>{tr.bus.text}</p>
              <a class="inl" href={OPERATORS[tr.bus.op].href} target="_blank" rel="noopener">{OPERATORS[tr.bus.op].name} schedules</a>
            </article>
            <article class="lp-mode">
              <span class="lp-mode-ico is-train"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><rect x="5" y="3" width="14" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 10h14M8 21l2-4M16 21l-2-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="9" cy="13.5" r="1.1" fill="currentColor"/><circle cx="15" cy="13.5" r="1.1" fill="currentColor"/></svg></span>
              <h4>By train</h4>
              <p>{tr.train.text}</p>
              <a class="inl" href={OPERATORS[tr.train.op].href} target="_blank" rel="noopener">{OPERATORS[tr.train.op].name}</a>
            </article>
          </div>
          <p class="lp-go-note">Bus and train times change, so check the operator’s schedule before you travel. Need help getting here? Call <a class="inl" href="tel:8607351448">(860) 735-1448</a>.</p>
        </div>
      )}
    </section>

    <!-- 7. Towns served + nearest other offices -->
    <section class="section is-mist" id="areas">
      <div class="container lp-areas">
        <div>
          <h2>Areas we serve from {l.city}</h2>
          <p class="lede">Clients travel to our {l.city} office from across the surrounding towns, and telehealth is available statewide.</p>
          <ul class="lp-towns">{l.areas.map((x) => <li><Icon name="pin" class="h-4 w-4" />{x}</li>)}</ul>
          {l.slug === "westbrook-ct" && <p class="lp-also">Clients also come from Guilford, Branford and Niantic.</p>}
        </div>
        <div class="lp-near">
          <h3>Nearest other Hopewell offices</h3>
          <ul>
            {near.map((x) => (
              <li>
                <img src={NEAR_PHOTO[x.slug]} alt={`Hopewell Health Solutions ${x.name} office`} width="264" height="208" loading="lazy" />
                <div>
                  <h4><a href={`/location/${x.slug}/`}>{x.name}</a></h4>
                  <small>{x.street}, {x.city}</small>
                  <p>{NEAR_NOTE[x.slug]}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 8. Insurance and admissions -->
    <Insurance heading="Most major PPO plans accepted" lede="We’re in-network with most major PPO plans. Our team verifies your benefits at no cost, before you commit to anything." tone="white" />
    <Locations heading="Our other locations" lede="Care across Connecticut: six offices from Hartford County to the shoreline, plus telehealth statewide." current={l.slug} />

    <!-- 9. Google reviews → As featured in → FAQ → closing CTA -->
    <Reviews tone="stone" first={PAGE.reviewsFirst} />
    <Faq faqs={faqs} heading={`${l.city} office, common questions`} tone="white" />
    <ClosingCta heading={`Get started at ${l.name}`} lede={`Reach out to Hopewell Health Solutions today, confidentially, with no pressure, and we’ll help you book at our ${l.name} office or by telehealth.`} />
  </main>
  <Footer />
  {ev && (
    <script>
      const el = document.querySelector<HTMLElement>("[data-event-end]");
      if (el && new Date() > new Date(el.dataset.eventEnd!)) el.remove();
    </script>
  )}
</Base>
