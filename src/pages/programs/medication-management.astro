<Base title="Medication Management in CT | Hopewell Health Solutions" description="Psychiatric medication management at Hopewell Health Solutions in CT — assessment, therapy & meds in one visit. Ages 4+, GeneSight testing. Most insurance accepted." image="/Assets/hhs-2026/westbrook-therapy-office.webp">
  <Header />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Programs", href: "/programs/" }, { label: "Medication Management" }]}
      title="Medication Management &amp; Psychiatric Care in Connecticut"
      lede="Medication Management &amp; Psychiatry · Glastonbury, CT · In person &amp; virtual. Getting the right medication shouldn’t feel like a guessing game. Psychiatric care at Hopewell Health Solutions is thoughtful, collaborative, and built around you."
      bullets={heroUsps}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews · every provider 5-star rated" }, { icon: "pin", text: "All six CT offices" }]}
      image={P + "south-glastonbury-waiting-room.webp"}
    />
    <Creds />

    <Split heading="What is medication management?" img={P + "westbrook-therapy-office.webp"} alt="A private office for medication management at our Westbrook location" img2={P + "east-hampton-waiting-room.webp"} alt2="The waiting room at our East Hampton office">
      <p><strong>Psychiatric care, built around you.</strong> Medication management is ongoing psychiatric care — a thorough evaluation, an accurate diagnosis, a personalized medication plan, and regular follow-ups to fine-tune it as you go. Our providers are specifically trained in psychiatric diagnoses, treatments, and medications.</p>
      <p>It’s essential care for promoting mental health, preventing things from getting worse, and meeting each person where they are. And we don’t put limits on your care — keep your current therapist, work with one of ours, or skip therapy altogether. It’s your call.</p>
    </Split>

    <Split heading="Assessment, therapy &amp; meds in one visit" img="/Assets/women%20looking%20at%20me.webp" alt="A patient in control of her psychiatric care in Connecticut" reverse tone="stone">
      <p><strong>Less runaround, more progress.</strong> Most practices make you bounce between a prescriber and a therapist. At Hopewell Health Solutions, you can get assessment, talk therapy, and medication in a single visit — and often a same-day appointment.</p>
      <p>We care for ages 4 and up — children, teens, and adults, including kids who need ADHD evaluation and support. Whether you’re starting medication for the first time or your longtime psychiatrist is retiring, we’ll build a plan you’re comfortable with.</p>
      <h3 style="font-size:20px">Your care, your choice</h3>
      <CheckList items={["Keep your therapist", "Work with ours", "Medication-only"]} />
    </Split>

    <section class="section is-white">
      <div class="container">
        <div class="sec-head"><h2>What medication management includes</h2><p class="lede">How it works.</p></div>
        <ol class="pg-steps">
          {howItWorks.map(([t, d], i) => <li><span class="n">{i + 1}</span><h3>{t}</h3><p>{d}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="section is-white" style="padding-top:0">
      <div class="container">
        <div class="pg-band">
          <span class="pg-band-icon"><Icon name="dna" class="h-9 w-9" /></span>
          <div>
            <h2>Find the right fit faster with GeneSight®</h2>
            <p><strong style="color:#fff">Precision prescribing.</strong> When it helps, we use GeneSight® pharmacogenomic testing — a simple cheek swab that shows how your body is likely to respond to different medications. Instead of trial-and-error, we use your biology to find the right fit faster.</p>
          </div>
          <a href="/treatment-methods/genesight-testing/" class="btn btn-ghost">Learn about GeneSight® testing</a>
        </div>
      </div>
    </section>

    <section class="section is-mist">
      <div class="container">
        <div class="sec-head"><h2>Psychiatric care for a wide range of concerns</h2><p class="lede">What we treat.</p></div>
        <ul class="pg-mods c3">
          {treats.map((c) => <li><span class="pg-mod-icon"><Icon name={c.icon} class="h-5 w-5" /></span><span set:html={c.t} /></li>)}
        </ul>
        <p class="sec-foot">Explore how we treat <a class="inl" href="/what-we-treat/anxiety/">anxiety</a>, <a class="inl" href="/what-we-treat/depression/">depression</a>, <a class="inl" href="/what-we-treat/adhd/">ADHD</a>, <a class="inl" href="/what-we-treat/ocd/">OCD</a> &amp; <a class="inl" href="/what-we-treat/trauma-ptsd/">trauma</a>.</p>
      </div>
    </section>

    <IconCards heading="Connected to a full continuum of care" lede="More than medication. Medication is one tool, not the whole toolbox. When it’s the right fit, we connect your care to:" items={moreThanMed} cols={3} />

    <Quote text="Providers who make sure you “leave with zero questions.”" cite="Every one of our medication-management providers holds a 5-star Google rating." img={P + "south-glastonbury-waiting-room.webp"} />

    <IconCards heading="Why people choose us for psychiatric care" lede="Why families choose Hopewell." items={unique} tone="stone" />

    <section class="section is-white">
      <div class="container">
        <div class="vc-head"><div class="sec-head" style="margin:0"><h2>Trusted &amp; featured across Connecticut</h2><p class="lede">In the news.</p></div><a href="/media/" class="vc-all">See all press &amp; interviews <span aria-hidden="true">&rarr;</span></a></div>
        <div class="pg-press">
          {press.map((p) => (
            <a href={p.href} target={p.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
              <img src={p.logo} alt={p.outlet} loading="lazy" />
              <small>{p.date}</small>
              <strong>{p.title}</strong>
              <span>Read the feature &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <VideoCarousel videos={stories} heading="Client Stories, in Their Own Words" lede="Clients share what care at Hopewell was like. Hear more on the <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a>." />

    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" />
    <Reviews heading="What Our Clients Say" tone="stone" first={["Medication management"]} />
    <Team heading="Our Psychiatric Providers" lede="Board-certified psychiatric nurse practitioners and physician assistants. <a class='inl' href='/about-us/team/'>Meet our full team</a>." slugs={["tracy-sibley-pmhnp-bc-aprn", "christina-lindsay-pmhnp-bc-aprn", "linda-scillia-pmhnp-bc-aprn", "katrin-moskowitz-dnp-pmhnp-bc-fnp", "ana-arroyo-aprn-pmhnp-bc", "chris-patenaude-pa", "katherine-salvador-pa-c"]} tone="white" />

    <Insurance heading="Most major PPO plans accepted" lede="We accept most major PPO plans. If you have questions about your coverage, contact us — our team verifies your benefits at no cost, before you commit to anything." />
    <Locations heading="Our Locations" lede="In person at six Connecticut offices — plus virtual visits statewide. Reach us at <a class='inl' href='tel:8607351448'>(860) 735-1448</a> · Fax (860) 781-8588 · <a class='inl' href='mailto:hhs4help@gmail.com'>hhs4help@gmail.com</a>." />
    <Faq faqs={faqs} heading="Medication management — common questions" tone="white" />
    <OtherPrograms current="/programs/medication-management/" />
    <ClosingCta heading="Take control of your mental health" lede="With a provider who listens and a plan that fits, psychiatric care can feel like a relief instead of a chore. Reach out to Hopewell Health Solutions today — confidentially, with no pressure." image={P + "south-glastonbury-waiting-room.webp"} imageAlt="The waiting room at our South Glastonbury office" />
  </main>
  <Footer />
</Base>
