---
// Adult Mental Health IOP — 2026 redesign (Corner Canyon layout). All live copy kept; see programs.css for the page kit.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Team from "../../components/hw/Team.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import Split from "../../components/programs/Split.astro";
import BlogSelfCheck from "../../components/blog/BlogSelfCheck.astro";
import ReadMore from "../../components/programs/ReadMore.astro";
import DualRecovery from "../../components/programs/graphics/DualRecovery.astro";
import AdultIopFit from "../../components/programs/graphics/AdultIopFit.astro";
import Quote from "../../components/programs/Quote.astro";
import IconCards from "../../components/programs/IconCards.astro";
import CheckList from "../../components/programs/CheckList.astro";
import ModalitiesOutcomes from "../../components/programs/ModalitiesOutcomes.astro";
import NewsVideos from "../../components/programs/NewsVideos.astro";
import Schedule from "../../components/programs/Schedule.astro";
import OtherPrograms from "../../components/programs/OtherPrograms.astro";
import { STORIES } from "../../data/videos.js";
import Prose from "../../components/seo/Prose.astro";
import "../../styles/pages/seo.css";
import "../../styles/pages/programs.css";

const P = "/Assets/hhs-2026/";
// The 4 agreed USPs — shown in the hero. ("hospitals don't offer" → no unsourced comparison, KB §1; specialist count
// matches the homepage's 50+.)
const heroUsps = [
  "Mental health &amp; addiction together",
  "Psychiatry and <a class='inl' href='/treatment-methods/medication-assisted-treatment/'>MAT</a> included",
  "<a class='inl' href='/treatment-methods/genesight-testing/'>GeneSight®</a> &amp; <a class='inl' href='/treatment-methods/tms/'>TMS</a> available",
];
const rightFit = ["Anxiety or depression", "Trauma or PTSD", "Emotional dysregulation or mood instability", "Co-occurring substance use concerns", "Difficulty functioning in daily life despite outpatient support"];
const weekIncludes = ["Evidence-based group therapy grounded in <a class='inl' href='/treatment-methods/dbt/'>DBT</a> &amp; CBT", "Experiential therapies, art, movement-based &amp; animal-assisted", "Individual therapy for personalized treatment", "Optional <a class='inl' href='/programs/medication-management/'>medication management</a> &amp; psychiatric support", "Optional family therapy &amp; psychoeducation"];
// Program-specific differentiators (preserved from the live page).
const unique = [
  { icon: "sparkles", t: "Multimodal treatment approach", d: "We blend clinical therapy with creative, somatic, and relational approaches for true mind–body healing." },
  { icon: "brain", t: "Foundational DBT &amp; CBT skills", d: "Mindfulness, emotion regulation, distress tolerance, interpersonal effectiveness, and cognitive restructuring." },
  { icon: "heart", t: "Healing beyond words", d: "Experiential therapies let you process emotion and trauma through movement, creative expression, and therapy animals." },
  { icon: "users", t: "A holistic care team", d: "Clinicians, psychiatric providers, and experiential therapists build a plan around your values and goals." },
];
const interviews = [
  { id: "aff5Xfy9CfE", t: "The Loneliness Crisis in Adults", outlet: "Hopewell Health Solutions" },
  { id: "GJeVqHhooBA", t: "Mommy Monday: Helping Children", outlet: "WFSB Channel 3" },
  { id: "uDy-K1dO0Fw", t: "CT Live!: Trauma in Women", outlet: "NBC Connecticut" },
];
const outcomes = ["Working on symptoms of anxiety, depression &amp; emotional overwhelm", "Building coping strategies and emotional resilience", "Practicing healthier communication and boundaries in relationships", "Growing self-awareness and confidence", "Working toward less reliance on substances or harmful behaviors"];
const modalities = [
  { t: "Dialectical Behavioral Therapy (DBT)", icon: "swap", href: "/treatment-methods/dbt/" },
  { t: "Cognitive Behavioral Therapy (CBT)", icon: "brain" },
  { t: "Art Therapy", icon: "sparkles" },
  { t: "Yoga Therapy", icon: "sun" },
  { t: "Mindfulness", icon: "cloud" },
  { t: "EMDR", icon: "bolt", href: "/treatment-methods/emdr/" },
  { t: "Somatic Therapy", icon: "heart" },
  { t: "Trauma-Informed Care", icon: "shield" },
];
const faqs: [string, string][] = [
  ["How long is the Adult IOP?", "Most participants attend 8–12 weeks, four days a week (Monday–Thursday), three hours a day, with regular progress evaluations."],
  ["What’s the difference between IOP and PHP?", "<a class='inl' href='/programs/partial-hospitalization-program/'>PHP</a> is more intensive (about six hours a day); IOP is part-time, so you can keep working, going to school, and caring for your family."],
  ["Can I keep working or going to school?", "Yes, choose a morning (9 AM–12 PM) or evening (5 PM–8 PM) track. Many participants also qualify for FMLA or CT Paid Leave."],
  ["Do you treat substance use too?", "Yes, it’s a co-occurring program. We treat mental health and substance use together, including <a class='inl' href='/treatment-methods/medication-assisted-treatment/'>Medication-Assisted Treatment (MAT)</a>."],
  ["What are co-occurring disorders?", "Co-occurring disorders means having a mental health condition, like depression, anxiety or trauma, and a substance use disorder at the same time. Learn more about <a class='inl' href='/what-we-treat/co-occurring/'>co-occurring disorders</a>."],
  ["What is dual diagnosis treatment?", "Dual diagnosis treatment is care that addresses both conditions together, with one team, instead of treating one and referring out for the other."],
  ["Why treat both at the same time?", "Each condition can make the other worse. Treating them together helps you understand the connection and build skills that support both."],
  ["Do I need to be sober to start?", "Our <a class='inl' href='/admissions/'>admissions team</a> will talk through where you are now. If you need detox or withdrawal care first, we’ll help you find it, then plan your start in the program."],
  ["Do you offer medication-assisted treatment?", "Yes. <a class='inl' href='/treatment-methods/medication-assisted-treatment/'>MAT</a> is available when it’s clinically appropriate, managed by our psychiatric team alongside therapy."],
  ["How is this different from the Addiction IOP?", "This program is for adults whose mental health and substance use are closely connected. Our <a class='inl' href='/programs/addiction-iop/'>Addiction and Substance Use IOP</a> centers on alcohol and drug use. Both meet in our adult co-ed IOP groups, Monday–Thursday, and our admissions team will help you choose."],
  ["Is my information kept confidential?", "Yes. Your treatment is protected by federal privacy law, including stricter federal rules that apply to substance use treatment records."],
  ["Will my family be involved?", "Only if you want them to be. Optional <a class='inl' href='/treatment-methods/therapeutic-treatments/'>family therapy</a> and psychoeducation are available."],
  ["Will my insurance cover it?", "We accept most major commercial insurance plans. We’ll <a class='inl' href='/rates-and-insurance-coverage/'>verify your benefits for free</a>, in minutes. Hopewell does not accept Medicare or Medicaid."],
];
const stories = STORIES.filter((v) => ["uIlSCS7clwE", "S_CyYMDqEio", "awy7nfDgC0k"].includes(v.yt));
---

<Base title="Adult Mental Health IOP in Connecticut | Hopewell" description="In-person adult mental health IOP in Glastonbury, CT, with morning and evening tracks, and co-occurring addiction care in one team. Check coverage." image={P + "group-room-bright.webp"}>
  <Header />
  <main id="main" tabindex="-1" class="hw" data-pgx>
    <ServiceHero
      crumbs={[{ label: "Programs", href: "/programs/" }, { label: "Adult Mental Health IOP" }]}
      title="Adult Mental Health IOP in Connecticut"
      lede="Structured, DBT-based care in Glastonbury and Westbrook, CT for adults 18+ who need more than weekly therapy, with one team for mental health and addiction."
      bullets={heroUsps}
      facts={[{ icon: "calendar", text: "Mon–Thu · 3 hours a day" }, { icon: "clock", text: "Morning or evening track" }, { icon: "star", text: "4.8 · 368 Google reviews" }]}
      image="/Assets/Blogs/iop-for-depression-in-connecticut-when-outpatient-treatment-is-enough.webp"
      imagePos="center 45%"
    >
      <p style="margin-top:18px;font-size:14.5px;color:#b9cbe0">Clinically reviewed by <a class="inl" href="/provider/kristine-a-schlichting-ph-d/">Kristine Schlichting, PhD</a></p>
    </ServiceHero>
    <Creds />

    <Split heading="What is an Adult Intensive Outpatient Program (IOP)?">
      <AdultIopFit slot="media" />
      <p class="pg-lede">An Adult IOP is a structured treatment plan for adults with mental health challenges who need <a class='inl' href='/post/iop-vs-outpatient-therapy-which-option-is-right-for-you/'>more support than weekly therapy</a> provides.</p>
      <CheckList icon="check" items={[
        "A higher level of care while you continue your daily life, work, school, and family",
        "No hospital stay required, unlike inpatient programs",
        "Support for <a class='inl' href='/what-we-treat/depression/'>depression</a>, <a class='inl' href='/what-we-treat/anxiety/'>anxiety</a>, <a class='inl' href='/what-we-treat/trauma-ptsd/'>trauma</a>, and <a class='inl' href='/post/mood-swings-vs-a-mood-disorder-and-what-iop-does-about-it/'>mood disorders</a>",
        "Help with <a class='inl' href='/what-we-treat/co-occurring/'>co-occurring substance use</a>",
        "Ideal if you’re stepping down from inpatient care or seeking more than traditional outpatient therapy"
      ]} />
      <ReadMore id="fold-adult">
        <p>An Adult Intensive Outpatient Program (IOP) is a structured treatment plan for adults experiencing mental health challenges who need more support than weekly therapy provides. Unlike inpatient programs, an Adult IOP doesn’t require a hospital stay. At Hopewell Health Solutions, our IOP supports adults struggling with depression, anxiety, trauma, mood disorders, and co-occurring substance use.</p>
      </ReadMore>
    </Split>

    {/* User 2026-11-18: "separate these two sections, add a quiz on the is this program right". The criteria stay
        visible on the left; the yes/no self-check (data/quizzes.js `adultIop`, built only from these criteria) sits right. */}
    <section class="section is-stone" id="right-for-you">
      <div class="container pg-two">
        <div>
          <h2>Is this program right for you?</h2>
          <p class="lede">Our Adult IOP is designed for individuals 18+ experiencing moderate-to-severe symptoms of:</p>
          <CheckList items={rightFit} />
          <p class="lede">If you’re ready to take a more active role in your healing but don’t require inpatient care, this program may be the right fit.</p>
        </div>
        <BlogSelfCheck quiz="adultIop" />
      </div>
    </section>

    <section class="section is-mist" id="how-it-works">
      <div class="container pg-two">
        <div>
          <h2>How does the program work?</h2>
          <p>Our IOP runs four days per week, three hours per day, a balance of intensive clinical care and flexibility for your work, school, or family life. Choose a <strong>morning (9 AM–12 PM)</strong> or <strong>evening (5 PM–8 PM)</strong> track, Monday–Thursday, at 300 Hebron Ave, Glastonbury. Most participants engage for <a class="inl" href="/post/retraining-the-brain-why-our-intensive-outpatient-programs-are-8-12-weeks/">8–12 weeks</a>, with regular progress evaluations. Each week includes:</p>
          <CheckList items={weekIncludes} />
          <p class="pg-small" style="font-size:15px;color:var(--hw-slate)">Most major insurances accepted · Many participants qualify for <a class="inl" href="/post/what-programs-at-hopewell-are-eligible-for-ct-paid-leave-or-fmla/">FMLA or CT Paid Leave</a>.</p>
        </div>
        <Schedule title="Adult IOP week" stat="3 h" note="a day · four days a week · Monday–Thursday" days={[3, 3, 3, 3, 0, 0, 0]} tracks={[["Morning track", "9 AM–12 PM"], ["Evening track", "5 PM–8 PM"]]} />
      </div>
    </section>

    <Split heading="Supporting both mental health &amp; substance-use recovery">
      <DualRecovery slot="media" />
      <p class="pg-lede"><strong>Struggling with unhealthy coping?</strong> While our focus is mental health, we recognize how closely <a class='inl' href='/what-we-treat/substance-use-disorder/'>substance use</a> and emotional pain are linked. We offer:</p>
      <CheckList icon="check" items={[
        "Psychoeducation on <a class='inl' href='/post/addiction-treatment-and-the-brain-how-therapy-and-medication-can-help-rewire-your-mind/'>addiction &amp; the brain</a>",
        "Relapse prevention &amp; recovery planning",
        "<a class='inl' href='/treatment-methods/dbt/'>DBT</a> &amp; CBT skill-building to replace maladaptive behaviors",
        "Dual-diagnosis support (<a class='inl' href='/what-we-treat/co-occurring/'>co-occurring mental health &amp; substance use</a>)",
        "<a class='inl' href='/treatment-methods/medication-assisted-treatment/'>Medication-Assisted Treatment (MAT)</a> services"
      ]} />
      <ReadMore id="fold-mat" label="What is MAT?">
        <div class="pg-panel">
          <h3>What is MAT?</h3>
          <p>Medication-Assisted Treatment combines FDA-approved medications with counseling and behavioral therapy to reduce cravings and withdrawal and support long-term recovery. Under the compassionate care of <a class="inl" href="/provider/katherine-salvador-pa-c/">Katherine Salvador, PA-C</a>, MAT is personalized, never one-size-fits-all, with a trauma-informed, judgment-free approach.</p>
        </div>
      </ReadMore>
    </Split>

    <Prose startTone={1} blocks={[
      { id: "who-its-for", h2: "Who the Co-Occurring Disorders IOP Is For",
        paras: [
          "This program is for adults 18 and older who are dealing with a mental health condition and <a class='inl' href='/what-we-treat/alcohol/'>drinking</a> or <a class='inl' href='/what-we-treat/drug/'>drug use</a> at the same time. Often the two feed each other: anxiety or depression leads to drinking or using to cope, and the substance use deepens the anxiety, depression or sleeplessness that started it. Trauma, mood instability and loneliness can sit underneath both.",
          "Many people who come to us have been through treatment before that addressed only one side. A therapist worked on depression but never asked about alcohol, or an addiction program focused on staying sober without addressing the panic attacks that kept pulling them back. Dual diagnosis treatment in Connecticut works best when both are on the table from day one.",
          "If your drinking or drug use is the main concern and mental health symptoms are less central, our <a class='inl' href='/programs/addiction-iop/'>addiction treatment IOP</a> may be a better fit. If symptoms make it hard to get through the day, a <a class='inl' href='/programs/partial-hospitalization-program/'>partial hospitalization program</a> offers more hours of care. Our admissions team helps you decide.",
        ],
        aside: { type: "points", title: "This program is often a fit when…", items: [["link", "Mental health and substance use feed each other"], ["refresh", "Past treatment addressed only one side"], ["calendar", "You need care that fits around work and family"], ["users", "You want one team, not separate providers"]] } },
      { id: "one-team", h2: "Dual Diagnosis IOP in Connecticut: One Team, No Hand-Off",
        paras: [
          "In many systems, mental health and addiction are treated by different providers who rarely talk. You might see a psychiatrist in one office and attend substance use groups in another, repeating your story each time. In our co-occurring IOP, the same team, therapists, psychiatric providers and experiential therapists, plans and delivers care for both, in one building.",
          "Your week combines group therapy grounded in DBT and CBT, relapse prevention and recovery planning, individual therapy, and psychiatric care with <a class='inl' href='/programs/medication-management/'>medication management</a>. When it’s clinically appropriate, <a class='inl' href='/treatment-methods/medication-assisted-treatment/'>medication-assisted treatment (MAT)</a> is managed by the same psychiatric team. Optional family sessions help the people at home understand what you’re working on.",
          "This page describes the program. To learn more about the conditions themselves, read about <a class='inl' href='/what-we-treat/co-occurring/'>co-occurring mental health and substance use disorders</a>, or compare every level of care in our <a class='inl' href='/programs/intensive-outpatient-program/'>intensive outpatient programs overview</a>.",
        ],
        aside: { type: "img", src: P + "adult-evening-iop-group.webp", alt: "The adult co-occurring disorders IOP team in a Glastonbury, CT group room", cap: "Part of the adult IOP team" } },
      { id: "where", h2: "Mental Health and Addiction Treatment in Glastonbury and Westbrook",
        paras: [
          "Morning (9 AM–12 PM) and evening (5–8 PM) tracks meet Monday through Thursday at our <a class='inl' href='/location/glastonbury-ct-2/'>Downtown Glastonbury office at 300 Hebron Ave</a>, and an evening IOP also meets at our <a class='inl' href='/location/westbrook-ct/'>Westbrook office</a> on the shoreline, where addiction care is offered too. Most people keep working throughout, and many qualify for FMLA or CT Paid Leave.",
          "When the program ends, care continues with the same team through <a class='inl' href='/programs/counseling/'>counseling</a> and medication management. To get started, call us or see <a class='inl' href='/admissions/'>how admissions works</a>. We’ll check your insurance for free before your first day.",
        ],
        aside: { type: "table", title: "Program at a glance", head: ["", "Adult Mental Health IOP"], rows: [["Who", "Adults 18+"], ["Schedule", "Mon–Thu, 3 hours a day"], ["Tracks", "9 AM–12 PM or 5–8 PM"], ["Length", "Most attend 8–12 weeks"], ["Where", "300 Hebron Ave & Westbrook"]] } },
    ]} />

    <Quote text="Caring for your mental health is an act of strength, not weakness. You’ve carried a lot, you don’t have to carry it alone." img={P + "team-lawn-small.webp"} />

    <IconCards heading="What makes our program unique?" lede="Why families choose Hopewell." items={unique} />

    <ModalitiesOutcomes modalities={modalities} outcomes={outcomes} note="Plus <a class='inl' href='/programs/medication-management/'>medication management</a> and additional <a class='inl' href='/treatment-methods/therapeutic-treatments/'>therapeutic treatments</a>." />

    <VideoCarousel videos={stories} heading="Adult IOP Stories, in Their Own Words" lede="Clients share what the Intensive Outpatient Program was like." />

    <NewsVideos heading="See Hopewell Health Solutions" lede="In the room &amp; in the news." videos={interviews} />


    <Team heading="Your Adult IOP Care Team" lede="Clinicians, psychiatric providers, and experiential therapists who build a plan around your values and goals. <a class='inl' href='/about-us/team/'>Meet our full team</a>." slugs={["teesha-huertas-lcsw", "katherine-salvador-pa-c", "tracy-sibley-pmhnp-bc-aprn", "chelsey-micciche-lpc", "kaitlyn-czapiga-lmsw", "sherrie-gaudet-lcsw", "jonathan-ficara-lcsw"]} tone="white" />

    <Insurance heading="Most major PPO plans accepted" lede="We’re in-network with most major PPO plans. Our admissions team verifies your benefits at no cost, before you commit to anything." />
    <Locations heading="Where the Program Meets" lede="Adult IOP morning and evening tracks meet at our <a class='inl' href='/location/glastonbury-ct-2/'>Downtown Glastonbury office</a>, 300 Hebron Ave, and an evening adult IOP also meets at our <a class='inl' href='/location/westbrook-ct/'>Westbrook office</a>. Therapy and medication management are available at <a class='inl' href='/locations/'>all six Connecticut offices</a>." current="glastonbury-ct-2" />
    <Reviews tone="white" heading="What Our IOP Clients Say" first={["IOP", "Women’s Wellness IOP"]} />
    <Faq faqs={faqs} heading="Adult Mental Health IOP, Common Questions" tone="stone" />
    <OtherPrograms current="/programs/adult-mental-health-iop/" />
    <ClosingCta heading="Start your healing journey today" lede="Healing is possible, and you don’t have to do it alone. We’re accepting new clients, accept most major insurance, and offer flexible payment options." image={P + "php-group-room.webp"} />
  </main>
  <Footer />
</Base>
