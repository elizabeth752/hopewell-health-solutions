---

<Base title="Therapy & Therapists in Glastonbury, CT | Hopewell" description="Individual, family, group and DBT therapy for children, teens and adults at Hopewell's Connecticut offices, plus play therapy for kids. Check your coverage." image={P + "westbrook-counseling-office.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(svc)} />
  <main class="hw" data-pgx>
    <ServiceHero
      crumbs={[{ label: "Programs", href: "/programs/" }, { label: "Counseling" }]}
      title="Therapy &amp; Counseling in Glastonbury, CT"
      lede="Individual, couples and family therapy for children, teens and adults at six offices from Glastonbury to Westbrook, and by telehealth."
      bullets={heroUsps}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "pin", text: "All six CT offices" }]}
      image="/Assets/therapeutic-treatments/Talk%20therapy.webp"
    >
      <p style="margin-top:18px;font-size:14.5px;color:#b9cbe0">Clinically reviewed by <a class="inl" href="/provider/kristine-a-schlichting-ph-d/">Kristine Schlichting, PhD</a></p>
    </ServiceHero>
    <!-- 2. As featured in -->
    <Creds />


    <!-- 4. Who it's for -->
    <Split heading="What is counseling?">
      <CounselingSession slot="media" />
      <p><strong>Help at your own pace.</strong> Counseling is talk therapy, a licensed clinician helps you work through difficult life situations and conditions like <a class="inl" href="/what-we-treat/depression/">depression</a> and <a class="inl" href="/what-we-treat/anxiety/">anxiety</a>, and build coping strategies that actually stick. Sessions typically run about 60 minutes, once or twice a week depending on what you need.</p>
      <p>One in five adults lives with a mental health condition. With the right support, life’s hardest stretches get more manageable, and you don’t have to face them alone. It’s a highly effective, flexible way to feel better and function better.</p>
    </Split>
    <Prose blocks={blocks.slice(0, 1)} startTone={1} />
    <section class="section is-white">
      <div class="container">
        <div class="sec-head"><h2>Support for life’s challenges</h2><p class="lede">What we help with.</p></div>
        <ul class="pg-mods c3">
          {helpWith.map((c) => <li><span class="pg-mod-icon"><Icon name={c.icon} class="h-5 w-5" /></span><span set:html={c.t} /></li>)}
        </ul>
      </div>
    </section>

    <!-- 5. What treatment includes -->
    <IconCards heading="Who counseling is for" lede="Whoever you’re carrying it with." items={whoFor} cols={3} tone="stone" />
    <IconCards heading="Types of therapy we offer" lede="One short guide to each. Your therapist may combine more than one." items={types} cols={3} tone="white" />
    <IconCards heading="How we work" lede="Evidence-based &amp; tailored to you." items={howWeWork} cols={3} tone="mist" />
    <Prose blocks={blocks.slice(1, 2)} startTone={1} />
    <section class="section is-white">
      <div class="container">
        <div class="sec-head"><h2>Counseling vs. IOP</h2><p class="lede"><strong>Find the right level.</strong> Weekly counseling is the right starting point for many people. If you need more structure, we’ll help you step up, seamlessly.</p></div>
        <div class="levels-grid pg-vs">
          <Schedule title="Weekly counseling" stat="60 min" note="once or twice a week" days={[1, 0, 0, 1, 0, 0, 0]} max={3} tone={1} icon="heart">
            <p>About <strong>60 minutes, once or twice a week</strong>flexible, personal support at your own pace. The right starting point for most people.</p>
          </Schedule>
          <Schedule title="Need more structure?" stat="3–6 h" note="a day, several days a week" days={[3, 3, 3, 3, 0, 0, 0]} max={3} tone={3} icon="refresh">
            <p>Our <a class="inl" href="/programs/intensive-outpatient-program/">IOP</a> and <a class="inl" href="/programs/partial-hospitalization-program/">PHP</a> add several days a week of support, and your therapist helps you move between levels.</p>
          </Schedule>
        </div>
        <p class="levels-key"><span class="key-swatch"></span>Example week: sessions per day (one or two weekly counseling sessions vs. a 4-day IOP)</p>
      </div>
    </section>
    <Prose blocks={blocks.slice(2)} startTone={1} />
    <Quote text="“You’re not just a number. I feel as if my voice is valued.”" img={P + "east-hampton-counseling-room.webp"} />
    <IconCards heading="Why people choose us for therapy" lede="Why Hopewell Health Solutions." items={unique} tone="stone" />

    <!-- 6. Team -->
    <Team heading="Meet Some of Our Therapists" lede="Licensed counselors, social workers, marriage &amp; family therapists and psychologists across six offices." slugs={["dori-bessette-crail-lmft", "joanne-malinka-lcsw", "jessenia-medina-lpc-ncc", "kimberly-devine-lcsw", "nathan-truong-lmft-a", "eunice-rivera-miranda-ph-d", "meagan-carr-ph-d"]} tone="stone" />

    <!-- 7. Testimonials -->
    <VideoCarousel videos={stories} mode="grid" tone="navy" heading="Client Stories, in Their Own Words" lede="Clients share what getting help at Hopewell was like. Hear more on the <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a>." link={{ href: "/testimonials/", label: "Read more patient stories" }} />

    <!-- 8. Locations -->
    <Locations heading="Counseling at All Six Offices" lede="In person at six Connecticut offices, plus virtual visits statewide. Looking for <a class='inl' href='/location/glastonbury-ct/'>mental health care in Glastonbury</a> or a therapist on the shoreline in <a class='inl' href='/location/westbrook-ct/'>Westbrook</a>? Reach us at <a class='inl' href='tel:8607351448'>(860) 735-1448</a> · <a class='inl' href='mailto:hhs4help@gmail.com'>hhs4help@gmail.com</a>." />

    <!-- 9. Insurance -->
    <Insurance heading="Insurance for counseling" lede="We’re in-network with most major commercial plans. Our team verifies your benefits at no cost, before you commit to anything. Hopewell doesn’t accept Medicare or Medicaid." tone="white" />

    <!-- Reviews sit last, right above the FAQ (coordinator, 2026-11-16) -->

    <!-- 10. FAQ -->
    <Reviews tone="stone" heading="What Our Clients Say" first={["Therapy", "Outpatient care"]} />
    <Faq faqs={faqs} heading="Counseling, common questions" tone="white" />

    <!-- 11. Related + final CTA -->
    <OtherPrograms current="/programs/counseling/" />
    <FinalCta heading="Find your therapist" lede="The right therapist can change everything. Reach out to Hopewell Health Solutions today, confidentially, with no pressure, and we’ll help you find yours." />
  </main>
  <Footer />
</Base>
