const whyHopewell = [
  { icon: "heart", t: "A woman-led practice", d: "Compassionate, evidence-based care in a welcoming environment, with a strong focus on connection and collaboration." },
  { icon: "users", t: "Tailored to you", d: "<a class='inl' href='/programs/counseling/'>Individual therapy</a>, <a class='inl' href='/programs/medication-management/'>psychiatric care</a>, or the Women’s Wellness IOP, we meet you where you are. You’re never just a number; your healing matters to us." },
];

// Who it's for — long-form blocks (brief: anxiety, depression, burnout, postpartum & perinatal, life transitions, relationship stress).
const whoBlocks = [
  { id: "who", h2: "Who the Women’s Wellness IOP in Connecticut is for",
    paras: [
      "The Women’s Wellness IOP is an <a class='inl' href='/programs/intensive-outpatient-program/'>intensive outpatient program</a> for adult women who need more support than a weekly therapy hour can give, but who want to keep living at home, working and caring for the people who count on them. It is one of the few women’s IOP options in Connecticut built entirely around a women-only group, and it now runs on the shoreline in Westbrook as well as in Glastonbury.",
      "Women come to the program for many reasons. Some have lived with <a class='inl' href='/what-we-treat/anxiety/'>anxiety</a> (and wondered <a class='inl' href='/post/what-are-the-levels-of-anxiety-and-when-do-you-need-more-than-therapy/'>when anxiety needs more than therapy</a>) or <a class='inl' href='/what-we-treat/depression/'>depression</a> for years and are tired of managing it alone. Some are running on empty from <a class='inl' href='/post/do-i-need-to-take-a-break-from-my-job-signs-of-job-burnout/'>burnout at work</a> or at home. Others are in the middle of a big change, a new baby, a divorce, an empty nest, a loss, a diagnosis, a move, and feel like they have lost their footing.",
      "You do not need a specific diagnosis to start. Our admissions team talks with you about what is going on and, after an assessment, recommends the level of care that fits. If the Women’s Wellness IOP isn’t the right starting point, we’ll explain why and point you to the option that is, whether that is <a class='inl' href='/programs/counseling/'>weekly counseling</a>, <a class='inl' href='/programs/medication-management/'>medication management</a> or a more intensive program.",
    ],
    aside: { type: "points", title: "Signs this program may help (non-diagnostic)", items: [["cloud", "Low mood, worry or irritability that won’t lift"], ["clock", "Feeling stretched thin by work, parenting or caregiving"], ["heart", "Mood changes during pregnancy or after a baby"], ["refresh", "A life transition that has shaken your sense of self"], ["users", "Relationship stress that keeps coming back"]] } },
  { id: "postpartum", h2: "Postpartum and perinatal support for new and expecting mothers",
    paras: [
      "Pregnancy and the first year with a baby can bring mood changes that are far bigger than the “baby blues.” Many women feel anxious, numb, tearful or angry, struggle to sleep even when the baby sleeps, or have frightening intrusive thoughts, and then feel ashamed for not enjoying a time they were told would be happy. These experiences are common and treatable, and you deserve support for them.",
      "Within the Women’s Wellness IOP, our clinicians support women through postpartum and perinatal mood changes with group and individual therapy, and with medication management from our psychiatric providers when it’s needed. Being in a group of other women who understand makes it easier to say out loud what you have been carrying.",
      "If you are not sure whether what you are feeling is “normal,” our articles on <a class='inl' href='/post/baby-blues-vs-postpartum-depression-how-to-tell-the-difference/'>baby blues vs. postpartum depression</a>, <a class='inl' href='/post/postpartum-anxiety-symptoms-how-long-it-lasts-and-treatment/'>postpartum anxiety</a>, <a class='inl' href='/post/postpartum-ocd-and-intrusive-thoughts-what-they-mean-and-how-theyre-treated/'>postpartum OCD and intrusive thoughts</a> and <a class='inl' href='/post/postpartum-rage-why-it-happens-and-when-to-get-help/'>postpartum rage</a> are a good place to start. You can also simply call, we’ll help you sort out what kind of care fits.",
    ],
    aside: { type: "img", src: W + "therapy-room-garden.webp", alt: "A bright therapy room at the Westbrook office where women meet for postpartum support", cap: "Westbrook therapy room" } },
];

// What treatment includes — long-form.
const includesBlocks = [
  { id: "holistic", h2: "Evidence-based therapy, with whole-person approaches alongside it",
    paras: [
      "The core of the Women’s Wellness IOP is evidence-based treatment: <a class='inl' href='/treatment-methods/dbt/'>DBT skills</a> for managing strong emotions, process groups where you talk through what is happening in your life, and individual check-ins with a clinician who knows your goals. When trauma is part of your story, trauma-informed methods such as <a class='inl' href='/treatment-methods/emdr/'>EMDR</a> and Trauma-Focused CBT are woven in.",
      "Alongside that work, the program encourages whole-person approaches that help women reconnect with their bodies and slow down: expressive arts, guided journaling, mindfulness, yoga-inspired movement and time outdoors. Blue Green therapy, spending intentional time in nature and near water, is an approach we encourage on the shoreline, not a separate service. Our <a class='inl' href='/treatment-methods/therapeutic-treatments/'>therapeutic treatments</a> page explains these approaches in more detail.",
    ],
    aside: { type: "steps", title: "A typical program day", items: [["Check-in", "How you’re arriving today, in a small women-only group."], ["Skills group", "A DBT skill you practise in the room and take home."], ["Process group", "Space to talk through what’s happening in your life."], ["Wellness & reflection", "Expressive arts, journaling, movement or mindfulness."]] } },
];

// Westbrook launch (brief).
const westbrookBlocks = [
  { id: "westbrook", h2: "Women’s therapy in Westbrook, CT, on the Connecticut shoreline",
    paras: [
      "The Women’s Wellness IOP was the first program at our <a class='inl' href='/location/westbrook-ct/'>Westbrook office</a> at 70 Essex Road, which opened on September 28, 2026. It brings in-person women’s mental health care to the shoreline, so women from Westbrook, Old Saybrook, Clinton, Niantic, Madison, Guilford and Branford no longer have to drive to Hartford County for an intensive program.",
      "We welcomed the community to an open house in October, and a second women’s group is planned as the program grows. The Westbrook office also offers 1:1 therapy and medication management, so women can step down to <a class='inl' href='/programs/counseling/'>weekly therapy</a> with the same team after the program ends.",
    ],
    aside: { type: "img", src: W + "therapy-room-shore.webp", alt: "A therapy room with shoreline artwork at Hopewell's Westbrook office", cap: "Westbrook office · 70 Essex Road" } },
