  "On-call clinical services",
  "In-person &amp; virtual options",
  "FMLA / CT Paid Leave assistance",
];
const outcomes = ["Reconnect with your body", "Reduce stress &amp; burnout", "Rebuild trust in yourself &amp; others", "Sustainable emotional wellness"];
const modalities = [
  { t: "Dialectical Behavior Therapy (DBT)", icon: "swap", href: "/treatment-methods/dbt/" },
  { t: "EMDR", icon: "bolt", href: "/treatment-methods/emdr/" },
  { t: "Somatic Therapy", icon: "heart" },
  { t: "Trauma-Focused CBT", icon: "brain" },
  { t: "Art Therapy", icon: "sparkles" },
  { t: "Yoga-Inspired Movement", icon: "sun" },
  { t: "Mindfulness", icon: "cloud" },
  { t: "Trauma-Informed Care", icon: "shield" },
];
const whyHopewell = [
  { icon: "heart", t: "A woman-led practice", d: "Compassionate, evidence-based care in a welcoming environment — with a strong focus on connection, collaboration, and real results." },
  { icon: "users", t: "Tailored to you", d: "<a class='inl' href='/programs/counseling/'>Individual therapy</a>, <a class='inl' href='/programs/medication-management/'>psychiatric care</a>, or the Women’s Wellness IOP — we meet you where you are. You’re never just a number; your healing matters to us." },
