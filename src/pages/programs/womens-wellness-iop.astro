const faqs: [string, string][] = [
  ["What is Women’s Wellness IOP?", "An intensive outpatient program for adult women, meeting several times a week in a women-only group, while you keep up with work and family."],
  ["Who is the Women’s Wellness IOP for?", "Women dealing with anxiety, depression, burnout, postpartum mood changes or major life transitions who need more than weekly therapy, as well as emotional burnout, stress, relationship challenges, low self-esteem, or the lingering effects of trauma. The program is open to all who identify as women, from all backgrounds."],
  ["Do you treat postpartum depression?", "Yes. Our clinicians support women through postpartum and perinatal mood changes, with therapy and <a class='inl' href='/programs/medication-management/'>medication management</a> when needed."],
  ["How is it different from Women’s Trauma IOP?", "Women’s Wellness focuses on mood, anxiety and life transitions. The <a class='inl' href='/programs/womens-trauma-iop/'>Women’s Trauma IOP</a> focuses on healing from past trauma."],
  ["Why a women-only group?", "Many women find it easier to talk openly with other women who share similar experiences."],
  ["Where is it offered?", "At our <a class='inl' href='/location/westbrook-ct/'>Westbrook office</a> on the Connecticut shoreline and at <a class='inl' href='/location/glastonbury-ct-2/'>300 Hebron Ave, Suite 212, in Glastonbury</a>. We serve women from Niantic, Branford, Madison, Guilford and nearby towns, with virtual options when coming in isn’t possible."],
  ["What’s the schedule?", "The program runs 8–12 weeks, Monday–Thursday. In Glastonbury, groups meet 9 AM–12 PM or 5–8 PM. Our admissions team will confirm the current Westbrook group times when you call. It’s built to fit around work and family."],
  ["Can I bring my baby?", "Please call our <a class='inl' href='/admissions/'>admissions team</a> to talk through childcare and infant questions before you start, so we can plan a schedule that works for you."],
  ["What approaches does the program use?", "It’s trauma-informed and evidence-based: <a class='inl' href='/treatment-methods/dbt/'>DBT</a>, <a class='inl' href='/treatment-methods/emdr/'>EMDR</a>, somatic therapies, and Trauma-Focused CBT (TF-CBT), plus expressive arts, journaling, yoga-inspired movement, time in nature, and animal-assisted support."],
  ["Does insurance cover it?", "Most commercial plans cover IOP when medically necessary, and TRICARE East is accepted as a PPO plan. Many participants also qualify for <a class='inl' href='/post/what-programs-at-hopewell-are-eligible-for-ct-paid-leave-or-fmla/'>Connecticut Paid Leave or FMLA</a>. We <a class='inl' href='/rates-and-insurance-coverage/'>verify benefits for free</a>; we don’t accept Medicare or Medicaid."],
  ["Do I need a referral?", "No referral is needed to call us. Our admissions team will let you know if your plan requires one."],
  ["Can I see a psychiatrist too?", "Yes. <a class='inl' href='/programs/medication-management/'>Medication management</a> is available at Westbrook and at all of our offices."],
];
const stories = ["eX6WO-MRdPs", "x6R6XOZmxUQ", "S_CyYMDqEio"].map((id) => VIDEOS.find((v) => v.yt === id)).filter(Boolean);
const svc = { "@context": "https://schema.org", "@type": "MedicalTherapy", name: "Women’s Wellness Intensive Outpatient Program (IOP)", url: SITE + "/programs/womens-wellness-iop/",
  description: "A women-only intensive outpatient program in Westbrook and Glastonbury, CT for anxiety, depression, burnout, postpartum mood changes and life transitions.",
  provider: { "@id": SITE + "/#organization" }, availableAtOrFrom: [{ "@id": SITE + "/location/westbrook-ct/#clinic" }, { "@id": SITE + "/location/glastonbury-ct-2/#clinic" }] };
---

<Base title="Women's Wellness IOP in Westbrook & Glastonbury, CT | Hopewell" description="An in-person IOP just for women in Westbrook, CT: support for anxiety, depression, postpartum and life transitions, in a group of women. Check coverage." image={W + "therapy-room-shore.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(svc)} />
  <main class="hw" data-pgx>
    <!-- 1. Hero + form -->
    <ServiceHero
      crumbs={[{ label: "Programs", href: "/programs/" }, { label: "IOP", href: "/programs/intensive-outpatient-program/" }, { label: "Women's Wellness" }]}
      title="Women's Wellness IOP in Connecticut"
      lede="An in-person women’s IOP in Connecticut, now in Westbrook and Glastonbury: support for anxiety, depression, burnout, postpartum mood changes and life transitions, in a group of women who understand. A program for women, designed by women."
      bullets={heroUsps}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "pin", text: "Westbrook & Glastonbury" }]}
      image={W + "therapy-room-shore.webp"}
    >
      <p style="margin-top:18px;font-size:14.5px;color:#b9cbe0">Medically reviewed by <a class="inl" href="/provider/kristine-a-schlichting-ph-d/">Kristine Schlichting, PhD</a></p>
    </ServiceHero>

    <!-- 2. As featured in -->
    <Creds />


    <!-- 4. Who this program is for -->
    <Split heading="We understand the load women carry" img={W + "therapy-room-sage.webp"} alt="A calm therapy room at the Westbrook office for the Women's Wellness IOP" img2={P + "group-room-bright.webp"} alt2="A bright group room for the Women's Wellness IOP in Glastonbury">
      <p><strong>A space to pause, process &amp; heal.</strong> Between work, parenting, caregiving, relationships, health concerns, and the constant pressure to “hold it all together,” it’s easy to lose your sense of self. That’s why we created the Women’s Wellness IOP, a supportive, structured space where women can pause, process, and begin to heal.</p>
      <p>This 8–12 week program is for women experiencing emotional burnout, <a class="inl" href="/what-we-treat/anxiety/">anxiety</a>, stress, life transitions, relationship challenges, low self-esteem, or the lingering effects of <a class="inl" href="/what-we-treat/trauma-ptsd/">trauma</a>. Whether you’re overwhelmed, disconnected, or simply ready to prioritize yourself, you don’t have to do it alone.</p>
    </Split>

    <Prose blocks={whoBlocks} startTone={1} />

    <section class="section is-mist">
      <div class="container">
        <div class="sec-head">
          <h2>Seeking care is a vital form of self-care</h2>
          <p class="lede">Why women’s mental health matters.</p>
        </div>
        <div class="pg-stats" style="--n:3">
          {stats.map(([n, d]) => <div class="pg-stat"><strong>{n}</strong><span>{d}</span></div>)}
        </div>
        <p class="sec-foot">Irritability, emotional numbness, disrupted sleep, chronic stress, or difficulty in relationships can be <a class="inl" href="/post/how-to-know-if-youre-experiencing-trauma/">signs of unresolved trauma</a> or accumulated stress. These are treatable, and you deserve a space where healing is supported.</p>
      </div>
    </section>

    <Split heading="Is this program right for me?" img={W + "sitting-room.webp"} alt="A quiet sitting room at the Westbrook office" reverse>
      <p><strong>The space &amp; support you’ve been looking for.</strong> You may be so used to functioning on autopilot that you’ve stopped checking in with yourself. Consider:</p>
      <CheckList items={questions} icon="heart" />
      <p>If any of these resonate, this program may offer the space and support you’ve been looking for. <a class="inl" href="/admissions/">Take our quick screening</a>.</p>
    </Split>

    <IconCards heading="Even if you’re telling yourself…" lede="You deserve help." items={beliefs.map((b, i) => ({ icon: ["alert", "users", "clock", "shield"][i], t: b, d: "" }))} tone="white">
      <p class="sec-foot">You don’t have to wait until things get worse. Wellness isn’t about comparison, it’s about taking care of yourself because you’re worth it. You’ve carried a lot. You don’t have to carry it alone.</p>
    </IconCards>

    <section class="section is-stone" id="compare">
      <div class="container">
        <div class="sec-head"><h2>Women’s Wellness IOP or Women’s Trauma IOP?</h2><p class="lede">Both are women-only intensive outpatient programs, but they focus on different needs. Women’s Wellness is for mood, anxiety, burnout and life transitions; the <a class="inl" href="/programs/womens-trauma-iop/">Women’s Trauma IOP</a> is for healing from past trauma and PTSD symptoms. If you aren’t sure, our assessment helps you choose.</p></div>
        <div class="pgx-compare">
          <div class="pgx-cmp is-here" style="--c:#b6863c"><small>You’re here</small><h3>Women’s Wellness IOP</h3><ul><li><Icon name="check" class="h-4 w-4" />Anxiety, depression and burnout</li><li><Icon name="check" class="h-4 w-4" />Postpartum and perinatal mood changes</li><li><Icon name="check" class="h-4 w-4" />Life transitions and relationship stress</li><li><Icon name="check" class="h-4 w-4" />Westbrook &amp; Glastonbury, mornings or evenings</li></ul></div>
          <div class="pgx-cmp" style="--c:#5c7c6b"><small>Trauma focus</small><h3><a class="inl" href="/programs/womens-trauma-iop/">Women’s Trauma IOP</a></h3><ul><li><Icon name="check" class="h-4 w-4" />Healing from past trauma and abuse</li><li><Icon name="check" class="h-4 w-4" />PTSD symptoms, nightmares and panic</li><li><Icon name="check" class="h-4 w-4" />Safety, choice and pace set with you</li><li><Icon name="check" class="h-4 w-4" />Evening group in Glastonbury</li></ul></div>
        </div>
      </div>
    </section>

    <!-- 5. What treatment includes -->
    <section class="section is-white">
      <div class="container pg-two">
        <div>
          <h2>What our program offers</h2>
          <p class="lede"><strong>More than just talk therapy.</strong> A trauma-informed, immersive experience designed to help women heal from past and ongoing stress and trauma. You’ll engage in process-based <a class="inl" href="/treatment-methods/group-therapy/">group therapy</a>, individual support, psychoeducation, and wellness activities, expressive arts, guided journaling, yoga-inspired movement, time in nature, somatic therapy, and animal-assisted support, to reconnect with your body, reduce stress, and rebuild trust.</p>
          <p class="lede">It’s grounded in evidence-based treatment: DBT, EMDR, somatic therapies, and Trauma-Focused CBT, with optional medication management, on-call services, and family involvement when helpful.</p>
          <CheckList items={includes} cols={2} />
        </div>
        <Schedule title="Flexible schedule" stat="3 h" note="a day · Monday–Thursday · 8–12 weeks" days={[3, 3, 3, 3, 0, 0, 0]} tone={1} icon="heart" tracks={[["Morning group", "9 AM–12 PM"], ["Evening group", "5–8 PM"]]}>
          <p>Glastonbury: Monday–Thursday, <strong>9 AM–12 PM</strong> or <strong>5–8 PM</strong> · <a class="inl" href="/location/glastonbury-ct-2/">300 Hebron Ave, Suite 212</a>. Westbrook group times confirmed when you call.</p>
        </Schedule>
      </div>
    </section>

    <Prose blocks={includesBlocks} startTone={1} />
    <ModalitiesOutcomes modalities={modalities} outcomes={outcomes} oHeading="What we work on together" note="Plus <a class='inl' href='/programs/medication-management/'>medication management</a> &amp; additional <a class='inl' href='/treatment-methods/therapeutic-treatments/'>therapeutic treatments</a>." tone="white" />
    <Quote text="When we invest in women, we invest in our future." cite="Dr. Kristine Schlichting, Founder" img={P + "group-room-bright.webp"} />
    <Prose blocks={westbrookBlocks} startTone={1} />

    <!-- 6. Meet the team -->
    <Team heading="A Woman-Led Care Team" lede="Compassionate, evidence-based care from clinicians who understand the load women carry, including our Westbrook team lead." slugs={["kaitlyn-czapiga-lmsw", "teesha-huertas-lcsw", "christina-lindsay-pmhnp-bc-aprn", "linda-scillia-pmhnp-bc-aprn", "chelsey-micciche-lpc", "traci-schneider-maatc-lpc-a-atr-p", "dori-bessette-crail-lmft"]} tone="white" />
    <IconCards heading="Care that sees the whole you" lede="Why Hopewell Health Solutions." items={whyHopewell} cols={2} tone="stone" />

    <!-- 7. Testimonials matched to this program -->
    <VideoCarousel videos={stories} mode="grid" tone="navy" heading="Women’s Wellness Stories, in Their Own Words" lede="Women who went through the program share what changed. More conversations on the <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a>." link={{ href: "/testimonials/", label: "Read more patient stories" }} />
    <NewsVideos heading="Trauma in women" lede="As seen on NBC Connecticut. Connecticut’s news outlets turn to our clinicians to talk about women’s mental health and trauma. Watch our team on CT Live! discuss <a class='inl' href='/post/how-womens-trauma-differs-from-mens-and-how-group-therapy-supports-healing/'>why so many women carry trauma</a>, and how the right support makes a difference." videos={[{ id: "uDy-K1dO0Fw", t: "CT Live!: Trauma in Women, Hopewell Health Solutions", outlet: "NBC Connecticut" }]} />

    <!-- 8. Locations -->
    <Locations heading="Where the Women’s Wellness IOP Meets" lede="Women’s Wellness IOP groups meet at our <a class='inl' href='/location/westbrook-ct/'>Westbrook office</a>, 70 Essex Road, and at <a class='inl' href='/location/glastonbury-ct-2/'>300 Hebron Ave, Suite 212, Glastonbury</a> (morning and evening). We serve women from Niantic, Branford, Madison, Guilford and across the shoreline, plus virtual visits statewide." current="westbrook-ct" />

    <!-- 9. Insurance and admissions -->
    <Insurance heading="Insurance for the Women’s Wellness IOP" lede="We accept most major commercial insurances, and TRICARE East is accepted as a PPO plan. Many participants also qualify for <strong>Connecticut Paid Leave or FMLA</strong>. Our team verifies your benefits at no cost, before you commit to anything. Hopewell doesn’t accept Medicare or Medicaid." />

    <!-- Reviews sit last, right above the FAQ (coordinator, 2026-11-16) -->

    <!-- 10. FAQ -->
    <Reviews tone="stone" heading="What Women Say About Hopewell" first={["Women’s Wellness IOP", "IOP"]} />
    <MediaStrip bg="crema" heading="Our clinicians, featured across Connecticut" />
    <Faq faqs={faqs} heading="Women’s Wellness IOP, common questions" tone="white" />

    <!-- 11. Related programs + final CTA -->
    <OtherPrograms current="/programs/womens-wellness-iop/" />
    <FinalCta heading="Ready to take the first step?" lede="Prioritizing your mental health is one of the most powerful, loving choices you can make for yourself. If you’re ready to stop surviving and start healing, we’re here to help." />
  </main>
  <Footer />
</Base>
