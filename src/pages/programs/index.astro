    <!-- 10. FAQ -->
    <Reviews tone="white" heading="What Our Program Clients Say" first={["IOP", "Women’s Wellness IOP"]} />
    <MediaStrip bg="white" />
    <Faq faqs={faqs} heading="Questions About Choosing a Program" tone="stone" />

    <!-- 11. Closing CTA -->
    <ClosingCta heading="Not Sure Which Program Fits? Start Here." lede="Tell us what’s going on, and our Connecticut team will help you find the right level of care, confidentially, with no pressure. Everything you share with us is confidential." image={P + "group-room-bright.webp"} imageAlt="A group room at Hopewell Health Solutions" />
  </main>
  <Footer />
</Base>

<script>
  // Audience chooser tabs (+ hero quick-picks and #hash), and the office filter on the program × office matrix.
  const tabs = document.querySelectorAll<HTMLButtonElement>(".ph-tab");
  const show = (id: string) => {
    tabs.forEach((t) => { const on = t.dataset.tab === id; t.classList.toggle("is-on", on); t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1; });
    document.querySelectorAll<HTMLElement>(".ph-panel").forEach((p) => p.classList.toggle("is-on", p.id === id));
  };
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => show(t.dataset.tab!));
    t.addEventListener("keydown", (e) => { const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0; if (!d) return; const n = tabs[(i + d + tabs.length) % tabs.length]; n.focus(); show(n.dataset.tab!); });
  });
  document.querySelectorAll<HTMLAnchorElement>(".ph-quick a[data-tab]").forEach((a) => a.addEventListener("click", () => show(a.dataset.tab!)));
  const h = location.hash.slice(1);
  if ([...tabs].some((t) => t.dataset.tab === h)) show(h);

  const fbtns = document.querySelectorAll<HTMLButtonElement>(".ph-f");
  fbtns.forEach((b) => b.addEventListener("click", () => {
    fbtns.forEach((x) => { x.classList.toggle("is-on", x === b); x.setAttribute("aria-pressed", String(x === b)); });
    const cols = (b.dataset.cols || "").split(" ").filter(Boolean);
    document.querySelectorAll<HTMLElement>(".ph-mx [data-col]").forEach((c) => { c.hidden = cols.length > 0 && !cols.includes(c.dataset.col!); });
    document.querySelectorAll<HTMLElement>(".ph-mx tbody tr").forEach((r) => { r.hidden = cols.length > 0 && !(r.dataset.at || "").split(" ").some((s) => cols.includes(s)); });
  }));
  // Option A: program chips dim offices that don't run the chosen program.
  const chips = document.querySelectorAll<HTMLButtonElement>(".ob-chip");
  const cards = document.querySelectorAll<HTMLElement>(".ob-card");
  const minis = document.querySelectorAll<HTMLElement>(".ob-mini");
  const status = document.querySelector<HTMLElement>(".ob-status");
  chips.forEach((c) => c.addEventListener("click", () => {
    const id = c.dataset.prog || "";
    chips.forEach((x) => { const on = x === c; x.classList.toggle("is-on", on); x.setAttribute("aria-pressed", String(on)); });
    let n = 0;
    cards.forEach((k) => { const has = !id || (k.dataset.progs || "").split(" ").includes(id); k.classList.toggle("is-off", !has); k.querySelectorAll<HTMLElement>(".ob-progs li").forEach((li) => li.classList.toggle("is-match", !!id && li.dataset.prog === id)); if (has) n++; });
    minis.forEach((m) => m.classList.toggle("is-off", !!id));
    if (!id) n = cards.length + minis.length;
    if (status) status.textContent = id ? `${c.textContent} meets at ${n} ${n === 1 ? "office" : "offices"}` : `Showing all ${n} offices`;
  }));
</script>
