---
// Programs hub — 2026 redesign, Corner Canyon content-rich hub pattern (user, 2026-11-16: "we need content for SEO").
// All live copy kept; each program now explained (who it's for, schedule, what happens), plus a comparison table,
// a typical IOP day, "not sure which program" and a fuller FAQ.
// Adds a "where each program meets" office grid from the client-confirmed program locations (2026-11-16) and a hub FAQ.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Team from "../../components/hw/Team.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import { STORIES } from "../../data/videos.js";
import "../../styles/pages/programs.css";
import "../../styles/pages/hubs.css";

const canonical = "https://www.hopewellhealthsolutions.com/programs/";
const P = "/Assets/hhs-2026/";
const iop = [
  { t: "Intensive Outpatient Program (IOP)", d: "Structured therapy several days a week, while you live at home, work, and parent.", href: "/programs/intensive-outpatient-program/", img: P + "iop-group-room-lights.webp", bar: "#2f76c4", facts: [["calendar", "Mon–Thu · day or evening"], ["users", "Tweens, teens, women & adults"]] },
  { t: "Adult Co-Occurring IOP", d: "IOP for adults facing mental health and co-occurring substance use, together.", href: "/programs/adult-mental-health-iop/", img: P + "php-group-room.webp", bar: "#0b2f55", facts: [["clock", "9 AM–12 PM or 5–8 PM"], ["pin", "300 Hebron Ave & Westbrook"]] },
  { t: "Teen & Tween IOP", d: "After-school support for ages 8–18, with the whole family involved.", href: "/programs/teen-tween-iop/", img: P + "tween-group-room.webp", bar: "#5c7c6b", facts: [["calendar", "After school, Mon–Thu"], ["pin", "1420 Main St, South Glastonbury"]] },
  { t: "Women’s Wellness IOP", d: "Trauma-informed, DBT-based care in a women-only group.", href: "/programs/womens-wellness-iop/", img: P + "group-room-bright.webp", bar: "#b6863c", facts: [["clock", "Morning or evening"], ["pin", "300 Hebron Ave & Westbrook"]] },
  { t: "Women’s Trauma IOP", d: "A women-only group built specifically around trauma and healing.", href: "/programs/womens-trauma-iop/", img: "/Assets/service/trauma-informed-group.webp", bar: "#b6863c", facts: [["clock", "Mon–Thu · 5–8 PM"], ["pin", "300 Hebron Ave"]] },
  { t: "First Responder IOP", d: "Specialized care for police, fire, EMS & dispatch — with people who get it.", href: "/programs/first-responder-iop/", img: "/Assets/service/first-responder-session.webp", bar: "#265489", facts: [["clock", "Mon–Thu · 9 AM–12 PM"], ["shield", "Confidential"]] },
  { t: "Addiction and Substance Use IOP", d: "Addiction treatment with SUD groups and dual-diagnosis care, and a step-down after rehab. In Glastonbury and Westbrook.", href: "/programs/addiction-iop/", img: P + "iop-group-session.webp", bar: "#0b2f55", facts: [["refresh", "Step-down after rehab"], ["pin", "300 Hebron Ave & Westbrook"]] },
];
const more = [
  { t: "Partial Hospitalization (PHP)", d: "Full-day treatment — the highest level of outpatient care, without an inpatient stay.", href: "/programs/partial-hospitalization-program/", img: P + "php-group-room.webp", bar: "#265489", facts: [["clock", "About 6 hours a day, Mon–Fri"], ["pin", "300 Hebron Ave"]] },
  { t: "Medication Management", d: "Expert psychiatric prescribing for ages 4 and up — thoughtful, never one-size-fits-all.", href: "/programs/medication-management/", img: "/Assets/hhs-2026/westbrook-therapy-office.webp", bar: "#5c7c6b", facts: [["pill", "Ages 4 and up"], ["pin", "All six offices"]] },
  { t: "Counseling", d: "Individual, couples & family counseling, in person or by telehealth.", href: "/programs/counseling/", img: P + "westbrook-counseling-office.webp", bar: "#2f76c4", facts: [["users", "Individual, couples & family"], ["pin", "All six offices"]] },
];

// Rich program write-ups (facts from each program page). Images are unique per card.
const details = {
  "/programs/intensive-outpatient-program/": { img: P + "iop-group-room-lights.webp", more: `Our IOPs meet about three hours a day, four days a week (Monday through Thursday), in day or evening tracks, for 8–12 weeks. Days blend DBT skills groups, process groups and individual check-ins, so you build skills while living at home. Learn about the <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program</a>.`, fit: ["Weekly therapy isn’t enough", "You need structure but can keep working or in school", "You’re stepping down from PHP or inpatient care"] },
  "/programs/adult-mental-health-iop/": { img: P + "adult-evening-iop-group.webp", more: `For adults living with depression, anxiety, trauma or mood disorders, often alongside drinking or drug use. Morning (9 AM–12 PM) and evening (5–8 PM) tracks fit around work and family. See the <a class="inl" href="/programs/adult-mental-health-iop/">Adult Co-Occurring IOP</a>.`, fit: ["Adults 18+", "Mental health and substance use together", "Day or evening schedules"] },
  "/programs/teen-tween-iop/": { img: P + "teen-iop-outside.webp", more: `Tweens (ages 8–12) and teens (13–17) meet after school in age-matched groups at our South Glastonbury office, with family sessions and school coordination built in. Read about the <a class="inl" href="/programs/teen-tween-iop/">Teen &amp; Tween IOP</a>.`, fit: ["Anxiety, depression or school refusal", "Kids who need more than weekly therapy", "Families who want to be part of the work"] },
  "/programs/womens-wellness-iop/": { img: P + "group-room-bright.webp", more: `A women-only group grounded in DBT and trauma-informed care, for emotional burnout, anxiety, life transitions and the weight of caring for everyone else. Morning and evening groups at 300 Hebron Ave and Westbrook. Explore the <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a>.`, fit: ["Burnout, stress and anxiety", "Life transitions and postpartum changes", "Women who want a women-only space"] },
  "/programs/womens-trauma-iop/": { img: "/Assets/service/trauma-informed-group.webp", more: `Built around trauma and healing, with EMDR, somatic approaches and trauma-focused CBT in a women-only evening group. Learn about the <a class="inl" href="/programs/womens-trauma-iop/">Women’s Trauma IOP</a>.`, fit: ["Past or ongoing trauma", "PTSD symptoms", "Women who want trauma-specific care"] },
  "/programs/first-responder-iop/": { img: "/Assets/service/first-responder-session.webp", more: `For police, fire, EMS and dispatch carrying the weight of the job, with clinicians who understand the culture, confidentiality and schedules involved. See the <a class="inl" href="/programs/first-responder-iop/">First Responder IOP</a>.`, fit: ["Critical-incident stress and PTSD", "Sleep, anger or drinking that’s changed", "Confidential, peer-informed care"] },
  "/programs/addiction-iop/": { img: P + "iop-group-session.webp", more: `SUD groups, individual therapy and medication support, including <a class="inl" href="/treatment-methods/medication-assisted-treatment/">MAT</a> when it fits, with mental health care alongside it. A step-down for people leaving detox or residential rehab, and a fit for working adults facing problem drinking. See the <a class="inl" href="/programs/addiction-iop/">Addiction and Substance Use IOP</a>.`, fit: ["Alcohol, drug or prescription drug addiction", "Step-down after rehab", "Co-occurring depression, anxiety or trauma"] },
  "/programs/partial-hospitalization-program/": { img: P + "php-group-room.webp", more: `About six structured hours a day, Monday through Friday, at 300 Hebron Ave in Glastonbury, with psychiatry, group and individual therapy. It’s the highest level of outpatient care, without an overnight stay. Learn about the <a class="inl" href="/programs/partial-hospitalization-program/">partial hospitalization program</a>.`, fit: ["Symptoms that make daily life hard to manage", "Stepping down from a hospital stay", "Needing more than IOP right now"] },
  "/programs/medication-management/": { img: P + "south-glastonbury-waiting-room.webp", more: `Board-certified psychiatric nurse practitioners and physician assistants build personalized medication plans and follow up closely, with <a class="inl" href="/treatment-methods/genesight-testing/">GeneSight® testing</a> available. See <a class="inl" href="/programs/medication-management/">medication management</a>.`, fit: ["Ages 4 and up", "Starting or adjusting psychiatric medication", "Pairing medication with therapy"] },
  "/programs/counseling/": { img: P + "east-hampton-therapy-office.webp", more: `Weekly or twice-weekly sessions with a licensed therapist, in person at all six offices or by telehealth, for individuals, couples and families. Explore <a class="inl" href="/programs/counseling/">counseling at Hopewell</a>.`, fit: ["Individual, couples and family therapy", "Ongoing support after a program", "In person or telehealth"] },
};
const compareRows = [
  ["Counseling", "Children, teens, adults, couples & families", "Weekly or twice weekly", "All six offices + telehealth", "/programs/counseling/"],
  ["Medication Management", "Ages 4 and up", "Regular follow-ups", "All six offices + telehealth", "/programs/medication-management/"],
  ["Adult IOP", "Adults 18+", "3 h a day, Mon–Thu, day or evening", "300 Hebron Ave & Westbrook", "/programs/adult-mental-health-iop/"],
  ["Addiction and Substance Use IOP", "Adults with addiction or co-occurring conditions", "3 h a day, several days a week", "300 Hebron Ave & Westbrook", "/programs/addiction-iop/"],
  ["Women’s Wellness IOP", "Women", "Morning or evening, Mon–Thu", "300 Hebron Ave & Westbrook", "/programs/womens-wellness-iop/"],
  ["Women’s Trauma IOP", "Women healing from trauma", "Evenings, Mon–Thu, 5–8 PM", "300 Hebron Ave", "/programs/womens-trauma-iop/"],
  ["Teen & Tween IOP", "Ages 8–17", "After school, Mon–Thu", "1420 Main St, South Glastonbury", "/programs/teen-tween-iop/"],
  ["First Responder IOP", "Police, fire, EMS & dispatch", "Mon–Thu, 9 AM–12 PM", "Ask our team", "/programs/first-responder-iop/"],
  ["Partial Hospitalization (PHP)", "Teens and adults needing full-day care", "About 6 h a day, Mon–Fri", "300 Hebron Ave", "/programs/partial-hospitalization-program/"],
];
const row = (href) => compareRows.find((r) => r[4] === href);
const icons = { "/programs/intensive-outpatient-program/": "calendar", "/programs/adult-mental-health-iop/": "users", "/programs/teen-tween-iop/": "sparkles", "/programs/womens-wellness-iop/": "heart", "/programs/womens-trauma-iop/": "shield", "/programs/first-responder-iop/": "shield", "/programs/addiction-iop/": "link", "/programs/partial-hospitalization-program/": "sun", "/programs/medication-management/": "pill", "/programs/counseling/": "chat" };
const day = [
  ["sun", "Check-in", "Each group opens with a check-in so your clinician knows how you’re doing today."],
  ["compass", "Skills group", "Learn and practice DBT skills: mindfulness, distress tolerance, emotion regulation."],
  ["users", "Process group", "Talk through what’s happening in your life with peers who get it."],
  ["clipboard", "Individual time", "One-on-one check-ins, and medication follow-ups with your prescriber when needed."],
];
const continuum = [
  { t: "Outpatient Therapy", d: "Weekly individual, couples &amp; family sessions", stat: "Weekly", days: [1, 0, 0, 0, 0, 0, 0], tone: 1, icon: "chat" },
  { t: "Intensive Outpatient (IOP)", d: "3 hrs/day · 4 days/week · day or evening", stat: "3 h", days: [3, 3, 3, 3, 0, 0, 0], tone: 2, icon: "calendar" },
  { t: "Partial Hospitalization (PHP)", d: "Full-day care — highest outpatient level", stat: "6 h", days: [6, 6, 6, 6, 6, 0, 0], tone: 3, icon: "sun" },
];
// Client-confirmed program locations (Google Doc "Hopewell Website Updates", 2026-11-16).
const where = [
  { name: "Downtown Glastonbury", addr: "300 Hebron Ave", slug: "glastonbury-ct-2", add: true, items: ["<a class='inl' href='/programs/partial-hospitalization-program/'>PHP</a>", "<a class='inl' href='/programs/adult-mental-health-iop/'>Adult IOP</a> &amp; <a class='inl' href='/programs/addiction-iop/'>addiction IOP</a>", "<a class='inl' href='/programs/womens-wellness-iop/'>Women’s Wellness IOP</a> (morning &amp; evening)", "Therapy &amp; medication management"] },
  { name: "South Glastonbury", addr: "1420 Main St", slug: "glastonbury-ct-3", items: ["<a class='inl' href='/programs/teen-tween-iop/'>Tween &amp; Teen IOP</a>", "Therapy &amp; medication management"] },
  { name: "Westbrook", addr: "70 Essex Rd", slug: "westbrook-ct", add: true, items: ["Adult IOP &amp; addiction IOP", "Women’s Wellness IOP", "Therapy &amp; medication management"] },
  { name: "West Hartford", addr: "1216 Farmington Ave", slug: "west-hartford-ct", items: ["<a class='inl' href='/programs/counseling/'>Therapy</a> &amp; <a class='inl' href='/programs/medication-management/'>medication management</a>"] },
  { name: "East Hampton", addr: "151 E. High St", slug: "east-hampton-ct", items: ["Therapy &amp; medication management"] },
  { name: "Glastonbury (Pratt St)", addr: "33 Pratt St", slug: "glastonbury-ct", items: ["Therapy &amp; medication management"] },
];
const faqs: [string, string][] = [
  ["Which program is right for me?", "It depends on how much support you need right now. Weekly <a class='inl' href='/programs/counseling/'>counseling</a> is the starting point for many people; an <a class='inl' href='/programs/intensive-outpatient-program/'>IOP</a> adds about three hours a day, four days a week; and <a class='inl' href='/programs/partial-hospitalization-program/'>PHP</a> is about six hours a day, Monday through Friday. Our team will help you find the right level of care."],
  ["Can I move between programs?", "Yes. You can step up when you need more support, or step down as you heal, without ever switching teams."],
  ["Do you treat children and teens?", "Yes. We care for ages 4 and up, and our <a class='inl' href='/programs/teen-tween-iop/'>Teen &amp; Tween IOP</a> serves ages 8–17 after school."],
  ["How long do the IOPs last?", "Most of our intensive outpatient programs run 8–12 weeks, about three hours a day, four days a week. Your team reviews progress along the way and plans your step-down to weekly care."],
  ["Can I keep working or going to school?", "Yes. That’s what IOP is designed for. Morning and evening tracks, and after-school groups for tweens and teens, let you get intensive support while keeping up with work, school and family."],
  ["Is there a program just for women?", "Yes. The <a class='inl' href='/programs/womens-wellness-iop/'>Women’s Wellness IOP</a> meets mornings and evenings at 300 Hebron Ave and in Westbrook, and the <a class='inl' href='/programs/womens-trauma-iop/'>Women’s Trauma IOP</a> focuses on healing from trauma."],
  ["Do you take insurance?", "We’re in-network with most major plans, including Aetna, Anthem, Blue Cross Blue Shield, Cigna, ConnectiCare, Harvard Pilgrim, Optum, TRICARE and UnitedHealthcare, and we verify your benefits for free. See <a class='inl' href='/rates-and-insurance-coverage/'>rates &amp; insurance</a>."],
  ["Where are addiction services offered?", "Addiction treatment, including the <a class='inl' href='/programs/addiction-iop/'>Addiction and Substance Use IOP</a>, is offered at our Downtown Glastonbury office (300 Hebron Ave) and our Westbrook office."],
];
const stories = STORIES.slice(0, 6);
const itemList = { "@context": "https://schema.org", "@type": "ItemList", name: "Mental health and addiction programs at Hopewell Health Solutions", itemListElement: [...iop, ...more].map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.t, url: "https://www.hopewellhealthsolutions.com" + c.href })) };
---
<Base title="Mental Health Programs in CT | Hopewell Health Solutions" description="Mental health programs at Hopewell Health Solutions in Connecticut — IOP, PHP, medication management & counseling for children, teens & adults, including specialized women's, teen, first responder & addiction programs. In person & telehealth." canonical={canonical} image={P + "php-group-room.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Programs" }]}
      title="Mental Health Programs in Connecticut"
      lede="A full continuum of care. From weekly counseling to intensive day programs, Hopewell Health Solutions offers a full continuum of outpatient care — so you can step up when you need more support, or step down as you heal, without ever switching teams. Care for children, teens, and adults, in person across Connecticut and by telehealth."
      bullets={["<a class='inl' href='/programs/intensive-outpatient-program/'>IOP</a> tracks for tweens, teens, women, adults &amp; first responders", "<a class='inl' href='/programs/partial-hospitalization-program/'>PHP</a> — full-day care without an inpatient stay", "<a class='inl' href='/programs/addiction-iop/'>Addiction treatment</a> in Glastonbury &amp; Westbrook", "<a class='inl' href='/programs/counseling/'>Counseling</a> &amp; <a class='inl' href='/programs/medication-management/'>medication management</a> at all six offices"]}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "pin", text: "Six Connecticut offices" }]}
      image={P + "php-group-room.webp"}
    />
    <Creds />

    <section class="section is-white" id="iop">
      <div class="container">
        <div class="sec-head"><h2>IOP — built for who you are</h2><p class="lede">Intensive Outpatient Programs. Structured group and individual therapy several days a week — including programs designed around specific people and needs.</p></div>
        <div class="pr-grid">
          {iop.map((c, k) => { const x = details[c.href]; const feat = k === 0; return (
                <article class:list={["pr-card", feat && "is-feature"]} style={`--bar-c:${c.bar ?? "#2f76c4"}`}>
                  <a class="pr-media" href={c.href} tabindex="-1" aria-hidden="true"><img src={x.img} alt="" width="1200" height="900" loading="lazy" /><span class="pr-icon"><Icon name={icons[c.href] ?? "heart"} class="h-6 w-6" /></span></a>
                  <div class="pr-body">
                    <h3><a href={c.href}>{c.t}</a></h3>
                    <p class="pr-lede">{c.d}</p>
                    {row(c.href) && <ul class="pr-facts"><li><Icon name="calendar" class="h-4 w-4" />{row(c.href)[2]}</li><li><Icon name="pin" class="h-4 w-4" />{row(c.href)[3]}</li><li><Icon name="users" class="h-4 w-4" />{row(c.href)[1]}</li></ul>}
                    <p class="pr-more" set:html={x.more} />
                    <div class="pr-fit"><strong>A good fit for</strong><ul>{x.fit.map((f) => <li><Icon name="check" class="h-4 w-4" />{f}</li>)}</ul></div>
                    <a class="btn btn-navy pr-btn" href={c.href}>Explore {c.t.replace(/ \(.*\)/, "")}<Icon name="arrow" /></a>
                  </div>
                </article>
          ); })}
        </div>
      </div>
    </section>

    <section class="section is-mist" id="more">
      <div class="container">
        <div class="sec-head"><h2>Beyond IOP</h2><p class="lede">More levels of care. Whether you need more structure or a lighter touch, there’s a right level of care here.</p></div>
        <div class="pr-grid is-3">
          {more.map((c) => { const x = details[c.href]; const feat = false; return (
                <article class:list={["pr-card", feat && "is-feature"]} style={`--bar-c:${c.bar ?? "#2f76c4"}`}>
                  <a class="pr-media" href={c.href} tabindex="-1" aria-hidden="true"><img src={x.img} alt="" width="1200" height="900" loading="lazy" /><span class="pr-icon"><Icon name={icons[c.href] ?? "heart"} class="h-6 w-6" /></span></a>
                  <div class="pr-body">
                    <h3><a href={c.href}>{c.t}</a></h3>
                    <p class="pr-lede">{c.d}</p>
                    {row(c.href) && <ul class="pr-facts"><li><Icon name="calendar" class="h-4 w-4" />{row(c.href)[2]}</li><li><Icon name="pin" class="h-4 w-4" />{row(c.href)[3]}</li><li><Icon name="users" class="h-4 w-4" />{row(c.href)[1]}</li></ul>}
                    <p class="pr-more" set:html={x.more} />
                    <div class="pr-fit"><strong>A good fit for</strong><ul>{x.fit.map((f) => <li><Icon name="check" class="h-4 w-4" />{f}</li>)}</ul></div>
                    <a class="btn btn-navy pr-btn" href={c.href}>Explore {c.t.replace(/ \(.*\)/, "")}<Icon name="arrow" /></a>
                  </div>
                </article>
          ); })}
        </div>
      </div>
    </section>

    <section class="section is-stone" id="compare">
      <div class="container">
        <div class="sec-head"><h2>Compare our programs</h2><p class="lede">Who each program is for, how often it meets, and where. Every office offers therapy and medication management; addiction treatment is offered at 300 Hebron Ave in Glastonbury and in Westbrook.</p></div>
        <div class="hb-table-wrap">
          <table class="hb-table">
            <thead><tr><th scope="col">Program</th><th scope="col">Who it’s for</th><th scope="col">Schedule</th><th scope="col">Where</th></tr></thead>
            <tbody>{compareRows.map(([t, w, sch, loc, href]) => <tr><th scope="row"><a class="inl" href={href}>{t}</a></th><td>{w}</td><td>{sch}</td><td>{loc}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section is-white" id="day">
      <div class="container">
        <div class="sec-head"><h2>What a day in IOP looks like</h2><p class="lede">Every program follows its own plan, but most IOP days move through the same rhythm. Groups are small and clinician-led, and nothing is shared outside the room.</p></div>
        <ol class="step-grid">
          {day.map(([icon, t, d], i) => <li class="step"><span class="step-dot"><Icon name={icon} /></span><span class="step-num">Part {i + 1}</span><h3>{t}</h3><p>{d}</p>{i < day.length - 1 && <span class="step-arrow" aria-hidden="true"><Icon name="arrow" class="h-4 w-4" /></span>}</li>)}
        </ol>
      </div>
    </section>

    <section class="section is-white" id="continuum">
      <div class="container">
        <div class="sec-head"><h2>Your continuum of care</h2><p class="lede">Move up or down as you heal — one team, one coordinated plan.</p></div>
        <div class="levels-grid">
          {continuum.map((c, i) => (
            <article class={`level-card lv-${c.tone}`}>
              <div class="level-head">
                <div class="level-title"><span class="level-icon"><Icon name={c.icon} class="h-[22px] w-[22px]" /></span><h3>{c.t}</h3></div>
                <p class="level-stat"><strong>{c.stat}</strong><span set:html={c.d} /></p>
                <div class="week" aria-hidden="true">
                  {["M", "T", "W", "T", "F", "S", "S"].map((d, j) => <span class="week-day"><span class="week-track"><span class="week-fill" style={`--h:${(c.days[j] / 6) * 100}%`}></span></span><span class="week-label">{d}</span></span>)}
                </div>
              </div>
              {i < continuum.length - 1 && <span class="level-next" aria-hidden="true"><Icon name="arrow" class="h-5 w-5" /></span>}
            </article>
          ))}
        </div>
        <p class="levels-key"><span class="key-swatch"></span>Hours of care each day in a typical week</p>
      </div>
    </section>

    <section class="section is-stone" id="where">
      <div class="container">
        <div class="sec-head"><h2>Where Each Program Meets</h2><p class="lede">Every office offers therapy and medication management. Day programs meet at the offices below; gold offices also offer addiction treatment.</p></div>
        <div class="pg-where">
          {where.map((o) => (
            <article class:list={["pg-office", o.add && "is-add"]}>
              <header><Icon name="pin" class="h-5 w-5" /><div><h3><a href={`/location/${o.slug}/`}>{o.name}</a></h3><span>{o.addr}</span></div></header>
              <ul>{o.items.map((t) => <li><Icon name="check" class="h-4 w-4" /><span set:html={t} /></li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section is-white" id="unsure">
      <div class="container">
        <div class="hb-unsure">
          <div class="hb-unsure-media"><img src={P + "downtown-glastonbury-entrance.webp"} alt="The entrance to Hopewell's Downtown Glastonbury office" width="1200" height="900" loading="lazy" /></div>
          <div class="hb-unsure-copy">
            <span class="hb-unsure-icon"><Icon name="compass" /></span>
            <h2>Not sure which program fits?</h2>
            <p>That’s normal, and you don’t have to decide alone. A clinical assessment looks at your symptoms, safety, schedule and goals, and our team recommends a starting level of care. If it isn’t the right fit later, you can step up or down without switching teams.</p>
            <p>We’ll also check your insurance for free before you start. See <a class="inl" href="/admissions/">how admissions works</a> or read <a class="inl" href="/admissions/#what-to-expect">what to expect at your first visit</a>.</p>
