---
// /programs/ hub — rebuilt to "Hopewell Programs Page: Content Brief" › Programs hub (2026-11-16).
// Owns: "iop programs in ct", "php vs iop / iop vs php", "signs you need iop / when to go to iop", "does insurance cover
// iop ct" (FAQ), "addiction treatment programs ct"; supports "outpatient mental health ct". Single-program terms stay on
// the program pages. Locations follow src/data/locations.js offers (client-confirmed in the Website Updates doc), which
// overrides the brief's "confirm" rows. Compliance: addiction wording, no outcome/"best" claims, no coverage promise,
// initials-only reviews, real photos only.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import LeadForm from "../../components/LeadForm.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Faq from "../../components/hw/Faq.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import Prose from "../../components/seo/Prose.astro";
import { VIDEOS } from "../../data/videos.js";
import { PHONE } from "../../data/site.js";
import "../../styles/pages/programs.css";
import "../../styles/pages/hubs.css";
import "../../styles/pages/seo.css";

const SITE = "https://www.hopewellhealthsolutions.com";
const canonical = SITE + "/programs/";
const P = "/Assets/hhs-2026/";

// Program finder: grouped by who it's for. loc = filter keys (gl = Glastonbury offices, wb = Westbrook, eh = East
// Hampton, wh = West Hartford). Locations from locations.js offers.
const ALL = ["gl", "wb", "eh", "wh"];
const groups = [
  { id: "adults", t: "Adults", icon: "users", items: [
    { t: "IOP Overview", href: "/programs/intensive-outpatient-program/", img: P + "iop-group-room-lights.webp", who: "Anyone comparing Hopewell’s intensive outpatient programs", level: "IOP · about 3 hours a day", where: "300 Hebron Ave, 1420 Main St (teens) & Westbrook", loc: ["gl", "wb"],
      d: `Structured therapy several days a week, while you live at home, work, and parent. Start with our <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient programs in Connecticut</a> to compare every IOP track.` },
    { t: "Adult Co-Occurring IOP", href: "/programs/adult-mental-health-iop/", img: P + "adult-evening-iop-group.webp", who: "Adults with mental health symptoms and substance use together", level: "IOP · morning or evening", where: "300 Hebron Ave & Westbrook", loc: ["gl", "wb"],
      d: `IOP for adults facing mental health and co-occurring substance use, together. Morning (9 AM–12 PM) and evening (5–8 PM) tracks fit around work and family. See the <a class="inl" href="/programs/adult-mental-health-iop/">Adult Co-Occurring IOP</a>.` },
    { t: "Partial Hospitalization (PHP)", href: "/programs/partial-hospitalization-program/", img: P + "php-group-room.webp", who: "Adults who need daily structured treatment", level: "PHP · highest outpatient level", where: "300 Hebron Ave, Glastonbury", loc: ["gl"],
      d: `Full-day treatment — the highest level of outpatient care, without an inpatient stay. About six structured hours a day, Monday through Friday. Learn about the <a class="inl" href="/programs/partial-hospitalization-program/">partial hospitalization program</a>.` },
  ] },
  { id: "addiction", t: "Addiction", icon: "link", items: [
    { t: "Addiction and Substance Use IOP", href: "/programs/addiction-iop/", img: P + "iop-group-session.webp", who: "Adults with alcohol or drug use; MAT available", level: "IOP", where: "300 Hebron Ave & Westbrook", loc: ["gl", "wb"],
      d: `Addiction treatment with SUD groups and dual-diagnosis care, and a step-down after rehab, with <a class="inl" href="/treatment-methods/medication-assisted-treatment/">medication-assisted treatment (MAT)</a> when it fits. See the <a class="inl" href="/programs/addiction-iop/">addiction IOP</a>.` },
  ] },
  { id: "teens", t: "Teens & children", icon: "sparkles", items: [
    { t: "Teen IOP (13–17)", href: "/programs/teen-iop/", img: P + "teen-iop-outside.webp", who: "Teens 13–17, with family involvement", level: "IOP · after school", where: "1420 Main St, South Glastonbury", loc: ["gl"],
      d: `After-school groups for teenagers working through anxiety, depression, school refusal or self-harm, with family sessions and school coordination. Read about the <a class="inl" href="/programs/teen-iop/">teen IOP</a>.` },
    { t: "Tween IOP (8–12)", href: "/programs/tween-iop/", img: P + "sg-tween-group-room.webp", who: "Children 8–12, with parent involvement", level: "IOP · after school", where: "1420 Main St, South Glastonbury", loc: ["gl"],
      d: `Age-matched groups for younger kids, built around play, skills and parent coaching. Explore the <a class="inl" href="/programs/tween-iop/">tween IOP</a>.` },
  ] },
  { id: "women", t: "Women", icon: "heart", items: [
    { t: "Women’s Wellness IOP", href: "/programs/womens-wellness-iop/", img: P + "group-room-bright.webp", who: "Adult women: anxiety, depression, life transitions, postpartum", level: "IOP · morning or evening", where: "300 Hebron Ave & Westbrook", loc: ["gl", "wb"],
      d: `Trauma-informed, DBT-based care in a women-only group, for burnout, anxiety and the weight of caring for everyone else. See the <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP in Connecticut</a>.` },
    { t: "Women’s Trauma IOP", href: "/programs/womens-trauma-iop/", img: P + "womens-trauma-iop-group-room.webp", who: "Adult women healing from trauma", level: "IOP · evenings", where: "300 Hebron Ave, Glastonbury", loc: ["gl"],
      d: `A women-only group built specifically around trauma and healing, with EMDR, somatic approaches and trauma-focused CBT. Learn about our <a class="inl" href="/programs/womens-trauma-iop/">women’s trauma IOP</a>.` },
  ] },
  { id: "first-responders", t: "First responders", icon: "shield", items: [
    { t: "First Responder IOP", href: "/programs/first-responder-iop/", img: P + "team-300-hebron.webp", who: "Police, fire, EMS, dispatch and other first responders", level: "IOP · Mon–Thu mornings", where: "300 Hebron Ave, Glastonbury", loc: ["gl"],
      d: `Specialized care for police, fire, EMS & dispatch — with people who get it, and clinicians who understand the culture, confidentiality and schedules involved. See the <a class="inl" href="/programs/first-responder-iop/">First Responder IOP</a>.` },
  ] },
  { id: "psychiatry", t: "Psychiatry, TMS & testing", icon: "pill", items: [
    { t: "Medication Management", href: "/programs/medication-management/", img: P + "south-glastonbury-med-waiting-room.webp", who: "Children, teens and adults needing psychiatric evaluation or medication", level: "Outpatient", where: "All six offices", loc: ALL,
      d: `Expert psychiatric prescribing for ages 4 and up — thoughtful, never one-size-fits-all, with <a class="inl" href="/treatment-methods/genesight-testing/">GeneSight® testing</a> available. See <a class="inl" href="/programs/medication-management/">medication management</a>.` },
    { t: "Counseling", href: "/programs/counseling/", img: P + "westbrook-counseling-office.webp", who: "Individual, group, family and DBT therapy; play therapy for kids", level: "Outpatient", where: "All six offices + telehealth", loc: ALL,
      d: `Weekly or twice-weekly sessions with a licensed therapist, in person at all six offices or by telehealth. Explore <a class="inl" href="/programs/counseling/">counseling at Hopewell</a>.` },
    { t: "TMS Therapy", href: "/treatment-methods/tms/", img: P + "tms-neurostar-device.webp", who: "Adults whose depression hasn’t responded to medication and therapy", level: "Outpatient treatment", where: "Glastonbury", loc: ["gl"],
      d: `FDA-cleared, drug-free NeuroStar® treatment for depression. Learn about <a class="inl" href="/treatment-methods/tms/">TMS therapy</a>.` },
    { t: "ADHD & Neuropsychological Testing", href: "/treatment-methods/neuropsychological-testing/", img: P + "tx-east-hampton-office.webp", who: "Children, teens and adults seeking answers about attention, learning or memory", level: "Evaluation", where: "Ask our team", loc: [],
      d: `Thorough evaluations that turn into a clear plan: <a class="inl" href="/treatment-methods/adhd-testing/">ADHD testing</a> and <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a>.` },
  ] },
];
const allItems = groups.flatMap((g) => g.items);

// Which level of care do I need?
const levelRows = [
  ["<a class='inl' href='/programs/partial-hospitalization-program/'>PHP</a>", "About 6 hours a day, Monday–Friday", "Symptoms make it hard to get through the day; stepping down from a hospital stay", "Set with your care team"],
  ["<a class='inl' href='/programs/intensive-outpatient-program/'>IOP</a>", "About 3 hours a day, Monday–Thursday, day or evening", "Weekly therapy isn’t enough, but you can keep up with work, school or family", "Most IOPs run 8–12 weeks"],
  ["<a class='inl' href='/programs/counseling/'>Outpatient</a>", "Weekly or twice-weekly sessions", "Ongoing support, or the step after IOP or PHP", "As long as it helps"],
];
const signs = [
  ["refresh", "Weekly therapy isn’t enough to keep symptoms in check"],
  ["alert", "Anxiety, depression or mood swings are affecting work, school or relationships"],
  ["link", "Drinking or drug use is getting harder to control, or is tangled up with how you feel"],
  ["home", "You’re leaving a hospital stay, detox or residential program and need a next step"],
  ["users", "Your teen is missing school, withdrawing, or struggling more than weekly sessions can address"],
  ["compass", "You’re not sure what level you need. Our assessment helps you decide."],
];

const prose = [
  { id: "level-of-care", h2: "Which Level of Care Do I Need? IOP vs. PHP vs. Outpatient",
    paras: [
      "Mental health and addiction treatment comes in levels, and the right one depends on how much support you need right now — not on how serious your problem “sounds.” At Hopewell Health Solutions, the three outpatient levels are partial hospitalization (PHP), intensive outpatient programs (IOP) and weekly outpatient care. You live at home at every level and go home each day.",
      `The difference comes down to hours and structure. <a class="inl" href="/programs/partial-hospitalization-program/">PHP</a> is the most intensive: about six structured hours a day, Monday through Friday, with group therapy, individual sessions and psychiatric care. An <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program (IOP)</a> meets about three hours a day, four days a week, in morning, evening or after-school tracks, so most people keep working or going to school. Weekly <a class="inl" href="/programs/counseling/">counseling</a> and <a class="inl" href="/programs/medication-management/">medication management</a> are the lightest level and the usual next step after a program.`,
      "Many people move between levels. Someone might start in PHP after a hospital stay, step down to IOP as daily life gets steadier, and then continue with a therapist and prescriber they already know. Because every level is run by the same Connecticut team, nothing restarts when you step up or down.",
    ],
    h3s: [{ h3: "Signs a higher level of care may help", paras: ["The list below isn’t a diagnosis. It describes common reasons people look for IOP or PHP. If several feel familiar, a short conversation with our admissions team is a good next step."] }],
    aside: { type: "table", title: "PHP vs. IOP vs. outpatient", head: ["Level", "Time", "Often a fit when…", "Length"], rows: levelRows } },
];
const prose2 = [
  { id: "program-week", h2: "What a Program Week Looks Like",
    paras: [
      "Every program follows its own plan, but most IOP days move through the same rhythm. Groups are small and clinician-led, and nothing is shared outside the room. A typical day opens with a check-in, moves into a skills group — often DBT skills such as mindfulness, distress tolerance and emotion regulation — and then a process group where you talk through what’s happening in your life with peers who get it.",
      "Individual time is built in. You meet one-on-one with your clinician, and psychiatric providers see you for evaluations and medication follow-ups when medication is part of your plan. In the teen and tween programs, family sessions and school coordination are part of the week, so parents know how to help at home.",
      "Our programs are built around in-person care — real rooms, real groups and clinicians who know your name — with telehealth for some services when coming in isn’t possible. PHP follows the same approach across a longer day, adding more group, individual and psychiatric time.",
    ],
    aside: { type: "img", src: P + "group-room-feelings-wheel.webp", alt: "One of Hopewell’s IOP programs in CT: a group room in Glastonbury", cap: "A Hopewell group room" } },
];

const day = [
  ["sun", "Check-in", "Each group opens with a check-in so your clinician knows how you’re doing today."],
  ["compass", "Skills group", "Learn and practice DBT skills: mindfulness, distress tolerance, emotion regulation."],
  ["users", "Process group", "Talk through what’s happening in your life with peers who get it."],
  ["clipboard", "Individual time", "One-on-one check-ins, and medication follow-ups with your prescriber when needed."],
];

// Testimonials matched to programs: adult IOP, IOP & recovery, parent/teen, Women's Wellness.
const matched = ["uIlSCS7clwE", "7ISgjKEBoZo", "awy7nfDgC0k", "eX6WO-MRdPs"].map((id) => VIDEOS.find((v) => v.yt === id)).filter(Boolean);

// FAQ — the brief's 14 questions; bracketed facts written neutrally or from confirmed site copy.
const faqs: [string, string][] = [
  ["What’s the difference between IOP and PHP?", `Both are structured outpatient programs, and you go home every day. <a class="inl" href="/programs/partial-hospitalization-program/">PHP (partial hospitalization)</a> is the most intensive, meeting most of the day — about six hours, Monday through Friday. An <a class="inl" href="/programs/intensive-outpatient-program/">IOP (intensive outpatient program)</a> meets about three hours a day, four days a week, so it’s easier to fit around work or school.`],
  ["How do I know if I need IOP?", "IOP can help when weekly therapy isn’t enough, symptoms are getting in the way of work, school or relationships, or you’re stepping down from a hospital stay or PHP. Our admissions team will walk you through an assessment to find the right fit."],
  ["What if I’m not sure which program is right for me?", "You don’t have to choose before you call. Tell us what’s going on, and our assessment will recommend a program and location. If a different level of care fits better, we’ll help you find it."],
  ["Can I move between programs?", "Yes. Many people step down from PHP to IOP, then to counseling and medication management as they progress. Your care team plans each step with you, without ever switching teams."],
  ["Do you have programs for addiction?", `Yes. Our <a class="inl" href="/programs/addiction-iop/">Addiction and Substance Use IOP</a> treats alcohol and drug use, and our <a class="inl" href="/programs/adult-mental-health-iop/">Adult Co-Occurring IOP</a> treats mental health and substance use together. <a class="inl" href="/treatment-methods/medication-assisted-treatment/">Medication-assisted treatment (MAT)</a> is available. Addiction care is offered at our 300 Hebron Ave (Glastonbury) and Westbrook offices.`],
  ["Do you have programs for teens and children?", `Yes. Our <a class="inl" href="/programs/teen-iop/">Teen IOP</a> serves ages 13–17 and our <a class="inl" href="/programs/tween-iop/">Tween IOP</a> serves ages 8–12, both with family involvement. We also offer counseling, play therapy and medication management for younger children, ages 4 and up.`],
  ["Are there programs just for women?", `Yes. The <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a> supports women facing anxiety, depression, postpartum challenges and life transitions. The <a class="inl" href="/programs/womens-trauma-iop/">Women’s Trauma IOP</a> focuses on healing from trauma in a women-only group.`],
  ["Do you have a program for first responders?", `Yes. Our <a class="inl" href="/programs/first-responder-iop/">First Responder IOP</a> is built for police, firefighters, EMS, dispatchers and others facing job-related stress and trauma, in a group with peers who understand the work.`],
  ["Can I keep working or going to school during treatment?", "With IOP, usually yes. Morning and evening tracks, and after-school groups for tweens and teens, let many people keep working or attending school. PHP takes most of the day, so most people take time off."],
  ["Are programs in person or online?", "Our programs are built around in-person care, with groups and clinicians you meet face to face. Telehealth is available for some services when coming in isn’t possible."],
  ["How long do programs last?", "It depends on your needs and progress. Most of our intensive outpatient programs run 8–12 weeks, and PHP length is set with your care team. Your team reviews your plan regularly and plans your step-down to weekly care."],
  ["Does insurance cover IOP and PHP?", `Most commercial plans cover IOP and PHP when medically necessary. We verify your benefits for free before you start. Hopewell does not accept Medicare or Medicaid. See <a class="inl" href="/rates-and-insurance-coverage/">rates and insurance</a>.`],
  ["How much does IOP cost?", `Your cost depends on your plan’s deductible, copay and coinsurance. We’ll check your benefits and explain what you can expect to pay before you begin. Read <a class="inl" href="/admissions/">how admissions works</a>.`],
  ["Which locations offer which programs?", `Programs differ by location. PHP, adult IOP, addiction IOP and the Women’s Wellness, Women’s Trauma and First Responder IOPs meet at 300 Hebron Ave in Glastonbury; the Teen &amp; Tween IOP meets at 1420 Main St in South Glastonbury; Westbrook offers adult IOP, addiction IOP and the Women’s Wellness IOP; and every office offers therapy and medication management. See <a class="inl" href="/locations/">all locations</a>.`],
];

const medicalWebPage = {
  "@context": "https://schema.org", "@type": "MedicalWebPage", "@id": canonical + "#webpage", url: canonical,
  name: "Mental Health & Addiction Treatment Programs in Connecticut", description: "Compare in-person IOP, PHP and outpatient programs for adults, teens and women at Hopewell Health Solutions in Connecticut.",
  about: [{ "@type": "MedicalTherapy", name: "Intensive outpatient program" }, { "@type": "MedicalTherapy", name: "Partial hospitalization program" }, { "@type": "MedicalCondition", name: "Substance use disorder" }],
  publisher: { "@type": "MedicalOrganization", "@id": SITE + "/#organization", name: "Hopewell Health Solutions" },
};
const itemList = { "@context": "https://schema.org", "@type": "ItemList", name: "Mental health and addiction treatment programs at Hopewell Health Solutions", itemListElement: allItems.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.t, url: SITE + c.href })) };
---
<Base title="IOP, PHP & Addiction Programs in Connecticut | Hopewell" description="Compare in-person IOP, PHP and outpatient programs for adults, teens and women in Glastonbury, Westbrook, East Hampton and West Hartford, CT. Check coverage." canonical={canonical} image={P + "php-group-room.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(medicalWebPage)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <main class="hw">
    <!-- 1. Hero + form -->
    <ServiceHero
      crumbs={[{ label: "Programs" }]}
      title="Mental Health &amp; Addiction Treatment Programs in Connecticut"
      lede="In-person IOP, PHP and outpatient care for adults, teens and children, with programs in Glastonbury, Westbrook, East Hampton and West Hartford."
      bullets={["<a class='inl' href='/programs/intensive-outpatient-program/'>IOP</a> tracks for tweens, teens, women, adults &amp; first responders", "<a class='inl' href='/programs/partial-hospitalization-program/'>PHP</a> — full-day care without an inpatient stay", "<a class='inl' href='/programs/addiction-iop/'>Addiction IOP</a> in Glastonbury &amp; Westbrook", "<a class='inl' href='/programs/counseling/'>Counseling</a> &amp; <a class='inl' href='/programs/medication-management/'>medication management</a> at all six offices"]}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "pin", text: "Six Connecticut offices" }]}
      image={P + "iop-group-room-lights.webp"}
      keepFormMobile
    >
      <nav class="ph-quick" aria-label="Jump to programs">
        <a href="#adults"><Icon name="users" class="h-4 w-4" />For me</a>
        <a href="#teens"><Icon name="sparkles" class="h-4 w-4" />For my teen or child</a>
        <a href="#addiction"><Icon name="link" class="h-4 w-4" />Drinking or drug use</a>
        <a href="#unsure"><Icon name="compass" class="h-4 w-4" />Not sure yet</a>
      </nav>
    </ServiceHero>

    <!-- 2. As featured in -->
    <Creds />
    <MediaStrip bg="white" />

    <!-- 3. Google reviews -->
    <Reviews heading="What Our Program Clients Say" tone="stone" first={["IOP", "Women’s Wellness IOP"]} />

    <!-- 4. Find your program -->
    <section class="section is-white" id="find">
      <div class="container">
        <div class="sec-head">
          <h2>Find Your Program: IOP Programs in CT, PHP and Outpatient Care</h2>
          <p class="lede">A full continuum of care. From weekly counseling to intensive day programs, Hopewell Health Solutions offers a full continuum of outpatient care — so you can step up when you need more support, or step down as you heal, without ever switching teams. Care for children, teens, and adults, in person across Connecticut and by telehealth. Pick who the care is for, or filter by the office closest to you.</p>
        </div>
        <div class="ph-filter" role="toolbar" aria-label="Filter programs by location">
          <span>Show programs in:</span>
          {[["all", "All locations"], ["gl", "Glastonbury"], ["wb", "Westbrook"], ["eh", "East Hampton"], ["wh", "West Hartford"]].map(([k, l], i) => <button type="button" class:list={["ph-f", i === 0 && "is-on"]} data-f={k} aria-pressed={i === 0 ? "true" : "false"}>{l}</button>)}
        </div>
        {groups.map((g) => (
          <div class="ph-group" id={g.id}>
            <h3 class="ph-gh"><span><Icon name={g.icon} class="h-5 w-5" /></span>{g.t}</h3>
            <div class="ph-cards">
              {g.items.map((c) => (
                <article class="ph-card" data-loc={c.loc.join(" ")}>
                  <a class="ph-media" href={c.href} tabindex="-1" aria-hidden="true"><img src={c.img} alt="" width="1200" height="900" loading="lazy" /></a>
                  <div class="ph-body">
                    <h4><a href={c.href}>{c.t}</a></h4>
                    <p class="ph-who">{c.who}</p>
                    <ul class="ph-facts"><li><Icon name="calendar" class="h-4 w-4" />{c.level}</li><li><Icon name="pin" class="h-4 w-4" />{c.where}</li></ul>
                    <p class="ph-d" set:html={c.d} />
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
        <p class="ph-empty" hidden>No program in this group meets at that office. Choose “All locations,” or <a class="inl" href={PHONE.href}>call us</a> and we’ll find the closest option.</p>
        <p class="sec-foot">Also available: <a class="inl" href="/treatment-methods/medication-assisted-treatment/">medication-assisted treatment (MAT)</a>, care for behavioral addictions such as video game and screen addiction, and <a class="inl" href="/treatment-methods/">evidence-based therapies</a> like DBT and EMDR inside every program.</p>
      </div>
    </section>

    <!-- 5. Which level of care do I need? -->
    <Prose blocks={prose} startTone={1} />
    <section class="section is-stone ph-signs-sec" style="padding-top:0">
      <div class="container">
        <ul class="ph-signs">{signs.map(([icon, t]) => <li><span class="icon-badge"><Icon name={icon} /></span><span>{t}</span></li>)}</ul>
      </div>
    </section>

    <!-- 6. What a program week looks like -->
    <Prose blocks={prose2} startTone={0} />
    <section class="section is-white" style="padding-top:0">
      <div class="container">
        <ol class="step-grid">
          {day.map(([icon, t, d], i) => <li class="step"><span class="step-dot"><Icon name={icon} /></span><span class="step-num">Part {i + 1}</span><h3>{t}</h3><p>{d}</p>{i < day.length - 1 && <span class="step-arrow" aria-hidden="true"><Icon name="arrow" class="h-4 w-4" /></span>}</li>)}
        </ol>
      </div>
    </section>

    <!-- 7. Programs by location -->
    <Locations heading="Programs by Location" lede="Every office offers therapy and medication management. PHP, adult IOP, addiction IOP and the Women’s Wellness IOP meet at 300 Hebron Ave in Glastonbury; the Teen &amp; Tween IOP meets at 1420 Main St in South Glastonbury; Westbrook offers adult IOP, addiction IOP and the Women’s Wellness IOP. We also serve the shoreline, including Niantic, Branford, Madison and Guilford." tone="mist" />

    <!-- 8. Testimonials matched to programs -->
    <VideoCarousel videos={matched} mode="grid" tone="navy" heading="Stories From Each Program" lede="Clients share what our programs were like, labeled by program: adult IOP, IOP and recovery, a teen and his mom, and Women’s Wellness. <a class='inl' href='/testimonials/'>Read more patient stories</a>." link={{ href: "/testimonials/", label: "Read more patient stories" }} />

    <!-- Not sure which program fits? -->
    <section class="section is-white" id="unsure">
      <div class="container">
        <div class="hb-unsure">
          <div class="hb-unsure-media"><img src={P + "downtown-glastonbury-entrance.webp"} alt="The entrance to Hopewell's Downtown Glastonbury office" width="1200" height="900" loading="lazy" /></div>
          <div class="hb-unsure-copy">
            <span class="hb-unsure-icon"><Icon name="compass" /></span>
            <h2>Not sure which program fits?</h2>
            <p>That’s normal, and you don’t have to decide alone. A clinical assessment looks at your symptoms, safety, schedule and goals, and our team recommends a starting level of care. If it isn’t the right fit later, you can step up or down without switching teams.</p>
            <p>We’ll also check your insurance for free before you start. See <a class="inl" href="/admissions/">how admissions works</a> or read <a class="inl" href="/admissions/#what-to-expect">what to expect at your first visit</a>.</p>
            <div class="hb-unsure-ctas"><a href={PHONE.href} class="btn btn-blue"><Icon name="phone" />Call {PHONE.display}</a><a href="#verify-ins" class="btn btn-ghost">Verify my insurance</a></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 9. Insurance and admissions -->
    <Insurance heading="Insurance and Admissions" lede="Three steps: call or send the form, we check your insurance for free, then an assessment and a start date. We’re in-network with most major commercial plans. Hopewell does not accept Medicare or Medicaid, and verifying benefits doesn’t guarantee coverage. See <a class='inl' href='/rates-and-insurance-coverage/'>rates &amp; insurance</a>." mobileForm={false} />

    <!-- 10. FAQ -->
    <Faq faqs={faqs} heading="Questions About Choosing a Program" tone="stone" />

    <!-- 11. Final call to action -->
    <section class="section fc-band">
      <div class="container fc-grid">
        <div>
          <h2>Not Sure Which Program Fits? Start Here.</h2>
          <p class="lede">Tell us what’s going on, and our Connecticut team will help you find the right level of care — confidentially, with no pressure. Forms sent after hours are answered the next business day.</p>
          <a href={PHONE.href} class="btn btn-blue" style="margin-top:22px"><Icon name="phone" />Call {PHONE.display}</a>
          <p class="fc-crisis">In crisis? Call or text <a href="tel:988">988</a>, or call 911. Everything you share with us is confidential.</p>
        </div>
        <div class="fc-form"><LeadForm heading="Check your coverage" sub="Free, confidential insurance check." formId="hhs-final" /></div>
      </div>
    </section>
  </main>
  <a href="#verify" class="hw-sticky-cta" aria-label="Check your coverage"><Icon name="shield" class="h-5 w-5" />Check coverage</a>
  <Footer />
</Base>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>(".ph-f");
  const cards = document.querySelectorAll<HTMLElement>(".ph-card");
  const groupsEl = document.querySelectorAll<HTMLElement>(".ph-group");
  const empty = document.querySelector<HTMLElement>(".ph-empty");
  btns.forEach((b) => b.addEventListener("click", () => {
    const f = b.dataset.f!;
    btns.forEach((x) => { x.classList.toggle("is-on", x === b); x.setAttribute("aria-pressed", String(x === b)); });
    cards.forEach((c) => { c.hidden = f !== "all" && !(c.dataset.loc || "").split(" ").includes(f); });
    let any = false;
    groupsEl.forEach((g) => { const vis = [...g.querySelectorAll<HTMLElement>(".ph-card")].some((c) => !c.hidden); g.hidden = !vis; any = any || vis; });
    if (empty) empty.hidden = any;
  }));
  const sticky = document.querySelector<HTMLElement>(".hw-sticky-cta");
  if (sticky && "IntersectionObserver" in window) {
    const vis = new Set();
    const io = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? vis.add(e.target) : vis.delete(e.target))); sticky.classList.toggle("is-hidden", vis.size > 0); });
    document.querySelectorAll(".lead-card, .fc-form").forEach((f) => io.observe(f));
  }
</script>
