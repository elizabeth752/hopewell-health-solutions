---
import Team from "../../components/hw/Team.astro";
// /programs/ hub — full redesign (user 2026-11-16 "redesign the whole programs page") to the Programs hub brief.
// Owns: "iop programs in ct", "php vs iop / iop vs php", "signs you need iop / when to go to iop", "does insurance cover
// iop ct" (FAQ), "addiction treatment programs ct"; supports "outpatient mental health ct". Single-program terms stay on
// the program pages. Locations follow src/data/locations.js offers (client-confirmed in the Website Updates doc), which
// overrides the brief's "confirm" rows. Compliance: addiction wording, no outcome/"best" claims, no coverage promise,
// initials-only reviews, real photos only.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Faq from "../../components/hw/Faq.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import Prose from "../../components/seo/Prose.astro";
import { VIDEOS } from "../../data/videos.js";
import { PHONE } from "../../data/site.js";
import OfficeFinder from "../../components/hw/OfficeFinder.astro";
import { locations } from "../../data/locations.js";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import "../../styles/pages/programs.css";
import "../../styles/pages/hubs.css";
import "../../styles/pages/seo.css";

const SITE = "https://www.hopewellhealthsolutions.com";
const canonical = SITE + "/programs/";
const P = "/Assets/hhs-2026/";

// Program chooser: one tab per audience. Each panel = a large real photo + program rows (thumb, who, schedule, office).
// Locations from locations.js offers + each program page (Women's Trauma / First Responder IOP: 300 Hebron Ave).
const groups = [
  { id: "adults", t: "Adults", icon: "users", img: P + "iop-group-session.webp", alt: "Adults in an IOP group at Hopewell's Glastonbury office",
    intro: "Structured care for adults 18+ dealing with depression, anxiety, trauma or mood disorders, from several hours a week to full days.", items: [
    { t: "IOP Overview", href: "/programs/intensive-outpatient-program/", img: P + "iop-group-room-lights.webp", who: "Compare every intensive outpatient program", sched: "About 3 hours a day, Mon–Thu", where: "300 Hebron Ave, 1420 Main St & Westbrook",
      d: `Start with our <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient programs in Connecticut</a> to compare every IOP track.` },
    { t: "Adult Co-Occurring IOP", href: "/programs/adult-mental-health-iop/", img: P + "iop-room-group-photo.webp", who: "Mental health and substance use treated together", sched: "9 AM–12 PM or 5–8 PM, Mon–Thu", where: "300 Hebron Ave & Westbrook",
      d: `See the <a class="inl" href="/programs/adult-mental-health-iop/">Adult Co-Occurring IOP</a>, with morning and evening tracks.` },
    { t: "Partial Hospitalization (PHP)", href: "/programs/partial-hospitalization-program/", img: P + "php-group-room.webp", who: "Full-day care without an inpatient stay", sched: "About 6 hours a day, Mon–Fri", where: "300 Hebron Ave, Glastonbury",
      d: `Learn about the <a class="inl" href="/programs/partial-hospitalization-program/">partial hospitalization program</a>, the highest level of outpatient care.` },
  ] },
  { id: "addiction", t: "Addiction", icon: "link", img: P + "westbrook-beach-group.webp", alt: "Clients on the beach near Hopewell's Westbrook office",
    intro: "Addiction treatment for alcohol and drug use, with mental health care built in. Offered at 300 Hebron Ave in Glastonbury and in Westbrook.", items: [
    { t: "Addiction and Substance Use IOP", href: "/programs/addiction-iop/", img: P + "iop-clinicians-group-room.webp", who: "Adults with alcohol or drug use", sched: "Several days a week", where: "300 Hebron Ave & Westbrook",
      d: `SUD groups, dual-diagnosis care and a step-down after rehab. See the <a class="inl" href="/programs/addiction-iop/">Addiction IOP</a>.` },
    { t: "Medication-Assisted Treatment (MAT)", href: "/treatment-methods/medication-assisted-treatment/", img: P + "south-glastonbury-med-waiting-room.webp", who: "Medication plus counseling for opioid and alcohol use", sched: "Alongside your program", where: "300 Hebron Ave & Westbrook",
      d: `<a class="inl" href="/treatment-methods/medication-assisted-treatment/">Medication-assisted treatment</a>, managed by our psychiatric team when it fits.` },
  ] },
  { id: "women", t: "Women", icon: "heart", img: P + "womens-wellness-team.webp", alt: "Hopewell's Women's Wellness IOP team in the group room",
    intro: "Women-only groups led by clinicians who specialize in women’s mental health, for burnout, life transitions, postpartum challenges and trauma.", items: [
    { t: "Women’s Wellness IOP", href: "/programs/womens-wellness-iop/", img: P + "group-room-bright.webp", who: "Anxiety, depression, transitions, postpartum", sched: "9 AM–12 PM or 5–8 PM, Mon–Thu", where: "300 Hebron Ave & Westbrook",
      d: `Trauma-informed, DBT-based care. See the <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP in Connecticut</a>.` },
    { t: "Women’s Trauma IOP", href: "/programs/womens-trauma-iop/", img: P + "womens-trauma-iop-group-room.webp", who: "Adult women healing from trauma", sched: "5–8 PM, Mon–Thu", where: "300 Hebron Ave, Glastonbury",
      d: `EMDR, somatic approaches and trauma-focused CBT in our <a class="inl" href="/programs/womens-trauma-iop/">women’s trauma IOP</a>.` },
  ] },
  { id: "teens", t: "Teens & tweens", icon: "sparkles", img: P + "teen-iop-outside.webp", alt: "Teen IOP group outside Hopewell's South Glastonbury office",
    intro: "After-school programs with family involvement and school coordination, at our South Glastonbury office. Counseling, play therapy and medication management for children 4 and up at every office.", items: [
    { t: "Teen IOP (13–17)", href: "/programs/teen-iop/", img: P + "sg-green-room.webp", who: "Anxiety, depression, school refusal, self-harm", sched: "5–8 PM, Mon–Thu", where: "1420 Main St, South Glastonbury",
      d: `After-school groups with family sessions. Read about the <a class="inl" href="/programs/teen-iop/">Teen IOP</a>.` },
    { t: "Tween IOP (8–12)", href: "/programs/tween-iop/", img: P + "sg-tween-group-room.webp", who: "Play, skills and parent coaching", sched: "4:30–7:30 PM, Mon–Thu", where: "1420 Main St, South Glastonbury",
      d: `Age-matched groups for younger kids. Explore the <a class="inl" href="/programs/tween-iop/">Tween IOP</a>.` },
  ] },
  { id: "first-responders", t: "First responders", icon: "shield", img: P + "team-300-hebron.webp", alt: "Hopewell's team outside the 300 Hebron Ave office in Glastonbury",
    intro: "Specialized care for police, fire, EMS and dispatch, with clinicians who understand the culture, confidentiality and schedules involved.", items: [
    { t: "First Responder IOP", href: "/programs/first-responder-iop/", img: P + "iop-group-room-lights.webp", who: "Police, fire, EMS, dispatch", sched: "9 AM–12 PM, Mon–Thu", where: "300 Hebron Ave, Glastonbury",
      d: `A group with peers who get it. See the <a class="inl" href="/programs/first-responder-iop/">First Responder IOP</a>.` },
  ] },
  { id: "psychiatry", t: "Psychiatry, TMS & testing", icon: "pill", img: P + "tms-neurostar-room.webp", alt: "A NeuroStar TMS treatment room at Hopewell in Glastonbury",
    intro: "Outpatient psychiatry, therapy and specialized treatment, for ongoing care or the step after a program.", items: [
    { t: "Medication Management", href: "/programs/medication-management/", img: P + "south-glastonbury-med-waiting-room.webp", who: "Psychiatric care for ages 4 and up", sched: "Outpatient visits", where: "All six offices",
      d: `Thoughtful prescribing, with <a class="inl" href="/treatment-methods/genesight-testing/">GeneSight® testing</a>. See <a class="inl" href="/programs/medication-management/">medication management</a>.` },
    { t: "Counseling", href: "/programs/counseling/", img: P + "westbrook-counseling-office.webp", who: "Individual, family, group and DBT therapy", sched: "Weekly or twice weekly", where: "All six offices + telehealth",
      d: `A licensed therapist, in person or by telehealth. Explore <a class="inl" href="/programs/counseling/">counseling at Hopewell</a>.` },
    { t: "TMS Therapy", href: "/treatment-methods/tms/", img: P + "tms-neurostar-device.webp", who: "Depression that hasn’t responded to medication", sched: "Outpatient treatment", where: "Glastonbury",
      d: `FDA-cleared, drug-free NeuroStar® treatment. Learn about <a class="inl" href="/treatment-methods/tms/">TMS therapy</a>.` },
    { t: "ADHD & Neuropsychological Testing", href: "/treatment-methods/neuropsychological-testing/", img: P + "tx-east-hampton-office.webp", who: "Attention, learning and memory", sched: "Evaluation", where: "Ask our team",
      d: `<a class="inl" href="/treatment-methods/adhd-testing/">ADHD testing</a> and <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a>.` },
  ] },
];
const allItems = groups.flatMap((g) => g.items);

// Level-of-care timetable (site copy: PHP ~9 AM–3:30 PM Mon–Fri; IOP 3 h Mon–Thu day/evening; teen/tween after school).
const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const tt = [
  { t: "PHP", sub: "Partial hospitalization", hrs: "About 30 h a week", tone: "navy", days: 5, time: "9 AM–3:30 PM", href: "/programs/partial-hospitalization-program/" },
  { t: "IOP · day", sub: "Adults & first responders", hrs: "About 12 h a week", tone: "blue", days: 4, time: "9 AM–12 PM", href: "/programs/intensive-outpatient-program/" },
  { t: "IOP · evening", sub: "Adults & women", hrs: "About 12 h a week", tone: "blue", days: 4, time: "5–8 PM", href: "/programs/intensive-outpatient-program/" },
  { t: "IOP · after school", sub: "Teens & tweens", hrs: "About 12 h a week", tone: "sky", days: 4, time: "4:30–8 PM", href: "/programs/teen-iop/" },
  { t: "Outpatient", sub: "Counseling & medication", hrs: "1–2 sessions a week", tone: "gold", days: 0, time: "", href: "/programs/counseling/" },
];
const levels = [
  { t: "PHP", icon: "sun", fit: "Symptoms make it hard to get through the day, or you’re stepping down from a hospital stay.", len: "Set with your care team", href: "/programs/partial-hospitalization-program/", cta: "About PHP" },
  { t: "IOP", icon: "calendar", fit: "Weekly therapy isn’t enough, but you can keep up with work, school or family.", len: "Most IOPs run 8–12 weeks", href: "/programs/intensive-outpatient-program/", cta: "About IOP" },
  { t: "Outpatient", icon: "chat", fit: "Ongoing support, or the next step after IOP or PHP.", len: "As long as it helps", href: "/programs/counseling/", cta: "About counseling" },
];

// Programs × offices matrix (locations.js offers; trauma + first responder from their program pages).
const offices = locations.map((l) => ({ slug: l.slug, name: l.name.replace("Glastonbury (Pratt St)", "Pratt St, Glastonbury"), offers: l.offers || [], street: l.street, city: l.city }));
const officePhoto = { "glastonbury-ct": "/Assets/locations/glastonbury/exterior.webp", "glastonbury-ct-2": "/Assets/hhs-2026/downtown-glastonbury-sign.webp", "glastonbury-ct-3": "/Assets/hhs-2026/sg-front-desk.webp", "west-hartford-ct": "/Assets/hhs-2026/west-hartford-office.webp", "east-hampton-ct": "/Assets/locations/east-hampton/exterior.webp", "westbrook-ct": "/Assets/hhs-2026/westbrook-sign.webp" };
const progIcon = { "Partial Hospitalization (PHP)": "sun", "Adult Co-Occurring IOP": "users", "Addiction IOP": "link", "Women’s Wellness IOP": "heart", "Women’s Trauma IOP": "shield", "First Responder IOP": "shield", "Teen IOP & Tween IOP": "sparkles", "Counseling": "chat", "Medication Management": "pill" };
const progColor = { "Partial Hospitalization (PHP)": "#265489", "Adult Co-Occurring IOP": "#2f76c4", "Addiction IOP": "#0b2f55", "Women’s Wellness IOP": "#b6863c", "Women’s Trauma IOP": "#b6863c", "First Responder IOP": "#265489", "Teen IOP & Tween IOP": "#5c7c6b", "Counseling": "#5a6b7a", "Medication Management": "#5a6b7a" };
const matrix = [
  { t: "Partial Hospitalization (PHP)", href: "/programs/partial-hospitalization-program/", key: "php" },
  { t: "Adult Co-Occurring IOP", href: "/programs/adult-mental-health-iop/", key: "iop" },
  { t: "Addiction IOP", href: "/programs/addiction-iop/", key: "addiction" },
  { t: "Women’s Wellness IOP", href: "/programs/womens-wellness-iop/", key: "womens" },
  { t: "Women’s Trauma IOP", href: "/programs/womens-trauma-iop/", only: ["glastonbury-ct-2"] },
  { t: "First Responder IOP", href: "/programs/first-responder-iop/", only: ["glastonbury-ct-2"] },
  { t: "Teen IOP & Tween IOP", href: "/programs/teen-iop/", key: "teen-tween" },
  { t: "Counseling", href: "/programs/counseling/", key: "therapy" },
  { t: "Medication Management", href: "/programs/medication-management/", key: "meds" },
].map((r) => ({ ...r, at: offices.map((o) => (r.only ? r.only.includes(o.slug) : o.offers.includes(r.key))) }));
// Option A office section: intensive programs as filter chips; offices split into two tiers.
const intensiveRows = matrix.filter((r) => !["Counseling", "Medication Management"].includes(r.t)).map((r, i) => ({ ...r, id: `p${i}` }));
const withK = offices.map((o, k) => ({ o, k, n: intensiveRows.filter((r) => r.at[k]).length }));
const tierOne = withK.filter((x) => x.n > 0);
const tierTwo = withK.filter((x) => x.n === 0);
const locBySlug = Object.fromEntries(locations.map((l) => [l.slug, l]));
const dirs = (o) => `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${o.street}, ${o.city}, CT ${locBySlug[o.slug]?.zip ?? ""}`.trim())}`;
const fkey = { gl: ["glastonbury-ct", "glastonbury-ct-2", "glastonbury-ct-3"], wb: ["westbrook-ct"], eh: ["east-hampton-ct"], wh: ["west-hartford-ct"] };

const signs = [
  ["refresh", "Weekly therapy isn’t enough to keep symptoms in check"],
  ["alert", "Anxiety, depression or mood swings are affecting work, school or relationships"],
  ["link", "Drinking or drug use is getting harder to control, or is tangled up with how you feel"],
  ["home", "You’re leaving a hospital stay, detox or residential program and need a next step"],
  ["users", "Your teen is missing school, withdrawing, or struggling more than weekly sessions can address"],
  ["compass", "You’re not sure what level you need. Our assessment helps you decide."],
];

const prose = [
  { id: "level-of-care", h2: "Which Level of Care Do I Need? IOP vs. PHP vs. Outpatient",
    paras: [
      "Mental health and addiction treatment comes in levels, and the right one depends on how much support you need right now, not on how serious your problem “sounds.” At Hopewell Health Solutions, the <a class='inl' href='/post/php-vs-iop-which-level-of-care-is-right-for-you/'>three outpatient levels</a> are partial hospitalization (PHP), intensive outpatient programs (IOP) and weekly outpatient care. You live at home at every level and go home each day.",
      `The difference comes down to hours and structure. <a class="inl" href="/programs/partial-hospitalization-program/">PHP</a> is the most intensive: about six structured hours a day, Monday through Friday, with group therapy, individual sessions and psychiatric care. An <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program (IOP)</a> meets about three hours a day, four days a week, in morning, evening or after-school tracks, so most people keep working or going to school. Weekly <a class="inl" href="/programs/counseling/">counseling</a> and <a class="inl" href="/programs/medication-management/">medication management</a> are the lightest level and the usual next step after a program.`,
      "Many people move between levels. Someone might start in PHP after a hospital stay, step down to IOP as daily life gets steadier, and then continue with a therapist and prescriber they already know. Because every level is run by the same Connecticut team, nothing restarts when you step up or down.",
    ],
  },
];
const prose2 = [
  { id: "program-week", h2: "What a Program Week Looks Like",
    paras: [
      "Every program follows its own plan, but most IOP days move through the same rhythm. <a class='inl' href='/treatment-methods/group-therapy/'>Groups</a> are small and clinician-led, and nothing is shared outside the room. A typical day opens with a check-in, moves into a skills group, often <a class='inl' href='/treatment-methods/dbt/'>DBT skills</a> such as mindfulness, distress tolerance and emotion regulation, and then a process group where you talk through what’s happening in your life with peers who get it.",
      "Individual time is built in. You meet one-on-one with your clinician, and psychiatric providers see you for evaluations and medication follow-ups when medication is part of your plan. In the teen and tween programs, family sessions and school coordination are part of the week, so parents know how to help at home.",
      "Our programs are built around <a class='inl' href='/post/the-importance-of-in-person-intensive-outpatient-programs-iops/'>in-person care</a>, real rooms, real groups and clinicians who know your name, with telehealth for some services when coming in isn’t possible. PHP follows the same approach across a longer day, adding more group, individual and psychiatric time.",
    ],
    aside: { type: "img", src: P + "group-room-feelings-wheel.webp", alt: "One of Hopewell’s IOP programs in CT: a group room in Glastonbury", cap: "A Hopewell group room" } },
];

const day = [
  ["sun", "Check-in", "Each group opens with a check-in so your clinician knows how you’re doing today."],
  ["compass", "Skills group", "Learn and practice DBT skills: mindfulness, distress tolerance, emotion regulation."],
  ["users", "Process group", "Talk through what’s happening in your life with peers who get it."],
  ["clipboard", "Individual time", "One-on-one check-ins, and medication follow-ups with your prescriber when needed."],
];

// Testimonials matched to programs: adult IOP, IOP & recovery, parent/teen, Women's Wellness.
const matched = ["uIlSCS7clwE", "7ISgjKEBoZo", "awy7nfDgC0k", "eX6WO-MRdPs"].map((id) => VIDEOS.find((v) => v.yt === id)).filter(Boolean);

// FAQ — the brief's 14 questions; bracketed facts written neutrally or from confirmed site copy.
const faqs: [string, string][] = [
  ["What’s the difference between IOP and PHP?", `Both are structured outpatient programs, and you go home every day. <a class="inl" href="/programs/partial-hospitalization-program/">PHP (partial hospitalization)</a> is the most intensive, meeting most of the day, about six hours, Monday through Friday. An <a class="inl" href="/programs/intensive-outpatient-program/">IOP (intensive outpatient program)</a> meets about three hours a day, four days a week, so it’s easier to fit around work or school.`],
  ["How do I know if I need IOP?", "IOP can help when weekly therapy isn’t enough, symptoms are getting in the way of work, school or relationships, or you’re stepping down from a hospital stay or PHP. Our admissions team will walk you through an <a class='inl' href='/admissions/what-to-expect/'>assessment</a> to find the right fit."],
  ["What if I’m not sure which program is right for me?", "You don’t have to choose before you call. Tell us what’s going on, and our assessment will recommend a program and location. If a different level of care fits better, we’ll help you find it."],
  ["Can I move between programs?", "Yes. Many people step down from PHP to IOP, then to counseling and medication management as they progress. Your care team plans each step with you, without ever switching teams."],
  ["Do you have programs for addiction?", `Yes. Our <a class="inl" href="/programs/addiction-iop/">Addiction and Substance Use IOP</a> treats alcohol and drug use, and our <a class="inl" href="/programs/adult-mental-health-iop/">Adult Co-Occurring IOP</a> treats mental health and substance use together. <a class="inl" href="/treatment-methods/medication-assisted-treatment/">Medication-assisted treatment (MAT)</a> is available. Addiction care is offered at our 300 Hebron Ave (Glastonbury) and Westbrook offices.`],
  ["Do you have programs for teens and children?", `Yes. Our <a class="inl" href="/programs/teen-iop/">Teen IOP</a> serves ages 13–17 and our <a class="inl" href="/programs/tween-iop/">Tween IOP</a> serves ages 8–12, both with family involvement. We also offer counseling, <a class="inl" href="/treatment-methods/therapeutic-treatments/">play therapy</a> and medication management for younger children, ages 4 and up.`],
  ["Are there programs just for women?", `Yes. The <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a> supports women facing anxiety, depression, postpartum challenges and life transitions. The <a class="inl" href="/programs/womens-trauma-iop/">Women’s Trauma IOP</a> focuses on healing from trauma in a women-only group.`],
  ["Do you have a program for first responders?", `Yes. Our <a class="inl" href="/programs/first-responder-iop/">First Responder IOP</a> is built for police, firefighters, EMS, dispatchers and others facing job-related stress and trauma, in a group with peers who understand the work.`],
  ["Can I keep working or going to school during treatment?", "With IOP, usually yes. Morning and evening tracks, and after-school groups for tweens and teens, let many people keep working or attending school. PHP takes most of the day, so most people take time off."],
  ["Are programs in person or online?", "Our programs are built around in-person care, with groups and clinicians you meet face to face. Telehealth is available for some services when coming in isn’t possible."],
  ["How long do programs last?", "It depends on your needs and progress. Most of our intensive outpatient programs run <a class='inl' href='/post/retraining-the-brain-why-our-intensive-outpatient-programs-are-8-12-weeks/'>8–12 weeks</a>, and PHP length is set with your care team. Your team reviews your plan regularly and plans your step-down to weekly care."],
  ["Does insurance cover IOP and PHP?", `Most commercial plans cover IOP and PHP when medically necessary. We verify your benefits for free before you start. Hopewell does not accept Medicare or Medicaid. See <a class="inl" href="/rates-and-insurance-coverage/">rates and insurance</a>.`],
  ["How much does IOP cost?", `Your cost <a class="inl" href="/post/how-much-does-iop-cost-in-connecticut-what-to-expect-with-insurance/">depends on your plan’s deductible, copay and coinsurance</a>. We’ll check your benefits and explain what you can expect to pay before you begin. Read <a class="inl" href="/admissions/">how admissions works</a>.`],
  ["Which locations offer which programs?", `Programs differ by location. PHP, adult IOP, addiction IOP and the Women’s Wellness, Women’s Trauma and First Responder IOPs meet at <a class="inl" href="/location/glastonbury-ct-2/">300 Hebron Ave in Glastonbury</a>; the Teen &amp; Tween IOP meets at <a class="inl" href="/location/glastonbury-ct-3/">1420 Main St in South Glastonbury</a>; <a class="inl" href="/location/westbrook-ct/">Westbrook</a> offers adult IOP, addiction IOP and the Women’s Wellness IOP; and every office offers therapy and medication management. See <a class="inl" href="/locations/">all locations</a>.`],
];

const medicalWebPage = {
  "@context": "https://schema.org", "@type": "MedicalWebPage", "@id": canonical + "#webpage", url: canonical,
  name: "Mental Health & Addiction Treatment Programs in Connecticut", description: "Compare in-person IOP, PHP and outpatient programs for adults, teens and women at Hopewell Health Solutions in Connecticut.",
  about: [{ "@type": "MedicalTherapy", name: "Intensive outpatient program" }, { "@type": "MedicalTherapy", name: "Partial hospitalization program" }, { "@type": "MedicalCondition", name: "Substance use disorder" }],
  publisher: { "@type": "MedicalOrganization", "@id": SITE + "/#organization", name: "Hopewell Health Solutions" },
};
const itemList = { "@context": "https://schema.org", "@type": "ItemList", name: "Mental health and addiction treatment programs at Hopewell Health Solutions", itemListElement: allItems.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.t, url: SITE + c.href })) };
---
<Base title="IOP, PHP & Addiction Programs in Connecticut | Hopewell" description="Compare in-person IOP, PHP and outpatient programs for adults, teens and women in Glastonbury, Westbrook, East Hampton and West Hartford, CT. Check coverage." canonical={canonical} image={P + "iop-group-session.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(medicalWebPage)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <main class="hw">
    <!-- 1. Hero + form -->
    <ServiceHero
      crumbs={[{ label: "Programs" }]}
      title="IOP, PHP &amp; Addiction Programs in Connecticut"
      lede="In-person IOP, PHP and outpatient care for adults, teens and children, with programs in Glastonbury, Westbrook, East Hampton and West Hartford."
      bullets={["<a class='inl' href='/programs/intensive-outpatient-program/'>IOP</a> tracks for tweens, teens, women, adults &amp; first responders", "<a class='inl' href='/programs/partial-hospitalization-program/'>PHP</a>full-day care without an inpatient stay", "<a class='inl' href='/programs/addiction-iop/'>Addiction IOP</a> in Glastonbury &amp; Westbrook", "<a class='inl' href='/programs/counseling/'>Counseling</a> &amp; <a class='inl' href='/programs/medication-management/'>medication management</a> at all six offices"]}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "pin", text: "Six Connecticut offices" }]}
      image={P + "iop-group-session.webp"}
      keepFormMobile
    >
      <nav class="ph-quick" aria-label="Who is the care for?">
        <a href="#find" data-tab="adults"><Icon name="users" class="h-4 w-4" />For me</a>
        <a href="#find" data-tab="teens"><Icon name="sparkles" class="h-4 w-4" />For my teen or child</a>
        <a href="#find" data-tab="addiction"><Icon name="link" class="h-4 w-4" />Drinking or drug use</a>
        <a href="#unsure"><Icon name="compass" class="h-4 w-4" />Not sure yet</a>
      </nav>
    </ServiceHero>

    <!-- 2. As featured in -->
    <Creds />

    <!-- 3. Find your program: audience chooser -->
    <section class="section is-stone" id="find">
      <div class="container">
        <div class="sec-head">
          <h2>Find Your Program: IOP Programs in CT, PHP and Outpatient Care</h2>
          <p class="lede">A full continuum of care. From weekly counseling to intensive day programs, Hopewell Health Solutions offers a full continuum of outpatient care, so you can step up when you need more support, or step down as you heal, without ever switching teams. Care for children, teens, and adults, in person across Connecticut and by telehealth. Start with who the care is for.</p>
        </div>
        <div class="ph-tabs" role="tablist" aria-label="Programs by who they serve">
          {groups.map((g, i) => <button type="button" role="tab" class:list={["ph-tab", i === 0 && "is-on"]} id={`tab-${g.id}`} aria-controls={g.id} aria-selected={i === 0 ? "true" : "false"} data-tab={g.id}><Icon name={g.icon} class="h-5 w-5" />{g.t}</button>)}
        </div>
        {groups.map((g, i) => (
          <div class:list={["ph-panel", i === 0 && "is-on"]} id={g.id} role="tabpanel" aria-labelledby={`tab-${g.id}`}>
            <div class="ph-panel-media">
              <img src={g.img} alt={g.alt} width="1200" height="900" loading={i === 0 ? "eager" : "lazy"} />
              <div class="ph-panel-cap"><span><Icon name={g.icon} class="h-5 w-5" /></span><h3>{g.t}</h3></div>
            </div>
            <div class="ph-panel-body">
              <p class="ph-intro">{g.intro}</p>
              <ul class="ph-rows">
                {g.items.map((c) => (
                  <li class="ph-row">
                    <img src={c.img} alt="" width="1200" height="900" loading="lazy" />
                    <div>
                      <h4><a href={c.href}>{c.t}</a></h4>
                      <p class="ph-who">{c.who}</p>
                      <p class="ph-meta"><span><Icon name="clock" class="h-4 w-4" />{c.sched}</span><span><Icon name="pin" class="h-4 w-4" />{c.where}</span></p>
                      <p class="ph-d" set:html={c.d} />
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Which level of care do I need? -->
    <section class="section is-white" id="level-of-care">
      <div class="container">
        <div class="ph-loc-head">
          <h2>{prose[0].h2}</h2>
          <div class="ph-loc-copy">{prose[0].paras.map((p) => <p set:html={p} />)}</div>
        </div>
        <figure class="ph-tt" aria-label="A typical week at each level of care">
          <div class="ph-tt-row ph-tt-headrow" aria-hidden="true"><span class="ph-tt-lab">Level of care</span>{DAYS.map((d) => <span class="ph-tt-day">{d}</span>)}<span class="ph-tt-hrs">Per week</span></div>
          {tt.map((r) => (
            <div class={`ph-tt-row tt-${r.tone}`}>
              <a class="ph-tt-lab" href={r.href}><strong>{r.t}</strong><small>{r.sub}</small></a>
              {r.days ? DAYS.map((d, k) => k < r.days ? <span class="ph-tt-cell is-on"><span class="sr-only">{d}: </span>{r.time}</span> : <span class="ph-tt-cell is-off"><span class="sr-only">{d}: </span>Off</span>)
                : <span class="ph-tt-cell is-flex">1–2 sessions on the days that work for you, in person or by telehealth</span>}
              <span class="ph-tt-hrs">{r.hrs}</span>
            </div>
          ))}
          <figcaption>A typical week at each level. Times are from our current program schedules; your exact schedule is set at your assessment.</figcaption>
        </figure>
        <div class="ph-levels">
          {levels.map((l) => (
            <article class="ph-level">
              <span class="icon-badge"><Icon name={l.icon} /></span>
              <h3>{l.t}</h3>
              <p class="ph-level-k">Often a fit when</p>
              <p>{l.fit}</p>
              <p class="ph-level-k">Length</p>
              <p>{l.len}</p>
              <a class="ph-level-go" href={l.href}>{l.cta}<Icon name="arrow" class="h-4 w-4" /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section is-mist" id="signs">
      <div class="container ph-signs-grid">
        <div>
          <h2>Signs a Higher Level of Care May Help</h2>
          <p class="lede">The list isn’t a diagnosis. It describes common reasons people look for IOP or PHP. If several feel familiar, a short conversation with our <a class="inl" href="/admissions/">admissions team</a> is a good next step.</p>
          <a href={PHONE.href} class="btn btn-blue"><Icon name="phone" />Call {PHONE.display}</a>
        </div>
        <ul class="ph-signs">{signs.map(([icon, t]) => <li><span class="icon-badge"><Icon name={icon} /></span><span>{t}</span></li>)}</ul>
      </div>
    </section>

    <!-- 5. What a program week looks like -->
    <section class="section is-white" id="program-week">
      <div class="container">
        <div class="ph-week">
          <div class="ph-week-copy">
            <h2>{prose2[0].h2}</h2>
            {prose2[0].paras.map((p) => <p set:html={p} />)}
          </div>
          <div class="ph-week-media"><img src={P + "group-room-feelings-wheel.webp"} alt="One of Hopewell’s IOP programs in CT: a group room in Glastonbury" width="1200" height="900" loading="lazy" /></div>
        </div>
        <ol class="ph-steps">
          {day.map(([icon, t, d], i) => <li><span class="ph-step-top"><span class="icon-badge"><Icon name={icon} /></span><span class="ph-step-n">Part {i + 1}</span></span><h3>{t}</h3><p>{d}</p></li>)}
        </ol>
      </div>
    </section>

    <OfficeFinder />

    <!-- 7. Testimonials matched to programs -->
    <VideoCarousel videos={matched} mode="marquee" tone="navy" heading="Stories From Each Program" lede="Clients share what our programs were like, labeled by program: adult IOP, IOP and recovery, a teen and his mom, and Women’s Wellness. <a class='inl' href='/testimonials/'>Read more patient stories</a>." link={{ href: "/testimonials/", label: "Read more patient stories" }} />

    <!-- 8. Insurance and admissions -->
    <Insurance heading="Insurance and Admissions" lede="Three steps: call or send the form, we check your insurance for free, then an assessment and a start date. We’re in-network with most major commercial plans. Hopewell does not accept Medicare or Medicaid, and verifying benefits doesn’t guarantee coverage. See <a class='inl' href='/rates-and-insurance-coverage/'>rates &amp; insurance</a>." tone="stone" />

    <!-- 9. Reviews, right above the FAQ -->
