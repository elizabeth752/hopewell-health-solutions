const faqs: [string, string][] = [
  ["Who is the Women’s Trauma IOP for?", "Women healing from <a class='inl' href='/what-we-treat/trauma-ptsd/'>trauma</a> — a single event or a series of experiences — who need more support than weekly therapy but don’t require hospitalization. Open to all who identify as women."],
