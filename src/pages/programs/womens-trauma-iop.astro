const offer = [
  { t: "Individual &amp; group therapy", d: "Personal and communal spaces to explore and heal from trauma.", icon: "users" },
  { t: "Creative &amp; expressive therapies", d: "Art, music, and movement sessions as dynamic outlets for expression.", icon: "sparkles" },
  { t: "Psychoeducation &amp; coping skills", d: "Tools and knowledge to manage stress and avoid relapse.", icon: "brain" },
