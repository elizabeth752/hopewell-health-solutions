<Base title="Women's Trauma IOP in Connecticut | Trauma-Informed Care | Hopewell" description="A women-only, trauma-informed intensive outpatient program in Connecticut. Heal from past trauma and PTSD with a team you meet in person. Check coverage." image={P + "iop-group-room-lights.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(svc)} />
  <main class="hw">
    <!-- 1. Hero + form -->
    <ServiceHero
      crumbs={[{ label: "Programs", href: "/programs/" }, { label: "IOP", href: "/programs/intensive-outpatient-program/" }, { label: "Women's Trauma" }]}
      title="Women's Trauma IOP in Connecticut"
      lede="A women-only, trauma-informed intensive outpatient program in Connecticut. Heal from past trauma and PTSD symptoms with a team you meet in person, in a supportive community of women. Rebuild your life, one step at a time."
      bullets={heroUsps}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "clock", text: "Mon–Thu · 5–8 PM" }]}
      image={P + "iop-group-room-lights.webp"}
    >
      <p style="margin-top:18px;font-size:14.5px;color:#b9cbe0">Medically reviewed by <a class="inl" href="/provider/kristine-a-schlichting-ph-d/">Kristine Schlichting, PhD</a></p>
    </ServiceHero>

    <!-- 2. As featured in -->
    <Creds />
    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" />

    <!-- 3. Reviews -->
    <Reviews heading="What Women Say About Hopewell" tone="stone" first={["Women’s Wellness IOP", "IOP"]} />

    <!-- 4. Who it's for -->
    <Split heading="What is trauma?" img={P + "iop-group-room-lights.webp"} alt="A calm Hopewell group room for women's trauma recovery" img2="/Assets/girl%20thinking%20worried.webp" alt2="Understanding trauma and its lasting effects" reverse tone="white">
      <p><strong>Understanding it is the first step.</strong> Trauma can come from a single event, or a series of events or circumstances that feel emotionally or physically harmful or life-threatening — with lasting effects on your functioning and your physical, social, emotional, or spiritual well-being.</p>
      <p>Trauma is deeply personal. Different people react to similar events in very different ways — what one person finds traumatic, another may not. There’s no “right” way to respond, and there’s no shame in needing support. Learn more about <a class="inl" href="/what-we-treat/trauma-ptsd/">trauma &amp; PTSD treatment</a>, and read how <a class="inl" href="/post/how-womens-trauma-differs-from-mens-and-how-group-therapy-supports-healing/">women’s trauma differs from men’s</a>.</p>
    </Split>
    <Prose blocks={whoBlocks} startTone={1} />
    <IconCards heading="Symptoms of trauma to look for" lede="Know the signs. The impact of trauma can be profound and long-lasting, and it shows up differently for everyone — commonly across five areas:" items={symptoms} cols={3} />

    <!-- 5. What treatment includes -->
    <section class="section is-stone">
      <div class="container pg-two">
        <div>
          <h2>A supportive space to heal from trauma</h2>
          <p class="lede"><strong>Welcome.</strong> Our Women’s Trauma IOP — Monday through Thursday, 5:00–8:00 PM — helps women balance life’s responsibilities with their healing journey. It’s a meaningful act of self-care: an opportunity to invest in your well-being while managing daily commitments.</p>
          <p class="lede">Over this 8-week program (extendable based on your needs and progress), you’ll be part of a supportive community focused on recovery from trauma — a proactive approach designed to manage symptoms and help prevent the need for hospitalization or a higher level of care.</p>
        </div>
        <Schedule title="Women’s Trauma IOP week" stat="3 h" note="every evening · Monday–Thursday · 5:00–8:00 PM" days={[3, 3, 3, 3, 0, 0, 0]} tone={3} icon="heart" tracks={[["Evening group", "5:00–8:00 PM at 300 Hebron Ave, Glastonbury"]]} />
      </div>
    </section>
    <IconCards heading="What our program offers" lede="Comprehensive, tailored care. We believe in the power of community and collaborative healing — with step-down support as you transition to less intensive care." items={offer} cols={3} tone="mist" />
    <Prose blocks={includesBlocks} startTone={0} />
    <Quote text="You gain the collective strength of women who understand — and the reassurance that you are not alone on this journey." cite="The value of community in healing" img={P + "group-room-bright.webp"} />
    <IconCards heading="The right care, at the right time" lede="Why now." items={why} cols={2}>
      <p class="sec-foot">Looking for support with mood, anxiety or burnout rather than trauma? Explore our <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a>. Trauma from the job? See our <a class="inl" href="/programs/first-responder-iop/">First Responder IOP</a>.</p>
    </IconCards>

    <!-- 6. Team -->
    <Team heading="Trauma-Informed Clinicians" lede="EMDR, DBT and somatic care from a woman-led team. <a class='inl' href='/about-us/team/'>Meet our full team</a>." slugs={["teesha-huertas-lcsw", "christina-lindsay-pmhnp-bc-aprn", "chelsey-micciche-lpc", "kaitlyn-czapiga-lmsw", "traci-schneider-maatc-lpc-a-atr-p", "dori-bessette-crail-lmft", "erica-schwartz-lcat"]} tone="white" />

    <!-- 7. Testimonials -->
    <VideoCarousel videos={stories} mode="grid" tone="navy" heading="Women’s Stories, in Their Own Words" lede="Women who have been through our IOPs share what changed, in their own words. More conversations on the <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a>." link={{ href: "/testimonials/", label: "Read more patient stories" }} />
    <NewsVideos heading="Trauma in women" lede="As seen on NBC Connecticut. Connecticut’s news outlets turn to our clinicians to talk about women’s mental health and trauma. Watch our team on CT Live! discuss why so many women carry trauma — and how the right support makes a difference." videos={[{ id: "uDy-K1dO0Fw", t: "CT Live!: Trauma in Women — Hopewell Health Solutions", outlet: "NBC Connecticut" }]} />

    <!-- 8. Locations -->
    <Locations heading="Where the Women’s Trauma IOP Meets" lede="The Women’s Trauma IOP is held at <a class='inl' href='/location/glastonbury-ct-2/'>300 Hebron Ave, Glastonbury</a>, with virtual visits statewide. Reach us at <a class='inl' href='tel:8607351448'>(860) 735-1448</a> · <a class='inl' href='mailto:hhs4help@gmail.com'>hhs4help@gmail.com</a>." current="glastonbury-ct-2" />

    <!-- 9. Insurance & admissions -->
    <Insurance heading="Insurance for women’s trauma treatment" lede="The Women’s Trauma IOP is covered by most major commercial insurance plans when medically necessary. Our team verifies your benefits at no cost — before you commit to anything. Hopewell doesn’t accept Medicare or Medicaid." />

    <!-- 10. FAQ -->
    <Faq faqs={faqs} heading="Women’s Trauma IOP — common questions" tone="white" />

    <!-- 11. Related + final CTA -->
    <OtherPrograms current="/programs/womens-trauma-iop/" />
    <FinalCta heading="We’re here for you" lede="If you’re ready to begin your journey to recovery — or just have questions — reach out. We’ll help you rebuild your life, one step at a time, in a supportive and caring environment." />
  </main>
  <Footer />
</Base>
