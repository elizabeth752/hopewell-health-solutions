---
// First Responder IOP — 2026 redesign (Corner Canyon layout). All live copy kept (team bios verbatim).
// KB updates: unsourced "best IOP in the area" tag dropped; insurance wording positive.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import Split from "../../components/programs/Split.astro";
import Quote from "../../components/programs/Quote.astro";
import IconCards from "../../components/programs/IconCards.astro";
import ModalitiesOutcomes from "../../components/programs/ModalitiesOutcomes.astro";
import Schedule from "../../components/programs/Schedule.astro";
import OtherPrograms from "../../components/programs/OtherPrograms.astro";
import { STORIES } from "../../data/videos.js";
import "../../styles/pages/programs.css";

const P = "/Assets/hhs-2026/";
const heroUsps = [
  "Designed by first responders, for first responders",
  "For police, fire, EMS, corrections &amp; 9-1-1 dispatch — current or retired",
  "Mon–Thu · 9 AM–12 PM · ~8 weeks · safe &amp; confidential",
  "CT may compensate you directly during day treatment · FMLA help",
];
const groupTopics = [
  ["Trauma processing", "Discussing specific incidents that have had a significant emotional impact."],
  ["Stress management", "Techniques for managing acute and chronic stress in high-pressure situations."],
  ["Work-life balance", "Strategies for protecting your well-being alongside demanding job responsibilities."],
  ["Peer support", "Building resilience through shared stories and mutual support."],
];
const whyMatters = [
  ["Exposure to trauma", "Regular exposure to traumatic events leads to cumulative stress and emotional fatigue."],
  ["Stigma", "Many fear that seeking help will be seen as weakness or could affect their career."],
  ["Support systems", "Access to counseling and peer support is vital for coping and resilience."],
  ["Self-care", "Mindfulness, physical activity, and hobbies help manage stress."],
  ["Education &amp; training", "Learning the signs of distress — in yourself and colleagues — saves careers and lives."],
];
const conditions = [
  { icon: "cloud", t: "Burnout", d: "Emotional exhaustion, depersonalization (a cynical attitude toward the job and the people you serve), and a reduced sense of personal accomplishment." },
  { icon: "bolt", t: "Acute stress reactions", d: "Anger, irritability, sadness, numbness, nightmares, intrusive thoughts — plus physical effects on sleep, appetite, and energy. Usually begins right after a traumatic event and lasts up to a month." },
  { icon: "alert", t: "PTSI — Post-Traumatic Stress Injury", d: "Nightmares, flashbacks, hypervigilance, chronic pain, headaches, irritability, emotional outbursts, sleep disturbance, and trouble concentrating. Can continue from acute stress or surface six+ months later. See <a class='inl' href='/what-we-treat/trauma-ptsd/'>trauma &amp; PTSD treatment</a>." },
];
const approach = [
  { icon: "heart", t: "Healing beyond words", d: "Experiential therapies help you explore emotions and process trauma in non-verbal, embodied ways — through movement, creative expression, and connection with therapy animals." },
  { icon: "link", t: "Optional family involvement", d: "Healing often means rebuilding relationships. We offer family sessions and psychoeducation to foster understanding and support at home." },
  { icon: "users", t: "A holistic care team", d: "Clinicians, psychiatric providers, and experiential therapists collaborate on a plan aligned with your values, goals, and needs." },
  { icon: "brain", t: "Foundational DBT &amp; CBT skills", d: "Build essential tools in mindfulness, emotion regulation, distress tolerance, interpersonal effectiveness, and cognitive restructuring." },
];
const modalities = [
  { t: "Group therapy grounded in DBT &amp; CBT", icon: "users", href: "/treatment-methods/group-therapy/" },
  { t: "Individual therapy for personalized support", icon: "heart" },
  { t: "Optional medication management &amp; psychiatric care", icon: "pill", href: "/programs/medication-management/" },
  { t: "Psychoeducation", icon: "clipboard" },
];
const ptg = ["Greater appreciation of life", "Improved relationships", "Renewed strength &amp; purpose", "New interests &amp; outlooks", "Reduced anxiety, depression &amp; emotional overwhelm", "Reduced hypervigilance &amp; distressing memories", "Decreased reliance on substances or harmful behaviors"];
const TM = "/Assets/Team%20Members/";
const team = [
  { n: "Christopher Patenaude, PA", role: "Medication Management", href: "/provider/chris-patenaude-pa/", photo: TM + "chris-patenaude-pa.webp", d: "Christopher is a board-certified physician assistant specializing in outpatient psychiatry at Hopewell Health Solutions in Glastonbury and West Hartford. A graduate of Bay Path University, he provides compassionate, evidence-based care for adults with conditions such as ADHD, bipolar disorder, and treatment-resistant depression. He values open communication and collaboration, helping patients build confidence and balance in their mental health journey." },
  { n: "Sherrie Gaudet, LCSW, LADC", role: "Licensed Clinical Social Worker & Addiction Counselor", href: "/provider/sherrie-gaudet-lcsw/", photo: TM + "sherrie-gaudet-lcsw.webp", d: "Sherrie is a holistic, integrative LCSW and Licensed Drug and Alcohol Counselor with more than 23 years of experience across community mental health, correctional settings, and outpatient care. She specializes in trauma, anxiety, depression, and complex co-occurring concerns, blending CBT, DBT, and trauma-informed care with a grounded, strength-based approach." },
  { n: "Tracy Sibley, PMHNP-BC, APRN", role: "Medication Management", href: "/provider/tracy-sibley-pmhnp-bc-aprn/", photo: TM + "tracy-sibley-pmhnp-bc-aprn.webp", d: "Tracy is a board-certified psychiatric mental health nurse practitioner at Hopewell Health Solutions in Glastonbury and West Hartford. She has served as a psychiatric nurse for eight years across acute care, residential, and substance-abuse settings, and provides compassionate medication management for children, teens, and adults." },
];
const faqs: [string, string][] = [
  ["Who is the First Responder IOP for?", "Current or retired first responders 18+ — police officers, firefighters, EMS professionals, corrections officers, and 9-1-1 dispatchers — managing trauma, burnout, acute stress, or PTSI."],
  ["What’s the schedule?", "Monday–Thursday, 9:00 AM–12:00 PM (three hours a day), for about 8 weeks at 300 Hebron Ave, Glastonbury, with ongoing progress evaluations."],
  ["Is it confidential?", "Yes — we provide a safe, confidential space built specifically for first responders, led by clinicians who have served. Seeking support is a mark of strength, not weakness."],
  ["How is it paid for?", "We accept most major insurance, and TRICARE East is accepted as a PPO plan. In some cases the State of Connecticut may compensate you directly while you’re in day treatment, and many qualify for FMLA or CT Paid Leave — our team handles the paperwork."],
];
const stories = STORIES.filter((v) => ["uIlSCS7clwE", "vlKx8J6hykA", "1NnnRKONzhg", "awy7nfDgC0k"].includes(v.yt));
---

<Base title="First Responder IOP in CT | Hopewell Health Solutions" description="A First Responder Intensive Outpatient Program at Hopewell Health Solutions, Glastonbury CT — designed by first responders, for first responders. Trauma, burnout & PTSI care. Mon–Thu, ~8 weeks. TRICARE East accepted as PPO." image="/Assets/service/first-responder-session.webp">
  <Header />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Programs", href: "/programs/" }, { label: "IOP", href: "/programs/intensive-outpatient-program/" }, { label: "First Responder" }]}
      title="First Responder Intensive Outpatient Program (IOP)"
      lede="First Responder IOP · Glastonbury, CT · Now enrolling. Designed by first responders, for first responders."
      bullets={heroUsps}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "shield", text: "Confidential" }]}
      image={P + "php-group-room.webp"}
    >
      <p style="margin-top:18px;font-size:14.5px;color:#b9cbe0">Medically reviewed by <a class="inl" href="/provider/chris-patenaude-pa/">Christopher Patenaude, PA</a></p>
    </ServiceHero>
    <Creds />

    <Split heading="Specialized care for those who answer the call" img="/Assets/service/first-responder-session.webp" alt="A police officer receiving one-on-one support at Hopewell Health Solutions' First Responder IOP">
      <p><strong>By those who serve, for those who serve.</strong> Our First Responder IOP is designed by first responders, for first responders. We understand the unique challenges of those who serve and protect — and we offer specialized care that supports both your mental health and your career longevity.</p>
      <p>In a safe, confidential space, you can process your experiences, learn coping strategies, and grow stronger — personally and professionally. Whether you’re stepping down from inpatient care, need more than weekly therapy, or are navigating work while managing your mental health, <strong>seeking support is a mark of strength.</strong></p>
    </Split>

    <Quote text="Seeking support for your mental health is a mark of strength and self-awareness." img={P + "iop-group-room-lights.webp"} />

    <section class="section is-stone">
      <div class="container pg-two">
        <div>
          <h2>How the program works</h2>
          <p class="lede"><strong>Flexible, compassionate, comprehensive.</strong> Built for first responders 18+, the program runs <strong>Monday–Thursday, 9:00 AM–12:00 PM</strong> (three hours a day) for about 8 weeks, with ongoing progress evaluations and individualized care updates.</p>
          <h3 style="font-size:20px">Common topics in group therapy</h3>
          <div class="pg-cards cols-2">
            {groupTopics.map(([t, d], i) => <div class={`pg-card t-${(i + 1) % 4}`} style="padding:20px"><h3 style="margin-top:0">{t}</h3><p>{d}</p></div>)}
          </div>
        </div>
        <Schedule title="First Responder IOP week" stat="3 h" note="a day · Monday–Thursday · 9:00 AM–12:00 PM" days={[3, 3, 3, 3, 0, 0, 0]} tone={3} icon="shield" tracks={[["About 8 weeks", "With ongoing progress evaluations"], ["300 Hebron Ave, Glastonbury", "Plus virtual visits statewide"]]}>
          <img src="/Assets/service/first-responder-how-it-works.webp" alt="A police officer in a one-on-one therapy session at Hopewell Health Solutions" width="1200" height="800" loading="lazy" style="width:100%;border-radius:16px;aspect-ratio:16/10;object-fit:cover" />
        </Schedule>
      </div>
    </section>

    <section class="section is-navy">
      <div class="container">
        <div class="sec-head"><h2>Why first responder mental health matters</h2><p class="lede"><strong style="color:#fff">It takes a toll.</strong> The stress of emergencies, trauma, and high-pressure situations often leads to PTSD, anxiety, and depression. A culture of openness makes all the difference.</p></div>
        <ol class="pg-why">
          {whyMatters.map(([t, d], i) => <li><span class="n">{i + 1}</span><span><strong set:html={t + "."} /> <Fragment set:html={d} /></span></li>)}
        </ol>
      </div>
    </section>

    <IconCards heading="Is this program right for you?" lede="Make the right choice. For current or retired <strong>police officers, firefighters, EMS professionals, corrections officers, and 9-1-1 dispatchers.</strong> These experiences can lead to:" items={conditions} cols={3} />

    <IconCards heading="A multimodal treatment approach" lede="More than just talk therapy. We blend clinical therapy with creative and relational approaches to promote true mind–body healing." items={approach} tone="mist" />

    <ModalitiesOutcomes mHeading="Modalities used" modalities={modalities} oHeading="Post-traumatic growth" oLede="With the right support, first responders can move beyond survival toward growth — reclaiming the nervous system and finding:" outcomes={ptg} note="Plus <a class='inl' href='/programs/medication-management/'>medication management</a> &amp; experiential therapies." tone="white" />

    <section class="section is-stone">
      <div class="container">
        <div class="sec-head"><h2>Personal, proven, and built from the ground up</h2><p class="lede">Built by people who understand. Our program was created by people who understand exactly what you face.</p></div>
        <div class="pg-people">
          {team.map((m) => (
            <a class="pg-person" href={m.href}>
              <img src={m.photo} alt={m.n} width="600" height="600" loading="lazy" />
              <div class="pg-person-body"><span class="pg-person-role">{m.role}</span><h3>{m.n}</h3><p>{m.d}</p></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <VideoCarousel videos={stories} heading="Stories of Recovery, in Their Own Words" lede="Real conversations about asking for help. Hear more on the <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a>." />

    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" />
    <Reviews heading="What Our IOP Clients Say" first={["IOP"]} />

    <Insurance heading="Most major insurance — TRICARE East accepted as PPO" lede="We accept most major insurance, and TRICARE East is accepted as a PPO plan. <strong>In some cases, the State of Connecticut may compensate you directly while you’re in day treatment</strong>, and many qualify for FMLA or CT Paid Leave. Our team guides you through the process and handles the paperwork." />
    <Locations heading="Our Locations" lede="The First Responder IOP is held at 300 Hebron Ave, Glastonbury · plus virtual visits statewide. Reach us at <a class='inl' href='tel:8607351448'>(860) 735-1448</a> · <a class='inl' href='mailto:hhs4help@gmail.com'>hhs4help@gmail.com</a>." current="glastonbury-ct-2" />
    <Faq faqs={faqs} heading="First Responder IOP — common questions" tone="white" />
    <OtherPrograms current="/programs/first-responder-iop/" />
    <ClosingCta heading="Start your healing journey today" lede="Healing is possible, and you don’t have to do it alone. We walk alongside you with evidence-based tools, compassionate support, and space for real transformation — built by people who’ve been where you are. Not a substitute for inpatient or emergency psychiatric care. If you’re in crisis, call 9-1-1 or go to your nearest emergency room." image="/Assets/service/first-responder-how-it-works.webp" />
  </main>
  <Footer />
</Base>
