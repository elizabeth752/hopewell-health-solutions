const P = "/Assets/hhs-2026/";
const heroUsps = [
  "Care for <a class='inl' href='/what-we-treat/alcohol/'>alcohol</a>, opioids, stimulants &amp; <a class='inl' href='/what-we-treat/prescription-drugs/'>prescription misuse</a>",
  "3–5 sessions a week · 6–8 weeks · live at home, keep working",
  "CBT &amp; <a class='inl' href='/treatment-methods/dbt/'>DBT</a> + relapse-prevention &amp; life-skills training",
