];
const substances = ["<a class='inl' href='/what-we-treat/alcohol/'>Alcohol</a>", "<a class='inl' href='/what-we-treat/prescription-drugs/'>Prescription medications</a>", "Opioids", "Stimulants", "Other illicit substances (see <a class='inl' href='/what-we-treat/drug/'>drug addiction</a>)"];
const components = [
