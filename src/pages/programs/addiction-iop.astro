  "Recovering from a relapse and needing structured treatment",
  "Needing intensive therapy while maintaining work or family responsibilities",
  "Ready to build coping skills and a strong support system for lasting sobriety",
];
// New (client direction): who the addiction IOP serves.
const workingAdults = [
  "Problem drinking that has become harder to control",
  "Functioning alcoholism, keeping up at work while alcohol takes up more of your life",
  "Adult substance use, including prescription medications, opioids and stimulants",
  "<a class='inl' href='/what-we-treat/co-occurring/'>Co-occurring disorders</a>: anxiety, depression or trauma alongside substance use",
];
const benefits = [
  { icon: "swap", t: "Flexibility with structure", d: "Intensive treatment while you maintain daily responsibilities, staying connected with family and work." },
  { icon: "users", t: "Peer support &amp; connection", d: "<a class='inl' href='/treatment-methods/group-therapy/'>Group therapy</a> builds community, with encouragement and shared experience to help sustain recovery." },
  { icon: "shield", t: "Skills for long-term sobriety", d: "Relapse-prevention techniques, stress management, and healthier coping to navigate life without substances." },
];
const modalities = [
  { t: "Cognitive Behavioral Therapy (CBT)", icon: "brain" },
  { t: "Dialectical Behavior Therapy (DBT)", icon: "swap", href: "/treatment-methods/dbt/" },
  { t: "Individual therapy", icon: "heart" },
  { t: "Group therapy", icon: "users", href: "/treatment-methods/group-therapy/" },
  { t: "Relapse-prevention education", icon: "shield" },
  { t: "Life-skills training", icon: "compass" },
];
const stepDown = [
  { icon: "compass", t: "Coming out of inpatient rehab or detox", d: "Keep the structure you built in rehab while you return to home, work, and family. The addiction IOP picks up where residential care leaves off." },
  { icon: "refresh", t: "Stepping down from our addiction PHP", d: "Clients in our <a class='inl' href='/programs/partial-hospitalization-program/'>Partial Hospitalization Program</a> move into the addiction IOP as they stabilize, with the same team and one continuous plan." },
  { icon: "shield", t: "Staying connected after the program", d: "When the IOP ends, outpatient therapy, medication management, and <a class='inl' href='/treatment-methods/medication-assisted-treatment/'>MAT</a> check-ins help protect long-term recovery." },
];
const sudGroups = [
  { icon: "shield", t: "Relapse-prevention group", d: "Spot triggers and high-risk moments early, and build a written plan for them." },
  { icon: "brain", t: "CBT &amp; DBT skills group", d: "Practical skills for cravings, stress, and difficult emotions." },
  { icon: "compass", t: "Life-skills group", d: "Stress management, communication, and goal-setting for life in recovery." },
