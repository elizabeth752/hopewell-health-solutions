];
const outcomes = ["Regain a sense of control", "Work toward lasting recovery", "Healthier coping mechanisms", "A stronger support system"];
const signs = [
  "You drink or use more, or for longer, than you meant to",
  "You’ve tried to cut back and it hasn’t stuck",
  "Cravings, hangovers or withdrawal are getting in the way of work",
  "People close to you have said they’re worried",
  "You’re hiding how much you drink or use",
