// alongside "substance use", highlight step-down care after rehab and the SUD groups patients value, and speak to
// working adults, functioning alcoholism, problem drinking, adult substance use and co-occurring disorders. Addiction
// services only at 300 Hebron Ave (Downtown Glastonbury) and Westbrook. Unsourced "best IOP" tag dropped; insurance
// wording positive.
// 2026-11-16: rebuilt to the "Addiction and Substance Use IOP" content brief (Programs Page Content Brief doc):
// URL /programs/addiction-iop/ (301 from /programs/substance-use-iop/), brief H1/title/meta, signs, substances &
// behaviors, Westbrook + shoreline, supportive accommodations, family, 14-question FAQ. Brief [confirm] items written
// neutrally (detox policy, accommodations details, Westbrook start date).
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
