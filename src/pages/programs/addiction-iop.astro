];
const behaviors = [
  { icon: "bolt", t: "Porn addiction", d: `Compulsive use that harms relationships or mood. Read <a class="inl" href="/post/is-porn-addiction-really-a-problem-why-it-might-be-impacting-your-life-more-than-you-think/">why porn addiction may be affecting your life</a> and <a class="inl" href="/post/does-porn-cause-anxiety-understanding-the-possible-connection/">the link between porn and anxiety</a>.` },
  { icon: "refresh", t: "Scrolling and screen addiction", d: `Hours lost to phones and feeds that crowd out sleep, work and people. See <a class="inl" href="/post/how-to-stop-scrolling-addiction/">how to stop scrolling addiction</a>.` },
  { icon: "sparkles", t: "Video game addiction", d: `Gaming that takes over school, work or family life. For younger people, see our <a class="inl" href="/programs/teen-iop/">teen IOP</a> and <a class="inl" href="/programs/tween-iop/">tween IOP</a>.` },
