  { icon: "swap", t: "Emotion regulation", d: "DBT skills for handling big feelings without shutting down or blowing up." },
  { icon: "cloud", t: "Anxiety &amp; low mood", d: "Practical tools for worry, panic and depression that get in the way of school." },
  { icon: "chat", t: "Communication", d: "Saying what they need, setting limits and repairing conflict with friends and family." },
  { icon: "users", t: "Family relationships", d: "Parents learn the same skills, so home becomes a place where they get practiced." },
];
const outcomes = ["Emotional regulation", "Resiliency", "Healthy coping skills", "Self-discovery"];
const modalities = [
  { t: "Dialectical Behavior Therapy (DBT)", icon: "swap", href: "/treatment-methods/dbt/" },
  { t: "Cognitive Behavioral Therapy (CBT)", icon: "brain" },
  { t: "Art Therapy", icon: "sparkles" },
  { t: "Yoga Therapy", icon: "sun" },
  { t: "Mindfulness", icon: "cloud" },
