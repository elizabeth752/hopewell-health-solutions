const signs = [
  "Pulling away from friends, family or activities they used to enjoy",
  "Falling grades, skipped classes or school refusal",
  "Self-harm, or talk of not wanting to be here (call or text <a class='inl' href='tel:988'>988</a> right away)",
  "Anxiety or depression that weekly therapy isn’t helping enough",
  "Screen time or video games taking over sleep, school and family life",
  "Big mood swings, anger or shutting down at home",
