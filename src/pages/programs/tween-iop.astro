---
// Tween IOP (8–12) — built 2026-11-16 to the "Tween IOP (8–12)" content brief (Programs Page Content Brief doc).
// Brief: "tween iop connecticut" fell out of the top 100. Cause found: the tween content was merged into
// /programs/teen-iop/ in the June rebuild and /programs/tween-iop/ + /tween-iop/ 301'd there, so no page was
// about tweens alone. This page restores a dedicated URL (old redirects now point here).
// Owns "tween iop connecticut", "child iop ct / iop for kids connecticut", "child anxiety treatment ct".
// Facts from the former page: Mon–Thu 4:30–7:30 PM, 1420 Main St Suite 114 (South Glastonbury), 8–12 weeks, parents
// weekly, Parent Support Group Tue + Parent Night Thu. The brief names East Hampton; the client-confirmed office list
// puts Teen & Tween IOP at 1420 Main St only, so that is what the page says.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
