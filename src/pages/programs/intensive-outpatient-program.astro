const faqs: [string, string][] = [
  ["What is an Intensive Outpatient Program (IOP)?", "An IOP provides structured therapeutic care without an overnight stay, individual and group counseling, skills-based psychotherapy, psychiatric <a class='inl' href='/programs/medication-management/'>medication management</a>, and experiential therapies, while you maintain your daily routine at home, work, or school."],
  ["What does the program include, and what’s the schedule?", "Our IOPs meet four times a week (Mon–Thu), day or evening depending on the track. Tweens run 4:30–7:30 PM and teens run 5–8 PM; <a class='inl' href='/programs/womens-wellness-iop/'>Women’s Wellness</a> and Adult Co-Occurring run 9 AM–12 PM or 5–8 PM. Each runs 8–12 weeks and blends DBT, CBT, interpersonal therapy, mindfulness, and expressive therapies (art, music, yoga). Family involvement is encouraged in the tween and teen programs."],
  ["Who can benefit from an IOP?", "Individuals experiencing depression, anxiety, PTSD, self-injury or suicidal thoughts, school refusal, trauma, emotional dysregulation, or substance use. All programs are inclusive and affirming, we welcome everyone regardless of gender identity, sexual orientation, cultural background, or diagnosis."],
  ["What makes Hopewell Health Solutions’ IOPs unique?", "A multidisciplinary team with 10–30 years of experience, customized treatment plans, a holistic approach, and Joint Commission Accreditation, the Gold Seal of Approval."],
  ["Do you accept insurance for the IOP programs?", "Yes, we accept almost all private insurances for all of our IOP programs, and TRICARE East is accepted as a PPO plan. If you have Medicaid / HUSKY, our admissions team can point you to programs that take it."],
  ["How many hours a week is IOP?", "Our IOPs meet about three hours a day, four days a week (Monday–Thursday), in day or evening tracks depending on the program. Your schedule is set during your assessment."],
  ["How long does IOP last?", "Most of our IOPs run <a class='inl' href='/post/retraining-the-brain-why-our-intensive-outpatient-programs-are-8-12-weeks/'>8–12 weeks</a>, depending on progress. Your care team reviews your plan regularly."],
  ["What's the difference between IOP and PHP?", "PHP is more intensive and meets most of the day, about six hours, Monday through Friday. IOP meets fewer hours, so it fits around daily life. Some people start in the <a class='inl' href='/programs/partial-hospitalization-program/'>partial hospitalization program</a> and step down to IOP."],
  ["What conditions does IOP treat?", "Depression, anxiety, trauma, mood disorders and <a class='inl' href='/what-we-treat/co-occurring/'>co-occurring mental health and substance use</a>. We also offer an <a class='inl' href='/programs/addiction-iop/'>addiction IOP</a> and specialty IOPs for teens, tweens, women and first responders."],
  ["Can I work while in IOP?", "Yes, most people do. Morning (9 AM–12 PM), evening (5–8 PM) and after-school tracks are scheduled to make that easier."],
  ["Is IOP in person or online?", "Our IOPs are built around <a class='inl' href='/post/the-importance-of-in-person-intensive-outpatient-programs-iops/'>in-person groups</a>, which is a big part of what makes them work. Telehealth is available for some services when coming in isn’t possible."],
  ["Does insurance cover IOP in Connecticut?", "Most commercial plans cover IOP when it’s medically necessary. We verify your benefits for free. We don’t accept Medicare or Medicaid. See <a class='inl' href='/rates-and-insurance-coverage/'>rates and insurance</a>."],
  ["How much does IOP cost?", "It <a class='inl' href='/post/how-much-does-iop-cost-in-connecticut-what-to-expect-with-insurance/'>depends on your deductible, copay and coinsurance</a>. We’ll explain your expected cost before you start."],
  ["What happens after IOP?", "Many people step down to <a class='inl' href='/programs/counseling/'>counseling</a> and medication management with the same team, so care continues without a gap."],
  ["How do I get started?", "Call us or request a consultation online to schedule an in-person or telehealth evaluation with our <a class='inl' href='/admissions/'>intake team</a>. We’ll help determine which IOP track is the right fit for you or your loved one."],
];
const stories = STORIES.filter((v) => ["awy7nfDgC0k", "uIlSCS7clwE", "x6R6XOZmxUQ", "S_CyYMDqEio", "vlKx8J6hykA"].includes(v.yt));
---

<Base title="Intensive Outpatient Program (IOP) in CT | Hopewell" description="In-person IOP for adults, teens and women in Glastonbury, South Glastonbury and Westbrook, CT. Structured care that fits around work or school. Check coverage." image={P + "iop-group-room-lights.webp"}>
  <Header />
  <main class="hw" data-pgx>
    <ServiceHero
      crumbs={[{ label: "Programs", href: "/programs/" }, { label: "IOP" }]}
      title="Intensive Outpatient Programs (IOP) in Connecticut"
      lede="Intensive outpatient programs in Connecticut · Glastonbury, South Glastonbury &amp; Westbrook · Day &amp; evening. Structured care for tweens, teens, women and adults who need more than weekly therapy, without an overnight stay."
      bullets={heroUsps}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "calendar", text: "Mon–Thu · 8–12 weeks" }]}
      image={P + "iop-group-room-lights.webp"}
    >
      <p style="margin-top:18px;font-size:14.5px;color:#b9cbe0">Medically reviewed by <a class="inl" href="/provider/kristine-a-schlichting-ph-d/">Kristine Schlichting, PhD</a></p>
    </ServiceHero>
    <Creds />

    <Split heading="What is an Intensive Outpatient Program?" img={P + "iop-group-session.webp"} alt="Intensive outpatient program group in Glastonbury, CT" img2={P + "php-group-room.webp"} alt2="A Hopewell group therapy room">
      <p><strong>A higher level of care, on your schedule.</strong> Mental health conditions are common, affecting nearly 23% of adults and 17% of children aged 6–17 in the United States. An Intensive Outpatient Program (IOP) offers structured therapeutic care for those who need <a class="inl" href="/post/iop-vs-outpatient-therapy-which-option-is-right-for-you/">more than weekly therapy</a>, without an overnight stay.</p>
      <p>At Hopewell Health Solutions, our IOPs combine individual and group counseling, skills-based psychotherapy, psychiatric <a class="inl" href="/programs/medication-management/">medication management</a>, and experiential therapies, so you can keep your routine at home, work, or school while you heal.</p>
    </Split>

    <section class="section is-mist" id="tracks">
      <div class="container">
        <div class="sec-head">
          <h2>Choose Your IOP Track</h2>
          <p class="lede">Find your fit. Seven specialty tracks, for adults, addiction, teens, tweens, women and first responders, most meeting Monday–Thursday for 8–12 weeks. Not sure which fits? Our intake team will help you decide.</p>
        </div>
        <ul class="tk-grid">
          {tracks.map((tr) => (
            <li class="tk" style={`--bar:${tr.bar}`}>
              <a class="tk-media" href={tr.href} tabindex="-1" aria-hidden="true"><img src={tr.img} alt="" width="1200" height="900" loading="lazy" /></a>
              <div class="tk-body">
                <h3><a href={tr.href}>{tr.t}</a></h3>
                <p class="tk-d" set:html={tr.d} />
                <ul class="tk-facts">
                  <li><Icon name="users" class="h-4 w-4" />{tr.age}</li>
                  <li><Icon name="calendar" class="h-4 w-4" />{tr.sched}</li>
                  <li><Icon name="pin" class="h-4 w-4" />{tr.loc}</li>
                </ul>
                <a class="tk-go" href={tr.href}>View program<Icon name="arrow" class="h-4 w-4" /></a>
              </div>
            </li>
          ))}
        </ul>
        </div>
      </div>
    </section>

    <Prose startTone={0} blocks={[
      { id: "who-iop-is-for", h2: "Who an Intensive Outpatient Program Is For",
        paras: [
          "An intensive outpatient program is a middle step: more support than a weekly therapy appointment, without leaving home or stepping away from your life for a hospital stay. People usually look for IOP when symptoms are starting to affect work, school or relationships, when weekly sessions aren’t enough to keep things steady, or when they’re stepping down from a hospital stay or a <a class='inl' href='/programs/partial-hospitalization-program/'>partial hospitalization program</a> and want structure while they rebuild routines.",
          "At Hopewell, IOP is built for real schedules. Adults can choose a morning (9 AM–12 PM) or evening (5–8 PM) track, <a class='inl' href='/programs/teen-iop/'>teens</a> and <a class='inl' href='/programs/tween-iop/'>tweens</a> meet after school, and the program runs Monday through Thursday so Fridays and weekends stay open for work, family and rest. Most people keep their job or stay in school throughout treatment.",
          "If you’re not sure IOP is the right level, that’s what the assessment is for. Our admissions team looks at your symptoms, safety, schedule and goals, then recommends a starting point, which might be IOP, PHP or weekly <a class='inl' href='/programs/counseling/'>counseling</a>. You can compare every option on our <a class='inl' href='/programs/'>programs page</a>.",
        ],
        aside: { type: "points", title: "IOP is often a fit when…", items: [["refresh", "Weekly therapy isn’t enough anymore"], ["alert", "Symptoms affect work, school or relationships"], ["home", "You’re stepping down from a hospital stay or PHP"], ["calendar", "You need care that fits around daily life"]] } },
      { id: "iop-for-depression", h2: "IOP for Depression in Connecticut",
        paras: [
          "Depression is one of the most common reasons people join an IOP at Hopewell. When low mood, exhaustion, hopelessness or loss of interest start to crowd out daily life, and <a class='inl' href='/post/iop-for-depression-in-connecticut-when-outpatient-treatment-is-enough/'>weekly therapy hasn’t been enough</a> to turn things around, an intensive outpatient program adds the structure and skills practice that can help you regain momentum.",
          "In IOP for depression, you build skills in small groups using DBT and CBT, practice them between sessions, and work one-on-one with a clinician. When medication is part of your plan, our psychiatric providers manage it alongside therapy through <a class='inl' href='/programs/medication-management/'>medication management</a>, and <a class='inl' href='/treatment-methods/genesight-testing/'>GeneSight® testing</a> can help guide medication choices.",
          "For depression that hasn’t responded to medication and therapy, Hopewell also offers <a class='inl' href='/treatment-methods/tms/'>TMS therapy</a> in Glastonbury. Learn more about <a class='inl' href='/what-we-treat/depression/'>depression treatment</a>, including care for postpartum depression.",
        ],
        aside: { type: "img", src: P + "iop-team-hallway.webp", alt: "Members of Hopewell's intensive outpatient program team in Glastonbury, CT", cap: "Part of our IOP clinical team" } },
      { id: "what-iop-includes", h2: "What Our IOP Includes",
        paras: [
          "Every Hopewell IOP combines <a class='inl' href='/treatment-methods/group-therapy/'>group therapy</a>, individual sessions and psychiatric care, coordinated by one multidisciplinary team. Groups are small and clinician-led and use <a class='inl' href='/treatment-methods/dbt/'>dialectical behavior therapy (DBT)</a>, cognitive behavioral therapy (CBT), interpersonal therapy and mindfulness, with expressive therapies such as art, music and yoga built into the week.",
          "Psychiatric evaluation and <a class='inl' href='/programs/medication-management/'>medication management</a> are available inside the program, so therapy and medication are planned together. In the teen and tween tracks, family involvement is encouraged, with parent sessions and school coordination. Adults working on drinking or drug use can join the <a class='inl' href='/programs/adult-mental-health-iop/'>Adult Co-Occurring IOP</a> or the <a class='inl' href='/programs/addiction-iop/'>addiction IOP</a> at our 300 Hebron Ave and Westbrook offices.",
          "When IOP ends, care doesn’t stop. Most people step down to <a class='inl' href='/programs/counseling/'>weekly counseling</a> and medication management with the same team, so there’s no gap between programs.",
        ],
        aside: { type: "table", title: "IOP at a glance", head: ["", "Hopewell IOP"], rows: [["Schedule", "About 3 hours a day, Mon–Thu"], ["Tracks", "Morning, evening & after school"], ["Length", "Most programs run 8–12 weeks"], ["Format", "In person, telehealth for some services"], ["Where", "300 Hebron Ave, 1420 Main St & Westbrook"]] } },
    ]} />

    <section class="section is-white">
      <div class="container pg-two">
        <div>
          <h2>Who can benefit from an IOP?</h2>
          <p class="lede">Who it’s for:</p>
          <CheckList items={whoBenefit} cols={2} />
          <p class="lede">We welcome all individuals, regardless of gender identity, sexual orientation, cultural background, or diagnosis. Every program is <a class="inl" href="/post/lgbtq-inclusivity-in-behavioral-health-treatment/">inclusive and affirming</a>.</p>
        </div>
        <div class="pg-media"><img src={P + "group-room-bright.webp"} alt="A Hopewell IOP group room" width="1200" height="900" loading="lazy" /></div>
      </div>
    </section>

    <IconCards heading="What makes our IOPs unique" lede="Setting the standard for IOP care." items={unique} tone="stone" />

    <ModalitiesOutcomes mHeading="Modalities used in our IOPs" modalities={modalities} outcomes={outcomes} tone="white" />

    <VideoCarousel videos={stories} heading="IOP Stories, in Their Own Words" lede="Teens, women and adults share what our Intensive Outpatient Programs were like. Hear the full conversations on the <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a>." />

    <NewsVideos heading="Helping children, teens &amp; families" lede="As seen on Connecticut news. Connecticut’s news outlets turn to our clinicians for guidance on teen and family mental health. Watch Dr. Kristine Schlichting and our team share how the right support changes lives." videos={[{ id: "GJeVqHhooBA", t: "Hopewell Health Solutions, helping children, teens & families", outlet: "WFSB Channel 3" }]} />

    <Team heading="Meet Your IOP Team" lede="Board-certified psychiatric providers, licensed counselors, psychologists, social workers and expressive therapists. <a class='inl' href='/about-us/team/'>Meet our full team</a>." slugs={["teesha-huertas-lcsw", "eric-schwartz-psy-d-abpp", "tracy-sibley-pmhnp-bc-aprn", "chelsey-micciche-lpc", "kaitlyn-czapiga-lmsw", "viviana-alvarado-lpc-a", "traci-schneider-maatc-lpc-a-atr-p"]} tone="white" />

    <Insurance heading="Almost all private insurance, TRICARE East accepted as PPO" lede="We accept almost all private insurance plans for our IOP programs, and TRICARE East is accepted as a PPO plan. Our admissions team verifies your benefits at no cost, before you commit to anything." />
    <Locations heading="IOP Locations Near You" lede="Adult &amp; Women’s tracks at <a class='inl' href='/location/glastonbury-ct-2/'>300 Hebron Ave</a> · Tween &amp; Teen tracks at <a class='inl' href='/location/glastonbury-ct-3/'>1420 Main St, Glastonbury</a> · Adult and Women’s Wellness IOP also at our <a class='inl' href='/location/westbrook-ct/'>Westbrook office</a>. Reach us at <a class='inl' href='tel:8607351448'>(860) 735-1448</a> · <a class='inl' href='mailto:hhs4help@gmail.com'>hhs4help@gmail.com</a>." current="glastonbury-ct-2" />
    <Reviews tone="white" heading="What Our IOP Clients Say" first={["IOP", "Women’s Wellness IOP"]} />
    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" />
    <Faq faqs={faqs} heading="IOP, common questions" tone="stone" />
    <OtherPrograms current="/programs/intensive-outpatient-program/" />
    <ClosingCta heading="Find the right IOP track" lede="Call us or request a consultation and our intake team will help determine which IOP is the right fit for you or your loved one, in person or by telehealth." image={P + "group-room-feelings-wheel.webp"} />
  </main>
  <Footer />
</Base>
