  { t: "Addiction and Substance Use IOP", d: "Addiction treatment for alcohol and drug use, with MAT when it fits.", age: "Adults 18+", sched: "Several days a week", loc: "300 Hebron Ave, Glastonbury & Westbrook", href: "/programs/addiction-iop/", img: P + "iop-group-session.webp", bar: "#265489" },
  { t: "Teen IOP", d: "After-school groups for teens, with family sessions and school coordination.", age: "Ages 13–17", sched: "Mon–Thu · 5:00–8:00 PM", loc: "1420 Main St, Glastonbury", href: "/programs/teen-iop/", img: P + "teen-iop-outside.webp", bar: "#2f76c4" },
