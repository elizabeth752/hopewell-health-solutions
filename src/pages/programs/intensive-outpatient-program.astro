const stories = STORIES.filter((v) => ["awy7nfDgC0k", "uIlSCS7clwE", "x6R6XOZmxUQ", "S_CyYMDqEio", "vlKx8J6hykA"].includes(v.yt));
---

<Base title="Intensive Outpatient Programs (IOP) in CT | Hopewell Health Solutions" description="Intensive Outpatient Programs (IOP) at Hopewell Health Solutions, Glastonbury CT — tween, teen, women's & adult tracks. DBT-based, day & evening. Joint Commission Accredited." image={P + "iop-group-room-lights.webp"}>
  <Header />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Programs", href: "/programs/" }, { label: "IOP" }]}
      title="Intensive Outpatient Programs (IOP) in Connecticut"
      lede="Intensive Outpatient Programs · Glastonbury, CT · Day &amp; evening. Structured care for tweens, teens, women and adults who need more than weekly therapy, without an overnight stay."
      bullets={heroUsps}
      facts={[{ icon: "star", text: "4.8 · 368 Google reviews" }, { icon: "calendar", text: "Mon–Thu · 8–12 weeks" }]}
      image={P + "iop-group-room-lights.webp"}
    >
      <p style="margin-top:18px;font-size:14.5px;color:#b9cbe0">Medically reviewed by <a class="inl" href="/provider/kristine-a-schlichting-ph-d/">Kristine Schlichting, PhD</a></p>
    </ServiceHero>
    <Creds />

    <Split heading="What is an Intensive Outpatient Program?" img={P + "iop-group-session.webp"} alt="Intensive outpatient program group in Glastonbury, CT" img2={P + "php-group-room.webp"} alt2="A Hopewell group therapy room">
      <p><strong>A higher level of care, on your schedule.</strong> Mental health conditions are common — affecting nearly 23% of adults and 17% of children aged 6–17 in the United States. An Intensive Outpatient Program (IOP) offers structured therapeutic care for those who need more than weekly therapy, without an overnight stay.</p>
      <p>At Hopewell Health Solutions, our IOPs combine individual and group counseling, skills-based psychotherapy, psychiatric <a class="inl" href="/programs/medication-management/">medication management</a>, and experiential therapies — so you can keep your routine at home, work, or school while you heal.</p>
    </Split>

    <section class="section is-mist" id="tracks">
      <div class="container">
        <div class="sec-head">
          <h2>Choose your IOP track</h2>
          <p class="lede">Find your fit. Four age-specific tracks, each meeting Monday–Thursday for 8–12 weeks. Not sure which fits? Our intake team will help you decide.</p>
        </div>
        <div class="pc-grid cols-4">
          {tracks.map((tr) => (
            <a href={tr.href} class="pc" style={`--bar:${tr.bar}`}>
              <span class="pc-media"><img src={tr.img} alt="" width="1200" height="900" loading="lazy" /><span class="pc-title">{tr.t}</span></span>
              <span class="pc-body">
                <span class="pc-t-m">{tr.t}</span>
                <span class="pc-facts" style="border-top:0;padding-top:0">
                  <span><Icon name="users" class="h-4 w-4" />{tr.age}</span>
                  <span><Icon name="calendar" class="h-4 w-4" />{tr.sched}</span>
                  <span><Icon name="pin" class="h-4 w-4" />{tr.loc}</span>
                </span>
                <span class="pc-go">Explore {tr.t}<Icon name="arrow" class="h-4 w-4" /></span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section is-white">
      <div class="container pg-two">
        <div>
          <h2>Who can benefit from an IOP?</h2>
          <p class="lede">Who it’s for:</p>
          <CheckList items={whoBenefit} cols={2} />
          <p class="lede">We welcome all individuals, regardless of gender identity, sexual orientation, cultural background, or diagnosis. Every program is inclusive and affirming.</p>
        </div>
        <div class="pg-media"><img src={P + "group-room-bright.webp"} alt="A Hopewell IOP group room" width="1200" height="900" loading="lazy" /></div>
      </div>
    </section>

    <IconCards heading="What makes our IOPs unique" lede="Setting the standard for IOP care." items={unique} tone="stone" />

    <ModalitiesOutcomes mHeading="Modalities used in our IOPs" modalities={modalities} outcomes={outcomes} tone="white" />

    <VideoCarousel videos={stories} heading="IOP Stories, in Their Own Words" lede="Teens, women and adults share what our Intensive Outpatient Programs were like. Hear the full conversations on the <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a>." />

    <NewsVideos heading="Helping children, teens &amp; families" lede="As seen on Connecticut news. Connecticut’s news outlets turn to our clinicians for guidance on teen and family mental health. Watch Dr. Kristine Schlichting and our team share how the right support changes lives." videos={[{ id: "GJeVqHhooBA", t: "Hopewell Health Solutions — helping children, teens & families", outlet: "WFSB Channel 3" }]} />

    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" />
    <Reviews heading="What Our IOP Clients Say" tone="stone" first={["IOP", "Women’s Wellness IOP"]} />
    <Team heading="Meet Your IOP Team" lede="Board-certified psychiatric providers, licensed counselors, psychologists, social workers and expressive therapists. <a class='inl' href='/about-us/team/'>Meet our full team</a>." slugs={["teesha-huertas-lcsw", "eric-schwartz-psy-d-abpp", "tracy-sibley-pmhnp-bc-aprn", "chelsey-micciche-lpc", "kaitlyn-czapiga-lmsw", "viviana-alvarado-lpc-a", "traci-schneider-maatc-lpc-a-atr-p"]} tone="white" />

    <Insurance heading="Almost all private insurance — TRICARE East accepted as PPO" lede="We accept almost all private insurance plans for our IOP programs, and TRICARE East is accepted as a PPO plan. Our admissions team verifies your benefits at no cost — before you commit to anything." />
    <Locations heading="Our Locations" lede="Adult &amp; Women’s tracks at 300 Hebron Ave · Tween &amp; Teen tracks at 1420 Main St, Glastonbury · Adult and Women’s Wellness IOP also at our Westbrook office. Reach us at <a class='inl' href='tel:8607351448'>(860) 735-1448</a> · <a class='inl' href='mailto:hhs4help@gmail.com'>hhs4help@gmail.com</a>." current="glastonbury-ct-2" />
    <Faq faqs={faqs} heading="IOP — common questions" tone="white" />
    <OtherPrograms current="/programs/intensive-outpatient-program/" />
    <ClosingCta heading="Find the right IOP track" lede="Call us or request a consultation and our intake team will help determine which IOP is the right fit for you or your loved one — in person or by telehealth." image={P + "group-room-feelings-wheel.webp"} />
  </main>
  <Footer />
</Base>
