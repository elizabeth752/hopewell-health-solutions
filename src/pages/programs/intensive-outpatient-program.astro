import ClosingCta from "../../components/hw/ClosingCta.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import Split from "../../components/programs/Split.astro";
import IconCards from "../../components/programs/IconCards.astro";
import CheckList from "../../components/programs/CheckList.astro";
import ModalitiesOutcomes from "../../components/programs/ModalitiesOutcomes.astro";
import NewsVideos from "../../components/programs/NewsVideos.astro";
import OtherPrograms from "../../components/programs/OtherPrograms.astro";
import { STORIES } from "../../data/videos.js";
import "../../styles/pages/programs.css";

const P = "/Assets/hhs-2026/";
const heroUsps = [
  "Tracks for every age — tweens, teens, women &amp; adults",
  "Day &amp; evening options, Mon–Thu — keep work &amp; school intact",
  "Joint Commission Accredited — the Gold Seal of Approval",
  "8–12 weeks · <a class='inl' href='/treatment-methods/dbt/'>DBT</a>-based care from a multidisciplinary team",
];
const tracks = [
  { t: "Tween IOP", age: "Ages 8–12", sched: "Mon–Thu · 4:30–7:30 PM", loc: "1420 Main St, Glastonbury", href: "/programs/teen-tween-iop/#tween", img: P + "tween-group-room.webp", bar: "#5c7c6b" },
  { t: "Teen IOP", age: "Ages 13–17", sched: "Mon–Thu · 5:00–8:00 PM", loc: "1420 Main St, Glastonbury", href: "/programs/teen-tween-iop/#teen", img: "/Assets/service/teen-iop.webp", bar: "#2f76c4" },
  { t: "Women's Wellness IOP", age: "Adults 18+", sched: "Mon–Thu · 9 AM–12 PM or 5–8 PM", loc: "300 Hebron Ave, Glastonbury & Westbrook", href: "/programs/womens-wellness-iop/", img: P + "group-room-bright.webp", bar: "#b6863c" },
  { t: "Adult Co-Occurring IOP", age: "Adults 18+", sched: "Mon–Thu · 9 AM–12 PM or 5–8 PM", loc: "300 Hebron Ave, Glastonbury & Westbrook", href: "/programs/adult-mental-health-iop/", img: P + "group-room-bright.webp", bar: "#0b2f55" },
];
const whoBenefit = [
  "<a class='inl' href='/what-we-treat/depression/'>Depression</a> &amp; mood disorders",
  "<a class='inl' href='/what-we-treat/anxiety/'>Anxiety</a> &amp; panic disorders",
  "<a class='inl' href='/what-we-treat/trauma-ptsd/'>Post-traumatic stress disorder (PTSD)</a>",
  "Self-injury or suicidal thoughts",
  "School refusal or social withdrawal (adolescents)",
  "Trauma &amp; relational difficulties (Women’s)",
  "Emotional dysregulation &amp; life transitions",
  "<a class='inl' href='/what-we-treat/substance-use-disorder/'>Substance use &amp; addiction</a> (Adult)",
];
const unique = [
  { icon: "users", t: "Multidisciplinary team", d: "Board-certified psychiatrists, licensed counselors, psychologists, social workers &amp; expressive therapists — each with 10–30 years of experience." },
  { icon: "clipboard", t: "Customized care", d: "Individualized treatment plans tailored to each client’s specific needs and goals." },
  { icon: "heart", t: "Holistic approach", d: "Traditional psychotherapy blended with wellness-based interventions for emotional and physical well-being." },
  { icon: "shield", t: "Accredited &amp; licensed", d: "State-licensed and Joint Commission Accredited — the Gold Seal of Approval." },
];
const outcomes = ["Emotional regulation", "Healthier coping skills", "Self-awareness &amp; empowerment", "Social &amp; relational growth", "Reduced mental health symptoms"];
const modalities = [
  { t: "Dialectical Behavior Therapy (DBT)", icon: "swap", href: "/treatment-methods/dbt/" },
  { t: "Cognitive Behavioral Therapy (CBT)", icon: "brain" },
  { t: "Interpersonal Therapy", icon: "users" },
  { t: "Mindfulness", icon: "cloud" },
  { t: "Art Therapy", icon: "sparkles" },
  { t: "Music Therapy", icon: "star" },
  { t: "Yoga Therapy", icon: "sun" },
  { t: "Experiential Activities", icon: "compass" },
];
const faqs: [string, string][] = [
  ["What is an Intensive Outpatient Program (IOP)?", "An IOP provides structured therapeutic care without an overnight stay — individual and group counseling, skills-based psychotherapy, psychiatric <a class='inl' href='/programs/medication-management/'>medication management</a>, and experiential therapies — while you maintain your daily routine at home, work, or school."],
  ["What does the program include, and what’s the schedule?", "Our IOPs meet four times a week (Mon–Thu), day or evening depending on the track. Tweens run 4:30–7:30 PM and teens run 5–8 PM; Women’s Wellness and Adult Co-Occurring run 9 AM–12 PM or 5–8 PM. Each runs 8–12 weeks and blends DBT, CBT, interpersonal therapy, mindfulness, and expressive therapies (art, music, yoga). Family involvement is encouraged in the tween and teen programs."],
  ["Who can benefit from an IOP?", "Individuals experiencing depression, anxiety, PTSD, self-injury or suicidal thoughts, school refusal, trauma, emotional dysregulation, or substance use. All programs are inclusive and affirming — we welcome everyone regardless of gender identity, sexual orientation, cultural background, or diagnosis."],
  ["What makes Hopewell Health Solutions’ IOPs unique?", "A multidisciplinary team with 10–30 years of experience, customized treatment plans, a holistic approach — and Joint Commission Accreditation, the Gold Seal of Approval."],
  ["Do you accept insurance for the IOP programs?", "Yes — we accept almost all private insurances for all of our IOP programs, and TRICARE East is accepted as a PPO plan. If you have Medicaid / HUSKY, our admissions team can point you to programs that take it."],
