  { t: "Women's Trauma IOP", d: "A women-only evening group built around healing from trauma.", age: "Women 18+", sched: "Mon–Thu · 5:00–8:00 PM", loc: "300 Hebron Ave, Glastonbury", href: "/programs/womens-trauma-iop/", img: P + "womens-trauma-iop-group-room.webp", bar: "#b6863c" },
  { t: "First Responder IOP", d: "For police, fire, EMS and dispatch, with peers who get the work.", age: "First responders", sched: "Mon–Thu · 9 AM–12 PM", loc: "300 Hebron Ave, Glastonbury", href: "/programs/first-responder-iop/", img: P + "team-300-hebron.webp", bar: "#265489" },
