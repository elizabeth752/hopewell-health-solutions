// IOP overview — 2026 redesign (Corner Canyon layout). All live copy kept.
// KB §1 (no unsourced "only" claims): "the only private IOP in CT that's Joint Commission Accredited" → "Joint Commission
// Accredited (Gold Seal of Approval)" in the hero, cards, FAQ and meta description. Insurance wording made positive.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
