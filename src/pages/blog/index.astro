---
// Blog hub — 2026 redesign. Every post keeps its stock hero photo (user, 2026-11-16: "keep the stock photos").
// Featured latest post, category filter as plain text tabs (no pills), every post on one page (no pagination).
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import { posts } from "../../data/posts.js";
import { providers } from "../../data/providers.js";
import { VIDEOS } from "../../data/videos.js";
import "../../styles/pages/blog.css";

const SITE = "https://www.hopewellhealthsolutions.com";
const canonical = `${SITE}/blog/`;
const byId = (slug) => providers.find((p) => p.slug === slug);
const photo = (p) => (p && p.photo && !p.photoPlaceholder ? `/Assets/Team%20Members/${p.photo}.webp` : null);
const fmt = (iso) => new Date(`${iso}T12:00:00`).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const sorted = [...posts].sort((a, b) => (a.datePublished < b.datePublished ? 1 : -1));
const [featured, ...rest] = sorted;
const categories = Array.from(new Set(sorted.map((p) => p.category))).sort();
const count = (c) => rest.filter((p) => p.category === c).length;
const barFor = (c) => ["#2f76c4", "#b6863c", "#5c7c6b", "#0b2f55", "#265489"][categories.indexOf(c) % 5];
const fa = featured ? byId(featured.authorSlug) : null;

const ld = {
  "@context": "https://schema.org", "@type": "Blog", name: "The Hopewell Blog", url: canonical,
  publisher: { "@type": "Organization", name: "Hopewell Health Solutions", url: SITE + "/" },
  blogPost: sorted.slice(0, 20).map((p) => ({ "@type": "BlogPosting", headline: p.title, url: `${SITE}/post/${p.slug}/`, datePublished: p.datePublished, image: SITE + p.heroImage })),
};
---

<Base title="Mental Health Blog & Resources | Hopewell Health Solutions" description="Evidence-based articles on mental health, treatment, and recovery — written and clinically reviewed by the licensed clinicians at Hopewell Health Solutions in Connecticut." canonical={canonical}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Blog" }]}
      title="The Hopewell Blog"
      lede="Practical, evidence-based guidance on mental health, treatment, and recovery — written and clinically reviewed by our Connecticut team."
      bullets={["Written by Hopewell clinicians", "Clinically reviewed", "Depression, anxiety, addiction, teens &amp; more", `${sorted.length} articles`]}
      image="/Assets/hhs-2026/group-room-feelings-wheel.webp"
      form={false}
    />

    {featured && (
      <section class="section is-white" style="padding-bottom:0">
        <div class="container">
          <a class="bh-feature" href={`/post/${featured.slug}/`}>
            <span class="bh-feature-media">{featured.heroImage && <img src={featured.heroImage} alt="" width="1024" height="640" />}</span>
            <span class="bh-feature-copy">
              <span class="bh-latest">Latest article · {featured.category}</span>
              <h2>{featured.title}</h2>
              <p>{featured.excerpt}</p>
              {fa && <span class="bh-by">{photo(fa) && <img src={photo(fa)} alt="" width="44" height="44" />}<span><strong>{fa.name}</strong>{fmt(featured.datePublished)}</span></span>}
              <span class="bh-read">Read article <Icon name="arrow" class="h-4 w-4" /></span>
            </span>
          </a>
        </div>
      </section>
    )}

    <section class="section is-white" id="articles">
      <div class="container">
        <div class="sec-head"><h2>Browse articles by topic</h2><p class="lede">Choose a topic, or explore our <a class="inl" href="/handouts/">free downloadable handouts</a> and the <a class="inl" href="/podcast/">Hope, Health &amp; Healing podcast</a>.</p></div>
        <div class="bh-filter" role="group" aria-label="Filter articles by topic">
          <button type="button" data-filter="all" class="is-on" aria-pressed="true">All<small>{rest.length}</small></button>
          {categories.filter((c) => count(c) > 0).map((c) => <button type="button" data-filter={c} aria-pressed="false">{c}<small>{count(c)}</small></button>)}
        </div>
        <div class="bh-grid">
          {rest.map((p) => {
            const a = byId(p.authorSlug);
            return (
              <a href={`/post/${p.slug}/`} class="bh-card" data-category={p.category} style={`--bar:${barFor(p.category)}`}>
                <span class="bh-card-media">{p.heroImage && <img src={p.heroImage} alt="" width="640" height="400" loading="lazy" />}</span>
                <span class="bh-card-body">
                  <span class="bh-cat">{p.category}</span>
                  <h3>{p.title}</h3>
                  <p>{p.excerpt}</p>
                  <span class="bh-meta">{photo(a) && <img src={photo(a)} alt="" width="28" height="28" loading="lazy" />}{a?.name} · {fmt(p.datePublished)}</span>
                </span>
              </a>
            );
          })}
        </div>
        <p class="bh-count">{sorted.length} {sorted.length === 1 ? "article" : "articles"} · more on the way</p>
      </div>
    </section>

    <VideoCarousel videos={VIDEOS.filter((v) => v.type.startsWith("Podcast"))} mode="grid" tone="navy" heading="Listen: Hope, Health &amp; Healing" lede="Real stories of treatment and recovery from the Hopewell podcast." link={{ href: "/podcast/", label: "All podcast episodes" }} />

    <ClosingCta verifyHref="/admissions/#verify" />
  </main>
  <Footer />
</Base>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>(".bh-filter button")];
  const cards = [...document.querySelectorAll<HTMLElement>(".bh-card")];
  btns.forEach((b) => b.addEventListener("click", () => {
    const f = b.dataset.filter;
    btns.forEach((x) => { const on = x === b; x.classList.toggle("is-on", on); x.setAttribute("aria-pressed", String(on)); });
    cards.forEach((c) => { c.hidden = !(f === "all" || c.dataset.category === f); });
  }));
</script>
