---
// What We Treat hub — 2026 redesign (Corner Canyon layout system). Title, meta, canonical, H1 and all card copy kept from
// the previous hub; photo condition cards, levels of care, and a short FAQ (facts from the site) added.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Locations from "../../components/hw/Locations.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import { LEVELS } from "../../components/conditions/catalog.js";
import { STORIES } from "../../data/videos.js";
import "../../styles/pages/conditions.css";

const canonical = "https://www.hopewellhealthsolutions.com/what-we-treat/";
const P = "/Assets/hhs-2026/";

const mentalHealth = [
  { t: "Depression", d: "More than sadness — therapy, medication & TMS for lasting relief.", href: "/what-we-treat/depression/", icon: "cloud", img: "/Assets/Blogs/addiction-treatment-and-the-brain-how-therapy-and-medication-can-help-rewire-your-mind.webp", bar: "#2f76c4" },
  { t: "Anxiety", d: "CBT, exposure therapy & skills for panic, social anxiety, GAD and more.", href: "/what-we-treat/anxiety/", icon: "alert", img: "/Assets/Blogs/silent-panic-attacks-what-they-are-and-when-to-seek-treatment-hero.webp", bar: "#b6863c" },
  { t: "Trauma & PTSD", d: "EMDR, ART & CPT, plus Women’s Trauma and First Responder programs.", href: "/what-we-treat/trauma-ptsd/", icon: "heart", img: "/Assets/service/what-is-trauma-ptsd.webp", bar: "#5c7c6b" },
  { t: "ADHD", d: "Comprehensive testing and treatment for children, teens & adults.", href: "/what-we-treat/adhd/", icon: "bolt", img: "/Assets/service/what-is-adhd.webp", bar: "#265489" },
  { t: "OCD", d: "ERP therapy, medication, and TMS — FDA-cleared for OCD.", href: "/what-we-treat/ocd/", icon: "refresh", img: "/Assets/Blogs/postpartum-ocd-intrusive-thoughts-hero.webp", bar: "#2f76c4" },
  { t: "Bipolar Disorder", d: "Expert medication management and therapy for lasting stability.", href: "/what-we-treat/bipolar/", icon: "swap", img: "/Assets/Blogs/mood-swings-vs-a-mood-disorder-and-what-iop-does-about-it.webp", bar: "#b6863c" },
  { t: "Co-Occurring Disorders", d: "Integrated, dual-diagnosis care — mental health and substance use together.", href: "/what-we-treat/co-occurring/", icon: "link", img: "/Assets/service/co-occurring.webp", bar: "#5c7c6b" },
];
const substanceUse = [
  { t: "Addiction & Substance Use Disorder", d: "Addiction treatment, from our addiction PHP and IOP to ongoing outpatient care.", href: "/what-we-treat/substance-use-disorder/", icon: "pill", img: "/Assets/AdobeStock_413328337-1747245457937.webp", bar: "#0b2f55" },
  { t: "Alcohol Addiction", d: "Compassionate alcohol addiction treatment, from stabilization to recovery.", href: "/what-we-treat/alcohol/", icon: "swap", img: "/Assets/Blogs/are-you-a-high-functioning-alcoholic.webp", bar: "#b6863c" },
  { t: "Drug Addiction", d: "Evidence-based drug addiction treatment and care for the roots beneath it.", href: "/what-we-treat/drug/", icon: "bolt", img: "/Assets/Blogs/the-path-to-sobriety-how-substance-use-disorder-therapy-programs-can-help-save-lives.webp", bar: "#2f76c4" },
  { t: "Prescription Drug Addiction", d: "Specialized treatment for prescription drug addiction.", href: "/what-we-treat/prescription-drugs/", icon: "clipboard", img: "/Assets/Blogs/finding-the-path-to-recovery-substance-use-disorder-iop-at-hopewell-health-solutions.webp", bar: "#5c7c6b" },
];
const faqs = [
  ["Do I need a diagnosis to reach out?", `No. You don’t need a diagnosis to reach out. Tell us what’s going on, and our Connecticut team will help you find the right care. If an evaluation would help, we offer <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a> and <a class="inl" href="/treatment-methods/adhd-testing/">ADHD testing</a>.`],
  ["What ages do you treat?", `We care for clients aged 4 and older. Children and teens can start with <a class="inl" href="/programs/counseling/">counseling</a> or <a class="inl" href="/programs/medication-management/">medication management</a>, and our <a class="inl" href="/programs/teen-tween-iop/">Teen &amp; Tween IOP</a> serves ages 8–17 after school.`],
  ["Where do you offer addiction treatment?", `Addiction treatment, including our <a class="inl" href="/programs/substance-use-iop/">Addiction and Substance Use IOP</a> and addiction PHP, is offered in person at our Downtown Glastonbury office (300 Hebron Avenue) and our Westbrook office (70 Essex Road), with telehealth available. Mental health care is offered at all six offices.`],
  ["Do you treat more than one condition at a time?", `Yes. Many people live with more than one condition, such as depression with anxiety, or addiction with trauma. Our <a class="inl" href="/what-we-treat/co-occurring/">co-occurring disorders</a> care treats them together, with one team and one plan.`],
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&") } })) };
const itemList = { "@context": "https://schema.org", "@type": "ItemList", name: "Conditions treated at Hopewell Health Solutions", itemListElement: [...mentalHealth, ...substanceUse].map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.t, url: "https://www.hopewellhealthsolutions.com" + c.href })) };
---
<Base title="Conditions We Treat in CT | Hopewell Health Solutions" description="The mental health conditions and addictions treated at Hopewell Health Solutions in Connecticut — depression, anxiety, trauma & PTSD, ADHD, OCD, bipolar, co-occurring & more. In person & telehealth." canonical={canonical} image={P + "iop-clinicians-group-room.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "What We Treat" }]}
      title="Conditions We Treat in Connecticut"
      lede="From depression and anxiety to trauma, ADHD, and substance use, the board-certified team at Hopewell Health Solutions treats the full range of mental health and co-occurring conditions — for children, teens, and adults — in person across Connecticut and by telehealth."
      bullets={["For ages 4 and up", "<a class='inl' href='#mental-health'>Mental health conditions</a>", "<a class='inl' href='#addiction'>Addiction treatment</a> in Glastonbury &amp; Westbrook", "In person or by telehealth"]}
      image={P + "iop-clinicians-group-room.webp"}
    />
    <Creds />

    <section class="section is-white" id="mental-health">
      <div class="container">
        <div class="sec-head"><h2>Mental health conditions</h2><p class="lede">Evidence-based, compassionate care — therapy, medication management, and advanced options like TMS — tailored to each person.</p></div>
        <div class="wt-grid">
          {mentalHealth.map((c) => (
            <a href={c.href} class="wt-card" style={`--bar:${c.bar}`}>
              <span class="wt-media"><img src={c.img} alt="" width="1200" height="800" loading="lazy" /><span class="wt-icon"><Icon name={c.icon} class="h-6 w-6" /></span></span>
              <span class="wt-body"><h3>{c.t}</h3><p>{c.d}</p><span class="wt-go">Explore {c.t} treatment <Icon name="arrow" class="h-4 w-4" /></span></span>
            </a>
          ))}
          <a href="/admissions/" class="tm-all" style="aspect-ratio:auto;min-height:260px">
            <span class="tm-all-go"><Icon name="arrow" class="h-5 w-5" /></span>
            <strong>Not sure what you’re dealing with?</strong>
            <span>You don’t need a diagnosis to reach out. See how admissions works, or call (860) 735-1448.</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section is-navy" id="addiction">
      <svg class="hero-arcs" style="left:auto;right:-380px;top:-420px;bottom:auto" viewBox="0 0 800 800" aria-hidden="true"><circle cx="400" cy="400" r="390" /><circle cx="400" cy="400" r="300" /></svg>
      <div class="container">
        <div class="sec-head"><h2>Addiction treatment</h2><p class="lede">Addiction treatment in Glastonbury and Westbrook, with the <a class="inl" href="/programs/substance-use-iop/">Addiction and Substance Use IOP</a>, an addiction PHP, step-down care after rehab, and integrated care that treats substance use alongside the mental health conditions that so often go with it.</p></div>
        <div class="wt-grid" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">
          {substanceUse.map((c) => (
            <a href={c.href} class="wt-card" style={`--bar:${c.bar}`}>
              <span class="wt-media"><img src={c.img} alt="" width="1200" height="800" loading="lazy" /><span class="wt-icon"><Icon name={c.icon} class="h-6 w-6" /></span></span>
              <span class="wt-body"><h3>{c.t}</h3><p>{c.d}</p><span class="wt-go">Learn more <Icon name="arrow" class="h-4 w-4" /></span></span>
            </a>
          ))}
        </div>
        <p class="cd-add-note"><Icon name="pin" class="h-5 w-5" />Addiction treatment is offered in person at our Downtown Glastonbury office (300 Hebron Avenue) and our Westbrook office (70 Essex Road), with telehealth available.</p>
      </div>
    </section>

    <section class="section is-mist" id="levels">
      <div class="container">
        <div class="sec-head"><h2>Care at the level you need</h2><p class="lede">A full continuum under one roof — from weekly counseling to intensive day programs. You can step up when you need more support, or step down as you heal, without ever switching teams. See <a class="inl" href="/programs/">all programs</a>.</p></div>
        <div class="levels-grid">
          {LEVELS.map((l, i) => (
            <article class={`level-card lv-${l.tone}`}>
              <div class="level-head">
                <div class="level-title"><span class="level-icon"><Icon name={l.icon} class="h-[22px] w-[22px]" /></span><h3>{l.t}</h3></div>
                <p class="level-stat"><strong>{l.stat}</strong><span>{l.note}</span></p>
                <div class="week" aria-hidden="true">{["M","T","W","T","F","S","S"].map((d, j) => <span class="week-day"><span class="week-track"><span class="week-fill" style={`--h:${(l.days[j] / 6) * 100}%`}></span></span><span class="week-label">{d}</span></span>)}</div>
              </div>
              <div class="level-body"><p set:html={l.html} /></div>
              {i < LEVELS.length - 1 && <span class="level-next" aria-hidden="true"><Icon name="arrow" class="h-5 w-5" /></span>}
            </article>
          ))}
        </div>
        <p class="levels-key"><span class="key-swatch"></span>Hours of care each day in a typical week (outpatient shown as one weekly session)</p>
      </div>
    </section>

    <VideoCarousel videos={STORIES} heading="Stories of Hope, in Their Own Words" lede="Hopewell clients and their families share what treatment was like. Watch the <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a> for the full conversations." />
    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" />
    <Reviews />
    <Insurance heading="Most major PPO plans accepted" lede="We’re in-network with most major PPO plans (we don’t accept Medicaid / HUSKY). Our team verifies your benefits at no cost — before you commit to anything." />
    <Locations />
    <Faq faqs={faqs} heading="Questions About What We Treat" tone="white" />
    <ClosingCta heading="Not sure where to start?" lede="You don’t need a diagnosis to reach out. Tell us what’s going on, and our Connecticut team will help you find the right care — confidentially, with no pressure." />
  </main>
  <Footer />
</Base>
