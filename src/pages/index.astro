---
import { socials } from "../data/socials";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import LeadForm from "../components/LeadForm.astro";
import MediaStrip from "../components/MediaStrip.astro";
import { posts } from "../data/posts.js";
import { providers } from "../data/providers.js";
import { locations as offices } from "../data/locations.js";
import LegitScriptSeal from "../components/LegitScriptSeal.astro";
import BbbSeal from "../components/BbbSeal.astro";

const C = "/Assets/credibility/";
const trustMarks = [
  ["The Joint Commission — Accredited", C + "joint-commission.webp"],
  ["Psychology Today Verified", C + "psychology-today.webp"],
];
const usps = [
  { icon: "sparkles", t: "Programs hospitals don’t offer", d: "Intensive Outpatient (IOP) & Partial Hospitalization (PHP) — including addiction IOP and PHP, plus programs for women, teens, tweens & first responders. Built for who you are." },
  { icon: "users", t: "Real, in-person care", d: "While others go all-virtual, our IOP, PHP, therapy and medication management happen face to face — human to human, with telehealth when you need it." },
  { icon: "dna", t: "GeneSight® genetic testing", d: "A simple cheek swab shows which medications fit your DNA — so we skip the trial-and-error." },
  { icon: "brain", t: "TMS for treatment-resistant depression", d: "FDA-cleared, drug-free, no downtime — for when medication and therapy haven’t been enough." },
];
const programs = [
  { t: "Adult IOP", d: "Structured therapy 3–4 days a week, while you live at home, work, and parent.", href: "/programs/adult-mental-health-iop/", icon: "users", img: "/Assets/AdobeStock_403830351.webp" },
  { t: "Women’s Wellness IOP", d: "Trauma-informed, DBT-based care in a women-only group where it’s safe to be seen.", href: "/programs/womens-wellness-iop/", icon: "heart", img: "/Assets/women%20looking%20at%20me.webp" },
  { t: "Teen & Tween IOP", d: "After-school support for ages 8–18, with the family woven into the work.", href: "/programs/teen-tween-iop/", icon: "sparkles", img: "/Assets/teen%20smiling.webp" },
  { t: "Partial Hospitalization (PHP)", d: "Full-day treatment for when weekly therapy simply isn’t enough.", href: "/programs/partial-hospitalization-program/", icon: "shield", img: "/Assets/AdobeStock_542909901.webp" },
  { t: "Medication Management", d: "Thoughtful psychiatric prescribing for ages 4 and up — never one-size-fits-all.", href: "/programs/medication-management/", icon: "pill", img: "/Assets/AdobeStock_404268940.webp" },
  { t: "Counseling", d: "Individual, couples & family counseling, in person or by telehealth.", href: "/programs/counseling/", icon: "heart", img: "/Assets/couple%20hugging.webp" },
];
const treatments = [
  { t: "TMS Therapy", d: "FDA-cleared magnetic stimulation for treatment-resistant depression & OCD.", href: "/treatment-methods/tms/", icon: "brain" },
  { t: "EMDR", d: "Evidence-based trauma therapy that helps the mind heal what words can’t reach.", href: "/treatment-methods/emdr/", icon: "refresh" },
  { t: "Therapeutic Treatments", d: "ART, the Gottman Method, mindfulness, yoga therapy & more.", href: "/treatment-methods/therapeutic-treatments/", icon: "heart" },
  { t: "Neuropsychological Testing", d: "Comprehensive evaluation for clarity, diagnosis, and a real plan.", href: "/treatment-methods/neuropsychological-testing/", icon: "clipboard" },
  { t: "ADHD Testing", d: "Thorough, compassionate assessment for children, teens & adults.", href: "/treatment-methods/adhd-testing/", icon: "bolt" },
];
const conditions = [
  { t: "Depression", icon: "cloud", href: "/what-we-treat/depression/" },
  { t: "Anxiety", icon: "alert", href: "/what-we-treat/anxiety/" },
  { t: "Trauma & PTSD", icon: "heart", href: "/what-we-treat/trauma-ptsd/" },
  { t: "ADHD", icon: "bolt", href: "/what-we-treat/adhd/" },
  { t: "Bipolar Disorder", icon: "swap", href: "/what-we-treat/bipolar/" },
  { t: "OCD", icon: "refresh", href: "/what-we-treat/ocd/" },
  { t: "Addiction (SUD)", icon: "pill", href: "/what-we-treat/substance-use-disorder/" },
  { t: "Co-occurring Disorders", icon: "link", href: "/what-we-treat/co-occurring/" },
];
const continuum = [
  { t: "Outpatient Therapy", d: "Weekly individual, couples & family sessions", level: 1 },
  { t: "Intensive Outpatient (IOP)", d: "3 hrs/day · 4 days/week · day or evening", level: 2 },
  { t: "Partial Hospitalization (PHP)", d: "Full-day care — highest outpatient level", level: 3 },
];
const stats = [
  ["14", "Years serving Central Connecticut", "calendar"],
  ["50+", "Clinicians on our team", "users"],
  ["6", "Connecticut locations", "pin"],
  ["50,000+", "Lives helped", "heart"],
];
const insurers = [
  ["Aetna","/Assets/Insurance/AETNA.webp"],["Anthem","/Assets/Insurance/Anthem.webp"],
  ["Blue Cross Blue Shield","/Assets/Insurance/BCBS.webp"],["Cigna","/Assets/Insurance/CIGNA.webp"],
  ["Magellan","/Assets/Insurance/Magellan%20Health.webp"],["Optum","/Assets/Insurance/Optum.webp"],
  ["TRICARE","/Assets/Insurance/TRICARE.webp"],["UMR","/Assets/Insurance/URM.webp"],
  ["UnitedHealthcare","/Assets/Insurance/UnitedHealthcare.webp"],["VA Community Care","/Assets/Insurance/VA%20Community%20Care.webp"],
  ["ConnectiCare","/Assets/ConnnectiCare.webp"],["Harvard Pilgrim","/Assets/Harvard%20Pilgrim.webp"],
];
// Featured team — prescribers first, then founder & psychologists.
const team = [
  ["Tracy Sibley, PMHNP-BC","Psychiatric NP","/Assets/Team%20Members/tracy-sibley-pmhnp-bc-aprn.webp","/provider/tracy-sibley-pmhnp-bc-aprn/"],
  ["Christina Lindsay, PMHNP-BC","Psychiatric NP","/Assets/Team%20Members/christina-lindsay-pmhnp-bc-aprn.webp","/provider/christina-lindsay-pmhnp-bc-aprn/"],
  ["Christopher Patenaude, PA","Physician Assistant","/Assets/Team%20Members/chris-patenaude-pa.webp","/provider/chris-patenaude-pa/"],
  ["Kristine A. Schlichting, PhD","Founder & Director","/Assets/Team%20Members/kristine-a-schlichting-phd.webp","/provider/kristine-a-schlichting-ph-d/"],
  ["Eric Schwartz, PsyD, ABPP","Psychologist","/Assets/Team%20Members/eric-schwarz-psyd-abpp.webp","/provider/eric-schwartz-psy-d-abpp/"],
  ["Laura Miller, PhD","Neuropsychologist","/Assets/Team%20Members/laura-miller-phd.webp","/provider/laura-miller-ph-d/"],
  ["Ashley Singh, PsyD","Psychologist","/Assets/Team%20Members/ashley-singh-psyd.webp","/provider/ashley-singh-psy-d/"],
];
const locations = [
  ["Glastonbury — Pratt St", "33 Pratt St", "Glastonbury, CT 06033", "/location/glastonbury-ct/"],
  ["Downtown Glastonbury", "300 Hebron Ave, Suite 203", "Glastonbury, CT 06033", "/location/glastonbury-ct-2/"],
  ["South Glastonbury", "1420 Main St, Suite 124", "Glastonbury, CT 06073", "/location/glastonbury-ct-3/"],
  ["West Hartford", "1216 Farmington Ave, Suite 301", "West Hartford, CT 06107", "/location/west-hartford-ct/"],
  ["East Hampton", "151 E. High St", "East Hampton, CT 06424", "/location/east-hampton-ct/"],
  ["Westbrook", "70 Essex Road", "Westbrook, CT 06498", "/location/westbrook-ct/"],
];
const reviews = [
  { name: "Jake Sted", meta: "2 months ago", text: "Hopewell’s IOP program made a huge difference in my life. The groups were engaging, and the therapists genuinely took the time to understand each person’s needs. It helped me develop real tools I use every day." },
  { name: "Emily Ross", meta: "8 months ago", text: "This is the best therapy place I have ever been to. I started in their Women’s Wellness IOP and all the clinicians are amazing and actually care about you. Now I’m doing individual therapy and med management — I highly recommend this place." },
  { name: "Joana Yoo", meta: "10 months ago", text: "Christopher P. was extremely accommodating and took the time to meet with us without making us feel rushed. His calm and respectful demeanor made it easy to open up, and we felt heard and understood. Highly recommended." },
  { name: "Cynthia Askew", meta: "6 months ago", text: "Rosa Kleinberg is a consummate professional — prepared and on top of her game. She asks the right questions and listens with care and understanding, committed to finding the right balance for a healthy, quality life." },
  { name: "Donald Krusinski", meta: "a year ago", text: "I'm under Tracy Sibley's care, and she is a kind and helpful person. She is so patient, understanding, and always very supportive. She is helping me through a difficult journey — I know I will be alright because of her excellent care!" },
  { name: "Lauren Irace", meta: "8 months ago", text: "I am very grateful for the care I am receiving at Hopewell Health Solutions. Everyone I have interacted with is extremely professional, friendly, and easy to talk to. I also appreciate the flexibility and willingness to accommodate additional support when needed. I highly recommend this practice to anyone seeking support." },
];
const steps = [
  { icon: "phone", t: "Reach out", d: "Call us, or request a confidential callback — no commitment." },
  { icon: "shield", t: "Verify insurance", d: "We check your benefits for you — free, in minutes." },
  { icon: "clipboard", t: "Assessment", d: "A clinical assessment to match you to the right care." },
  { icon: "compass", t: "Begin care", d: "Start at the right level — and adjust as you heal." },
];
const byId = (slug) => providers.find((p) => p.slug === slug);
const blogTeasers = [...posts].sort((a, b) => (a.datePublished < b.datePublished ? 1 : -1)).slice(0, 3);

// --- Homepage structured data: MedicalBusiness + aggregateRating + sameAs (rich results + knowledge panel) ---
const SITE = "https://www.hopewellhealthsolutions.com";
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": SITE + "/#organization",
  name: "Hopewell Health Solutions",
  alternateName: "Hopewell Health Solutions, LLC.",
  url: SITE + "/",
  logo: SITE + "/Assets/logo/hopewell-wave-logo.webp",
  image: SITE + "/Assets/full%20team%20happy.webp",
  description: "Outpatient mental health and psychiatry across Connecticut — IOP, PHP, TMS, medication management and counseling for ages 4 and up.",
  // Downtown Glastonbury GBP number (CTM-tracked). The Pratt St main line isn't tracked by CTM.
  telephone: offices.find((l) => l.slug === "glastonbury-ct-2").phone,
  email: "hhs4help@gmail.com",
  priceRange: "$$",
  foundingDate: "2013",
  address: {
    "@type": "PostalAddress",
    streetAddress: "33 Pratt St",
    addressLocality: "Glastonbury",
    addressRegion: "CT",
    postalCode: "06033",
    addressCountry: "US",
  },
  areaServed: [
    "Glastonbury CT", "South Glastonbury CT", "West Hartford CT", "East Hampton CT", "Westbrook CT",
    "Hartford County CT", "Middlesex County CT", "South Windsor", "Wethersfield", "Rocky Hill",
    "Newington", "Berlin", "Colchester", "Old Saybrook", "Clinton",
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    reviewCount: "368",
    bestRating: "5",
    worstRating: "1",
  },
  sameAs: [
    ...socials.map((s) => s.href),
    "https://www.psychologytoday.com/us/treatment-rehab/hopewell-health-solutions-iop-glastonbury-ct/1084012",
    "https://www.bbb.org/us/ct/glastonbury/profile/psychologist/hopewell-health-solutions-llc-0111-87124396",
  ],
};

// ---- Redesign helpers (graphics carry real data from locations.js) ----
// Simple Connecticut outline projected to a 400×306 box (lon/lat → x/y).
const proj = (lng, lat) => [((lng + 73.75) / 1.98) * 400, ((42.07 - lat) / 1.13) * 306];
const ctOutline = [[-73.49,42.05],[-71.80,42.02],[-71.80,41.33],[-71.86,41.32],[-72.10,41.31],[-72.38,41.27],[-72.55,41.26],[-72.90,41.25],[-73.10,41.16],[-73.40,41.08],[-73.66,40.99],[-73.73,41.10],[-73.48,41.21],[-73.55,41.29],[-73.52,41.66]]
  .map(([lng, lat]) => proj(lng, lat).map((n) => n.toFixed(1)).join(",")).join(" ");
const pins = offices.map((o) => ({ ...o, xy: proj(o.lng, o.lat) }));
// Towns named in the "Care Near You" copy, shown as small grey dots.
const servedTowns = [["South Windsor",-72.62,41.82],["Wethersfield",-72.65,41.71],["Rocky Hill",-72.66,41.66],["Newington",-72.73,41.69],["Berlin",-72.75,41.62],["Colchester",-72.33,41.58],["Old Saybrook",-72.38,41.29],["Clinton",-72.53,41.28]]
  .map(([t, lng, lat]) => ({ t, xy: proj(lng, lat) }));
const mapLabels = [
  { t: "Glastonbury ×3", at: proj(-72.60, 41.70), dx: 12, dy: -10 },
  { t: "West Hartford", at: proj(-72.764, 41.756), dx: -12, dy: -12, end: true },
  { t: "East Hampton", at: proj(-72.49, 41.596), dx: 12, dy: 4 },
  { t: "Westbrook", at: proj(-72.447, 41.287), dx: 12, dy: -6 },
];
// Hero photo strip (real Hopewell photos).
const heroPhotos = [
  ["/Assets/home-b/hero-group-green.webp", "Hopewell clients smiling together", "center 30%"],
  ["/Assets/locations/westbrook/sitting-room.webp", "The sitting room at our Westbrook office", "center 50%"],
  ["/Assets/Team%20united.webp", "Hopewell clinicians outside the office", "center 35%"],
];

---

<Base title="Mental Health & Psychiatry in Glastonbury, Westbrook & West Hartford, CT | Hopewell Health Solutions" description="Hopewell Health Solutions — Connecticut’s trusted outpatient mental-health & psychiatry team. IOP, PHP, TMS & medication management across Glastonbury, West Hartford, East Hampton & Westbrook. 4.8★, Joint Commission accredited. Verify your insurance." canonical={SITE + "/"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-crema">
    <svg class="pointer-events-none absolute -right-40 -top-24 -z-10 h-[620px] w-[620px] text-azul-light" viewBox="0 0 200 200" aria-hidden="true"><circle cx="100" cy="100" r="100" fill="currentColor"/></svg>
    <div class="wrap grid items-center gap-12 pt-12 pb-20 lg:grid-cols-[1.08fr_1fr] lg:pt-16 lg:pb-24">
      <div>
        <p class="flex items-center gap-2 text-[15px] font-semibold text-azul"><Icon name="pin" class="h-4 w-4" />Glastonbury · West Hartford · East Hampton · Westbrook, CT</p>
        <h1 class="h-xl mt-4 text-ink">Mental Health &amp; Psychiatry in Connecticut</h1>
        <p class="mt-4 font-display text-2xl italic text-azul sm:text-3xl">There is hope to heal.</p>
        <p class="lede mt-5 max-w-xl">Connecticut’s most trusted outpatient mental-health team — <a href="/programs/intensive-outpatient-program/" class="ilink">intensive programs</a>, psychiatry, <a href="/programs/medication-management/" class="ilink">medication management</a> and <a href="/treatment-methods/tms/" class="ilink">TMS</a>, delivered in person by clinicians who know your name. For ages 4 and up, in person or by telehealth.</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="tel:8607351448" class="btn btn-primary h-[52px] px-7"><Icon name="phone" class="h-4 w-4" />Call (860) 735-1448</a>
          <span class="flex items-center gap-2.5 rounded-full bg-white px-4 py-2.5 text-sm text-ink shadow-sm ring-1 ring-line">
            <img src="/Assets/home-b/google-g.svg" alt="" width="18" height="18" class="h-[18px] w-[18px]" />
            <span class="text-[#f5b301]">★★★★★</span><strong>4.8</strong><span class="text-muted">· 368 reviews</span>
          </span>
        </div>
        <p class="mt-10 text-sm font-semibold text-ink">Accredited &amp; verified by</p>
        <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-4">
          {trustMarks.map(([alt, src]) => <img src={src} alt={alt} width="150" height="36" loading="lazy" decoding="async" class="h-9 w-auto max-w-[150px] object-contain" />)}
          <LegitScriptSeal />
          <BbbSeal />
        </div>
      </div>

      <!-- desktop: photo arches + form; phones: photo only (form sits above insurance) -->
      <div class="relative">
        <div class="grid grid-cols-[1.25fr_1fr] gap-4 lg:pr-0">
          <img src={heroPhotos[0][0]} alt={heroPhotos[0][1]} width="600" height="760" fetchpriority="high" decoding="async" class="arch h-[300px] w-full object-cover sm:h-[420px] lg:h-[520px]" style={`object-position:${heroPhotos[0][2]}`} />
          <div class="grid gap-4">
            <img src={heroPhotos[1][0]} alt={heroPhotos[1][1]} width="400" height="400" decoding="async" class="h-[142px] w-full rounded-[1.5rem] object-cover sm:h-[202px] lg:h-[252px]" style={`object-position:${heroPhotos[1][2]}`} />
            <img src={heroPhotos[2][0]} alt={heroPhotos[2][1]} width="400" height="400" decoding="async" class="h-[142px] w-full rounded-[1.5rem] rounded-br-[5rem] object-cover sm:h-[202px] lg:h-[252px]" style={`object-position:${heroPhotos[2][2]}`} />
          </div>
        </div>
      </div>
    </div>
    <svg class="absolute bottom-0 left-0 block h-10 w-full text-white sm:h-14" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 80h1440V40c-120 22-240 34-360 26S840 26 720 32 480 70 360 68 120 44 0 36Z"/></svg>
  </section>

  <!-- desktop form band, pulled up over the hero wave -->
  <div id="verify" class="relative z-10 hidden scroll-mt-28 lg:block">
    <div class="wrap -mt-10">
      <div class="grid items-center gap-8 rounded-[2rem] bg-night p-8 text-white shadow-2xl lg:grid-cols-[0.8fr_1.6fr]">
        <div class="on-dark">
          <h2 class="h-md text-white">Free, confidential insurance check</h2>
          <p class="mt-2 text-white/75">Tell us who to call back. We check your benefits for you — free, in minutes — and a real person helps you find the next step.</p>
          <ul class="mt-5 space-y-2 text-sm text-white/85">
            <li class="flex items-center gap-2"><Icon name="shield" class="h-4 w-4 text-azul-light" />HIPAA-compliant and private</li>
            <li class="flex items-center gap-2"><Icon name="clipboard" class="h-4 w-4 text-azul-light" />In-network with most major plans</li>
          </ul>
        </div>
        <LeadForm variant="card" formId="hhs-hero" />
      </div>
    </div>
  </div>

  <div class="pt-6 lg:pt-12"><MediaStrip bg="white" /></div>

  <!-- WHERE TO BEGIN -->
  <section class="sec bg-white">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr] lg:items-end">
        <h2 class="h-lg text-ink">Where Would You Like to Begin?</h2>
        <p class="copy">One in five U.S. adults lives with a mental health condition — and untreated, it rarely gets easier on its own. You are not alone, and you don’t have to navigate this alone. Wherever you’re starting from, there’s a clear next step here.</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {[
          { img: "/Assets/service/home-help-myself-opt.webp", alt: "Beginning your own healing journey", icon: "heart", t: "Help for myself", d: "Taking the first step takes courage. We’ll make the next ones simple.", link: ["Find my program", "/programs/"], bg: "bg-azul-light" },
          { img: "/Assets/service/home-help-loved-one-opt.webp", alt: "Supporting a loved one who is struggling", icon: "users", t: "Help for someone I love", d: "A child, partner, or parent who’s struggling? We’ll help you help them.", link: ["Get guidance", "/admissions/#for-families"], bg: "bg-sage-light" },
        ].map((c) => (
          <a href={c.link[1]} class={`group relative grid overflow-hidden rounded-[2rem] ${c.bg} sm:grid-cols-[1fr_1.1fr]`}>
            <img src={c.img} alt={c.alt} width="800" height="440" loading="lazy" decoding="async" class="h-40 w-full object-cover sm:h-full transition duration-500 group-hover:scale-[1.03]" />
            <div class="flex flex-col p-7">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-white text-azul shadow-sm"><Icon name={c.icon} class="h-6 w-6" /></span>
              <h3 class="h-md mt-5 text-ink">{c.t}</h3>
              <p class="mt-2 flex-1 text-[16px] leading-relaxed text-ink/80">{c.d}</p>
              <span class="btn btn-primary mt-6 self-start">{c.link[0]}<Icon name="arrow" class="h-4 w-4" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY HOPEWELL — each USP with its own small graphic -->
  <section id="why" class="sec relative isolate overflow-hidden bg-night text-white scroll-mt-24">
    <svg class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-full w-full opacity-[.07]" viewBox="0 0 1440 600" preserveAspectRatio="none" aria-hidden="true"><path d="M0 420c160-60 320-90 480-60s320 120 480 110 320-110 480-130" fill="none" stroke="#fff" stroke-width="2"/><path d="M0 470c160-60 320-90 480-60s320 120 480 110 320-110 480-130" fill="none" stroke="#fff" stroke-width="2"/><path d="M0 520c160-60 320-90 480-60s320 120 480 110 320-110 480-130" fill="none" stroke="#fff" stroke-width="2"/></svg>
    <div class="wrap">
      <h2 class="h-lg max-w-2xl text-white">Care You Can’t Get Just Anywhere</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {usps.map((u, i) => (
          <div class="flex flex-col rounded-[1.75rem] bg-white/[.06] p-6 ring-1 ring-white/10">
            <div class="grid h-20 place-items-center rounded-2xl bg-white/[.06] sm:h-28">
              {i === 0 && (
                <svg viewBox="0 0 160 80" class="h-20 w-40" aria-hidden="true">
                  {[["OP",18,"#7fa8d6"],["IOP",38,"#4f8bd0"],["PHP",58,"#2f76c4"]].map(([l,h,c],k) => (<g><rect x={18+k*48} y={70-h} width="30" height={h} rx="6" fill={c} /><text x={33+k*48} y="79" font-size="8" text-anchor="middle" fill="#fff" fill-opacity=".8" font-family="Urbanist" font-weight="700">{l}</text></g>))}
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 160 80" class="h-20 w-40" aria-hidden="true"><circle cx="58" cy="30" r="13" fill="#7fa8d6"/><path d="M34 74a24 24 0 0 1 48 0Z" fill="#7fa8d6"/><circle cx="102" cy="30" r="13" fill="#f3e8d2"/><path d="M78 74a24 24 0 0 1 48 0Z" fill="#f3e8d2"/><path d="M73 52h14" stroke="#fff" stroke-width="3" stroke-linecap="round"/></svg>
              )}
              {i === 2 && (
                <svg viewBox="0 0 160 80" class="h-20 w-40" aria-hidden="true" fill="none" stroke-width="3" stroke-linecap="round">{Array.from({length:9}).map((_,k)=>{const x=20+k*15;const y1=40+24*Math.sin(k*0.8);const y2=40-24*Math.sin(k*0.8);return (<g><line x1={x} y1={y1} x2={x} y2={y2} stroke="#fff" stroke-opacity=".35"/><circle cx={x} cy={y1} r="4" fill="#7fa8d6" stroke="none"/><circle cx={x} cy={y2} r="4" fill="#f3e8d2" stroke="none"/></g>)})}</svg>
              )}
              {i === 3 && (
                <svg viewBox="0 0 160 80" class="h-20 w-40" aria-hidden="true" fill="none" stroke-linecap="round"><path d="M8 40h26l8-22 12 44 12-34 8 12h78" stroke="#7fa8d6" stroke-width="3.5" stroke-linejoin="round"/><circle cx="128" cy="40" r="9" fill="#f3e8d2"/></svg>
              )}
            </div>
            <h3 class="h-md mt-6 text-white">{u.t}</h3>
