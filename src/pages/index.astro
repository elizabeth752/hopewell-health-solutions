<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  // Hero: crossfade the real team photos every 6 s; dots pick one.
  const slides = [...document.querySelectorAll<HTMLElement>(".hero-slide")];
  const dots = [...document.querySelectorAll<HTMLButtonElement>(".hero-dots button")];
  let cur = 0;
  const show = (n: number) => { slides[cur]?.classList.remove("is-active"); dots[cur]?.classList.remove("is-on"); cur = (n + slides.length) % slides.length; slides[cur]?.classList.add("is-active"); dots[cur]?.classList.add("is-on"); };
  dots.forEach((d, i) => d.addEventListener("click", () => show(i)));
  if (!reduce && slides.length > 1) setInterval(() => { if (!document.hidden) show(cur + 1); }, 6000);

  // Office gallery: thumbnails pick the large photo; autoplay every 5 s, paused on hover/focus.
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((g) => {
    const thumbs = [...g.querySelectorAll<HTMLButtonElement>(".gal-thumb")];
    const imgs = [...g.querySelectorAll<HTMLElement>(".gal-slide")];
    let i = 0, hold = false;
    const pick = (n: number) => { thumbs[i].classList.remove("is-active"); thumbs[i].setAttribute("aria-pressed", "false"); imgs[i].classList.remove("is-active"); i = (n + imgs.length) % imgs.length; thumbs[i].classList.add("is-active"); thumbs[i].setAttribute("aria-pressed", "true"); imgs[i].classList.add("is-active"); };
    thumbs.forEach((t, n) => t.addEventListener("click", () => pick(n)));
    g.addEventListener("mouseenter", () => (hold = true)); g.addEventListener("mouseleave", () => (hold = false));
    g.addEventListener("focusin", () => (hold = true)); g.addEventListener("focusout", () => (hold = false));
    if (!reduce) setInterval(() => { if (!hold && !document.hidden) pick(i + 1); }, 5000);
  });

</script>
