---
// Homepage — 2026 redesign (Corner Canyon layout system, Hopewell brand). Every SEO element of the live page is kept:
// title, meta description, canonical, H1, MedicalBusiness schema, section headings and internal links.
// Copy changes (2026-11-16, per the knowledge base): no unsourced "most trusted"/"superior" claims; addiction wording;
// real Hopewell photos only (Drive "HHS - Branding & Media Assets", no AI images); reviews show initials only.
import { socials } from "../data/socials";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import LeadForm from "../components/LeadForm.astro";
import MediaStrip from "../components/MediaStrip.astro";
import LegitScriptSeal from "../components/LegitScriptSeal.astro";
import BbbSeal from "../components/BbbSeal.astro";
import { posts } from "../data/posts.js";
import { providers } from "../data/providers.js";
import { locations as offices } from "../data/locations.js";

const P = "/Assets/hhs-2026/";
const heroSlides = [
  [P + "team-celebrating-outside.webp", "The Hopewell team celebrating together outside the office", "center 45%"],
  [P + "iop-clinicians-group-room.webp", "Hopewell IOP clinicians in a group therapy room", "center 40%"],
  [P + "team-outside-with-therapy-dog.webp", "Hopewell staff outside with the office therapy dog", "center 40%"],
  [P + "womens-trauma-iop-group-room.webp", "Clinicians in the Women's Trauma IOP group room", "center 45%"],
  [P + "iop-team-hallway.webp", "The Hopewell IOP team at the Glastonbury office", "center 40%"],
  [P + "full-team-lawn.webp", "The full Hopewell Health Solutions team on the lawn", "center 45%"],
];

const C = "/Assets/credibility/";
const usps = [
  { icon: "users", t: "Real, in-person care", d: "While others go all-virtual, our IOP, PHP, therapy and medication management happen face to face — human to human, with telehealth when you need it." },
  { icon: "dna", t: "GeneSight® genetic testing", d: "A simple cheek swab shows which medications fit your DNA — so we skip the trial-and-error.", href: "/treatment-methods/genesight-testing/" },
  { icon: "brain", t: "TMS for treatment-resistant depression", d: "FDA-cleared, drug-free, no downtime — for when medication and therapy haven’t been enough.", href: "/treatment-methods/tms/" },
];
const stats = [
  ["14", "Years serving Central Connecticut", "calendar"],
  ["50+", "Clinicians on our team", "users"],
  ["6", "Connecticut locations", "pin"],
  ["50,000+", "Lives helped", "heart"],
];
const levels = [
  { t: "Outpatient Therapy", icon: "chat", stat: "Weekly", note: "individual, couples & family sessions", days: [1, 0, 0, 0, 0, 0, 0], tone: 1,
    html: `Weekly sessions with one therapist, in person or by telehealth. <a class="inl" href="/programs/counseling/">Individual, couples &amp; family counseling</a> and <a class="inl" href="/programs/medication-management/">medication management</a> for ages 4 and up.` },
  { t: "Intensive Outpatient (IOP)", icon: "calendar", stat: "3 h", note: "a day · 4 days a week · day or evening", days: [3, 3, 3, 3, 0, 0, 0], tone: 2,
    html: `Structured therapy 3–4 days a week, while you live at home, work, and parent. Our <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient programs</a> run day and evening tracks.` },
  { t: "Partial Hospitalization (PHP)", icon: "sun", stat: "6 h", note: "a day · Monday through Friday", days: [6, 6, 6, 6, 6, 0, 0], tone: 3,
    html: `Full-day care — highest outpatient level. Our <a class="inl" href="/programs/partial-hospitalization-program/">partial hospitalization program</a> is for when weekly therapy simply isn’t enough.` },
];
const programs = [
  { t: "Adult IOP", d: "Structured therapy 3–4 days a week, while you live at home, work, and parent.", href: "/programs/adult-mental-health-iop/", img: P + "adult-evening-iop-group.webp", bar: "#2f76c4" },
  { t: "Women’s Wellness IOP", d: "Trauma-informed, DBT-based care in a women-only group where it’s safe to be seen.", href: "/programs/womens-wellness-iop/", img: P + "womens-wellness-team.webp", bar: "#b6863c" },
  { t: "Teen & Tween IOP", d: "After-school support for ages 8–18, with the family woven into the work.", href: "/programs/teen-tween-iop/", img: P + "tween-group-room.webp", bar: "#5c7c6b" },
  { t: "Addiction IOP", d: "Addiction treatment with mental health care alongside it, at our Downtown Glastonbury and Westbrook offices.", href: "/programs/substance-use-iop/", img: P + "iop-group-session.webp", bar: "#0b2f55" },
  { t: "Partial Hospitalization (PHP)", d: "Full-day treatment for when weekly therapy simply isn’t enough.", href: "/programs/partial-hospitalization-program/", img: P + "php-group-room.webp", bar: "#265489" },
  { t: "First Responder IOP", d: "A program built for police, fire, EMS and dispatch, with clinicians who understand the job.", href: "/programs/first-responder-iop/", img: "/Assets/service/first-responder-session.webp", bar: "#b6863c" },
  { t: "Medication Management", d: "Thoughtful psychiatric prescribing for ages 4 and up — never one-size-fits-all.", href: "/programs/medication-management/", img: P + "providers-together.webp", bar: "#5c7c6b" },
  { t: "Counseling", d: "Individual, couples & family counseling, in person or by telehealth.", href: "/programs/counseling/", img: P + "westbrook-therapy-office.webp", bar: "#2f76c4" },
];
const treatments = [
  { t: "EMDR", d: "Evidence-based trauma therapy that helps the mind heal what words can’t reach.", href: "/treatment-methods/emdr/", icon: "refresh" },
  { t: "Therapeutic Treatments", d: "ART, the Gottman Method, mindfulness, yoga therapy & more.", href: "/treatment-methods/therapeutic-treatments/", icon: "heart" },
  { t: "Neuropsychological Testing", d: "Comprehensive evaluation for clarity, diagnosis, and a real plan.", href: "/treatment-methods/neuropsychological-testing/", icon: "clipboard" },
  { t: "ADHD Testing", d: "Thorough, compassionate assessment for children, teens & adults.", href: "/treatment-methods/adhd-testing/", icon: "bolt" },
];
const conditions = [
  { t: "Depression", icon: "cloud", href: "/what-we-treat/depression/", d: "depression treatment" },
  { t: "Anxiety", icon: "alert", href: "/what-we-treat/anxiety/", d: "anxiety treatment" },
  { t: "Trauma & PTSD", icon: "heart", href: "/what-we-treat/trauma-ptsd/", d: "trauma and PTSD treatment" },
  { t: "Addiction", icon: "pill", href: "/what-we-treat/substance-use-disorder/", d: "addiction treatment" },
  { t: "ADHD", icon: "bolt", href: "/what-we-treat/adhd/", d: "ADHD treatment" },
  { t: "Bipolar Disorder", icon: "swap", href: "/what-we-treat/bipolar/", d: "bipolar disorder treatment" },
  { t: "OCD", icon: "refresh", href: "/what-we-treat/ocd/", d: "OCD treatment" },
  { t: "Co-occurring Disorders", icon: "link", href: "/what-we-treat/co-occurring/", d: "co-occurring disorder treatment" },
];
const condNote = {
  "Depression": "for low mood that won’t lift, including postpartum depression.",
  "Anxiety": "for worry, panic and social anxiety.",
  "Trauma & PTSD": "with EMDR, ART and trauma-informed groups.",
  "Addiction": "for alcohol, drug and prescription drug addiction.",
  "ADHD": "with testing and care for children, teens and adults.",
  "Bipolar Disorder": "with psychiatric medication management.",
  "OCD": "including TMS when it fits your plan.",
  "Co-occurring Disorders": "for mental health and addiction, treated together.",
};
const insurers = [
  ["Aetna","/Assets/Insurance/AETNA.webp"],["Anthem","/Assets/Insurance/Anthem.webp"],
  ["Blue Cross Blue Shield","/Assets/home-b/insurance/bcbs.svg"],["Cigna","/Assets/Insurance/CIGNA.webp"],
  ["ConnectiCare","/Assets/home-b/insurance/connecticare.svg"],["Harvard Pilgrim","/Assets/home-b/insurance/harvard-pilgrim.svg"],
  ["Magellan","/Assets/Insurance/Magellan%20Health.webp"],["Optum","/Assets/home-b/insurance/optum.svg"],
  ["TRICARE","/Assets/Insurance/TRICARE.webp"],["UMR","/Assets/home-b/insurance/umr.svg"],
  ["UnitedHealthcare","/Assets/home-b/insurance/unitedhealthcare.svg"],["VA Community Care","/Assets/Insurance/VA%20Community%20Care.webp"],
];
const team = [
  ["Tracy Sibley, PMHNP-BC","Psychiatric NP","/Assets/Team%20Members/tracy-sibley-pmhnp-bc-aprn.webp","/provider/tracy-sibley-pmhnp-bc-aprn/"],
  ["Christina Lindsay, PMHNP-BC","Psychiatric NP","/Assets/Team%20Members/christina-lindsay-pmhnp-bc-aprn.webp","/provider/christina-lindsay-pmhnp-bc-aprn/"],
  ["Christopher Patenaude, PA","Physician Assistant","/Assets/Team%20Members/chris-patenaude-pa.webp","/provider/chris-patenaude-pa/"],
  ["Kristine A. Schlichting, PhD","Founder & Director","/Assets/Team%20Members/kristine-a-schlichting-phd.webp","/provider/kristine-a-schlichting-ph-d/"],
  ["Eric Schwartz, PsyD, ABPP","Psychologist","/Assets/Team%20Members/eric-schwarz-psyd-abpp.webp","/provider/eric-schwartz-psy-d-abpp/"],
  ["Laura Miller, PhD","Neuropsychologist","/Assets/Team%20Members/laura-miller-phd.webp","/provider/laura-miller-ph-d/"],
  ["Ashley Singh, PsyD","Psychologist","/Assets/Team%20Members/ashley-singh-psyd.webp","/provider/ashley-singh-psy-d/"],
  ["Teesha Huertas, LCSW","Clinic Director","/Assets/Team%20Members/teesha-huertas-lcsw.webp","/provider/teesha-huertas-lcsw/"],
];
const gallery = [
  [P + "group-room-bright.webp", "A bright group therapy room", "Group room"],
  [P + "php-group-room.webp", "The PHP group room at Downtown Glastonbury", "PHP room"],
  [P + "tween-group-room.webp", "The tween group room in South Glastonbury", "Tween room"],
  [P + "south-glastonbury-waiting-room.webp", "The waiting room in South Glastonbury", "Waiting room"],
  [P + "westbrook-therapy-office.webp", "A therapy office at our Westbrook location", "Westbrook"],
  [P + "east-hampton-waiting-room.webp", "The waiting room at our East Hampton office", "East Hampton"],
];
const locPhoto = {
  "glastonbury-ct": "/Assets/locations/glastonbury/exterior.webp",
  "glastonbury-ct-2": P + "downtown-glastonbury-sign.webp",
  "glastonbury-ct-3": P + "south-glastonbury-office.webp",
  "west-hartford-ct": P + "west-hartford-office.webp",
  "east-hampton-ct": "/Assets/locations/east-hampton/exterior.webp",
  "westbrook-ct": P + "westbrook-sign.webp",
};
const reviews = [
  { name: "Jake Sted", meta: "2 months ago", text: "Hopewell’s IOP program made a huge difference in my life. The groups were engaging, and the therapists genuinely took the time to understand each person’s needs. It helped me develop real tools I use every day." },
  { name: "Emily Ross", meta: "8 months ago", text: "This is the best therapy place I have ever been to. I started in their Women’s Wellness IOP and all the clinicians are amazing and actually care about you. Now I’m doing individual therapy and med management — I highly recommend this place." },
  { name: "Joana Yoo", meta: "10 months ago", text: "Christopher P. was extremely accommodating and took the time to meet with us without making us feel rushed. His calm and respectful demeanor made it easy to open up, and we felt heard and understood. Highly recommended." },
  { name: "Cynthia Askew", meta: "6 months ago", text: "Rosa Kleinberg is a consummate professional — prepared and on top of her game. She asks the right questions and listens with care and understanding, committed to finding the right balance for a healthy, quality life." },
  { name: "Donald Krusinski", meta: "a year ago", text: "I'm under Tracy Sibley's care, and she is a kind and helpful person. She is so patient, understanding, and always very supportive. She is helping me through a difficult journey — I know I will be alright because of her excellent care!" },
  { name: "Lauren Irace", meta: "8 months ago", text: "I am very grateful for the care I am receiving at Hopewell Health Solutions. Everyone I have interacted with is extremely professional, friendly, and easy to talk to. I also appreciate the flexibility and willingness to accommodate additional support when needed. I highly recommend this practice to anyone seeking support." },
];
const initials = (n) => n.split(/[\s,.]+/).filter(Boolean).map((w) => w[0]).filter((c, i, a) => i === 0 || i === a.length - 1).join(".").toUpperCase() + ".";
const steps = [
  { icon: "phone", t: "Reach out", d: "Call us, or request a confidential callback — no commitment." },
  { icon: "shield", t: "Verify insurance", d: "We check your benefits for you — free, in minutes." },
  { icon: "clipboard", t: "Assessment", d: "A clinical assessment to match you to the right care." },
  { icon: "compass", t: "Begin care", d: "Start at the right level — and adjust as you heal." },
];
const faqs = [
  ["What ages does Hopewell Health Solutions treat?", `We care for clients aged 4 and older. Children and families can start with <a class="inl" href="/programs/counseling/">counseling</a> or <a class="inl" href="/programs/medication-management/">medication management</a>, and our <a class="inl" href="/programs/teen-tween-iop/">Teen &amp; Tween IOP</a> serves ages 8–17 after school.`],
  ["Do you take my insurance?", `We’re in-network with most major plans, including Aetna, Anthem, Blue Cross Blue Shield, Cigna, ConnectiCare, Harvard Pilgrim, Optum, TRICARE and UnitedHealthcare. We’ll check your benefits for you — free, in minutes. See <a class="inl" href="/rates-and-insurance-coverage/">rates and insurance coverage</a>.`],
  ["What is the difference between IOP and PHP?", `PHP is more intensive — about six hours a day, Monday through Friday. IOP is lighter (around three hours, four days a week), so you can keep working or going to school. Compare our <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program</a> and <a class="inl" href="/programs/partial-hospitalization-program/">partial hospitalization program</a>.`],
  ["Do you offer addiction treatment?", `Yes. Our <a class="inl" href="/programs/substance-use-iop/">addiction IOP</a> and co-occurring care run at our Downtown Glastonbury (300 Hebron Ave) and Westbrook offices, with mental health treatment alongside it. Learn more about <a class="inl" href="/what-we-treat/substance-use-disorder/">addiction treatment</a>.`],
  ["Where are your offices?", `We have six Connecticut offices: three in Glastonbury (Pratt St, Hebron Ave and Main St in South Glastonbury), plus West Hartford, East Hampton and Westbrook. See <a class="inl" href="/locations/">all locations</a>.`],
  ["Can I be seen by telehealth?", `Our IOP, PHP, therapy and medication management happen face to face, with telehealth when you need it. Ask our team which option fits your plan.`],
  ["How do I get started?", `Call <a class="inl" href="tel:8607351448">(860) 735-1448</a> or request a confidential callback. We verify your insurance, complete a clinical assessment, and match you to the right level of care. Read <a class="inl" href="/admissions/">how admissions works</a>.`],
];
const strip = (h) => h.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&");
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: strip(a) } })) };
const byId = (slug) => providers.find((p) => p.slug === slug);
const blogTeasers = [...posts].sort((a, b) => (a.datePublished < b.datePublished ? 1 : -1)).slice(0, 3);

// --- Homepage structured data: MedicalBusiness + aggregateRating + sameAs (rich results + knowledge panel) ---
const SITE = "https://www.hopewellhealthsolutions.com";
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": SITE + "/#organization",
  name: "Hopewell Health Solutions",
  alternateName: "Hopewell Health Solutions, LLC.",
  url: SITE + "/",
  logo: SITE + "/Assets/logo/hopewell-wave-logo.webp",
  image: SITE + "/Assets/full%20team%20happy.webp",
  description: "Outpatient mental health, addiction treatment and psychiatry across Connecticut — IOP, PHP, TMS, medication management and counseling for ages 4 and up.",
  // Downtown Glastonbury GBP number (CTM-tracked). The Pratt St main line isn't tracked by CTM.
  telephone: offices.find((l) => l.slug === "glastonbury-ct-2").phone,
  email: "hhs4help@gmail.com",
  priceRange: "$$",
  foundingDate: "2013",
  address: {
    "@type": "PostalAddress",
    streetAddress: "33 Pratt St",
    addressLocality: "Glastonbury",
    addressRegion: "CT",
    postalCode: "06033",
    addressCountry: "US",
  },
  areaServed: [
    "Glastonbury CT", "South Glastonbury CT", "West Hartford CT", "East Hampton CT", "Westbrook CT",
    "Hartford County CT", "Middlesex County CT", "South Windsor", "Wethersfield", "Rocky Hill",
    "Newington", "Berlin", "Colchester", "Old Saybrook", "Clinton",
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    reviewCount: "368",
    bestRating: "5",
    worstRating: "1",
  },
  sameAs: [
    ...socials.map((s) => s.href),
    "https://www.psychologytoday.com/us/treatment-rehab/hopewell-health-solutions-iop-glastonbury-ct/1084012",
    "https://www.bbb.org/us/ct/glastonbury/profile/psychologist/hopewell-health-solutions-llc-0111-87124396",
  ],
};

---

<Base title="Mental Health & Psychiatry in Glastonbury, Westbrook & West Hartford, CT | Hopewell Health Solutions" description="Hopewell Health Solutions — Connecticut’s trusted outpatient mental-health & psychiatry team. IOP, PHP, TMS & medication management across Glastonbury, West Hartford, East Hampton & Westbrook. 4.8★, Joint Commission accredited. Verify your insurance." canonical={SITE + "/"} image={heroSlides[0][0]}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <main class="hw">

  <!-- 1. Hero: rotating real team photos, form on the right (desktop) -->
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      {heroSlides.map(([src, , pos], i) => (
        <img class:list={["hero-slide", i === 0 && "is-active"]} src={src} alt="" width="1920" height="1440" style={`object-position:${pos}`} fetchpriority={i === 0 ? "high" : "low"} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
      ))}
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <svg class="hero-arcs" viewBox="0 0 800 800" aria-hidden="true"><circle cx="400" cy="400" r="390" /><circle cx="400" cy="400" r="300" /><circle cx="400" cy="400" r="210" /></svg>
    <div class="container hero-grid">
      <div>
        <h1>Mental Health &amp; Psychiatry in Connecticut</h1>
        <p class="hero-tag">There is hope to heal.</p>
        <a class="hero-rating" href="/testimonials/"><span class="g"><img src="/Assets/home-b/google-g.svg" alt="" width="16" height="16" /></span><span class="stars" aria-hidden="true">★★★★★</span><span>4.8 on Google · 368 reviews</span></a>
        <p class="lede">Outpatient mental-health and addiction care from a Connecticut team you can meet in person — <a class="inl" href="/programs/intensive-outpatient-program/">intensive programs</a>, psychiatry, <a class="inl" href="/programs/medication-management/">medication management</a> and <a class="inl" href="/treatment-methods/tms/">TMS</a>, delivered by clinicians who know your name. For ages 4 and up, in person or by telehealth.</p>
        <div class="hero-ctas">
          <a href="tel:8607351448" class="btn btn-blue"><Icon name="phone" />Call (860) 735-1448</a>
          <a href="#verify-m" class="btn btn-ghost only-m">Verify my insurance</a>
          <a href="/admissions/" class="btn btn-ghost only-d">How admissions works</a>
        </div>
        <p class="hero-where"><Icon name="pin" class="h-[18px] w-[18px]" />Glastonbury · West Hartford · East Hampton · Westbrook, CT</p>
        <div class="hero-dots" role="group" aria-label="Choose a hero photo">
          {heroSlides.map(([, label], i) => <button type="button" class:list={[i === 0 && "is-on"]} aria-label={`Show photo: ${label}`}></button>)}
        </div>
      </div>
      <div class="hero-form" id="verify"><LeadForm variant="card" formId="hhs-hero" /></div>
    </div>
  </section>

  <!-- Accredited & verified: bare logos -->
  <div class="creds">
    <div class="container">
      <ul class="creds-list" aria-label="Accredited and verified by">
        <li><img src="/Assets/home-b/joint-commission-seal.webp" alt="The Joint Commission — Gold Seal of Approval" width="240" height="240" loading="lazy" /></li>
        <li><LegitScriptSeal /></li>
        <li><img src="/Assets/home-b/psychology-today-verified.webp" alt="Psychology Today Verified" class="is-wide" width="300" height="80" loading="lazy" /></li>
        <li><BbbSeal /></li>
        <li><img src={C + "joint-commission.webp"} alt="The Joint Commission — Accredited" class="is-wide" width="300" height="72" loading="lazy" /></li>
      </ul>
    </div>
  </div>

  <MediaStrip bg="white" />

  <!-- 2. Why Hopewell -->
  <section id="why" class="section is-white">
    <div class="container">
      <div class="sec-head">
        <h2>Care You Can’t Get Just Anywhere</h2>
        <p class="lede">Intensive Outpatient (IOP) &amp; Partial Hospitalization (PHP) — including addiction IOP and PHP, plus programs for women, teens, tweens &amp; first responders. Built for who you are.</p>
      </div>
      <div class="usp-grid">
        <a class="usp-photo" href="/programs/">
          <img src={P + "iop-group-session.webp"} alt="A Hopewell IOP group session in progress" width="1200" height="900" loading="lazy" />
          <div class="usp-photo-copy">
            <span class="usp-icon"><Icon name="sparkles" /></span>
            <h3>Programs built for who you are</h3>
            <p>Intensive programs for adults, women, teens, tweens and first responders, plus addiction IOP — all under one roof.</p>
          </div>
        </a>
        {usps.map((u, i) => (
          <div class={`usp-card tone-${i}`}>
            <span class="usp-icon"><Icon name={u.icon} /></span>
            <h3>{u.href ? <a href={u.href} class="inl" style="text-decoration:none;color:inherit">{u.t}</a> : u.t}</h3>
            <p>{u.d}</p>
          </div>
        ))}
      </div>
      <ul class="usp-more is-stats">
        {stats.map(([n, l, icon]) => <li><span class="usp-more-icon"><Icon name={icon} /></span><span><strong>{n}</strong>{l}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- 3. Where would you like to begin -->
  <section class="section is-stone">
    <div class="container">
      <div class="sec-head">
        <h2>Where Would You Like to Begin?</h2>
        <p class="lede">One in five U.S. adults lives with a mental health condition — and untreated, it rarely gets easier on its own. You are not alone, and you don’t have to navigate this alone. Wherever you’re starting from, there’s a clear next step here.</p>
      </div>
      <div class="path-grid">
        <a class="path" href="/programs/">
          <img src="/Assets/service/home-help-myself-opt.webp" alt="Beginning your own healing journey" width="800" height="440" loading="lazy" />
          <div class="path-body"><span class="icon-badge"><Icon name="heart" /></span><h3>Help for myself</h3><p>Taking the first step takes courage. We’ll make the next ones simple.</p><span class="btn btn-navy">Find my program<Icon name="arrow" /></span></div>
        </a>
        <a class="path" href="/admissions/#for-families">
          <img src="/Assets/service/home-help-loved-one-opt.webp" alt="Supporting a loved one who is struggling" width="800" height="440" loading="lazy" />
          <div class="path-body"><span class="icon-badge"><Icon name="users" /></span><h3>Help for someone I love</h3><p>A child, partner, or parent who’s struggling? We’ll help you help them.</p><span class="btn btn-navy">Get guidance<Icon name="arrow" /></span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Mission -->
  <section id="about" class="section is-white">
    <div class="container split">
      <div>
        <h2>Our Mission Is to Help You Live Your Best Life</h2>
        <p class="lede" style="margin-top:18px">Hopewell Health Solutions is a multidisciplinary mental-health practice rooted in Glastonbury and West Hartford, Connecticut. Our board-certified specialists take an innovative approach to care for clients aged 4 and older — in a compassionate, safe environment, whether in person or by telehealth.</p>
