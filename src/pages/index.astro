---
import HomeSelfCheck from "../components/hw/HomeSelfCheck.astro";
import HeroCreds from "../components/hw/HeroCreds.astro";
// Homepage — rebuilt to the "Hopewell Homepage: Content Brief" (2026-11-16). 11 sections, top to bottom:
// 1 hero + form · 2 as featured in · 3 Google reviews · 4 what we help with · 5 why in-person + video ·
// 6 locations · 7 testimonials matched to the page · 8 how admissions works (+ form) · 9 team teaser · 10 FAQ ·
// 11 final call to action. Primary conversion = the coverage form (hero, mid-page, bottom + sticky mobile button).
// Compliance: addiction wording, no outcome/"best" claims, initials-only reviews, real photos only, Medicare/Medicaid
// stated plainly, no promise of coverage, admission or start date. No review-star schema (brief).
import { socials } from "../data/socials";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import LeadForm from "../components/LeadForm.astro";
import Creds from "../components/hw/Creds.astro";
import VideoCarousel from "../components/hw/VideoCarousel.astro";
import Reviews from "../components/hw/Reviews.astro";
import Team from "../components/hw/Team.astro";
import ClosingCta from "../components/hw/ClosingCta.astro";
import Locations from "../components/hw/Locations.astro";
import PhotoSlider from "../components/hw/PhotoSlider.astro";
import NewsVideos from "../components/programs/NewsVideos.astro";
import { VIDEOS, PODCAST, videoSchema } from "../data/videos.js";
import { providers } from "../data/providers.js";
import { locations as offices, OFFERS, OFFER_ORDER } from "../data/locations.js";
import { PHONE } from "../data/site.js";

const SITE = "https://www.hopewellhealthsolutions.com";
const P = "/Assets/hhs-2026/";

// 1. Hero (user pick 2026-11-18): like the old site. A full-width slider of the old site's banner photos (recovered via
// the Wayback Machine: couple, man, teen, woman, young woman) under ONE fixed text block: H1 (primary keyword), H2,
// H3 tagline, one button and the accreditation logos. The text never changes between slides; the photos lead. The
// photo runs behind the coverage form too (user 2026-11-18); phones get the form further down.
const heroSlides = [
  { img: P + "hero-slide-couple.webp", pos: "30% 35%", alt: "A smiling couple embracing outdoors" },
  { img: P + "hero-slide-man.webp", pos: "35% 30%", alt: "A smiling man outdoors" },
  { img: P + "hero-slide-teen.webp", pos: "30% 30%", alt: "A smiling teenage boy" },
  { img: P + "hero-slide-woman.webp", pos: "25% 30%", alt: "A smiling woman" },
  { img: P + "hero-slide-young-adult.webp", pos: "45% 35%", alt: "A young woman smiling outdoors" },
];

// 4. What we help with — conditions wheel (graphic) + program cards written around the visitor's problem.
// Group room gallery: the client's own iPhone photos (2026-11-17). Office not confirmed yet, so no office name in the alt text.
const roomPhotos = [
  { src: P + "group-lounge-feelings-wheel.webp", alt: "A Hopewell group room with a circle of chairs and an \u201cIt\u2019s okay to feel this way\u201d feelings wheel", w: 1050, h: 1400 },
  { src: P + "group-lounge-beach-mural.webp", alt: "A Hopewell group room with a beach mural, a screen and seating around a low table", w: 1050, h: 1400 },
  { src: P + "group-lounge-feelings-wheel-2.webp", alt: "Seating, plants and string lights in a Hopewell group room", w: 1050, h: 1400 },
];
const teamPhotos = [
  ["team-celebrating-outside", "The Hopewell Health Solutions team celebrating together outside the office"],
  ["team-with-dr-k-lawn", "Dr. Kristine Schlichting with members of the Hopewell team"],
  ["team-outside-with-therapy-dog", "Hopewell clinicians outside with the office therapy dog"],
  ["iop-team-hallway", "Members of Hopewell's intensive outpatient team"],
  ["iop-clinicians-group-room", "Hopewell IOP clinicians in a group room"],
];
const wheel = [
  ["Depression", "/what-we-treat/depression/", "#2f76c4", "Low mood, no energy, losing interest in things you used to enjoy.", [["Counseling", "/programs/counseling/"], ["Medication management", "/programs/medication-management/"], ["Adult IOP", "/programs/adult-mental-health-iop/"], ["PHP", "/programs/partial-hospitalization-program/"], ["TMS", "/treatment-methods/tms/"]]],
  ["Anxiety", "/what-we-treat/anxiety/", "#265489", "Constant worry, panic or avoiding things because of fear.", [["Counseling", "/programs/counseling/"], ["Adult IOP", "/programs/adult-mental-health-iop/"], ["Teen & Tween IOP", "/programs/teen-iop/"]]],
  ["Trauma", "/what-we-treat/trauma-ptsd/", "#5c7c6b", "Past events still showing up in nightmares, fear or numbness.", [["Women’s Trauma IOP", "/programs/womens-trauma-iop/"], ["First Responder IOP", "/programs/first-responder-iop/"], ["Counseling", "/programs/counseling/"]]],
  ["Addiction", "/what-we-treat/substance-use-disorder/", "#0b2f55", "When alcohol or drug use is hard to control.", [["Addiction IOP", "/programs/addiction-iop/"], ["MAT", "/treatment-methods/medication-assisted-treatment/"], ["Counseling", "/programs/counseling/"]]],
  ["ADHD", "/what-we-treat/adhd/", "#b6863c", "Trouble focusing, staying organized or sitting still.", [["ADHD testing", "/treatment-methods/adhd-testing/"], ["Medication management", "/programs/medication-management/"], ["Counseling", "/programs/counseling/"]]],
  ["Bipolar", "/what-we-treat/bipolar/", "#2f76c4", "Highs and lows in mood, energy and sleep.", [["Medication management", "/programs/medication-management/"], ["PHP", "/programs/partial-hospitalization-program/"], ["Adult IOP", "/programs/adult-mental-health-iop/"]]],
  ["OCD", "/what-we-treat/ocd/", "#265489", "Unwanted thoughts and rituals that are hard to stop.", [["Counseling", "/programs/counseling/"], ["Medication management", "/programs/medication-management/"], ["IOP", "/programs/intensive-outpatient-program/"]]],
  ["Co-occurring", "/what-we-treat/co-occurring/", "#5c7c6b", "Mental health and substance use, treated together.", [["Adult Co-Occurring IOP", "/programs/adult-mental-health-iop/"], ["PHP", "/programs/partial-hospitalization-program/"]]],
];
const R = 150, r = 82, C = 170;
const pt = (a, rad) => [C + rad * Math.cos(a), C + rad * Math.sin(a)];
const seg = (i, n) => {
  const g = 0.035, a0 = (i / n) * 2 * Math.PI - Math.PI / 2 + g, a1 = ((i + 1) / n) * 2 * Math.PI - Math.PI / 2 - g;
  const [x0, y0] = pt(a0, R), [x1, y1] = pt(a1, R), [x2, y2] = pt(a1, r), [x3, y3] = pt(a0, r);
  const am = (a0 + a1) / 2, [lx, ly] = pt(am, (R + r) / 2);
  return { d: `M${x0},${y0} A${R},${R} 0 0 1 ${x1},${y1} L${x2},${y2} A${r},${r} 0 0 0 ${x3},${y3} Z`, lx, ly };
};
const helps = [
  { q: "“Weekly therapy isn’t enough anymore.”", t: "Adult IOP & PHP", img: P + "php-group-room.webp", icon: "users", bar: "#2f76c4",
    html: `Structured care while you live at home: our <a class="inl" href="/programs/adult-mental-health-iop/">adult mental health IOP</a> meets a few hours a day, and our <a class="inl" href="/programs/partial-hospitalization-program/">partial hospitalization program (PHP)</a> adds full days when you need more.` },
  { q: "“Drinking or drug use is getting harder to control.”", t: "Addiction & Substance Use IOP", img: P + "iop-group-session.webp", icon: "link", bar: "#0b2f55",
    html: `Our <a class="inl" href="/programs/addiction-iop/">addiction IOP</a> treats addiction with <a class="inl" href="/what-we-treat/co-occurring/">co-occurring mental health and addiction</a> care alongside it, including step-down care after rehab, at 300 Hebron Ave and Westbrook.` },
  { q: "“My teen or tween is struggling.”", t: "Teen & Tween IOP", img: P + "teen-iop-outside.webp", icon: "sparkles", bar: "#5c7c6b",
    html: `After-school groups for ages 8–17, with the family part of the work. Learn about our <a class="inl" href="/programs/teen-iop/">teen and tween IOP</a>.` },
  { q: "“I’m carrying too much, and I want women who get it.”", t: "Women’s Wellness IOP", img: P + "womens-wellness-team.webp", icon: "heart", bar: "#b6863c",
    html: `A women-only group, mornings or evenings, for burnout, anxiety and life transitions. See the <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a>.` },
  { q: "“The job is following me home.”", t: "First Responder IOP", img: P + "group-lounge-beach-mural.webp", icon: "shield", bar: "#265489",
    html: `For police, fire, EMS and dispatch, with clinicians who understand the work. Explore the <a class="inl" href="/programs/first-responder-iop/">first responder IOP</a>.` },
  { q: "“I need the right medication, managed well.”", t: "Psychiatry & medication", img: P + "south-glastonbury-med-waiting-room.webp", icon: "pill", bar: "#5c7c6b",
    html: `Evaluations and follow-up with our psychiatric providers for ages 4 and up. Read about <a class="inl" href="/programs/medication-management/">psychiatry and medication management</a>.` },
  { q: "“Medication and therapy haven’t been enough.”", t: "TMS", img: P + "tms-neurostar-device.webp", icon: "brain", bar: "#2f76c4",
    html: `FDA-cleared, drug-free treatment for depression that hasn’t responded to other care. Learn about <a class="inl" href="/treatment-methods/tms/">TMS</a>.` },
  { q: "“I want answers about attention, learning or memory.”", t: "ADHD & neuropsychological testing", img: P + "tx-east-hampton-play-room.webp", icon: "clipboard", bar: "#b6863c",
    html: `Thorough evaluations for children, teens and adults: <a class="inl" href="/treatment-methods/adhd-testing/">ADHD testing</a> and <a class="inl" href="/treatment-methods/neuropsychological-testing/">neuropsychological testing</a>.` },
  { q: "“Since the baby came, I don’t feel like myself.”", t: "Postpartum depression", img: P + "sg-family-room.webp", icon: "heart", bar: "#265489",
    html: `Therapy, medication management and <a class="inl" href="/programs/womens-wellness-iop/">women’s groups</a> for new and expecting mothers. See <a class="inl" href="/what-we-treat/depression/">depression treatment</a>, including postpartum care.` },
];
for (const h of helps) h.href = h.html.match(/href="([^"]+)"/)?.[1] ?? "/programs/";

// 5. Why in-person — what happens when you visit (real photos).
const visit = [
  [P + "downtown-glastonbury-entrance.webp", "The entrance to our Downtown Glastonbury office", "pin", "You arrive", "We confirm your appointment, your insurance and which office to come to before your first visit."],
  [P + "sg-front-desk.webp", "The front desk at our South Glastonbury office", "clipboard", "A warm check-in", "Our front desk team greets you and walks you through paperwork, so nothing feels rushed."],
  [P + "sg-waiting-room.webp", "The waiting room at our South Glastonbury office", "home", "A calm place to wait", "Comfortable, private waiting rooms, more like a living room than a clinic."],
  [P + "group-room-bright.webp", "A Hopewell group therapy room", "users", "Shown around", "Your clinician welcomes you and shows you the rooms and group spaces where you’ll meet."],
];
const tour = VIDEOS.find((v) => v.yt === "s0sEv1hIrfk"); // the old homepage welcome video (user 2026-11-18)
const teenTour = VIDEOS.find((v) => v.yt === "loSaQbRc-oE");

// 7. Testimonials matched to the page (Evan feature removed, user 2026-11-17): IOP & recovery, a teen (with his mom), Women's Wellness.
const matched = ["7ISgjKEBoZo", "awy7nfDgC0k", "eX6WO-MRdPs"].map((id) => VIDEOS.find((v) => v.yt === id)).filter(Boolean);

// 8. Admissions + insurance.
const insurers = [
  ["Aetna","/Assets/Insurance/AETNA.webp"],["Anthem","/Assets/Insurance/Anthem.webp"],
  ["Blue Cross Blue Shield","/Assets/home-b/insurance/bcbs.svg"],["Cigna","/Assets/Insurance/CIGNA.webp"],
  ["ConnectiCare","/Assets/home-b/insurance/connecticare.svg"],["Harvard Pilgrim","/Assets/home-b/insurance/harvard-pilgrim.svg"],
  ["Optum","/Assets/home-b/insurance/optum.svg"],["UnitedHealthcare","/Assets/home-b/insurance/unitedhealthcare.svg"],
  ["TRICARE","/Assets/Insurance/TRICARE.webp"],["VA Community Care","/Assets/Insurance/VA%20Community%20Care.webp"],
  ["Magellan","/Assets/Insurance/Magellan%20Health.webp"],["UMR","/Assets/home-b/insurance/umr.svg"],
];
const admit = [
  ["phone", "Call or send the form", `Call <a class="inl" href="${PHONE.href}">${PHONE.display}</a> or use the coverage form. An admissions specialist talks with you about what’s going on.`],
  ["shield", "We check your insurance", "We verify your benefits for free before you start, so you know what’s covered."],
  ["calendar", "Assessment and start date", `A <a class="inl" href="/admissions/what-to-expect/">clinical assessment</a> matches you to the right program, and we set a start date that works.`],
];

// 9. Team teaser.
const teamSlugs = ["teesha-huertas-lcsw", "kaitlyn-czapiga-lmsw", "tracy-sibley-pmhnp-bc-aprn", "christina-lindsay-pmhnp-bc-aprn", "chris-patenaude-pa", "laura-miller-ph-d"];
const team = teamSlugs.map((s) => providers.find((p) => p.slug === s)).filter((p) => p && p.photo);
const shortRole = (r) => r.replace(/^Board-Certified /, "").replace(/ · .*/, "").replace(/ & Licensed Clinical Social Worker/, "");

// 10. FAQ — 12 questions in 4 groups (brief). Bracketed facts in the brief are written neutrally until TJ confirms.
const faqGroups = [
  ["Getting started", [
    ["How do I get started at Hopewell?", `Call us at <a class="inl" href="${PHONE.href}">${PHONE.display}</a> or fill out the coverage form on this page. An admissions specialist will talk with you about what’s going on, check your insurance, and set up an assessment. Forms sent after hours are answered the next business day. Read <a class="inl" href="/admissions/">how admissions works</a>.`],
    ["How soon can I start?", "It depends on the program and location you need. Our admissions team gives you a start date once your insurance is verified and your assessment is complete."],
    ["Do I need a referral?", "You can call us directly. Our admissions team will tell you if your plan or program needs a referral, and we also accept referrals from doctors, therapists and schools."],
    ["What if I’m in crisis right now?", `Hopewell is an outpatient program, not an emergency service. If you or someone you love is in danger, call or text <a class="inl" href="tel:988">988</a>, call 911, or go to your nearest emergency room.`],
  ]],
  ["Insurance and cost", [
    ["Do you take my insurance?", `We work with most major commercial plans, including Aetna, Anthem, Blue Cross Blue Shield, Cigna, ConnectiCare, Harvard Pilgrim, Optum, UnitedHealthcare, TRICARE and VA Community Care. We check your benefits for free before you start, so you know what’s covered. See <a class="inl" href="/rates-and-insurance-coverage/">rates and insurance</a>.`],
    ["Do you accept Medicare or Medicaid?", "No. Hopewell does not accept Medicare or Medicaid (HUSKY) at this time. If that’s your coverage, our team can point you to other options in Connecticut."],
  ]],
  ["Programs and care", [
    ["What’s the difference between IOP and PHP?", `Both are structured outpatient programs where you go home each day. The <a class="inl" href="/programs/partial-hospitalization-program/">partial hospitalization program (PHP)</a> is the more intensive level, with more hours each day. An <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program (IOP)</a> meets for fewer hours a week, so it’s easier to fit around work or school. Your assessment helps decide which fits.`],
    ["Do you treat addiction?", `Yes. We offer an <a class="inl" href="/programs/addiction-iop/">addiction IOP</a> for adults, care for <a class="inl" href="/what-we-treat/co-occurring/">co-occurring mental health and substance use</a>, and <a class="inl" href="/treatment-methods/medication-assisted-treatment/">medication-assisted treatment (MAT)</a>. Addiction care is offered at our 300 Hebron Ave (Glastonbury) and Westbrook offices.`],
    ["What ages do you see?", `We care for children, teens and adults, ages 4 and up. We run separate <a class="inl" href="/programs/teen-iop/">teen</a> and <a class="inl" href="/programs/tween-iop/">tween IOPs</a>, and adult programs for ages 18 and up.`],
    ["Do you offer psychiatry and medication management?", `Yes. Our psychiatric providers offer evaluations and ongoing <a class="inl" href="/programs/medication-management/">medication management</a>, and we also offer <a class="inl" href="/treatment-methods/tms/">TMS</a> and <a class="inl" href="/treatment-methods/neuropsychological-testing/">ADHD and neuropsychological testing</a>.`],
  ]],
  ["Locations and visits", [
    ["Where are you located?", `We have offices in <a class="inl" href="/location/glastonbury-ct-2/">Glastonbury (300 Hebron Ave)</a>, <a class="inl" href="/location/glastonbury-ct/">Glastonbury (Pratt St)</a>, <a class="inl" href="/location/glastonbury-ct-3/">South Glastonbury</a>, <a class="inl" href="/location/west-hartford-ct/">West Hartford</a>, <a class="inl" href="/location/east-hampton-ct/">East Hampton</a> and <a class="inl" href="/location/westbrook-ct/">Westbrook</a>, and we serve families along the shoreline, including Niantic, Branford, Madison and Guilford. Each location offers different programs, so check the location page.`],
    ["Is care in person or by telehealth?", `Our programs are built around <a class="inl" href="/post/the-importance-of-in-person-intensive-outpatient-programs-iops/">in-person care</a>, with groups and clinicians you meet face to face. Telehealth is available for some services when coming in isn’t possible.`],
  ]],
];
const strip = (h) => h.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&");
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqGroups.flatMap(([, qs]) => qs).map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: strip(a) } })) };

// Schema: MedicalOrganization + each office as a MedicalClinic (address, phone, hours, services offered there).
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalOrganization",
  "@id": SITE + "/#organization",
  name: "Hopewell Health Solutions",
  alternateName: "Hopewell Health Solutions, LLC.",
  url: SITE + "/",
  logo: SITE + "/Assets/logo/hopewell-wave-logo.webp",
  image: SITE + "/Assets/full%20team%20happy.webp",
  description: "In-person mental health, addiction and psychiatry care in Connecticut, IOP, PHP, addiction IOP, TMS, medication management and counseling for ages 4 and up.",
  telephone: offices.find((l) => l.slug === "glastonbury-ct-2").phone,
  email: "hhs4help@gmail.com",
  foundingDate: "2013",
  areaServed: ["Glastonbury CT", "South Glastonbury CT", "West Hartford CT", "East Hampton CT", "Westbrook CT", "Hartford County CT", "Middlesex County CT", "Niantic CT", "Branford CT", "Madison CT", "Guilford CT"],
  sameAs: [...socials.map((s) => s.href), "https://www.psychologytoday.com/us/treatment-rehab/hopewell-health-solutions-iop-glastonbury-ct/1084012", "https://www.bbb.org/us/ct/glastonbury/profile/psychologist/hopewell-health-solutions-llc-0111-87124396"],
  subOrganization: offices.map((l) => ({
    "@type": "MedicalClinic", "@id": `${SITE}/location/${l.slug}/#clinic`, name: `Hopewell Health Solutions, ${l.name}`, url: `${SITE}/location/${l.slug}/`,
    telephone: l.phone, openingHours: l.hours,
    address: { "@type": "PostalAddress", streetAddress: l.street, addressLocality: l.city, addressRegion: "CT", postalCode: l.zip, addressCountry: "US" },
    geo: { "@type": "GeoCoordinates", latitude: l.lat, longitude: l.lng },
    availableService: OFFER_ORDER.filter((k) => l.offers?.includes(k)).map((k) => ({ "@type": "MedicalTherapy", name: OFFERS[k].t, url: SITE + OFFERS[k].href })),
  })),
};
const videoLd = [tour, ...matched].filter(Boolean).map((v) => videoSchema(v, SITE));
---

<Base title="Mental Health & Addiction Treatment in CT | Hopewell" description="In-person mental health, addiction and psychiatry care in Glastonbury, West Hartford, East Hampton and Westbrook, CT. IOP, PHP and more. Check coverage." canonical={SITE + "/"} image={heroSlides[0].img}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(videoLd)} />
  <main class="hw">

  <!-- 1. Hero + form -->
  <section class="hero hero-old" aria-roledescription="carousel" aria-label="Hopewell Health Solutions">
    <div class="ho-media">
      {heroSlides.map((x, i) => (
        <img class:list={["ho-slide", i === 0 && "is-on"]} src={x.img} alt={i === 0 ? x.alt : ""} width="1536" height="768" style={`object-position:${x.pos}`} fetchpriority={i === 0 ? "high" : "low"} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
      ))}
    </div>
    <div class="container ho-grid">
      <div class="ho-text">
        <h1>Mental Health &amp; Addiction Treatment in Connecticut</h1>
        <h2 class="ho-h2">Outpatient Programs, Therapy &amp; Psychiatry in Glastonbury, Westbrook and Across CT</h2>
        <h3 class="ho-h3">There is <em>hope</em> to <em>heal</em></h3>
        <a href="#verify" class="btn btn-blue ho-cta">Start today <span aria-hidden="true">&rarr;</span></a>
        <HeroCreds />
      </div>
      <div class="hero-form ho-form" id="verify"><LeadForm variant="card" formId="hhs-hero" /></div>
    </div>
    <div class="ho-dots" role="group" aria-label="Choose a photo">
      {heroSlides.map((x, i) => <button type="button" class:list={[i === 0 && "is-on"]} aria-label={`Show photo ${i + 1}`}></button>)}
    </div>
  </section>

  <!-- 2. Trust bar: accreditations + as featured in -->
  <Creds />

  <!-- 3. Testimonials matched to the page (moved under the hero, user 2026-11-17) -->
  <VideoCarousel videos={matched} mode="grid" tone="navy" heading="Patient Stories From Our Outpatient Programs" lede="Hopewell clients share what treatment was like, in their own words: IOP and recovery, a teen and his mom, and Women’s Wellness. <a class='inl' href='/testimonials/'>Read more patient stories</a>." link={{ href: "/testimonials/", label: "Read more patient stories" }} />

  <!-- 4. What we help with -->
  <section class="section is-stone" id="programs">
    <div class="container">
      <div class="wh-top">
        <div class="sec-head" style="margin:0">
          <h2>Mental Health and Addiction Conditions We Treat</h2>
          <p class="lede">Hopewell treats the conditions we see most, depression, anxiety, trauma, addiction, ADHD and more, for children, teens and adults across Connecticut. Start with what’s going on, and we’ll match you to the right program. See <a class="inl" href="/what-we-treat/">everything we treat</a> or <a class="inl" href="/programs/">all programs</a>.</p>
          <ul class="wh-legend">
            <li><Icon name="users" class="h-5 w-5" />Children, teens and adults, ages 4 and up</li>
            <li><Icon name="refresh" class="h-5 w-5" />Step up or down in care with the same team</li>
            <li><Icon name="link" class="h-5 w-5" />Mental health and addiction treated together</li>
          </ul>
          <div class="wh-pick" aria-live="polite">
            {wheel.map(([t, href, c, line, progs], i) => (
              <div class="wh-pick-p" data-i={i} hidden={i !== 0} style={`--c:${c}`}>
                <p class="wh-pick-h"><span class="wh-pick-dot"></span>{t}</p>
                <p class="wh-pick-line">{line}</p>
                <p class="wh-pick-progs">{progs.map(([n, u], k) => <Fragment>{k > 0 && <span aria-hidden="true"> · </span>}<a class="inl" href={u}>{n}</a></Fragment>)}</p>
                <p class="wh-pick-more">Read how we treat <a class="inl" href={href}>{t === "Co-occurring" ? "co-occurring disorders" : t === "Trauma" ? "trauma and PTSD" : t.toLowerCase()}</a>.</p>
              </div>
            ))}
          </div>
        </div>
        <figure class="wh-wheel">
          <svg viewBox="0 0 340 340" role="img" aria-label="Conditions we treat: depression, anxiety, trauma and PTSD, addiction, ADHD, bipolar disorder, OCD and co-occurring disorders">
            {wheel.map(([t, href, c], i) => { const s = seg(i, wheel.length); return (
              <a href={href} aria-label={`${t} treatment`} data-i={i} class="wh-seg-a">
                <g class="wh-seg"><path d={s.d} fill={c} /><text x={s.lx} y={s.ly + 4} text-anchor="middle" font-size="11.5" font-weight="800" fill="#fff" font-family="Urbanist, sans-serif">{t}</text></g>
              </a>
            ); })}
            <circle cx={C} cy={C} r={r - 8} fill="#fff" />
