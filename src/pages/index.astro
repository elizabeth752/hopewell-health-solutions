<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const ho = [...document.querySelectorAll<HTMLElement>(".ho-slide")];
  const hoDots = [...document.querySelectorAll<HTMLButtonElement>(".ho-dots button")];
  let hoCur = 0;
  const hoShow = (n: number) => { hoCur = (n + ho.length) % ho.length; ho.forEach((x, i) => x.classList.toggle("is-on", i === hoCur)); hoDots.forEach((d, i) => d.classList.toggle("is-on", i === hoCur)); };
  hoDots.forEach((d, i) => d.addEventListener("click", () => hoShow(i)));
  if (!reduce && ho.length > 1) setInterval(() => { if (!document.hidden) hoShow(hoCur + 1); }, 5500);
  // Sticky mobile button hides while a form is on screen.
  const sticky = document.querySelector<HTMLElement>(".hw-sticky-cta");
  // Hidden while a form or the hero buttons are on screen (they overlapped on phones).
  const forms = document.querySelectorAll(".lead-card, .hero-ctas");
  if (sticky && "IntersectionObserver" in window) {
    const vis = new Set();
    const io = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? vis.add(e.target) : vis.delete(e.target))); sticky.classList.toggle("is-hidden", vis.size > 0); });
    forms.forEach((f) => io.observe(f));
  }
  // What we help with (option C): hovering or focusing a wheel segment shows that condition in the panel.
  const picks = document.querySelectorAll<HTMLElement>(".wh-pick-p");
  document.querySelectorAll<SVGAElement>(".wh-seg-a").forEach((a) => {
    const show = () => { picks.forEach((p) => (p.hidden = p.dataset.i !== a.dataset.i)); document.querySelectorAll(".wh-seg-a").forEach((x) => x.classList.toggle("is-on", x === a)); };
    a.addEventListener("mouseenter", show); a.addEventListener("focus", show);
  });
  document.querySelector(".wh-seg-a")?.classList.add("is-on");
</script>
