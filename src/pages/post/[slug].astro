---
import Team from "../../components/hw/Team.astro";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import "../../styles/pages/blog.css";
import BlogListen from "../../components/blog/BlogListen.astro";
import BlogSelfCheck from "../../components/blog/BlogSelfCheck.astro";
import BlogNextStep from "../../components/blog/BlogNextStep.astro";
import BlogPrograms from "../../components/blog/BlogPrograms.astro";
import BlogCovered from "../../components/blog/BlogCovered.astro";
import BlogVideo from "../../components/blog/BlogVideo.astro";
import BlogClosing from "../../components/blog/BlogClosing.astro";
import { quizFor } from "../../data/quizzes.js";
import { VIDEOS } from "../../data/videos.js";
import { posts, relatedPosts } from "../../data/posts.js";
import { providers } from "../../data/providers.js";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;

const SITE = "https://www.hopewellhealthsolutions.com";
const TM = "/Assets/Team%20Members/";
const INS = "/Assets/Insurance/";
const canonical = `${SITE}/post/${post.slug}/`;

// --- Author / reviewer (E-E-A-T) — real clinicians from providers.js ---
const byId = (slug) => providers.find((p) => p.slug === slug);
const author = byId(post.authorSlug);
const reviewer = post.reviewerSlug ? byId(post.reviewerSlug) : null;
// "Medically reviewed" only for prescribers (MD/DO/APRN/NP/PA); psychologists and therapists (e.g. PhD) are "Clinically reviewed".
const reviewLabel = reviewer && /\b(MD|M\.D\.|DO|APRN|PMHNP|DNP|NP|FNP|PA)\b/.test(reviewer.credentials ?? "") ? "Medically reviewed by" : "Clinically reviewed by";
const initials = (name) => {
  const w = name.split(",")[0].trim().split(" ").filter(Boolean);
  return (w[0][0] + (w.length > 1 ? w[w.length - 1][0] : "")).toUpperCase();
};
const photoUrl = (p) => (p && p.photo ? `${TM}${p.photo}.webp` : null);
const authorExcerpt = author?.bio ? author.bio.split("\n\n")[0] : "";

// --- Dates ---
const fmt = (iso) => new Date(`${iso}T12:00:00`).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const wasUpdated = post.dateModified && post.dateModified !== post.datePublished;

// --- Sidebar widgets ---
const insurers = [
  ["Aetna", "AETNA.webp"], ["Anthem", "Anthem.webp"], ["Blue Cross Blue Shield", "BCBS.webp"],
  ["Cigna", "CIGNA.webp"], ["Optum", "Optum.webp"], ["UnitedHealthcare", "UnitedHealthcare.webp"],
];
// Verbatim GBP reviews (mirrors the approved set on the homepage — never fabricate)
const reviews = [
  { name: "Emily Ross", meta: "8 months ago", text: "This is the best therapy place I have ever been to. I started in their Women’s Wellness IOP and all the clinicians are amazing and actually care about you." },
];

// --- Share links ---
const enc = encodeURIComponent;
const share = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${enc(canonical)}`,
  twitter: `https://twitter.com/intent/tweet?url=${enc(canonical)}&text=${enc(post.title)}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(canonical)}`,
};

const related = relatedPosts(post.slug, 3);

// --- Metas: pull verbatim from the live page where provided; fall back to excerpt ---
// Migrated titles carry the old site's boilerplate ("| Mental Health & Psychiatry located in Glastonbury and West
// Hartford, CT | Hopewell Health Solutions"), which pushes them past 150 chars. Strip it, then add the longest
// brand suffix that keeps the title within ~60 chars (SEO audit 2026-11-18).
const BOILER = /\s*\|\s*Mental Health & Psychiatry located in[^|]*/i;
const baseTitle = (post.metaTitle || post.title).replace(BOILER, "").replace(/\s*\|\s*Hopewell Health Solutions\s*$/i, "").replace(/\s+/g, " ").trim();
const metaTitle = post.seoTitle || [`${baseTitle} | Hopewell Health Solutions`, `${baseTitle} | Hopewell`].find((t) => t.length <= 60) || baseTitle;
const rawDesc = (post.metaDescription || post.excerpt || "").replace(/\s+/g, " ").trim();
// Cut long descriptions at a word boundary rather than mid-word.
const metaDesc = rawDesc.length <= 160 ? rawDesc : rawDesc.slice(0, 158).replace(/\s+\S*$/, "").replace(/[\s,;:–—-]+$/, "") + "…";
const hasSources = post.sources && post.sources.length > 0;

// --- Body: migrated posts carry verbatim `bodyHtml`; auto-build the TOC from its <h2>s ---
// Hand-authored posts use structured `sections` instead. We build a unified `tocItems`
// list and (for bodyHtml) inject id anchors so the TOC links resolve.
const slugifyHeading = (s) =>
  s.toLowerCase().replace(/<[^>]+>/g, "").replace(/&[a-z]+;/gi, " ").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
let bodyHtml = post.bodyHtml || null;
let tocItems = [];
if (bodyHtml) {
  // A few migrated bodies start their outline at <h3> (no <h2>), which skips a level after the page H1.
  // Shift every heading up so the outline starts at <h2>; the words stay exactly as written.
  const firstLevel = Number((bodyHtml.match(/<h([2-6])[\s>]/i) || [])[1] || 2);
  if (firstLevel > 2) {
    const shift = firstLevel - 2;
    bodyHtml = bodyHtml.replace(/<(\/?)h([3-6])(?=[\s>])/gi, (_m, close, lv) => `<${close}h${Math.max(2, Number(lv) - shift)}`);
  }
  bodyHtml = bodyHtml.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/gi, (_m, _attrs, inner) => {
    const text = inner.replace(/<[^>]+>/g, "").trim();
    const id = slugifyHeading(text);
    tocItems.push({ id, text });
    return `<h2 id="${id}" class="post-h2">${inner}</h2>`;
  });
} else if (post.sections) {
  tocItems = post.sections.map((s) => ({ id: s.id, text: s.h2 }));
}

// --- In-article photos ---
// Every post already has a hero (`heroImage`), shown as the featured image at the
// top of the article. Posts with no pictures in the body get 1–2 more, drawn from
// clinic photos already approved on the service pages. Hand-authored posts that
// already include infographics are left as they are. The same pool is rotated by
// slug so articles in one category don't all show the identical pair.
const clinicPhotos = {
  // Old service/womens-wellness photo retired (client: shows former employees) — current room photo, no people.
  women: { src: "/Assets/hhs-2026/group-room-bright.webp", alt: "A bright, welcoming group room for Hopewell's Women's Wellness IOP in Connecticut" },
  feelings: { src: "/Assets/service/trauma-informed-group.webp", alt: "Trauma-informed group therapy at Hopewell Health Solutions" },
  room: { src: "/Assets/service/therapy-room.webp", alt: "A calming counseling room at Hopewell Health Solutions, Glastonbury CT" },
  chairs: { src: "/Assets/service/trauma-informed-individual.webp", alt: "Trauma-informed individual therapy at Hopewell Health Solutions" },
  groupRoom: { src: "/Assets/service/group-therapy-room.webp", alt: "A comfortable treatment room at Hopewell Health Solutions, Glastonbury CT" },
  iop: { src: "/Assets/service/iop-group-session.webp", alt: "Intensive outpatient program group in Glastonbury, CT" },
  teen: { src: "/Assets/tweens-1729660767703.webp", alt: "A group of teenagers laughing together" },
  tween: { src: "/Assets/02-1729661349143.webp", alt: "Two kids laughing together on a school bus" },
  adhd: { src: "/Assets/Blogs/secrets-from-a-504-insider-a-parents-guide-to-academic-accommodations.webp", alt: "A parent and child meeting with a teacher about attention and learning at school" },
  adhdEval: { src: "/Assets/12.webp", alt: "A clinician meeting one-on-one with a teen during an evaluation" },
  trauma: { src: "/Assets/service/what-is-trauma-ptsd.webp", alt: "Compassionate, trauma-informed care at Hopewell Health Solutions, Connecticut" },
  substance: { src: "/Assets/AdobeStock_413328337-1747245457937.webp", alt: "Adults talking together in a substance use group session" },
  co: { src: "/Assets/hhs-2026/adult-evening-iop-group.webp", alt: "An adult evening IOP group with Hopewell clinicians in Glastonbury, CT" },
  php: { src: "/Assets/service/php-what-is.webp", alt: "Partial hospitalization day program in Glastonbury, CT" },
  phpBenefits: { src: "/Assets/service/what-is-adhd.webp", alt: "Adults in a group session at Hopewell's Glastonbury office" },
  dbt: { src: "/Assets/service/dbt.webp", alt: "Dialectical Behavior Therapy at Hopewell Health Solutions" },
  solutions: { src: "/Assets/service/solutions-focused.webp", alt: "Solutions-Focused Therapy at Hopewell Health Solutions" },
  team: { src: "/Assets/service/team-dedicated.webp", alt: "The Hopewell Health Solutions team in Connecticut" },
  responder: { src: "/Assets/service/first-responder-session.webp", alt: "A police officer receiving one-on-one support at Hopewell Health Solutions' First Responder IOP" },
};
const photosByCategory = {
  "Women's Mental Health": ["women", "feelings", "room", "chairs"],
  "Inclusive Care": ["adhd", "adhdEval", "teen", "room"],
  "Intensive Outpatient (IOP)": ["iop", "groupRoom", "php", "teen"],
  "Levels of Care": ["php", "phpBenefits", "iop", "groupRoom"],
  "Medication & Psychiatry": ["groupRoom", "room", "chairs", "dbt"],
  "Mental Health": ["room", "chairs", "feelings", "iop"],
  "Teens & Families": ["teen", "tween", "groupRoom", "adhd"],
  "Therapy Approaches": ["dbt", "solutions", "chairs", "room"],
  "Trauma & PTSD": ["trauma", "feelings", "chairs", "responder"],
  "Addiction & Recovery": ["substance", "co", "iop", "groupRoom"],
  "Treatment & Access": ["room", "team", "iop", "php"],
  "Meet the Team": ["team", "women", "room", "iop"],
};
const slugHash = (s) => {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return h;
};
const existingInline = bodyHtml
  ? (bodyHtml.match(/<img\b/gi) || []).length
  : (post.sections || []).reduce((n, s) => n + (s.blocks || []).filter((b) => b.img).length, 0);
const paragraphCount = bodyHtml
  ? (bodyHtml.match(/<p[\s>]/gi) || []).length
  : (post.sections || []).reduce((n, s) => n + (s.blocks || []).filter((b) => b.p).length, 0);
// Task 16 (client doc "Hopewell Website Updates"): posts can list their own in-body images —
//   bodyImages: [{ src: "/Assets/hhs-2026/...", alt: "...", afterHeading: "Key Components" }, ...]  (2–3 recommended)
// `afterHeading` (optional) places the photo after the first paragraph of the section whose H2 contains that
// text (case-insensitive), so each photo sits beside the part of the article it illustrates; images without it
// are spread evenly. Posts set bodyImages in their own file or in BODY_IMAGES in src/data/posts.js.
// Without bodyImages, posts with no pictures in the body get 1–2 approved clinic photos as before.
const inlineTarget = existingInline > 0 ? 0 : paragraphCount < 4 ? 1 : 2;
const photoPool = (photosByCategory[post.category] || ["room", "iop", "groupRoom", "team"])
  .map((key) => clinicPhotos[key])
  .filter((img) => img && img.src !== post.heroImage);
const poolStart = photoPool.length ? slugHash(post.slug) % photoPool.length : 0;
const inlineImages = Array.isArray(post.bodyImages) && post.bodyImages.length
  ? post.bodyImages.filter((b) => b && b.src).slice(0, 3).map((b) => ({ src: b.src, alt: b.alt || "", afterHeading: b.afterHeading || "" }))
  : photoPool.length
    ? Array.from({ length: Math.min(inlineTarget, photoPool.length) }, (_, i) => photoPool[(poolStart + i) % photoPool.length])
    : [];
const spread = (count, n) => { const out = []; for (let i = 0; i < count; i++) { const at = Math.min(n - 1, Math.max(0, Math.round(((i + 1) * n) / (count + 1)) - 1)); if (!out.includes(at)) out.push(at); } return out; };
const figureMarkup = (img) => {
  const alt = String(img.alt || "").replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
  return `<figure class="post-inline-figure"><img src="${img.src}" alt="${alt}" loading="lazy" decoding="async" /></figure>`;
};
if (bodyHtml && inlineImages.length) {
  const matches = [...bodyHtml.matchAll(/<\/p>/gi)];
  if (!matches.length) {
    bodyHtml += inlineImages.map(figureMarkup).join("");
  } else {
    const slots = spread(inlineImages.length, matches.length);
    // Default: spread evenly, just after a paragraph. Images that name a heading go after the first
    // paragraph of that H2's section — or at the end of the section if it has no paragraph (lists only).
    const end = (m) => m.index + m[0].length;
    const positions = slots.map((slot) => (slot === undefined ? undefined : end(matches[slot])));
    const h2s = [...bodyHtml.matchAll(/<h2[^>]*>([\s\S]*?)<\/h2>/gi)].map((m) => ({ at: m.index, text: m[1].replace(/<[^>]+>/g, "").toLowerCase() }));
    inlineImages.forEach((img, i) => {
      if (!img.afterHeading) return;
      const hi = h2s.findIndex((x) => x.text.includes(img.afterHeading.toLowerCase()));
      if (hi < 0) return;
      const nextAt = hi + 1 < h2s.length ? h2s[hi + 1].at : bodyHtml.length;
      const firstP = matches.find((m) => m.index > h2s[hi].at);
      positions[i] = firstP && firstP.index < nextAt ? end(firstP) : nextAt;
    });
    const placed = [];
    inlineImages.forEach((img, i) => { if (positions[i] !== undefined && !placed.some((p) => p.at === positions[i])) placed.push({ at: positions[i], img }); });
    placed.sort((x, y) => y.at - x.at);
    for (const { at, img } of placed) {
      bodyHtml = bodyHtml.slice(0, at) + figureMarkup(img) + bodyHtml.slice(at);
    }
  }
}
const inlineAfter = {};
if (!bodyHtml && inlineImages.length && post.sections?.length) {
  const n = post.sections.length;
  const slots = spread(inlineImages.length, n);
  inlineImages.forEach((img, i) => {
    let idx = img.afterHeading ? post.sections.findIndex((sec) => String(sec.h2 || "").toLowerCase().includes(img.afterHeading.toLowerCase())) : -1;
    if (idx < 0) idx = slots[i];
    if (idx !== undefined && !inlineAfter[idx]) inlineAfter[idx] = img;
  });
}

// --- JSON-LD: BlogPosting with author + publisher (E-E-A-T core) ---
// Schema strategy mirrors the Virtue Recovery Center build: BreadcrumbList, an
// auto-built FAQPage, and an ImageObject per in-article graphic — see docs/
// blog-post-standard.md's schema section on that project for the pattern being
// matched. NOTE: `reviewedBy` is a real schema.org property only on
// MedicalWebPage, not on Article/BlogPosting — adding it here isn't recognized
// by validators, so the reviewer stays visible-only (byline + bio card), not in
// schema, same as before this change.
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: metaDesc,
  image: `${SITE}${post.heroImage}`,
  datePublished: post.datePublished,
  dateModified: post.dateModified || post.datePublished,
  ...(author ? { author: { "@type": "Person", name: author.name, jobTitle: author.role, url: `${SITE}/provider/${author.slug}/` } } : {}),
  publisher: { "@type": "Organization", name: "Hopewell Health Solutions", logo: { "@type": "ImageObject", url: `${SITE}/Assets/logo/hopewell-wave-logo.webp` } },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
};

// --- JSON-LD: BreadcrumbList ---
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog/` },
    { "@type": "ListItem", position: 3, name: post.title, item: canonical },
  ],
};

// --- JSON-LD: FAQPage — auto-built from question-style H2s in hand-authored posts.
// Per the Virtue build's rule: every FAQ answer must be the article's own paragraph,
// verbatim, not written fresh for schema — using each section's first `p` block
// guarantees that instead of hand-maintaining a separate faqs list per post.
// Migrated posts (bodyHtml) are skipped; retrofitting those is a separate pass.
const faqSections = bodyHtml
  ? []
  : (post.sections || []).filter((s) => /\?\s*$/.test(s.h2 || "") && s.blocks?.[0]?.p);
const faqSchema = faqSections.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqSections.map((s) => ({
        "@type": "Question",
        name: s.h2,
        acceptedAnswer: { "@type": "Answer", text: s.blocks[0].p },
      })),
    }
  : null;

// --- JSON-LD: ImageObject for every captioned in-article graphic ---
const imageObject = (url, alt) => ({
  "@context": "https://schema.org",
  "@type": "ImageObject",
  contentUrl: `${SITE}${url}`,
  url: `${SITE}${url}`,
  name: alt,
  caption: alt,
  creditText: "Hopewell Health Solutions",
  creator: { "@type": "Organization", name: "Hopewell Health Solutions" },
  license: canonical,
  acquireLicensePage: `${SITE}/admissions/`,
});
const imageSchemas = [
  ...(bodyHtml
    ? []
    : (post.sections || [])
        .flatMap((s) => s.blocks || [])
        .filter((b) => b.img && b.alt)
        .map((b) => imageObject(b.img, b.alt))),
  ...inlineImages.filter((b) => b.src && b.alt).map((b) => imageObject(b.src, b.alt)),
];

const schemas = [blogPostingSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : []), ...imageSchemas];

// --- 2026 redesign additions ---
// Reading time: the post's own value, else ~230 words a minute from the body text.
const plain = (bodyHtml || (post.sections || []).flatMap((s) => (s.blocks || []).map((b) => b.p || (b.ul || []).join(" ") || "")).join(" ")).replace(/<[^>]+>/g, " ");
const readMin = post.readingMinutes || Math.max(3, Math.round(plain.split(/\s+/).filter(Boolean).length / 230));
// Related programs, linked inline by category.
const PROGRAM_LINKS = {
  "Women's Mental Health": [["Women’s Wellness IOP", "/programs/womens-wellness-iop/"], ["Women’s Trauma IOP", "/programs/womens-trauma-iop/"], ["medication management", "/programs/medication-management/"]],
  "Inclusive Care": [["counseling", "/programs/counseling/"], ["ADHD testing", "/treatment-methods/adhd-testing/"], ["Teen & Tween IOP", "/programs/teen-iop/"]],
  "Intensive Outpatient (IOP)": [["intensive outpatient programs", "/programs/intensive-outpatient-program/"], ["Adult IOP", "/programs/adult-mental-health-iop/"], ["Teen & Tween IOP", "/programs/teen-iop/"]],
  "Levels of Care": [["partial hospitalization (PHP)", "/programs/partial-hospitalization-program/"], ["intensive outpatient (IOP)", "/programs/intensive-outpatient-program/"], ["outpatient counseling", "/programs/counseling/"]],
  "Medication & Psychiatry": [["medication management", "/programs/medication-management/"], ["GeneSight® testing", "/treatment-methods/genesight-testing/"], ["TMS", "/treatment-methods/tms/"]],
  "Mental Health": [["counseling", "/programs/counseling/"], ["intensive outpatient programs", "/programs/intensive-outpatient-program/"], ["medication management", "/programs/medication-management/"]],
  "Teens & Families": [["Teen & Tween IOP", "/programs/teen-iop/"], ["ADHD testing", "/treatment-methods/adhd-testing/"], ["family counseling", "/programs/counseling/"]],
  "Therapy Approaches": [["DBT", "/treatment-methods/dbt/"], ["EMDR", "/treatment-methods/emdr/"], ["our therapeutic treatments", "/treatment-methods/therapeutic-treatments/"]],
  "Trauma & PTSD": [["trauma and PTSD treatment", "/what-we-treat/trauma-ptsd/"], ["EMDR", "/treatment-methods/emdr/"], ["Women’s Trauma IOP", "/programs/womens-trauma-iop/"]],
  "Addiction & Recovery": [["Addiction IOP", "/programs/addiction-iop/"], ["addiction treatment", "/what-we-treat/substance-use-disorder/"], ["medication-assisted treatment", "/treatment-methods/medication-assisted-treatment/"]],
  "Treatment & Access": [["admissions", "/admissions/"], ["rates and insurance", "/rates-and-insurance-coverage/"], ["intensive outpatient programs", "/programs/intensive-outpatient-program/"]],
  "Meet the Team": [["our team", "/about-us/team/"], ["about Hopewell", "/about-us/"], ["admissions", "/admissions/"]],
};
const progLinks = PROGRAM_LINKS[post.category] || PROGRAM_LINKS["Mental Health"];
const progSentence = progLinks.map(([t, h]) => `<a class="inl" href="${h}">${t.replace(/&/g, "&amp;")}</a>`);
// --- Corner Canyon blog pieces (2026-11-16): listen bar, topic self-check, video, care options, insurance strip,
// next-step finder, closing checklist. Placed between the article's own sections; the article text is unchanged.
const quiz = quizFor(post);
const vid = (yt) => VIDEOS.find((v) => v.yt === yt);
const VIDEO_FOR = { anxiety: "cb3SsebwGiA", behavior: "cb3SsebwGiA", depression: "aff5Xfy9CfE", teen: "awy7nfDgC0k", adhd: "LInMQYyZSmY", alcohol: "1NnnRKONzhg", drugs: "1NnnRKONzhg", trauma: "uIlSCS7clwE", postpartum: "S_CyYMDqEio", burnout: "vlKx8J6hykA" };
const VIDEO_CAT = { "Women's Mental Health": "x6R6XOZmxUQ", "Teens & Families": "awy7nfDgC0k", "Intensive Outpatient (IOP)": "vlKx8J6hykA", "Levels of Care": "vlKx8J6hykA", "Addiction & Recovery": "1NnnRKONzhg", "Therapy Approaches": "aff5Xfy9CfE" };
const video = vid(VIDEO_FOR[quiz] || VIDEO_CAT[post.category] || "aff5Xfy9CfE");
const FIRST = { alcohol: "addiction", drugs: "addiction", postpartum: "womens", teen: "teen", adhd: "meds", depression: "therapy", anxiety: "therapy", burnout: "iop", behavior: "therapy" };
const FIRST_CAT = { "Intensive Outpatient (IOP)": "iop", "Levels of Care": "php", "Medication & Psychiatry": "meds", "Women's Mental Health": "womens", "Teens & Families": "teen", "Addiction & Recovery": "addiction" };
const firstProg = /first-responder|heroism/.test(post.slug) ? "responder" : FIRST[quiz] || FIRST_CAT[post.category] || "therapy";
// Article split into chunks at each H2 so the pieces can sit between sections.
const chunks = bodyHtml ? bodyHtml.split(/(?=<h2 id=)/).filter((c) => c.trim()) : (post.sections || []).map((_, i) => i);
const total = chunks.length;
const at = (f) => Math.min(total - 1, Math.max(0, Math.floor(total * f)));
const slots = {};
const put = (i, k) => { (slots[i] = slots[i] || []).push(k); };
if (quiz) put(at(0.3), "quiz");
if (video) put(at(0.5), "video");
put(at(0.65), "programs");
put(at(0.85), "covered");
const barFor = (c) => ["#2f76c4", "#b6863c", "#5c7c6b", "#0b2f55", "#265489"][(c || "").length % 5];

---

<Base title={metaTitle} description={metaDesc} canonical={canonical} image={post.heroImage}>
  <Header />
  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <main class="hw">

  <!-- HERO: title, meta and bylines on navy, the post's stock photo beside them -->
  <section class="bp-hero">
    <div class="container bp-hero-grid is-text">
      <div>
        <nav class="sv-crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/blog/">Blog</a></li><li><span aria-current="page">{post.category}</span></li></ol></nav>
        <a class="bp-cat" href="/blog/#articles">{post.category}</a>
        <h1>{post.title}</h1>
        <p class="bp-meta">
          <span><Icon name="calendar" class="h-4 w-4" />Published {fmt(post.datePublished)}</span>
          {wasUpdated && <span><Icon name="refresh" class="h-4 w-4" />Updated {fmt(post.dateModified)}</span>}
          <span><Icon name="clock" class="h-4 w-4" />{readMin} min read</span>
        </p>
        <div class="bp-byline">
          {author && (
            <a class="bp-person" href={`/provider/${author.slug}/`}>
              {photoUrl(author) ? <img src={photoUrl(author)} alt="" width="50" height="50" /> : <span class="bp-ini">{initials(author.name)}</span>}
              <span><small>Written by</small><strong>{author.name}</strong>{author.role}</span>
            </a>
          )}
          {reviewer && (
            reviewer.removed
              ? <span class="bp-person"><span class="bp-ini">{initials(reviewer.name)}</span><span><small>{reviewLabel}</small><strong>{reviewer.name}</strong>{reviewer.role}</span></span>
              : <a class="bp-person" href={`/provider/${reviewer.slug}/`}>
                  {photoUrl(reviewer) ? <img src={photoUrl(reviewer)} alt="" width="50" height="50" /> : <span class="bp-ini">{initials(reviewer.name)}</span>}
                  <span><small>{reviewLabel}</small><strong>{reviewer.name}</strong>{reviewer.role}</span>
                </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- BODY: article + sticky contents list pinned together with the "Talk to admissions" card -->
  <section class="section is-white bp-body-sec">
    <div class="container bp-layout">
      <article>
        {tocItems.length > 1 && (
          <details class="bp-toc-m">
            <summary>Table of contents</summary>
            <ol>{tocItems.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
          </details>
        )}
        {post.heroImage && (
          <figure class="bp-feature"><img src={post.heroImage} alt={post.heroAlt || post.title} width="1024" height="576" fetchpriority="high" decoding="async" /></figure>
        )}
        {post.intro && <p class="post-intro">{post.intro}</p>}

        <BlogListen minutes={readMin} />
        <div class="bp-content">
        {chunks.map((c, i) => (
          <Fragment>
            {bodyHtml
              ? <div class="post-body" set:html={c} />
              : (() => { const sec = post.sections[c]; return (
                <div id={sec.id} class="post-sec">
                  <h2>{sec.h2}</h2>
                  <div class="post-sec-blocks">
                    {sec.blocks.map((b) => (
                      b.p ? <p set:html={b.p} />
                      : b.h3 ? <h3>{b.h3}</h3>
                      : b.ul ? <ul>{b.ul.map((li) => <li><span set:html={li} /></li>)}</ul>
                      : b.img ? <figure class="post-sec-fig"><img class="is-graphic" src={b.img} alt={b.alt || ""} loading="lazy" /></figure>
                      : b.note ? <p class="post-note">{b.note}</p>
                      : null
                    ))}
                    {inlineAfter[c] && (
                      <figure class="post-sec-fig"><img src={inlineAfter[c].src} alt={inlineAfter[c].alt} loading="lazy" decoding="async" /></figure>
                    )}
                  </div>
                </div>
              ); })()}
            {(slots[i] || []).map((k) => (
              k === "quiz" ? <BlogSelfCheck quiz={quiz} />
              : k === "video" ? <BlogVideo v={video} />
              : k === "programs" ? <BlogPrograms first={firstProg} />
              : <BlogCovered />
            ))}
          </Fragment>
        ))}
        </div>

        <BlogNextStep />

        {hasSources && (
          <div id="sources" class="bp-sources">
            <h2>Sources</h2>
            <ol>
              {post.sources.map((src) => <li><a href={src.href} target="_blank" rel="noopener nofollow">{src.text}</a></li>)}
            </ol>
          </div>
        )}

        <p class="bp-programs"><strong>Getting help at Hopewell:</strong> learn about {progSentence.map((l, i) => <Fragment>{i > 0 && (i === progSentence.length - 1 ? ", and " : ", ")}<Fragment set:html={l} /></Fragment>)}, or call <a class="inl" href="tel:8607351448">(860) 735-1448</a> to talk with our admissions team.</p>

        <BlogClosing />

        <div class="bp-share">
          <span>Share:</span>
          <a href={share.facebook} target="_blank" rel="noopener" aria-label="Share on Facebook"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.8-.1-1.6-.15-2.4-.15-2.4 0-4.05 1.45-4.05 4.15v2.3H7.5V13h2.75v8h3.25Z"/></svg></a>
          <a href={share.twitter} target="_blank" rel="noopener" aria-label="Share on X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"/></svg></a>
          <a href={share.linkedin} target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.6 4.1 5.5 3 5.5S1 4.6 1 3.5 1.9 1.5 3 1.5s1.98.9 1.98 2ZM1.25 8.25h3.5V22h-3.5V8.25ZM8 8.25h3.35v1.88h.05c.47-.88 1.6-1.8 3.3-1.8 3.53 0 4.18 2.32 4.18 5.34V22h-3.5v-5.7c0-1.36-.02-3.1-1.9-3.1-1.9 0-2.18 1.48-2.18 3v5.8H8V8.25Z"/></svg></a>
          <a href={`mailto:?subject=${enc(post.title)}&body=${enc(canonical)}`} aria-label="Share by email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18v12H3zM3 6l9 7 9-7"/></svg></a>
          <a href={`sms:?&body=${enc(post.title)}%20${enc(canonical)}`} aria-label="Share by text message"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg></a>
          <button type="button" data-copy-link aria-label="Copy link"><Icon name="link" class="h-4 w-4" /></button>
        </div>

        <div class="bp-notes">
          <p><Icon name="shield" class="h-[18px] w-[18px]" />This article is for general education and doesn’t replace an individual medical or clinical evaluation. A conversation with our team is the fastest way to know what applies to you.</p>
          <p><Icon name="phone" class="h-[18px] w-[18px]" />If you or someone you care about is in immediate danger, call 911. For a mental health or suicide crisis, call or text 988.</p>
        </div>

        {author && (
          <div class="bp-author">
            {photoUrl(author) ? <img src={photoUrl(author)} alt={author.name} width="96" height="96" loading="lazy" /> : <span class="bp-ini">{initials(author.name)}</span>}
            <div>
              <small>Written by</small>
              <p class="bp-author-name">{author.name}</p>
              <p class="bp-role">{author.role}</p>
              {authorExcerpt && <p>{authorExcerpt}</p>}
              <a class="inl" href={`/provider/${author.slug}/`}>Read {author.name.split(",")[0]}’s full bio</a>
              {reviewer && (
                <p class="bp-rev"><Icon name="shield" class="mr-1 inline h-4 w-4" />{reviewLabel}{" "}
                  {reviewer.removed ? <strong>{reviewer.name}</strong> : <a class="inl" href={`/provider/${reviewer.slug}/`}>{reviewer.name}</a>}, {reviewer.role}.
                </p>
              )}
            </div>
          </div>
        )}
      </article>

      <aside class="bp-side" data-side>
        {tocItems.length > 0 && (
          <nav class="bp-toc" aria-label="Table of contents">
            <p class="bp-toc-h">In this article</p>
            <ol>
              {tocItems.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
              {hasSources && <li><a href="#sources">Sources</a></li>}
            </ol>
          </nav>
        )}
        <div class="bp-talk">
          <strong>Talk to admissions</strong>
          <p>Questions about care for you or a loved one? A real person will help, confidentially.</p>
          <a href="tel:8607351448" class="btn btn-blue"><Icon name="phone" />(860) 735-1448</a>
          <a class="bp-talk-link" href="/admissions/#verify">Verify your insurance</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- RELATED -->
  {related.length > 0 && (
    <section class="section is-stone">
      <div class="container">
        <div class="sec-head"><h2>Popular articles</h2><p class="lede">More from the <a class="inl" href="/blog/">Hopewell blog</a>.</p></div>
        <div class="bh-grid">
          {related.map((r) => {
            const a = byId(r.authorSlug);
            return (
              <a href={`/post/${r.slug}/`} class="bh-card" style={`--bar:${barFor(r.category)}`}>
                <span class="bh-card-media">{r.heroImage && <img src={r.heroImage} alt="" width="640" height="400" loading="lazy" />}</span>
                <span class="bh-card-body">
                  <span class="bh-cat">{r.category}</span>
                  <h3>{r.title}</h3>
                  <p>{r.excerpt}</p>
                  <span class="bh-meta">{photoUrl(a) && <img src={photoUrl(a)} alt="" width="28" height="28" loading="lazy" />}{a?.name} · {fmt(r.datePublished)}</span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <Team tone="white" />

  <ClosingCta verifyHref="/admissions/#verify" />
  </main>
  <Footer />

  <script>
    document.querySelectorAll("[data-copy-link]").forEach((btn) => {
      btn.addEventListener("click", () => {
        navigator.clipboard?.writeText(window.location.href);
        btn.setAttribute("aria-label", "Link copied");
      });
    });
    // Contents list: highlight the section being read; tighten the sidebar when it would overflow the screen.
    const side = document.querySelector<HTMLElement>("[data-side]");
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".bp-toc a[href^='#']")];
    const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
    if (heads.length && "IntersectionObserver" in window) {
      const on = (id: string) => links.forEach((a) => a.classList.toggle("is-on", decodeURIComponent(a.hash.slice(1)) === id));
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) on(e.target.id); }), { rootMargin: "-15% 0px -75% 0px" });
      heads.forEach((h) => io.observe(h));
    }
    const fit = () => { if (!side) return; side.classList.remove("is-tight"); if (side.offsetHeight > window.innerHeight - 140) side.classList.add("is-tight"); };
    fit(); window.addEventListener("resize", fit);
  </script>
</Base>
