---
import ServicesDirectory from "../../components/hw/ServicesDirectory.astro";
import Team from "../../components/hw/Team.astro";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import "../../styles/pages/about.css";
import Insurance from "../../components/hw/Insurance.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import LeadForm from "../../components/LeadForm.astro";
import { providers } from "../../data/providers.js";

export function getStaticPaths() {
  return providers.filter((p) => !p.removed).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const TM = "/Assets/Team%20Members/";
const photo = p.photo ? `${TM}${p.photo}.webp` : null;
const initials = (() => {
  const w = p.name.split(",")[0].trim().split(" ").filter(Boolean);
  return (w[0][0] + (w.length > 1 ? w[w.length - 1][0] : "")).toUpperCase();
})();
const bioParas = p.bio ? p.bio.split("\n\n") : [];
const metaDesc = p.bio ? p.bio.replace(/\s+/g, " ").slice(0, 155) : `${p.name}, ${p.role} at Hopewell Health Solutions, Glastonbury, Westbrook & West Hartford, CT.`;
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: p.name,
  jobTitle: p.role,
  worksFor: { "@type": "MedicalOrganization", name: "Hopewell Health Solutions" },
  url: `https://www.hopewellhealthsolutions.com/provider/${p.slug}`,
  ...(p.bio ? { description: p.bio.replace(/\s+/g, " ") } : {}),
  ...(photo && !p.photoPlaceholder ? { image: `https://www.hopewellhealthsolutions.com${photo}` } : {}),
};
const first = p.name.split(",")[0];
const SITE = "https://www.hopewellhealthsolutions.com";
const crumbs = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
  { "@type": "ListItem", position: 2, name: "Our Team", item: SITE + "/about-us/team/" },
  { "@type": "ListItem", position: 3, name: p.name, item: `${SITE}/provider/${p.slug}/` },
] };
const pos = p.photoPos ? p.photoPos.replace(/^object-\[|\]$/g, "").replace(/_/g, " ") : "top";
const services = [
  { t: "Intensive Outpatient Program", href: "/programs/intensive-outpatient-program/", icon: "users" },
  { t: "Medication Management", href: "/programs/medication-management/", icon: "pill" },
  { t: "Counseling", href: "/programs/counseling/", icon: "heart" },
  { t: "HHS Therapeutic Treatments", href: "/treatment-methods/therapeutic-treatments/", icon: "refresh" },
  { t: "Neuropsychological Testing", href: "/treatment-methods/neuropsychological-testing/", icon: "clipboard" },
  { t: "Addiction Treatment (S.U.D.)", href: "/what-we-treat/substance-use-disorder/", icon: "swap" },
  { t: "ADHD Testing", href: "/treatment-methods/adhd-testing/", icon: "bolt" },
  { t: "TMS", href: "/treatment-methods/tms/", icon: "brain" },
  { t: "Alcohol Addiction Treatment", href: "/what-we-treat/alcohol/", icon: "shield" },
  { t: "Drug Addiction Treatment", href: "/what-we-treat/drug/", icon: "compass" },
  { t: "Prescription Drug Addiction Treatment", href: "/what-we-treat/prescription-drugs/", icon: "alert" },
];

---

<Base title={[`${p.name} | Hopewell Health Solutions`, `${p.name} | Hopewell`].find((t) => t.length <= 60) || p.name} description={metaDesc} image={photo && !p.photoPlaceholder ? photo : undefined}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  <main class="hw">
    <section class="pf-hero">
      <div class="container pf-grid">
        <div class="pf-photo">
          {photo
            ? <img src={photo} alt={p.name} width="600" height="750" style={`object-position:${pos}`} fetchpriority="high" />
            : <span class="ab-init" aria-hidden="true">{initials}</span>}
        </div>
        <div>
          <nav class="sv-crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/about-us/team/">Our Team</a></li><li><span aria-current="page">{p.name}</span></li></ol></nav>
          <h1>{p.name}</h1>
          <p class="pf-role">{p.role}</p>
          {p.quote && <p class="pf-quote">{p.quote}</p>}
          <ul class="pf-meta">
            {p.prescribes && <li><span class="ab-ico"><Icon name="pill" class="h-[18px] w-[18px]" /></span><span><strong>Prescribing provider</strong> · psychiatric medication management</span></li>}
            {p.education && <li><span class="ab-ico"><Icon name="clipboard" class="h-[18px] w-[18px]" /></span><span><strong>Education:</strong> {p.education}</span></li>}
            <li><span class="ab-ico"><Icon name="pin" class="h-[18px] w-[18px]" /></span><span>Hopewell Health Solutions · <a class="inl" href="/locations/">Connecticut offices</a> &amp; telehealth</span></li>
          </ul>
          <div class="sv-ctas">
            <a href="tel:8607351448" class="btn btn-blue"><Icon name="phone" />(860) 735-1448</a>
            <a href="#book" class="btn btn-ghost">Request an appointment</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section is-white" id="about">
      <div class="container pf-body">
        <div class="ab-copy">
          <h2>About {first}</h2>
          <div style="margin-top:18px">
            {bioParas.length > 0
              ? bioParas.map((para) => <p>{para}</p>)
              : <p>Full bio coming soon. Reach out and our team will be glad to tell you more about {first} and how they can help.</p>}
          </div>
        </div>
        <aside class="pf-aside">
          {p.focus && p.focus.length > 0 && (
            <div class="pf-card">
              <h2>How {first} can help</h2>
              <ul class="pf-focus">{p.focus.map((f) => <li><Icon name="check" class="h-[18px] w-[18px]" />{f}</li>)}</ul>
            </div>
          )}
          <div class="pf-card is-navy" id="book">
            <h2>Ready to connect with {first}?</h2>
            <p style="margin-top:8px;font-size:16px">Reach out to Hopewell Health Solutions today, confidentially, with no pressure, and we’ll help you get started.</p>
            <a href="tel:8607351448" class="btn btn-blue"><Icon name="phone" />(860) 735-1448</a>
            <a href="/about-us/team/" class="btn btn-ghost">Meet the full team</a>
          </div>
        </aside>
      </div>
    </section>

    <section class="section is-stone" id="request">
      <div class="container ins-grid">
        <div>
          <h2>Request an appointment</h2>
          <p class="lede" style="margin-top:14px">Tell us who to call back. We’ll verify your insurance for free and help you book with {first} or the clinician who best fits your needs, in person or by telehealth.</p>
          <ul class="ab-checks">
            <li><span class="sv-tick"><Icon name="check" class="h-4 w-4" /></span><span>Free, confidential insurance check</span></li>
            <li><span class="sv-tick"><Icon name="check" class="h-4 w-4" /></span><span>Daytime &amp; evening appointments</span></li>
            <li><span class="sv-tick"><Icon name="check" class="h-4 w-4" /></span><span>Six <a class="inl" href="/locations/">Connecticut offices</a> plus telehealth</span></li>
          </ul>
        </div>
        <div id="verify"><span id="verify-m"></span><LeadForm variant="card" formId="hhs-provider" /></div>
      </div>
    </section>

    <ServicesDirectory lede="Explore the programs and treatments our team offers." />

    <Insurance mobileForm={false} />
    <Team tone="white" heading="More of Our Team" />
    <ClosingCta heading={`Ready to connect with ${first}?`} lede="Reach out to Hopewell Health Solutions today, confidentially, with no pressure, and we’ll help you get started." />
  </main>
  <Footer />
</Base>
