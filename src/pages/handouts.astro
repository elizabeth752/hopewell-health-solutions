---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import ServiceHero from "../components/hw/ServiceHero.astro";
import ClosingCta from "../components/hw/ClosingCta.astro";
import VideoCarousel from "../components/hw/VideoCarousel.astro";
import { VIDEOS } from "../data/videos.js";
import "../styles/pages/admissions.css";
const bars = ["#2f76c4", "#b6863c", "#5c7c6b", "#0b2f55", "#265489"];
const tips = VIDEOS.filter((v) => v.type.startsWith("Clinician") || v.type.startsWith("Dr."));

const canonical = "https://www.hopewellhealthsolutions.com/handouts/";
const H = "/Assets/Handouts/";

const handouts = [
  {
    title: "Understanding and Overcoming Self-Harm",
    audience: "For kids & teens",
    desc: "A compassionate, easy-to-read guide to what self-harm is, why it happens, and healthier ways to cope.",
    cover: H + "understanding-overcoming-self-harm.webp",
    pdf: H + "understanding-overcoming-self-harm.pdf",
  },
  {
    title: "What Is Anxiety?",
    audience: "For kids",
    desc: "A simple, reassuring explanation of anxiety for children — what it feels like and gentle tools to feel calmer.",
    cover: H + "what-is-anxiety.webp",
    pdf: H + "what-is-anxiety.pdf",
  },
  {
    title: "Understanding School Refusal",
    audience: "For parents",
    desc: "A guide for parents addressing school avoidance — how to recognize it, what drives it, and how to help your child get back to class.",
    cover: H + "school-refusal-parents-guide.webp",
    pdf: H + "school-refusal-parents-guide.pdf",
  },
  {
    title: "A Parent’s Guide to Your Child’s Anxiety",
    audience: "For parents",
    desc: "How to recognize, understand, and manage anxiety in your child, with practical strategies you can use at home.",
    cover: H + "parents-guide-child-anxiety.webp",
    pdf: H + "parents-guide-child-anxiety.pdf",
  },
  {
    title: "Supporting a Child Struggling with Self-Harm",
    audience: "For parents",
    desc: "Practical guidance for parents on how to respond with calm and care, support your child, and find the right help.",
    cover: H + "parents-guide-child-self-harm.webp",
    pdf: H + "parents-guide-child-self-harm.pdf",
  },
];
---

<Base title="Free Mental Health Handouts & Guides | Hopewell Health Solutions" description="Free, downloadable mental health handouts from Hopewell Health Solutions — parent guides and kid-friendly resources on anxiety, self-harm, and school refusal from our Connecticut clinicians." canonical={canonical}>
  <Header />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Resources", href: "/blog/" }, { label: "Handouts" }]}
      title="Handouts &amp; Guides"
      lede="Free, downloadable guides written by our Connecticut clinicians — to help families and kids understand anxiety, self-harm, and school refusal, and take the next step with confidence."
      bullets={["Parent guides on anxiety, self-harm and school refusal", "Kid-friendly explanations", "Free PDF downloads", "Written by our Connecticut clinicians"]}
      image="/Assets/hhs-2026/tween-group-room.webp"
      form={false}
    />

    <section class="section is-white">
      <div class="container">
        <div class="sec-head"><h2>Free guides for families and kids</h2><p class="lede">Download a guide, print it, or share it with someone who needs it. Looking for more? Read the <a class="inl" href="/blog/">Hopewell blog</a> or learn about our <a class="inl" href="/programs/teen-tween-iop/">Teen &amp; Tween IOP</a>.</p></div>
        <div class="ho-grid">
          {handouts.map((h, i) => (
            <article class="ho" style={`--bar:${bars[i % bars.length]}`}>
              <a href={h.pdf} target="_blank" rel="noopener" class="ho-cover" aria-label={`Open ${h.title} (PDF)`}>
                <img src={h.cover} alt={`Cover of ${h.title}`} width="600" height="660" loading="lazy" />
              </a>
              <div class="ho-body">
                <span class="ho-aud">{h.audience}</span>
                <h2>{h.title}</h2>
                <p>{h.desc}</p>
                <a href={h.pdf} target="_blank" rel="noopener" download class="btn btn-navy">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  Download PDF
                </a>
              </div>
            </article>
          ))}
        </div>
        <p class="ho-note"><Icon name="alert" class="h-5 w-5" /><span>These guides are for general education and are <strong>not a substitute for professional care</strong>. If you or your child are in crisis, call or text <strong>988</strong> (Suicide &amp; Crisis Lifeline) or call <strong>911</strong>.</span></p>
      </div>
    </section>

    <VideoCarousel videos={tips} mode="grid" tone="navy" heading="Short Videos From Our Clinicians" lede="Quick, practical skills from the Hopewell team. More on the <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a>." link={null} />

    <ClosingCta heading="Ready to talk to someone?" lede="Our Connecticut team is here to help you or your child take the next step toward feeling better." verifyHref="/admissions/#verify" />
  </main>
  <Footer />
</Base>
