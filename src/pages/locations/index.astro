---
import Team from "../../components/hw/Team.astro";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import "../../styles/pages/about.css";
import "../../styles/pages/hubs.css";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Insurance from "../../components/hw/Insurance.astro";
import PhotoSlider from "../../components/hw/PhotoSlider.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import { locations, OFFERS, OFFER_ORDER } from "../../data/locations.js";
import OfficeFinder from "../../components/hw/OfficeFinder.astro";
import VideoCarousel from "../../components/hw/VideoCarousel.astro";
import { STORIES, VIDEOS, videoSchema } from "../../data/videos.js";

const canonical = "https://www.hopewellhealthsolutions.com/locations/";
// Hero map: offices projected from locations.js lat/lng into a 100x80 box (graphic, not to scale at the shoreline).
const lng0 = -72.95, lng1 = -72.30, lat0 = 41.85, lat1 = 41.22;
const proj = (l) => ({ x: ((l.lng - lng0) / (lng1 - lng0)) * 100, y: ((lat0 - l.lat) / (lat0 - lat1)) * 74 });
const pins = locations.map((l, i) => ({ ...proj(l), n: i + 1, slug: l.slug, name: l.name, add: !!l.addiction }));
// spread the three Glastonbury pins so they don't overlap
for (const [slug, dx, dy] of [["glastonbury-ct", -3.5, -3], ["glastonbury-ct-2", 3.5, -2], ["glastonbury-ct-3", 0, 4]]) { const p = pins.find((q) => q.slug === slug); if (p) { p.x += dx; p.y += dy; } }
const towns = [["Hartford", 14, 8], ["Middletown", 36, 41], ["Old Saybrook", 80, 70], ["New Haven", 3, 66]];
const tour = VIDEOS.find((v) => v.yt === "ZsyYzk9epww");
const L = "/Assets/locations/";
const heroHouses = [
  { src: L + "glastonbury/exterior.webp", alt: "The Hopewell house at 33 Pratt Street, Glastonbury", cap: "Glastonbury · Pratt St", href: "/location/glastonbury-ct/", w: 1536, h: 1536 },
  { src: L + "downtown-glastonbury/building.webp", alt: "The Medical Arts Center at 300 Hebron Avenue, Glastonbury", cap: "Downtown Glastonbury · 300 Hebron Ave", href: "/location/glastonbury-ct-2/", w: 1100, h: 886 },
  { src: "/Assets/hhs-2026/south-glastonbury-office.webp", alt: "The South Glastonbury office at 1420 Main Street", cap: "South Glastonbury · 1420 Main St", href: "/location/glastonbury-ct-3/" },
  { src: "/Assets/hhs-2026/west-hartford-office.webp", alt: "The West Hartford office on Farmington Avenue", cap: "West Hartford", href: "/location/west-hartford-ct/" },
  { src: L + "east-hampton/exterior.webp", alt: "The East Hampton office at 151 East High Street", cap: "East Hampton", href: "/location/east-hampton-ct/", w: 1360, h: 1020 },
  { src: L + "westbrook/exterior.webp", alt: "The Westbrook office at 70 Essex Road", cap: "Westbrook · the shoreline", href: "/location/westbrook-ct/", w: 1536, h: 866 },
];
const regions = [
  { icon: "home", t: "Greater Hartford", d: `Three Glastonbury offices and <a class="inl" href="/location/west-hartford-ct/">West Hartford</a>, close to Hartford, Manchester, Wethersfield, Rocky Hill, South Windsor and Newington.` },
  { icon: "compass", t: "The Connecticut River Valley", d: `<a class="inl" href="/location/east-hampton-ct/">East Hampton</a> serves Middletown, Portland, Colchester, Marlborough and the rest of Middlesex County.` },
  { icon: "sun", t: "The shoreline", d: `<a class="inl" href="/location/westbrook-ct/">Westbrook</a> serves Old Saybrook, Clinton, Madison, Guilford, Branford, Essex and Niantic.` },
];
const teleWhy = [
  ["users", "The same clinicians who see clients in our offices"],
  ["shield", "Secure, private video on your phone, tablet or computer"],
  ["refresh", "Switch between in-person and video visits any time"],
  ["calendar", "Daytime and evening appointments"],
];
const teleSteps = [
  ["Call or send a form", "We check your insurance for free and match you with a clinician."],
  ["Get your link", "You receive a secure video link before your appointment."],
  ["Meet from home", "Join from a quiet, private space anywhere in Connecticut."],
];
const allAreas = Array.from(new Set(locations.flatMap((l) => l.areas))).sort();
const heroUsps = [
  { icon: "pin", t: "Six Connecticut offices, Hartford County & the shoreline" },
  { icon: "compass", t: "In person locally or by secure telehealth statewide" },
  { icon: "calendar", t: "Daytime & evening appointments" },
  { icon: "shield", t: "Joint Commission accredited · 4.8★ · most major PPOs" },
];
const why = [
  { icon: "users", t: "One team, every office", d: "The same psychiatrists, nurse practitioners, psychologists, and therapists support you across all six locations, your care travels with you." },
  { icon: "refresh", t: "A full continuum of care", d: "Therapy, medication management, IOP, PHP, TMS, and testing, step up or down without leaving the practice." },
  { icon: "compass", t: "In person or virtual", d: "Choose the office closest to home, or meet by secure video anywhere in Connecticut." },
  { icon: "heart", t: "Compassionate, judgment-free", d: "A warm, welcoming environment for individuals and families of every background and identity." },
];
const faqs = [
  ["Where are your offices?", "Six offices: Pratt St and Downtown (Hebron Ave) in Glastonbury, South Glastonbury (Main St), West Hartford, East Hampton and Westbrook."],
  ["Which office has the program I need?", "Intensive programs meet in Downtown Glastonbury, South Glastonbury and Westbrook. Use the program filter above to see exactly where."],
  ["Do all offices offer therapy and medication management?", "Yes, all six do."],
  ["Which office is closest to the shoreline?", "Westbrook, which serves Niantic, Branford, Madison, Guilford and nearby towns."],
  ["Where is the teen and tween program?", "South Glastonbury, 1420 Main St."],
  ["How many locations does Hopewell Health Solutions have?", "We have six offices across Connecticut: three in Glastonbury (Pratt Street, Downtown / Hebron Avenue, and South Glastonbury / Main Street), plus West Hartford, East Hampton, and Westbrook. We also offer secure telehealth statewide."],
  ["Do you offer telehealth, or do I have to come in person?", "Both. You can be seen in person at any of our offices or by secure video telehealth anywhere in Connecticut. Many clients combine the two, in-person visits when it helps, virtual sessions when life is busy."],
  ["Can I see the same provider at more than one office?", "Our clinical team works as one practice across all locations. We’ll match you to the provider who best fits your needs and help you find the most convenient office or a telehealth option."],
  ["Which services are available at each location?", "Every office offers 1:1 therapy and medication management. Downtown Glastonbury (300 Hebron Avenue) also offers PHP, adult IOP, the Women’s Wellness IOP (morning and evening) and addiction treatment. South Glastonbury (1420 Main Street) offers the Tween & Teen IOP. Westbrook offers an adult IOP, the Women’s Wellness IOP and addiction treatment. TMS and testing are available across the practice, call us and we’ll direct you to the right office for the care you need."],
  ["What are your hours?", "All of our offices are open Monday to Thursday, 9:00 AM to 8:00 PM, and Friday, 9:00 AM to 5:00 PM. We are closed on weekends. Call (860) 735-1448 to book at the office nearest you."],
  ["Do you take my insurance?", "We’re in-network with most major PPO plans (we don’t accept Medicaid / HUSKY). We’ll verify your benefits for free before your first visit."],
  ["What if I’m in crisis?", "Call or text 988, call 911, or go to the nearest emergency room."],
];
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalOrganization",
  name: "Hopewell Health Solutions",
  url: canonical,
  location: locations.map((l) => ({
    "@type": "MedicalClinic",
    name: `Hopewell Health Solutions, ${l.name}`,
    url: `https://www.hopewellhealthsolutions.com/location/${l.slug}`,
    ...(l.phone ? { telephone: l.phone } : {}),
    address: { "@type": "PostalAddress", streetAddress: l.street, addressLocality: l.city, addressRegion: "CT", postalCode: l.zip, addressCountry: "US" },
    geo: { "@type": "GeoCoordinates", latitude: l.lat, longitude: l.lng },
  })),
};
const P = "/Assets/hhs-2026/";
const officePhoto = {
  "glastonbury-ct": "/Assets/locations/glastonbury/exterior.webp",
  "glastonbury-ct-2": P + "downtown-glastonbury-sign.webp",
  "glastonbury-ct-3": P + "south-glastonbury-office.webp",
  "west-hartford-ct": P + "west-hartford-office.webp",
  "east-hampton-ct": "/Assets/locations/east-hampton/exterior.webp",
  "westbrook-ct": "/Assets/locations/westbrook/exterior.webp",
};
// Office guide by need (client-confirmed services, Google Doc 2026-11-16) — Corner Canyon hub pattern, more SEO copy.
const guide = [
  { icon: "link", t: "Addiction treatment", bar: "#b6863c", d: `The <a class="inl" href="/programs/addiction-iop/">Addiction and Substance Use IOP</a> and MAT are offered at <a class="inl" href="/location/glastonbury-ct-2/">Downtown Glastonbury (300 Hebron Ave)</a> and <a class="inl" href="/location/westbrook-ct/">Westbrook (70 Essex Rd)</a>.` },
  { icon: "sun", t: "Full-day care (PHP)", bar: "#0b2f55", d: `Our <a class="inl" href="/programs/partial-hospitalization-program/">partial hospitalization program</a> meets about six hours a day, Monday through Friday, at 300 Hebron Ave in Glastonbury.` },
  { icon: "users", t: "Tweens & teens", bar: "#5c7c6b", d: `The <a class="inl" href="/programs/teen-iop/">Teen &amp; Tween IOP</a> meets after school at our <a class="inl" href="/location/glastonbury-ct-3/">South Glastonbury office (1420 Main St)</a>.` },
  { icon: "heart", t: "Women’s programs", bar: "#b6863c", d: `The <a class="inl" href="/programs/womens-wellness-iop/">Women’s Wellness IOP</a> runs morning and evening groups at 300 Hebron Ave and in Westbrook.` },
  { icon: "compass", t: "The shoreline", bar: "#2f76c4", d: `Our <a class="inl" href="/location/westbrook-ct/">Westbrook office</a> serves Old Saybrook, Clinton, Madison, Guilford, Branford and nearby shoreline towns with adult IOP, Women’s Wellness IOP, therapy and medication management.` },
  { icon: "pin", t: "Greater Hartford & Middlesex", bar: "#265489", d: `Weekly therapy and medication management close to home at <a class="inl" href="/location/west-hartford-ct/">West Hartford</a>, <a class="inl" href="/location/east-hampton-ct/">East Hampton</a> and our <a class="inl" href="/location/glastonbury-ct/">Pratt Street office in Glastonbury</a>.` },
];
const visit = [
  ["phone", "Before you come", "We confirm your appointment, check your insurance for free and tell you which office and suite to come to."],
  ["pin", "Arriving", "We’ll tell you where to park when we confirm your appointment. Arrive a few minutes early for your first visit."],
  ["clipboard", "Checking in", "Our front desk team welcomes you and walks you through any paperwork."],
  ["users", "Your first session", "Your clinician meets you, shows you the room or group space, and talks through what comes next."],
];
const bars = ["#2f76c4", "#b6863c", "#5c7c6b", "#265489", "#2f76c4", "#b6863c"];
const allServices = [
  { t: "Intensive Outpatient Program", href: "/programs/intensive-outpatient-program/", icon: "users" },
  { t: "Medication Management", href: "/programs/medication-management/", icon: "pill" },
  { t: "Counseling", href: "/programs/counseling/", icon: "heart" },
  { t: "HHS Therapeutic Treatments", href: "/treatment-methods/therapeutic-treatments/", icon: "refresh" },
  { t: "Neuropsychological Testing", href: "/treatment-methods/neuropsychological-testing/", icon: "clipboard" },
  { t: "Addiction Treatment (S.U.D.)", href: "/what-we-treat/substance-use-disorder/", icon: "swap", addiction: true },
  { t: "ADHD Testing", href: "/treatment-methods/adhd-testing/", icon: "bolt" },
  { t: "TMS", href: "/treatment-methods/tms/", icon: "brain" },
  { t: "Alcohol Addiction Treatment", href: "/what-we-treat/alcohol/", icon: "shield", addiction: true },
  { t: "Drug Addiction Treatment", href: "/what-we-treat/drug/", icon: "compass", addiction: true },
  { t: "Prescription Drug Addiction Treatment", href: "/what-we-treat/prescription-drugs/", icon: "alert", addiction: true },
];
// FAQ answers with inline links (FAQPage schema strips the tags).
const faqsHtml = faqs.map(([q, a]) => [q, a
  .replace("(860) 735-1448", '<a class="inl" href="tel:8607351448">(860) 735-1448</a>')
  .replace("intensive programs (IOP/PHP)", 'intensive programs (<a class="inl" href="/programs/intensive-outpatient-program/">IOP</a>/<a class="inl" href="/programs/partial-hospitalization-program/">PHP</a>)')
  .replace("verify your benefits for free", 'verify your benefits for free (see <a class="inl" href="/rates-and-insurance-coverage/">rates &amp; insurance</a>)')
  .replace("Westbrook, which serves", '<a class="inl" href="/location/westbrook-ct/">Westbrook</a>, which serves')
  .replace("Our clinical team works as one practice", 'Our <a class="inl" href="/about-us/team/">clinical team</a> works as one practice')
  .replace("offers the Tween & Teen IOP", 'offers the <a class="inl" href="/programs/teen-iop/">Tween &amp; Teen IOP</a>')
  .replace("(morning and evening) and addiction treatment", '(morning and evening) and <a class="inl" href="/programs/addiction-iop/">addiction treatment</a>')]);

---

<Base title="Mental Health &amp; Addiction Care Locations in Connecticut | Hopewell" description="Six Hopewell offices in Glastonbury, South Glastonbury, West Hartford, East Hampton and Westbrook, CT. See which programs each offers. Check coverage." canonical={canonical} image={P + "downtown-glastonbury-sign.webp"}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "ItemList", name: "Hopewell Health Solutions locations", itemListElement: locations.map((l, i) => ({ "@type": "ListItem", position: i + 1, name: `Hopewell Health Solutions ${l.name}`, url: `https://www.hopewellhealthsolutions.com/location/${l.slug}/` })) })} />
  <main class="hw">
    <!-- Hero (Corner Canyon hub pattern): navy, H1 + facts, and a carousel of the office buildings (user 2026-11-17: houses, not the map) -->
    <section class="wq-hero">
      <svg class="wq-hero-arcs" viewBox="0 0 800 800" aria-hidden="true"><circle cx="400" cy="400" r="390" /><circle cx="400" cy="400" r="290" /></svg>
      <div class="container wq-hero-grid">
        <div>
          <nav class="wq-crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>Locations</span></nav>
          <h1>Our Connecticut Offices</h1>
          <p class="lede">Six offices, one trusted team, and telehealth wherever you are.</p>
          <ul class="wq-facts">
            {heroUsps.slice(0, 3).map((u) => <li><Icon name={u.icon} class="h-[18px] w-[18px]" />{u.t}</li>)}
          </ul>
          <div class="wq-ctas"><a href="tel:8607351448" class="btn btn-blue"><Icon name="phone" />Call (860) 735-1448</a><a href="#by-location" class="btn wq-ghost">Find a program near you</a></div>
        </div>
        <div class="lh-houses">
          <PhotoSlider photos={heroHouses} eager label="Photos of Hopewell's Connecticut offices" />
        </div>
      </div>
    </section>
    <Creds />

    <OfficeFinder tone="stone" />

    <!-- Overview -->
    <section class="section is-white" id="overview">
      <div class="container ab-story">
        <figure class="ab-story-media" style="margin:0">
          <img src={P + "downtown-glastonbury-entrance.webp"} alt="The entrance to our Downtown Glastonbury office at 300 Hebron Avenue" width="1200" height="900" loading="lazy" />
          <figcaption>Our Downtown Glastonbury office at 300 Hebron Avenue, one of six Hopewell locations.</figcaption>
        </figure>
        <div class="ab-copy">
          <h2>Mental health &amp; psychiatry, close to home across Connecticut</h2>
          <div style="margin-top:20px">
            <p>Hopewell Health Solutions has grown into an accessible outpatient mental health and psychiatry practice, with <strong>six offices</strong> spanning Hartford County and the shoreline, three in Glastonbury, plus West Hartford, East Hampton, and Westbrook. Wherever you are in the state, compassionate, evidence-based care is close to home, and when getting to an office isn’t practical, secure telehealth brings the same trusted team to you.</p>
            <p>Since 2013, we’ve built our reputation on a simple idea: change is a practice, not a concept. Our clinicians fuse psychology, psychiatry, and whole-person wellness into care that’s active, collaborative, and tailored to each person. Across every location you’ll find the same standard of care, a <a href="/about-us/" class="inl">Joint Commission–accredited practice</a> with a 4.8-star reputation and a team of <a href="/about-us/team/" class="inl">psychiatrists, board-certified nurse practitioners, psychologists, and licensed therapists</a> who genuinely listen.</p>
            <p>Each office offers the support most people need most often<a href="/programs/counseling/" class="inl">individual, couples, and family therapy</a> and <a href="/programs/medication-management/" class="inl">medication management</a>. Across the practice we also provide our <a href="/programs/intensive-outpatient-program/" class="inl">Intensive Outpatient Program (IOP)</a> and <a href="/programs/partial-hospitalization-program/" class="inl">Partial Hospitalization Program (PHP)</a>, plus specialized treatments such as <a href="/treatment-methods/tms/" class="inl">TMS</a> and <a href="/treatment-methods/neuropsychological-testing/" class="inl">neuropsychological and ADHD testing</a>. Because all of it lives under one roof, you can step up or down between levels of care, or add a service, without ever having to start over with a new practice.</p>
            <p>We treat the <a href="/what-we-treat/" class="inl">full range of mental health and behavioral concerns</a>: depression, anxiety, trauma and PTSD, ADHD, OCD, and bipolar disorder, with <a href="/what-we-treat/substance-use-disorder/" class="inl">addiction</a> and co-occurring care at our Downtown Glastonbury and Westbrook offices. We welcome individuals of every age, background, and identity, and we work hard to make starting easy, most major PPO insurance plans are accepted, and our team <a href="/rates-and-insurance-coverage/" class="inl">verifies your benefits for free</a> before your first visit. Choose the office nearest you below, or call <a href="tel:8607351448" class="inl">(860) 735-1448</a> and we’ll help you find the right location, provider, and level of care.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Connecticut (user 2026-11-17: talk more about Connecticut). The office map moved here from the hero. -->
    <section class="section is-navy" id="connecticut">
      <div class="container lh-ct">
        <div class="lh-ct-copy">
          <h2>Mental health care rooted in Connecticut</h2>
          <p class="lede">Hopewell started in Glastonbury in 2013 and has grown one Connecticut town at a time. Our clinicians live and work here, so they know the commutes, the school calendars, the local support groups and the hospitals and doctors you may already see.</p>
          <p>Our offices follow the Connecticut River from the Hartford suburbs down through Middlesex County to the shoreline. That means most people in Hartford and Middlesex Counties, and along the coast from Branford to Old Saybrook, can reach an office without a long drive. Anyone else in the state can see the same team by secure telehealth.</p>
          <ul class="lh-regions">
            {regions.map((r) => <li><span class="lh-region-ico"><Icon name={r.icon} class="h-5 w-5" /></span><span><strong>{r.t}</strong><span set:html={r.d} /></span></li>)}
          </ul>
          <p class="lh-ct-help"><Icon name="phone" class="h-5 w-5" /><span>In crisis anywhere in Connecticut? Call or text <a href="tel:988">988</a>. For local community services, dial <a href="tel:211">2-1-1</a> (United Way of Connecticut).</span></p>
        </div>
        <figure class="lhm-map lh-ct-map" aria-label="Map of Hopewell's six Connecticut offices">
          <svg viewBox="0 0 100 80" role="img" aria-labelledby="lhm-map-t">
            <title id="lhm-map-t">Hopewell offices in Glastonbury, South Glastonbury, West Hartford, East Hampton and Westbrook, Connecticut</title>
            <path d="M0,70 C14,71 26,74 40,74.5 S60,75.5 72,75 S90,73.5 100,73 L100,80 L0,80 Z" class="lhm-sea" />
            <path d="M0,70 C14,71 26,74 40,74.5 S60,75.5 72,75 S90,73.5 100,73" class="lhm-coast" />
            <path d="M45,0 C46,6 47,12 48,18 S49,30 51,38 S56,52 62,60 S70,70 73,75" class="lhm-river" />
            <text x="24" y="78.4" class="lhm-sea-t">LONG ISLAND SOUND</text>
            {pins.map((p) => (
              <a href={`/location/${p.slug}/`} aria-label={p.name}>
                <g class:list={["lhm-pin", p.add && "is-add"]} transform={`translate(${p.x} ${p.y})`}>
                  <circle r="3.1" /><text y="1.1" text-anchor="middle">{p.n}</text>
                </g>
              </a>
            ))}
            {towns.map(([t, x, y]) => <text x={x} y={y} class="lhm-town">{t}</text>)}
          </svg>
          <figcaption>
            <ol class="lhm-key">{pins.map((p) => <li><span class:list={["lhm-key-n", p.add && "is-add"]}>{p.n}</span><a href={`/location/${p.slug}/`}>{p.name}</a></li>)}</ol>
            <p class="lhm-legend"><span class="lhm-dot"></span>Mental health care <span class="lhm-dot is-add"></span>Also addiction treatment</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- All six offices -->
    <section class="section is-stone" id="offices">
      <div class="container">
        <div class="sec-head"><h2>All six Connecticut locations</h2><p class="lede">Find your office: each one is open Monday to Thursday 9 AM–8 PM and Friday 9 AM–5 PM.</p></div>
        <div class="ab-offices">
          {locations.map((l, i) => (
            <article class="ab-office" style={`--bar:${bars[i]}`}>
              <a class="ab-office-media" href={`/location/${l.slug}/`}><img src={officePhoto[l.slug]} alt={`Hopewell Health Solutions, ${l.name}`} width="1200" height="900" loading="lazy" /><span>{l.name}</span></a>
              <div class="ab-office-body">
                <span class:list={["ab-office-care", l.addiction && "is-add"]}>{l.addiction ? "Mental health & addiction care" : "Mental health & psychiatry"}</span>
                <h3 class="sr-only">{l.name}</h3>
                <p class="ab-office-addr"><Icon name="pin" class="h-4 w-4" />{l.street}, {l.city}, CT {l.zip}</p>
                <p>{l.blurb.replace(/<[^>]+>/g, "")}</p>
                <ul class="ab-office-offers" aria-label={`Services at ${l.name}`}>
                  {OFFER_ORDER.filter((k) => l.offers?.includes(k)).map((k) => <li><Icon name={OFFERS[k].icon} class="h-4 w-4" /><a href={OFFERS[k].href}>{OFFERS[k].t}</a></li>)}
                </ul>
                <div class="ab-office-ctas">
                  <a href={`/location/${l.slug}/`} class="btn btn-navy">View office <Icon name="arrow" /></a>
                  <a href="tel:8607351448" class="btn btn-outline"><Icon name="phone" />Call</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Areas served -->
    <section class="section is-white" id="choose">
      <div class="container">
        <div class="sec-head"><h2>Which office is right for you?</h2><p class="lede">Every office offers 1:1 therapy and medication management, in person and by telehealth. Some programs meet only at certain offices, so here’s where to go for what you need.</p></div>
        <div class="hb-tiles">
          {guide.map((g) => <div class="hb-tile" style={`--bar:${g.bar}`}><span class="hb-tile-icon"><Icon name={g.icon} /></span><h3>{g.t}</h3><p set:html={g.d} /></div>)}
        </div>
      </div>
    </section>

    <section class="section is-stone" id="visit">
      <div class="container">
        <div class="lh-visit-top">
          <div class="sec-head" style="margin:0"><h2>What to expect when you visit</h2><p class="lede">Comfortable, private offices that feel more like a living room than a clinic, and a team that walks you through every step. Read more about <a class="inl" href="/admissions/#what-to-expect">what to expect at your first visit</a>.</p>
            <p class="lh-visit-note"><Icon name="play" class="h-5 w-5" />Watch a 16-second look inside our Glastonbury spaces.</p></div>
          {tour && (
            <button type="button" class="vc-card lh-tour" data-yt={tour.yt} data-title={tour.title} data-vertical="1" aria-label={`Play: ${tour.title}`}>
              <span class="vc-poster"><img src={`/Assets/videos/${tour.img}.webp`} alt="" width="1280" height="720" loading="lazy" /><span class="vc-play"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="#fff"/></svg></span><span class="vc-len">{tour.len}</span></span>
              <span class="vc-body"><span class="vc-type">Take a look inside</span><span class="vc-name">Welcome to Hopewell</span><span class="vc-desc">{tour.desc}</span></span>
            </button>
          )}
        </div>
        <ol class="step-grid">
          {visit.map(([icon, t, d], i) => <li class="step"><span class="step-dot"><Icon name={icon} /></span><span class="step-num">Step {i + 1}</span><h3>{t}</h3><p>{d}</p>{i < visit.length - 1 && <span class="step-arrow" aria-hidden="true"><Icon name="arrow" class="h-4 w-4" /></span>}</li>)}
        </ol>
      </div>
    </section>

    <section class="section is-mist" id="areas">
      <div class="container ab-areas">
        <div>
          <h2>Serving towns across Connecticut</h2>
          <p class="lede" style="margin-top:14px">From Hartford County to the shoreline, clients travel to our offices from dozens of nearby communities, and telehealth reaches every corner of the state.</p>
        </div>
        <ul class="ab-towns is-wide">{allAreas.map((a) => <li><Icon name="pin" class="h-4 w-4" />{a}</li>)}</ul>
      </div>
    </section>

    <!-- Telehealth (user 2026-11-17: "put more love on design"): navy card, benefits, steps and a video-call illustration -->
    <section class="section is-white" id="telehealth">
      <div class="container">
        <div class="lh-tele">
          <svg class="lh-tele-arcs" viewBox="0 0 600 600" aria-hidden="true"><circle cx="300" cy="300" r="290" /><circle cx="300" cy="300" r="200" /></svg>
          <div class="lh-tele-copy">
            <span class="lh-tele-tag"><Icon name="compass" class="h-4 w-4" />Telehealth across Connecticut</span>
            <h2>The same team, from wherever you are</h2>
            <p class="lede">Can’t make it to an office, or prefer to meet from home? Our secure video telehealth brings the same clinicians and the same quality of care to anywhere in Connecticut. It’s ideal for busy schedules, transportation challenges, or simply the comfort of your own space, and you can move between in-person and virtual visits whenever it suits your life.</p>
            <ul class="lh-tele-list">
              {teleWhy.map(([icon, t]) => <li><span><Icon name={icon} class="h-5 w-5" /></span>{t}</li>)}
            </ul>
            <div class="lh-tele-ctas">
              <a href="tel:8607351448" class="btn btn-blue"><Icon name="phone" />Call (860) 735-1448</a>
              <a href="/programs/counseling/" class="btn lh-tele-ghost">Telehealth counseling <Icon name="arrow" /></a>
            </div>
          </div>
          <figure class="lh-tele-art" aria-hidden="true">
            <svg viewBox="0 0 420 330">
              <defs><linearGradient id="lhtScreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#eaf2fb"/><stop offset="1" stop-color="#d6e5f5"/></linearGradient></defs>
              <rect x="40" y="30" width="340" height="215" rx="16" fill="#fff" />
              <rect x="54" y="44" width="312" height="187" rx="10" fill="url(#lhtScreen)" />
              <rect x="66" y="56" width="186" height="163" rx="10" fill="#265489" />
              <circle cx="159" cy="118" r="26" fill="#f2d3b8" /><path d="M133 112c2-20 48-22 52 0-8-8-40-9-52 0z" fill="#6b4a33" />
              <path d="M111 219c4-34 26-48 48-48s44 14 48 48z" fill="#9cc3ea" />
              <rect x="264" y="56" width="90" height="76" rx="10" fill="#b6863c" />
              <circle cx="309" cy="88" r="15" fill="#e8c4a2" /><path d="M287 132c3-18 13-26 22-26s19 8 22 26z" fill="#f4e6d0" />
              <rect x="264" y="142" width="90" height="77" rx="10" fill="#fff" />
              <rect x="276" y="156" width="54" height="7" rx="3.5" fill="#9cc3ea" /><rect x="276" y="170" width="66" height="7" rx="3.5" fill="#d6e5f5" /><rect x="276" y="184" width="44" height="7" rx="3.5" fill="#d6e5f5" />
              <circle cx="288" cy="205" r="7" fill="#2f76c4" /><circle cx="309" cy="205" r="7" fill="#e05a4f" /><circle cx="330" cy="205" r="7" fill="#5c7c6b" />
              <path d="M20 252h380l-22 22H42z" fill="#d6e5f5" /><rect x="176" y="252" width="68" height="6" rx="3" fill="#9cc3ea" />
              <g transform="translate(312 8)"><rect width="96" height="34" rx="17" fill="#fff" /><path d="M20 10l9 4v6c0 5-4 8-9 10-5-2-9-5-9-10v-6z" fill="#5c7c6b" /><text x="36" y="22" font-family="Urbanist, sans-serif" font-weight="800" font-size="12" fill="#0b2f55">Secure</text></g>
              <g transform="translate(0 286)"><rect width="150" height="36" rx="18" fill="#fff" /><circle cx="18" cy="18" r="7" fill="#2f76c4" /><text x="32" y="23" font-family="Urbanist, sans-serif" font-weight="800" font-size="12.5" fill="#0b2f55">Anywhere in CT</text></g>
            </svg>
          </figure>
          <ol class="lh-tele-steps">
            {teleSteps.map(([t, d], i) => <li><span class="lh-tele-n">{i + 1}</span><span><strong>{t}</strong>{d}</span></li>)}
          </ol>
        </div>
      </div>
    </section>

    <!-- Why -->
    <section class="section is-stone" id="why">
      <div class="container">
        <div class="sec-head"><h2>The same trusted care at every location</h2></div>
        <div class="ab-why">
          {why.map((w) => (
            <div><span class="usp-icon"><Icon name={w.icon} class="h-6 w-6" /></span><h3>{w.t}</h3><p>{w.d}</p></div>
          ))}
        </div>
      </div>
    </section>

    <VideoCarousel videos={STORIES} heading="Stories From Our Offices" lede="Clients and families from across Connecticut share <a class='inl' href='/testimonials/'>what treatment at Hopewell was like</a>." />
    <Team tone="stone" />
    <Insurance heading="Most major PPO plans accepted" lede="We’re in-network with most major PPO plans. Our team verifies your benefits at no cost, at every one of our locations, before you commit to anything." />

    <!-- Services -->
    <section class="section is-white" id="services">
      <div class="container">
        <div class="sec-head"><h2>Services &amp; programs across our offices</h2><p class="lede">Outpatient therapy and medication management are available across our offices, and our intensive programs (IOP/PHP) and specialized treatments (TMS and testing) are offered at select locations. Addiction services are offered at our Downtown Glastonbury and Westbrook offices.</p></div>
        <div class="ab-svc">
          {allServices.map((s) => <a href={s.href} class:list={[s.addiction && "is-add"]}><span class="icon-badge"><Icon name={s.icon} /></span>{s.t}<Icon name="arrow" class="h-5 w-5" /></a>)}
        </div>
      </div>
    </section>

    <Reviews tone="white" />
    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" />
    <Faq faqs={faqsHtml} heading="Locations, common questions" />
    <ClosingCta heading="Find the right office for you" lede="Reach out to Hopewell Health Solutions today, confidentially, with no pressure, and we’ll help you choose the location nearest you, or set up a telehealth visit." image={P + "full-team-lawn.webp"} />
  </main>
  <Footer />
</Base>
