<script>
  // Hero banner: crossfade the office photos and update the caption.
  const slides = [...document.querySelectorAll<HTMLElement>(".lh-hero .hero-slide")];
  const now = document.querySelector<HTMLElement>(".lh-hero-now span");
  const caps = slides.map((_, i) => (document.querySelectorAll(".lh-gal .ps-cap")[i] as HTMLElement | undefined)?.textContent ?? "");
  if (slides.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let i = 0;
    setInterval(() => {
      slides[i].classList.remove("is-active"); i = (i + 1) % slides.length; slides[i].classList.add("is-active");
      if (now && caps[i]) now.textContent = caps[i];
    }, 6000);
  }
</script>
