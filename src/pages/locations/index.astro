];
const visit = [
  ["phone", "Before you come", "We confirm your appointment, check your insurance for free and tell you which office and suite to come to."],
  ["pin", "Arriving", "We’ll tell you where to park when we confirm your appointment. Arrive a few minutes early for your first visit."],
