<script>
  document.querySelectorAll<HTMLButtonElement>("#lh-more + .sp-more, .sp-more[aria-controls='lh-more']").forEach((b) => b.addEventListener("click", () => {
    const box = document.getElementById("lh-more")!; const open = box.classList.toggle("is-open");
    b.setAttribute("aria-expanded", String(open)); b.textContent = open ? "Show less" : "Read more";
  }));
</script>
