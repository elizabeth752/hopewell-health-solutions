---
// Admissions — 2026 redesign (Corner Canyon layout, Hopewell brand). Keeps title, description, canonical, H1 and all copy.
// Anchors the header links to: #verify (hero form, desktop), #what-to-expect, #for-families.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ServiceHero from "../../components/hw/ServiceHero.astro";
import Creds from "../../components/hw/Creds.astro";
import Insurance from "../../components/hw/Insurance.astro";
import Reviews from "../../components/hw/Reviews.astro";
import Locations from "../../components/hw/Locations.astro";
import Faq from "../../components/hw/Faq.astro";
import ClosingCta from "../../components/hw/ClosingCta.astro";
import "../../styles/pages/admissions.css";

const canonical = "https://www.hopewellhealthsolutions.com/admissions/";
const P = "/Assets/hhs-2026/";

const steps = [
  { icon: "phone", t: "Reach out", d: "Call us, or request a confidential callback — no commitment." },
  { icon: "shield", t: "Verify insurance", d: "We check your benefits for you — free, in minutes." },
  { icon: "clipboard", t: "Assessment", d: "A clinical assessment matches you to the right care." },
  { icon: "compass", t: "Begin care", d: "Start at the right level — and adjust as you heal." },
];
const expect = [
  { icon: "phone", t: "A real person, not a portal", d: "When you call, you’ll reach a caring member of our team — never an automated maze." },
  { icon: "shield", t: "A free benefits check", d: "We verify your insurance for you, so you know your coverage before you commit to anything." },
  { icon: "clipboard", t: "A thorough assessment", d: "A clinical assessment matches you with the right clinician and the right level of care." },
  { icon: "compass", t: "A plan built around you", d: "You’ll start at the level that fits — and we adjust the plan as you heal." },
];
// Answers use facts already published on this site (programs, rates, locations pages).
const faqs = [
  ["How do I start treatment at Hopewell Health Solutions?", `Call <a class="inl" href="tel:8607351448">(860) 735-1448</a> or request a confidential callback. We verify your insurance for free, complete a clinical assessment, and match you to the right level of care, from <a class="inl" href="/programs/counseling/">counseling</a> to an <a class="inl" href="/programs/intensive-outpatient-program/">intensive outpatient program</a>.`],
  ["Do I need a referral or a diagnosis to reach out?", `No. You don’t need a diagnosis or all the answers to reach out. Call us, and we’ll help you understand the options and figure out the right next step.`],
  ["Which insurance plans do you accept?", `We’re in-network with most major PPO plans, including Anthem, Blue Cross/Blue Shield, Optum, United, Meritain, Aetna, Cigna, Evernorth, TRICARE, Magellan, Harvard Pilgrim, ConnectiCare, UMR, and VA Care. See <a class="inl" href="/rates-and-insurance-coverage/">rates and insurance coverage</a>.`],
  ["Can a parent or family member call for a loved one?", `Yes. Families can call on behalf of a child, partner, or parent. Our <a class="inl" href="/programs/teen-tween-iop/">Teen &amp; Tween IOP</a> weaves families directly into the work, and our team is glad to talk through how to support a loved one.`],
  ["Do you offer telehealth?", `Yes. Therapy and medication management are available in person or by telehealth, and our team will help you choose what fits your plan.`],
  ["Where are your offices?", `We have six Connecticut offices: three in Glastonbury, plus West Hartford, East Hampton and Westbrook. See <a class="inl" href="/locations/">all locations</a>.`],
];
---

<Base title="Admissions — Get Started | Hopewell Health Solutions" description="Getting started at Hopewell Health Solutions in Connecticut is simple. Verify your insurance, learn what to expect, and reach our team — confidentially, with no pressure. In person & telehealth." canonical={canonical}>
  <Header />
  <main class="hw">
    <ServiceHero
      crumbs={[{ label: "Admissions" }]}
      title="Admissions Made Simple"
      lede="Reaching out is the hardest part — we handle the rest. From your first call to your first session, the Hopewell Health Solutions team makes admissions simple, confidential, and pressure-free."
      bullets={["Free, confidential insurance check", "A real person, not a portal", "In person or by telehealth", "Six Connecticut offices"]}
      facts={[{ icon: "phone", text: "(860) 735-1448" }, { icon: "pin", text: "Glastonbury · West Hartford · East Hampton · Westbrook" }]}
      image={P + "iop-team-hallway.webp"}
      imagePos="center 40%"
    />
    <Creds />

    <!-- How admissions works -->
    <section class="section is-white">
      <div class="container">
        <div class="sec-head"><h2>How admissions works</h2><p class="lede">Four simple steps — and a real person with you the whole way.</p></div>
        <ol class="step-grid">
          {steps.map((s, i) => (
            <li class="step">
              <span class="step-dot"><Icon name={s.icon} /></span>
              <span class="step-num">Step {i + 1}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              {i < steps.length - 1 && <span class="step-arrow" aria-hidden="true"><Icon name="arrow" class="h-4 w-4" /></span>}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- What to expect -->
    <section id="what-to-expect" class="section is-stone" style="scroll-margin-top:110px">
      <div class="container ad-split">
        <div class="ad-photo">
          <img src={P + "south-glastonbury-waiting-room.webp"} alt="The waiting room at our South Glastonbury office" width="1200" height="900" loading="lazy" />
          <p class="ad-photo-badge"><span><Icon name="heart" class="h-5 w-5" /></span>No surprises</p>
        </div>
        <div>
          <h2>What to expect</h2>
          <p class="lede" style="margin-top:14px">From the first call to your first session, here’s what working with us looks like.</p>
          <ul class="ad-rows">
            {expect.map((e) => <li><span class="icon-badge"><Icon name={e.icon} /></span><div><h3>{e.t}</h3><p>{e.d}</p></div></li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Verify insurance (the hero form is the desktop form; phones get one form right above this section) -->
    <Insurance heading="Verify your insurance — free" lede="We’re in-network with most major PPO plans (we don’t accept Medicaid / HUSKY). Our team verifies your benefits at no cost and walks you through your options before you commit to anything. See <a class='inl' href='/rates-and-insurance-coverage/'>full rates &amp; insurance details</a>." tone="white" />

    <!-- For families -->
    <section id="for-families" class="section is-mist" style="scroll-margin-top:110px">
      <div class="container ad-split">
        <div>
          <h2>Helping someone you love</h2>
          <p class="lede" style="margin-top:16px">Watching a child, partner, or parent struggle is one of the hardest things there is. You don’t need a diagnosis or all the answers to reach out — call us, and we’ll help you understand the options and figure out the right next step.</p>
          <p class="lede" style="margin-top:14px">Our <a class="inl" href="/programs/teen-tween-iop/">teen and tween programs</a> weave families directly into the work, and our team is always glad to talk through how to support a loved one with compassion and patience.</p>
          <div class="sv-ctas">
            <a href="tel:8607351448" class="btn btn-blue"><Icon name="phone" />(860) 735-1448</a>
            <a href="#verify" class="btn btn-outline only-d">Get guidance</a>
            <a href="#verify-m" class="btn btn-outline only-m">Get guidance</a>
          </div>
        </div>
        <div class="ad-photo">
          <img src={P + "team-lawn-small.webp"} alt="Support for families at Hopewell Health Solutions, Connecticut" width="1200" height="900" loading="lazy" />
          <p class="ad-photo-badge"><span><Icon name="users" class="h-5 w-5" /></span>For families &amp; loved ones</p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section is-white">
      <div class="container">
        <div class="sec-head"><h2>Contact our team</h2><p class="lede">We’re here to answer questions, verify benefits, or just talk through your options — confidentially, with no pressure.</p></div>
        <div class="ad-contact">
          <a href="tel:8607351448"><span class="icon-badge"><Icon name="phone" /></span><span><strong>(860) 735-1448</strong><small>Call or request a callback</small></span></a>
          <a href="mailto:hhs4help@gmail.com"><span class="icon-badge"><Icon name="clipboard" /></span><span><strong>hhs4help@gmail.com</strong><small>Please don’t include health details</small></span></a>
          <a href="/locations/"><span class="icon-badge"><Icon name="pin" /></span><span><strong>Our 6 CT locations</strong><small>Glastonbury to Westbrook</small></span></a>
        </div>
      </div>
    </section>

    <Reviews tone="stone" />
    <Locations tone="white" heading="Find an Office Near You" lede="Six Connecticut offices, with care in person or by telehealth." />
    <Faq faqs={faqs} heading="Admissions Questions" tone="stone" />
    <ClosingCta heading="Ready when you are" lede="Whether it’s for you or someone you love, reaching out is the first step. We’ll take it from there. Not a substitute for emergency care." />
  </main>
  <Footer />
</Base>
