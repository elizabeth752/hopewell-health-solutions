---
// Admissions hero (2026-11-16 briefs): the navy What We Treat hero (wq-hero, hubs.css) with the insurance form on the
// right. The brief makes the form an equal option to calling on every admissions page, so it stays visible on phones
// too (stacked under the copy). Emits BreadcrumbList schema. Lives under pages/admissions/_parts (not routed).
import Icon from "../../../components/Icon.astro";
import LeadForm from "../../../components/LeadForm.astro";
import { PHONE, SITE } from "../../../data/site.js";
interface Crumb { label: string; href?: string }
interface Props { crumbs: Crumb[]; title: string; lede: string; facts?: { icon: string; text: string }[]; note?: string; formId?: string }
const { crumbs, title, lede, facts = [], note, formId = "hhs-hero" } = Astro.props;
const all = [{ label: "Home", href: "/" }, ...crumbs];
const ld = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: all.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.label, item: SITE + (c.href ?? Astro.url.pathname) })) };
---
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<section class="wq-hero ax-hero">
  <svg class="wq-hero-arcs" viewBox="0 0 800 800" aria-hidden="true"><circle cx="400" cy="400" r="390" /><circle cx="400" cy="400" r="290" /></svg>
  <div class="container wq-hero-grid ax-hero-grid">
    <div>
      <nav class="wq-crumbs" aria-label="Breadcrumb">{all.map((c, i) => <Fragment>{i > 0 && " / "}{c.href && i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</Fragment>)}</nav>
      <h1 set:html={title} />
      <p class="lede" set:html={lede} />
      {facts.length > 0 && <ul class="wq-facts">{facts.map((f) => <li><Icon name={f.icon} class="h-[18px] w-[18px]" /><span set:html={f.text} /></li>)}</ul>}
      <div class="wq-ctas"><a href={PHONE.href} class="btn btn-blue"><Icon name="phone" />Call {PHONE.display}</a></div>
      {note && <p class="ax-hero-note"><Icon name="clock" class="h-[18px] w-[18px]" /><span set:html={note} /></p>}
      <slot />
      <p class="ax-hero-crisis">In crisis? Call or text <a href="tel:988">988</a> or call <a href="tel:911">911</a>.</p>
    </div>
    <div class="ax-hero-form" id="verify"><span id="verify-m"></span><LeadForm variant="card" formId={formId} /></div>
  </div>
</section>
