---
import "../styles/global.css";
import "../styles/site.css";
import EventPopup from "../components/EventPopup.astro";
import WestbrookLauncher from "../components/WestbrookLauncher.astro";
import GoogleBadge from "../components/hw/GoogleBadge.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  robots?: string;
}

const SITE = "https://www.hopewellhealthsolutions.com";
const {
  title = "Hopewell Health Solutions",
  description = "Hopewell Health Solutions",
  canonical,
  image = "/Assets/full%20team%20happy.webp",
  robots = "index, follow, max-image-preview:large",
} = Astro.props;

const ogImage = image.startsWith("http") ? image : SITE + image;
// Every page gets a self-referencing canonical by default (override via the `canonical` prop).
const canonicalHref = canonical || SITE + Astro.url.pathname;
const ogUrl = canonicalHref;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico?v=4" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=4" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
    <meta name="robots" content={robots} />
    <!-- Self-hosted fonts — preload critical faces for faster LCP (H1/body text) -->
    <link rel="preload" href="/fonts/urbanist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/baskervville-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <!-- Google Tag Manager — loads immediately (async) so CTM swaps the number before anyone can call the default one -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-KHKPJ2RF');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hopewell Health Solutions" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KHKPJ2RF" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
    <EventPopup />
    <WestbrookLauncher />
    <GoogleBadge />
  <script>
  // Phones (user 2026-11-17: "all the galleries should be always moving on mobile"): every gallery/carousel/marquee becomes a
  // row of whole photos (or video cards) that glides continuously (~30px/s) and loops via cloned items. Stops while
  // touched/hovered/focused (resumes 3s later), while a video is open and off-screen. Reduced motion: plain swipe row.
  (() => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const phone = matchMedia("(max-width: 640px)").matches;
    // Touch tablets: only the self-moving marquees switch to the swipeable drift (galleries keep their tablet grid).
    if (!phone && !matchMedia("(hover: none) and (pointer: coarse)").matches) return;
    const MARQUEES = ".lc-track, .rv-loop-track, .vc-marquee .vc-track, .ps-mq-track";
    const SEL = phone ? `.ps-strip .ps-track, .ps-single .ps-track, .tp-grid, .ab-gal, #offices-gallery .ab-offices, .vc-grid, ${MARQUEES}` : MARQUEES;
    // These marquees already render their list twice (second half aria-hidden), so they loop without extra clones.
    const PRE = ".lc-track, .rv-loop-track, .vc-track, .ps-mq-track";
    document.querySelectorAll<HTMLElement>(SEL).forEach((row) => {
      const pre = row.matches(PRE);
      const items = (pre ? [...row.children].slice(0, row.children.length / 2) : [...row.children]) as HTMLElement[];
      if (items.length < 2) return;
      row.classList.add("m-drift");
      row.closest(".ps")?.classList.add("m-drift-host");
      if (!pre) items.forEach((it, i) => {
        const c = it.cloneNode(true) as HTMLElement;
        c.classList.add("m-clone"); c.setAttribute("aria-hidden", "true");
        c.querySelectorAll("img").forEach((im) => im.setAttribute("alt", ""));
        c.querySelectorAll<HTMLElement>("a, button").forEach((el) => el.setAttribute("tabindex", "-1"));
        // Cloned video buttons have no player handler, so they forward the tap to the original card.
        c.querySelectorAll<HTMLElement>("button").forEach((b) => b.addEventListener("click", () => items[i].querySelector<HTMLElement>("button")?.click()));
        row.append(c);
      });
      let hold = false, seen = false, resume = 0, pos = 0, last = 0;
      const pause = () => { hold = true; clearTimeout(resume); };
      const later = () => { clearTimeout(resume); resume = window.setTimeout(() => { pos = row.scrollLeft; hold = false; }, 3000); };
      row.addEventListener("touchstart", pause, { passive: true }); row.addEventListener("touchend", later, { passive: true });
      row.addEventListener("mouseenter", pause); row.addEventListener("mouseleave", later);
      row.addEventListener("focusin", pause); row.addEventListener("focusout", later);
      new IntersectionObserver(([e]) => (seen = e.isIntersecting), { threshold: 0.2 }).observe(row);
      const frame = (t: number) => {
        const dt = last ? Math.min(t - last, 64) : 0; last = t;
        // first visible item of each half (office tabs can hide cards)
        const kids = [...row.children] as HTMLElement[];
        const a = kids.slice(0, items.length).find((k) => !k.hidden), b = kids.slice(items.length).find((k) => !k.hidden);
        const half = a && b ? b.offsetLeft - a.offsetLeft : 0;
        if (half > 0 && !hold && seen && !document.hidden && !document.querySelector("dialog[open]")) {
          pos += dt * 0.03;
          if (pos >= half) pos -= half;
          row.scrollLeft = pos;
        } else if (hold && half > 0 && row.scrollLeft >= half) row.scrollLeft -= half;
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    });
  })();
</script>
<script>
  // Phones: condition/treatment cards show the summary first, the rest opens with "Read more" (text stays in the HTML).
  document.querySelectorAll<HTMLElement>(".wq-card").forEach((card) => {
    if (!card.querySelector(":scope > p:not(.wq-line):not(.wq-meta)")) return;
    card.classList.add("has-more");
    const b = document.createElement("button");
    b.type = "button"; b.className = "wq-more"; b.textContent = "Read more"; b.setAttribute("aria-expanded", "false");
    b.addEventListener("click", () => { const open = card.classList.toggle("is-open"); b.textContent = open ? "Show less" : "Read more"; b.setAttribute("aria-expanded", String(open)); });
    const meta = card.querySelector(":scope > .wq-meta");
    meta ? card.insertBefore(b, meta) : card.append(b);
  });
</script>
<script>
  // Phones hide the hero form (one form sits above insurance), so "#verify" links jump to whichever form is visible.
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href="#verify"], a[href$="/#verify"]');
    if (!a || (a.pathname !== location.pathname && !a.getAttribute("href")!.startsWith("#"))) return;
    const t = document.getElementById("verify");
    if (t && t.offsetParent) return;
    const alt = [...document.querySelectorAll<HTMLElement>(".lead-card")].find((el) => el.offsetParent);
    if (!alt) return;
    e.preventDefault();
    alt.scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>
</body>
</html>
