---
import "../styles/global.css";
import EventPopup from "../components/EventPopup.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  robots?: string;
}

const SITE = "https://www.hopewellhealthsolutions.com";
const {
  title = "Hopewell Health Solutions",
  description = "Hopewell Health Solutions",
  canonical,
  image = "/Assets/full%20team%20happy.webp",
  robots = "index, follow, max-image-preview:large",
} = Astro.props;

const ogImage = image.startsWith("http") ? image : SITE + image;
// Every page gets a self-referencing canonical by default (override via the `canonical` prop).
const canonicalHref = canonical || SITE + Astro.url.pathname;
const ogUrl = canonicalHref;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico?v=4" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=4" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
    <meta name="robots" content={robots} />
    <!-- Self-hosted fonts — preload critical faces for faster LCP (H1/body text) -->
    <link rel="preload" href="/fonts/urbanist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/baskervville-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://api.calltrackingmetrics.com" />
    <!-- Google Tag Manager — deferred until idle to reduce JS/main-thread impact -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
      function loadGtm() {
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtm.js?id=GTM-KHKPJ2RF";
        document.head.appendChild(s);
      }
      if ("requestIdleCallback" in window) {
        requestIdleCallback(loadGtm, { timeout: 4500 });
      } else {
        window.addEventListener("load", function () { setTimeout(loadGtm, 2000); });
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hopewell Health Solutions" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KHKPJ2RF" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
    <EventPopup />
  </body>
</html>
