---
// Program cards: photo with the title over a navy fade, a colour band, the description, and a quick-facts row.
import Icon from "../Icon.astro";
interface Prog { t: string; d: string; href: string; img: string; bar?: string; facts?: [string, string][] }
interface Props { items: Prog[]; cols?: 3 | 4 }
const { items, cols = 4 } = Astro.props;
---
<div class={`pc-grid cols-${cols}`}>
  {items.map((p) => (
    <a href={p.href} class="pc" style={`--bar:${p.bar ?? "#2f76c4"}`}>
      <span class="pc-media"><img src={p.img} alt="" width="1200" height="900" loading="lazy" /><span class="pc-title">{p.t}</span></span>
      <span class="pc-body">
        <span class="pc-t-m">{p.t}</span>
        <span class="pc-desc">{p.d}</span>
        {p.facts && <span class="pc-facts">{p.facts.map(([icon, t]) => <span><Icon name={icon} class="h-4 w-4" />{t}</span>)}</span>}
        <span class="pc-go">Explore {p.t.replace(/ \(.*\)/, "")}<Icon name="arrow" class="h-4 w-4" /></span>
      </span>
    </a>
  ))}
</div>
