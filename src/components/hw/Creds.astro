---
// Accreditation band: bare logos in one row.
import LegitScriptSeal from "../LegitScriptSeal.astro";
import BbbSeal from "../BbbSeal.astro";
import MediaStrip from "../MediaStrip.astro";
// "As featured in" sits right under the accreditations on every page (user 2026-11-17).
const { media = true } = Astro.props;
---
<div class="creds">
  <div class="container">
    <ul class="creds-list" aria-label="Accredited and verified by">
      <li><img src="/Assets/home-b/joint-commission-seal.webp" alt="The Joint Commission, Gold Seal of Approval" width="240" height="240" loading="lazy" /></li>
      <li><LegitScriptSeal /></li>
      <li><img src="/Assets/home-b/psychology-today-verified.webp" alt="Psychology Today Verified" class="is-wide" width="300" height="80" loading="lazy" /></li>
      <li><BbbSeal /></li>
      <li><img src="/Assets/credibility/joint-commission.webp" alt="The Joint Commission, Accredited" class="is-wide" width="300" height="72" loading="lazy" /></li>
    </ul>
  </div>
</div>
{media && <MediaStrip bg="white" compact />}
