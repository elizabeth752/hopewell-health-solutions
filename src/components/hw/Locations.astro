---
// Locations: a Connecticut map drawn from each office's real coordinates (numbered pins) beside compact office cards with
// photos. Gold pins = offices that also offer addiction treatment (locations.js `addiction`). `current` highlights one.
import { locations } from "../../data/locations.js";
import Icon from "../Icon.astro";
interface Props { heading?: string; lede?: string; current?: string; tone?: "mist" | "white" | "stone" }
const { heading = "Care Near You, Across Central Connecticut", lede = "Hopewell Health Solutions provides expert mental-health and psychiatric care from offices in Glastonbury, South Glastonbury, West Hartford, East Hampton, and Westbrook, CT — serving Hartford and Middlesex Counties, including South Windsor, Wethersfield, Rocky Hill, Newington, Berlin, Colchester, Old Saybrook, and Clinton. Our compassionate team also sees clients virtually across New England, so trusted psychiatric support is always within reach.", current, tone = "mist" } = Astro.props;
const P = "/Assets/hhs-2026/";
const photo = {
  "glastonbury-ct": "/Assets/locations/glastonbury/exterior.webp",
  "glastonbury-ct-2": P + "downtown-glastonbury-sign.webp",
  "glastonbury-ct-3": P + "south-glastonbury-office.webp",
  "west-hartford-ct": P + "west-hartford-office.webp",
  "east-hampton-ct": "/Assets/locations/east-hampton/exterior.webp",
  "westbrook-ct": P + "westbrook-sign.webp",
};
// Connecticut outline projected to a 400×306 box.
const proj = (lng, lat) => [((lng + 73.75) / 1.98) * 400, ((42.07 - lat) / 1.13) * 306];
const outline = [[-73.49,42.05],[-71.80,42.02],[-71.80,41.33],[-71.86,41.32],[-72.10,41.31],[-72.38,41.27],[-72.55,41.26],[-72.90,41.25],[-73.10,41.16],[-73.40,41.08],[-73.66,40.99],[-73.73,41.10],[-73.48,41.21],[-73.55,41.29],[-73.52,41.66]].map(([a, b]) => proj(a, b).map((n) => n.toFixed(1)).join(",")).join(" ");
// Pins: the three Glastonbury offices sit within a mile of each other, so they fan out slightly to stay readable.
const nudge = { "glastonbury-ct": [-6, -5], "glastonbury-ct-2": [7, -1], "glastonbury-ct-3": [1, 7] };
const pins = locations.map((l, i) => { const [x, y] = proj(l.lng, l.lat); const [dx, dy] = nudge[l.slug] || [0, 0]; return { ...l, n: i + 1, x: x + dx, y: y + dy }; });
const towns = [["Hartford",-72.68,41.765],["Middletown",-72.65,41.56],["Old Saybrook",-72.38,41.29],["New Haven",-72.93,41.31],["Manchester",-72.52,41.776],["Wethersfield",-72.65,41.714],["Colchester",-72.33,41.575],["Clinton",-72.53,41.279]].map(([t, a, b]) => ({ t, xy: proj(a, b) }));
const mapsHref = (l) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Hopewell Health Solutions, ${l.street}, ${l.city}, CT ${l.zip}`)}`;
---
<section class={`section is-${tone}`} id="locations">
  <div class="container">
    <div class="sec-head"><h2>{heading}</h2><p class="lede" set:html={lede} /></div>
    <div class="lx-grid">
      <figure class="lx-map">
        <svg viewBox="128 22 210 228" role="img" aria-label="Map of Connecticut with Hopewell's six offices: three in Glastonbury, plus West Hartford, East Hampton and Westbrook">
          <polygon points={outline} fill="#fff" stroke="#265489" stroke-opacity=".3" stroke-width="2" stroke-linejoin="round" />
          <text x="150" y="246" font-size="6.5" fill="#265489" fill-opacity=".5" font-weight="700" letter-spacing="2" font-family="Urbanist, sans-serif">LONG ISLAND SOUND</text>
          {towns.map((t) => <g><circle cx={t.xy[0]} cy={t.xy[1]} r="1.4" fill="#5a6b7a" fill-opacity=".55" /><text x={t.xy[0] - 3} y={t.xy[1] + 2} text-anchor="end" font-size="5" fill="#5a6b7a" font-family="Urbanist, sans-serif">{t.t}</text></g>)}
          {pins.map((p) => (
            <a href={`/location/${p.slug}/`} aria-label={p.name}>
              <g class:list={["lx-pin", current === p.slug && "is-current"]}>
                <circle cx={p.x} cy={p.y} r="6.2" fill={p.addiction ? "#b6863c" : "#2f76c4"} stroke="#fff" stroke-width="1.2" />
                <text x={p.x} y={p.y + 2.2} text-anchor="middle" font-size="6.4" font-weight="800" fill="#fff" font-family="Urbanist, sans-serif">{p.n}</text>
              </g>
            </a>
          ))}
        </svg>
        <figcaption><span><i style="background:#2f76c4"></i>Mental health care</span><span><i style="background:#b6863c"></i>Mental health &amp; addiction care</span></figcaption>
      </figure>
      <ol class="lx-list">
        {pins.map((p) => (
          <li class:list={["lx", current === p.slug && "is-current"]}>
            <img src={photo[p.slug]} alt={`Hopewell Health Solutions ${p.name} office`} width="1200" height="900" loading="lazy" />
            <div class="lx-body">
              <span class:list={["lx-n", p.addiction && "is-add"]}>{p.n}</span>
              <h3><a href={`/location/${p.slug}/`}>{p.name}</a></h3>
              <p class="lx-addr">{p.street}, {p.city}, CT {p.zip}</p>
              <p class="lx-links"><a class="inl" href={`/location/${p.slug}/`}>Office details</a><a class="inl" href={mapsHref(p)} target="_blank" rel="noopener">Directions</a></p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
