---
// Insurance: copy + plan table on the left, how-it-works steps on the right, payer logo marquee below.
// On phones the page's one form sits right above this section (mobileForm), never inside it.
import LeadForm from "../LeadForm.astro";
import Icon from "../Icon.astro";
import { PHONE } from "../../data/site.js";
interface Props { heading?: string; lede?: string; mobileForm?: boolean; tone?: "stone" | "white" }
const { heading = "Comprehensive Coverage Options", lede = "We’re in-network with most major plans, and licensed in CT, Massachusetts, New York &amp; Florida. Not sure about your coverage? We’ll check it for you — free, in minutes.", mobileForm = true, tone = "stone" } = Astro.props;
const insurers = [
  ["Aetna","/Assets/Insurance/AETNA.webp"],["Anthem","/Assets/Insurance/Anthem.webp"],
  ["Blue Cross Blue Shield","/Assets/home-b/insurance/bcbs.svg"],["Cigna","/Assets/Insurance/CIGNA.webp"],
  ["ConnectiCare","/Assets/home-b/insurance/connecticare.svg"],["Harvard Pilgrim","/Assets/home-b/insurance/harvard-pilgrim.svg"],
  ["Magellan","/Assets/Insurance/Magellan%20Health.webp"],["Optum","/Assets/home-b/insurance/optum.svg"],
  ["TRICARE","/Assets/Insurance/TRICARE.webp"],["UMR","/Assets/home-b/insurance/umr.svg"],
  ["UnitedHealthcare","/Assets/home-b/insurance/unitedhealthcare.svg"],["VA Community Care","/Assets/Insurance/VA%20Community%20Care.webp"],
];
const steps = [
  ["phone", "Share your plan", "Request a callback or call us with your insurance card handy."],
  ["shield", "We verify your benefits", "Free and confidential, usually within minutes."],
  ["check", "You know your costs", "Before you start, with no pressure to commit."],
];
---
{mobileForm && <div class="mobile-verify is-white" id="verify-m"><div class="container"><LeadForm variant="card" formId="hhs-mobile" /></div></div>}
<section class={`section ${tone === "white" ? "is-white" : "is-stone"}`} id="insurance">
  <div class="container ins-grid">
    <div class="ins-copy">
      <h2>{heading}</h2>
      <p class="lede" set:html={lede} />
      <div class="plan-table">
        <div class="plan-row"><span>Commercial plans (Aetna, Anthem, BCBS, Cigna &amp; more)</span><span class="plan-status"><Icon name="check" class="h-4 w-4" />In-network</span></div>
        <div class="plan-row"><span>TRICARE &amp; VA Community Care</span><span class="plan-status"><Icon name="check" class="h-4 w-4" />Accepted</span></div>
        <div class="plan-row"><span>Not sure what your plan covers?</span><span class="plan-status is-info"><Icon name="shield" class="h-4 w-4" />Free check</span></div>
      </div>
      <p>See <a class="inl" href="/rates-and-insurance-coverage/">rates &amp; insurance</a>, or call <a class="inl" href={PHONE.href}>{PHONE.display}</a>.</p>
    </div>
    <ol class="ins-steps">
      {steps.map(([icon, t, d], i) => (
        <li><span class="ins-step-dot"><Icon name={icon} class="h-6 w-6" /></span><span><span class="step-num">Step {i + 1}</span><strong>{t}</strong><span>{d}</span></span></li>
      ))}
    </ol>
  </div>
  <div class="container payers">
    <div class="marquee" aria-label="Insurance plans we accept">
      <div class="marquee-track">
        {[0, 1].map((k) => insurers.map(([name, img]) => <span class="payer" aria-hidden={k === 1 ? "true" : undefined}><img src={img} alt={k === 0 ? name : ""} width="160" height="40" loading="lazy" /></span>))}
      </div>
    </div>
  </div>
</section>
