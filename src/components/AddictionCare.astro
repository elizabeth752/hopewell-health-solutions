---
import Icon from "./Icon.astro";
// Addiction levels-of-care band for the addiction cluster pages (SUD, alcohol, drug,
// prescription drugs, co-occurring). Addiction services are only offered at
// Downtown Glastonbury (300 Hebron Ave) and Westbrook (70 Essex Road) — keep it that way.
// Props: condition = lowercase phrase used in the intro (e.g. "alcohol addiction").
const { condition = "addiction" } = Astro.props;
const levels = [
  { icon: "calendar", t: "Addiction PHP", d: "Six structured hours of treatment a day, Monday to Friday, at our Glastonbury office, for when you need more support than weekly therapy.", href: "/programs/partial-hospitalization-program/" },
  { icon: "users", t: "Addiction IOP", d: "Our Addiction and Substance Use IOP meets 3 to 5 times a week in Glastonbury and Westbrook, built around SUD groups, CBT, DBT, and relapse prevention.", href: "/programs/substance-use-iop/" },
  { icon: "refresh", t: "Step-down after rehab", d: "Coming home from inpatient rehab or detox? Step down into our addiction PHP or IOP and keep the structure you worked for.", href: "/programs/substance-use-iop/" },
  { icon: "pill", t: "Ongoing outpatient care", d: "Individual therapy, psychiatric medication management, and MAT when it fits your plan, to protect recovery long term.", href: "/treatment-methods/medication-assisted-treatment/" },
];
---
<section class="bg-ink text-white">
  <div class="mx-auto max-w-6xl px-5 py-16">
    <div class="text-center">
      <h2 class="font-display text-3xl sm:text-4xl text-white text-balance">Addiction treatment at every level of care</h2>
      <p class="mt-3 text-white/80 max-w-2xl mx-auto text-pretty">Treatment for {condition} is matched to how much support you need right now, and changes as you get stronger, with one team the whole way through.</p>
    </div>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {levels.map((l) => (
        <a href={l.href} class="group rounded-2xl border border-white/15 bg-white/5 p-6 flex flex-col hover:border-gold-light hover:bg-white/10 transition">
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/10 text-gold-light"><Icon name={l.icon} class="h-6 w-6" /></span>
          <h3 class="mt-4 font-display text-lg text-white leading-snug">{l.t}</h3>
          <p class="mt-2 text-sm text-white/75 leading-relaxed flex-1">{l.d}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-gold-light group-hover:gap-2 transition-all">Learn more <Icon name="arrow" class="h-4 w-4" /></span>
        </a>
      ))}
    </div>
    <p class="mt-8 text-center text-sm text-white/70 text-pretty">Addiction treatment is offered in person at our Downtown Glastonbury office (300 Hebron Avenue) and our Westbrook office (70 Essex Road), with telehealth available.</p>
  </div>
</section>
