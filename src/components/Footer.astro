---
import { socials } from "../data/socials";
import Icon from "./Icon.astro";
// `above` = background colour of the section right above, so the wave blends in.
const { above = "#ffffff" } = Astro.props;
const locations = [
  ["Glastonbury", "33 Pratt St", "/location/glastonbury-ct/"],
  ["Downtown Glastonbury", "300 Hebron Ave", "/location/glastonbury-ct-2/"],
  ["South Glastonbury", "1420 Main St", "/location/glastonbury-ct-3/"],
  ["West Hartford", "1216 Farmington Ave", "/location/west-hartford-ct/"],
  ["East Hampton", "151 E. High St", "/location/east-hampton-ct/"],
  ["Westbrook", "70 Essex Rd", "/location/westbrook-ct/"],
];
const cols = [
  { h: "Programs", links: [
    ["Intensive Outpatient (IOP)", "/programs/intensive-outpatient-program/"],
    ["Partial Hospitalization (PHP)", "/programs/partial-hospitalization-program/"],
    ["Medication Management", "/programs/medication-management/"],
    ["Outpatient Therapy", "/programs/counseling/"],
  ] },
  { h: "What We Treat", links: [
    ["Depression", "/what-we-treat/depression/"],
    ["Anxiety", "/what-we-treat/anxiety/"],
    ["Trauma & PTSD", "/what-we-treat/trauma-ptsd/"],
    ["Addiction Treatment", "/what-we-treat/substance-use-disorder/"],
    ["ADHD", "/what-we-treat/adhd/"],
  ] },
  { h: "Treatments", links: [
    ["TMS", "/treatment-methods/tms/"],
    ["EMDR", "/treatment-methods/emdr/"],
    ["GeneSight®", "/treatment-methods/genesight-testing/"],
  ] },
];
---
<footer class="relative isolate overflow-hidden bg-night text-white/80">
  <!-- wave top, echoes the logo -->
  <svg class="block w-full h-10 sm:h-14" style={`color:${above}`} viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 0h1440v34c-120 26-240 40-360 30S840 22 720 30 480 74 360 72 120 40 0 30Z"/></svg>
  <div class="wrap pt-10 pb-12">
    <!-- call strip -->
    <div class="grid gap-6 rounded-[2rem] bg-white/[.06] p-6 sm:p-8 ring-1 ring-white/10 lg:grid-cols-[1fr_auto] lg:items-center">
      <div class="flex items-center gap-5">
        <img src="/Assets/logo/hopewell-wave-logo-white.svg" alt="Hopewell Health Solutions" width="990" height="444" loading="lazy" decoding="async" class="h-16 w-auto shrink-0" />
        <p class="text-[15px] leading-relaxed max-w-md">Connecticut’s intensive programs center for mental wellness &amp; psychiatry. There is hope to heal.</p>
      </div>
      <a href="tel:8607351448" class="btn btn-light h-14 text-lg"><Icon name="phone" class="h-5 w-5" />(860) 735-1448</a>
    </div>

    <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <h4 class="font-display text-xl text-white">Our Connecticut Locations</h4>
        <ul class="mt-4 space-y-3 text-[15px]">
          {locations.map(([city, addr, href]) => (
            <li><a href={href} class="flex gap-3 hover:text-white transition"><Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0 text-azul-light" /><span><span class="font-semibold text-white">{city}</span><br />{addr}</span></a></li>
          ))}
        </ul>
      </div>
      {cols.map((c) => (
        <div>
          <h4 class="font-display text-xl text-white">{c.h}</h4>
          <ul class="mt-4 space-y-2.5 text-[15px]">
            {c.links.map(([label, href]) => <li><a href={href} class="hover:text-white transition">{label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <h4 class="text-sm font-semibold text-white">Follow Us</h4>
      <ul class="flex flex-wrap gap-1.5">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" aria-label={`${s.label} (opens in a new tab)`} title={s.label} class:list={["grid h-9 w-9 place-items-center rounded-full bg-white/10 text-white hover:bg-white hover:text-ink focus-visible:bg-white focus-visible:text-ink transition", s.small ? "[&>svg]:h-3 [&>svg]:w-3" : "[&>svg]:h-3.5 [&>svg]:w-3.5"]}><Fragment set:html={s.svg} /></a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-10 border-t border-white/10 pt-7 grid items-center gap-4 text-xs text-white/60 text-center md:grid-cols-[1fr_auto_1fr] md:text-left">
      <span>© 2026 Hopewell Health Solutions, LLC. All rights reserved.</span>
      <a href="https://elev8.io" target="_blank" rel="noopener" aria-label="Website by elev8.io (opens in a new tab)" class="tracking-wide text-white/70 hover:text-white transition">by <strong class="font-bold text-white">elev8.io</strong></a>
      <span class="flex flex-wrap justify-center gap-4 md:justify-end"><a href="/privacy/" class="hover:text-white">Privacy</a><a href="/hipaa-notice/" class="hover:text-white">HIPAA Notice</a><a href="/terms/" class="hover:text-white">Terms</a><a href="/accessibility/" class="hover:text-white">Accessibility</a></span>
    </div>
  </div>
</footer>
