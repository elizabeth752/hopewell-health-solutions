---
// Reusable CTM lead form — posts to /api/lead (api/lead.js), which adds the
// FormReactor key server-side so it never ships in the page.
// Field map → CTM:
//   Full name        → caller_name
//   Phone            → phone_number (normalized to E.164, +1…)
//   Email (optional) → email  (CTM's built-in contact field, sent top-level —
//                      NOT custom_fields[]. CTM silently drops misnamed keys.)
//   Insurance carrier→ custom_fields[insurance_carrier]
//   Member/Policy ID → custom_fields[membership_policy_id]
//   gclid + ValueTrack from the landing URL → paid_attribution[…]
// variant="card": labeled two-column card with HIPAA badge (same fields, names and submit logic).
const { heading = "Request a confidential callback", sub = "Free insurance check. No pressure.", compact = false, variant = "default", formId = "hhs-lead" } = Astro.props;
const lbl = "mb-1.5 block text-[13px] leading-snug text-muted";
const field = "h-[45px] w-full min-w-0 rounded-lg border border-muted/50 bg-white px-[13px] text-[15px] text-ink focus:border-azul focus:outline-none focus:ring-2 focus:ring-azul/25";
const carriers = ["Aetna","Anthem","Blue Cross Blue Shield","Cigna","ConnectiCare","Evernorth","Harvard Pilgrim","Magellan","Meritain","Optum","TRICARE","UMR","UnitedHealthcare","VA Community Care","Other / Not sure"];
const pad = compact ? "py-2.5" : "py-3";
---
{variant === "card" ? (
<div class="lead-card w-full rounded-2xl bg-white p-5 text-ink shadow-[0_2px_6px_rgba(0,0,0,0.18),0_20px_44px_rgba(0,0,0,0.18)]">
  <div class="mb-4 flex items-center gap-3">
    <img src="/Assets/badges/hipaa-compliant.svg" alt="HIPAA Compliant" width="115" height="64" class="block h-10 w-auto flex-none" />
    <span class="text-lg font-bold tracking-[-0.015em]">Talk to an Admissions Specialist</span>
  </div>
  <form class="ctm-lead-form grid grid-cols-1 gap-3 sm:grid-cols-2" novalidate>
    <div>
      <label class={lbl} for={`${formId}-name`}>What’s your name? <span aria-hidden="true" class="text-red-700">*</span></label>
      <input id={`${formId}-name`} class={field} type="text" name="caller_name" autocomplete="name" required maxlength="80" />
    </div>
    <div>
      <label class={lbl} for={`${formId}-phone`}>What’s your number? <span aria-hidden="true" class="text-red-700">*</span></label>
      <div class="flex gap-2">
        <span aria-hidden="true" class="flex h-[45px] flex-none items-center gap-[5px] rounded-lg border border-muted/50 bg-crema px-2.5 text-sm text-ink">
          <svg viewBox="0 0 19 10" width="19" height="10" class="block rounded-[2px]" aria-hidden="true"><rect width="19" height="10" fill="#B22234" /><path d="M0 1.15h19M0 2.7h19M0 4.23h19M0 5.77h19M0 7.3h19M0 8.85h19" stroke="#fff" stroke-width=".77" /><rect width="7.6" height="5.38" fill="#3C3B6E" /></svg>
          US +1
        </span>
        <input id={`${formId}-phone`} class={field} type="tel" name="phone_number" autocomplete="tel-national" inputmode="tel" required />
      </div>
    </div>
    <div>
      <label class:list={[lbl, "whitespace-nowrap"]} for={`${formId}-policy`}>Membership Policy ID (optional)</label>
      <input id={`${formId}-policy`} class={field} type="text" name="membership_policy_id" maxlength="40" autocomplete="off" />
    </div>
    <div>
      <label class={lbl} for={`${formId}-carrier`}>Insurance Carrier (optional)</label>
      <div class="relative">
        <select id={`${formId}-carrier`} class:list={[field, "appearance-none pr-10"]} name="insurance_carrier">
          <option value="" selected></option>
          {carriers.map((c) => <option value={c}>{c}</option>)}
        </select>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-muted"><path d="m6 9 6 6 6-6" /></svg>
      </div>
    </div>
    <div class="sm:col-span-2">
      <label class={lbl} for={`${formId}-email`}>Email (optional)</label>
      <input id={`${formId}-email`} class={field} type="email" name="email" autocomplete="email" maxlength="120" />
    </div>
    <input type="text" name="company_website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <label class="flex items-start gap-2.5 text-[13px] leading-snug text-muted sm:col-span-2"><input type="checkbox" name="consent" class="mt-0.5 h-4 w-4 flex-none accent-azul" required /><span>I agree to be contacted by Hopewell Health Solutions (msg/data rates may apply). Not for emergencies — call 988 if in crisis.</span></label>
    <button type="submit" class="mt-1.5 inline-flex h-[45px] items-center justify-center rounded-lg bg-azul-bright px-[30px] text-[15px] font-bold text-white transition hover:bg-azul disabled:cursor-wait disabled:opacity-60 sm:col-span-2">Check Your Coverage</button>
    <p class="ctm-form-msg hidden text-sm rounded-lg px-3 py-2 sm:col-span-2" role="status" aria-live="polite"></p>
  </form>
  <p class="mt-3.5 text-center text-[11px] leading-relaxed text-muted">Or call us at <a href="tel:8607351448" class="font-bold text-azul">(860) 735-1448</a>. Everything you share is confidential.</p>
  <p class="mt-2 text-center text-[10px] leading-normal text-muted">By submitting, you agree to our <a href="/privacy/" class="underline">Privacy Policy</a>.</p>
</div>
) : (
<div class="rounded-2xl bg-white shadow-xl border border-line p-6">
  <h2 class="font-display text-2xl text-ink">{heading}</h2>
  <p class="text-sm text-muted mt-1">{sub}</p>
  <form class="ctm-lead-form mt-4 space-y-3" novalidate>
    <input class={`w-full rounded-lg border border-line px-4 ${pad} text-sm`} type="text" name="caller_name" placeholder="Full name" autocomplete="name" required />
    <input class={`w-full rounded-lg border border-line px-4 ${pad} text-sm`} type="tel" name="phone_number" placeholder="Phone" autocomplete="tel" required />
    <input class={`w-full rounded-lg border border-line px-4 ${pad} text-sm`} type="email" name="email" placeholder="Email (optional)" autocomplete="email" />
    <select class={`w-full rounded-lg border border-line px-4 ${pad} text-sm text-muted`} name="insurance_carrier" required>
      <option value="">Insurance carrier</option>
      {carriers.map((c) => <option value={c}>{c}</option>)}
    </select>
    <input class={`w-full rounded-lg border border-line px-4 ${pad} text-sm`} type="text" name="membership_policy_id" placeholder="Member / Policy ID" />
    <!-- honeypot: bots fill this; humans never see it -->
    <input type="text" name="company_website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <label class="flex items-start gap-2 text-xs text-muted"><input type="checkbox" name="consent" class="mt-0.5" required /> I agree to be contacted by Hopewell Health Solutions (msg/data rates may apply). Not for emergencies — call 988 if in crisis.</label>
    <button type="submit" class="w-full rounded-lg bg-azul py-3 font-semibold text-white hover:bg-azul-dark transition disabled:opacity-60">Verify My Insurance →</button>
    <p class="ctm-form-msg hidden text-sm rounded-lg px-3 py-2" role="status" aria-live="polite"></p>
  </form>
</div>
)}

<script>
  const ENDPOINT = "/api/lead/"; // trailing slash: vercel.json trailingSlash would 308 otherwise
  const FORM_ID = "hopewell-website-lead";
  const ATTR_KEYS = ["gclid","gbraid","wbraid","utm_source","utm_medium","utm_campaign","utm_term","utm_content","campaignid","adgroupid","creative","keyword"];

  // Capture ad attribution from the landing URL and persist it across the visit.
  (function captureAttribution() {
    try {
      const p = new URLSearchParams(window.location.search);
      const stored = JSON.parse(localStorage.getItem("hhs_attr") || "{}");
      let changed = false;
      ATTR_KEYS.forEach((k) => { const v = p.get(k); if (v) { stored[k] = v; changed = true; } });
      // First-touch session signals so CTM can classify the true source (direct/organic/referral),
      // not a default. Captured once and kept for the whole visit.
      if (!("landing_url" in stored)) { stored.landing_url = window.location.href; changed = true; }
      if (!("referrer" in stored)) {
        const ref = document.referrer || "";
        // Ignore our own pages so internal navigation never overwrites the real (external) referrer.
        stored.referrer = (ref && ref.indexOf(window.location.hostname) === -1) ? ref : "";
        changed = true;
      }
      if (changed) localStorage.setItem("hhs_attr", JSON.stringify(stored));
    } catch (e) {}
  })();
  function getAttr() { try { return JSON.parse(localStorage.getItem("hhs_attr") || "{}"); } catch (e) { return {}; } }

  // CTM's tracking script sets a first-party session cookie holding the real source.
  // Pass it so the submission ties to that tracked visit instead of getting a default.
  function getCtmSid() {
    try {
      const m = document.cookie.match(/(?:^|;\s*)(?:__ctmid|__ctm_sid|ctm_sid)=([^;]+)/i);
      if (m) return decodeURIComponent(m[1]);
      if (window.__ctm && window.__ctm.config && window.__ctm.config.sid) return String(window.__ctm.config.sid);
    } catch (e) {}
    return "";
  }

  function toE164(raw) {
    const d = (raw || "").replace(/\D/g, "");
    if (d.length === 10) return "+1" + d;
    if (d.length === 11 && d[0] === "1") return "+" + d;
    return d ? "+" + d : "";
  }

  function bind(form) {
    const msg = form.querySelector(".ctm-form-msg");
    const btn = form.querySelector('button[type="submit"]');
    const show = (text, ok) => {
      msg.textContent = text;
      msg.className = "ctm-form-msg text-sm rounded-lg px-3 py-2 " + (ok ? "bg-sage-light text-sage" : "bg-gold-light text-ink");
    };
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const get = (n) => (form.querySelector(`[name="${n}"]`) || {}).value || "";
      // honeypot + consent guards
      if (get("company_website")) return;
      if (!form.querySelector('[name="consent"]').checked) { show("Please agree to be contacted so we can reach you.", false); return; }
      const phone = toE164(get("phone_number"));
      if (phone.length < 12) { show("Please enter a valid phone number.", false); return; }
      const email = get("email").trim();
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { show("Please enter a valid email address, or leave it blank.", false); return; }

      const body = new URLSearchParams();
      body.set("phone_number", phone);
      if (get("caller_name")) body.set("caller_name", get("caller_name"));
      if (email) body.set("email", email);
      if (get("insurance_carrier")) body.set("custom_fields[insurance_carrier]", get("insurance_carrier"));
      if (get("membership_policy_id")) body.set("custom_fields[membership_policy_id]", get("membership_policy_id"));
      const a = getAttr();
      if (a.gclid) body.set("paid_attribution[gclid]", a.gclid);
      if (a.campaignid) body.set("paid_attribution[campaign_id]", a.campaignid);
      if (a.adgroupid) body.set("paid_attribution[adgroup_id]", a.adgroupid);
      if (a.creative) body.set("paid_attribution[creative_id]", a.creative);
      body.set("paid_attribution[form_id]", FORM_ID);

      // --- Real session/source so CTM attributes the true origin (not a forced default) ---
      ["utm_source","utm_medium","utm_campaign","utm_term","utm_content"].forEach((k) => { if (a[k]) body.set(k, a[k]); });
      if (a.keyword) body.set("keyword", a.keyword);
      body.set("referrer", typeof a.referrer === "string" ? a.referrer : (document.referrer || ""));
      if (a.landing_url) body.set("landing_url", a.landing_url);
      body.set("url", window.location.href);
      const sid = getCtmSid();
      if (sid) { body.set("sid", sid); body.set("visitor_sid", sid); }

      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = "Sending…";
      try {
        const res = await fetch(ENDPOINT, { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error("Bad status " + res.status);
        form.reset();
        show("Thank you — we’ve got your info and will reach out shortly.", true);
        // GA4/GTM conversion event
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "generate_lead", form_id: FORM_ID });
      } catch (err) {
        show("Something went wrong. Please call us and we’ll help right away.", false);
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  }

  document.querySelectorAll(".ctm-lead-form").forEach(bind);
</script>
