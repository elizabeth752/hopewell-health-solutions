---
// Long-form SEO article blocks (2026-11-16, "not just sections"): each block is an H2 with 2–4 real paragraphs
// (optional H3 sub-sections) beside a visual aside — a photo, an icon key-points card, numbered steps or a mini table.
// Blocks alternate side and background. Paragraphs are HTML strings so interlinks sit inline (class "inl").
import Icon from "../Icon.astro";
interface Aside { type: "img" | "points" | "steps" | "table"; src?: string; alt?: string; cap?: string; title?: string; items?: any[]; head?: string[]; rows?: string[][] }
interface Block { id?: string; h2: string; paras: string[]; h3s?: { h3: string; paras: string[] }[]; aside?: Aside; tone?: "white" | "stone" | "mist" }
interface Props { blocks: Block[]; startTone?: number }
const { blocks, startTone = 0 } = Astro.props;
const tones = ["white", "stone"];
---
{blocks.map((b, i) => (
  <section class={`section is-${b.tone ?? tones[(i + startTone) % 2]} sp-sec`} id={b.id}>
    <div class:list={["container sp-grid", !b.aside && "is-solo", i % 2 === 1 && "is-flip"]}>
      <div class="sp-copy">
        <h2 set:html={b.h2} />
        {b.paras.map((p) => <p set:html={p} />)}
        {b.h3s?.map((s) => (<div class="sp-sub"><h3 set:html={s.h3} />{s.paras.map((p) => <p set:html={p} />)}</div>))}
      </div>
      {b.aside && (
        <aside class={`sp-aside sp-${b.aside.type}`}>
          {b.aside.type === "img" && (<figure><img src={b.aside.src} alt={b.aside.alt ?? ""} width="1200" height="900" loading="lazy" />{b.aside.cap && <figcaption>{b.aside.cap}</figcaption>}</figure>)}
          {b.aside.type === "points" && (<div class="sp-card">{b.aside.title && <p class="sp-card-h">{b.aside.title}</p>}<ul>{b.aside.items.map(([icon, t]) => <li><span class="icon-badge"><Icon name={icon} /></span><span set:html={t} /></li>)}</ul></div>)}
          {b.aside.type === "steps" && (<div class="sp-card">{b.aside.title && <p class="sp-card-h">{b.aside.title}</p>}<ol>{b.aside.items.map(([t, d], k) => <li><span class="sp-n">{k + 1}</span><span><strong set:html={t} /><span set:html={d} /></span></li>)}</ol></div>)}
          {b.aside.type === "iopfit" && (
            <div class="sp-card iopfit" aria-label="Where IOP sits between weekly therapy and a hospital stay, and the IOP week">
              <p class="sp-card-h">The middle step of care</p>
              <ol class="if-ladder">
                <li><span>Weekly therapy</span><small>1 hour a week</small></li>
                <li class="is-on"><span>Intensive outpatient (IOP)</span><small>3 hours a day · Mon–Thu · home every night</small></li>
                <li><span>Partial hospitalization (PHP)</span><small>Full days · Mon–Fri</small></li>
                <li><span>Hospital stay</span><small>Overnight, inpatient</small></li>
              </ol>
              <p class="sp-card-h" style="margin-top:18px">An IOP week</p>
              <div class="if-week">{["Mon","Tue","Wed","Thu","Fri","Sat","Sun"].map((d, k) => <span class:list={["if-day", k < 4 && "is-on"]}><b>{d}</b><i>{k < 4 ? "3 h" : "Off"}</i></span>)}</div>
              <ul class="if-tracks">
                <li><b>Morning</b> 9 AM–12 PM</li>
                <li><b>Evening</b> 5–8 PM</li>
                <li><b>Teens &amp; tweens</b> after school</li>
              </ul>
            </div>
          )}
          {b.aside.type === "table" && (<div class="sp-card sp-tbl">{b.aside.title && <p class="sp-card-h">{b.aside.title}</p>}<table><thead><tr>{b.aside.head.map((h) => <th scope="col">{h}</th>)}</tr></thead><tbody>{b.aside.rows.map((r) => <tr>{r.map((c, k) => k === 0 ? <th scope="row" set:html={c} /> : <td set:html={c} />)}</tr>)}</tbody></table></div>)}
        </aside>
      )}
    </div>
  </section>
))}

<style>
  .iopfit .if-ladder { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column-reverse; gap: 6px; }
  .iopfit .if-ladder li { position: relative; display: flex; flex-direction: column; padding: 10px 14px 10px 18px; border-radius: 12px; background: var(--hw-stone, #f3f1ec); border-left: 4px solid var(--hw-line, #d5dfe9); }
  .iopfit .if-ladder li:nth-child(1) { margin-right: 36%; } .iopfit .if-ladder li:nth-child(2) { margin-right: 18%; } .iopfit .if-ladder li:nth-child(3) { margin-right: 9%; }
  .iopfit .if-ladder li span { font-weight: 800; color: var(--hw-navy, #0b2f55); font-size: 15px; }
  .iopfit .if-ladder li small { font-size: 12.5px; color: var(--hw-slate, #55657a); }
  .iopfit .if-ladder li.is-on { background: var(--hw-navy, #0b2f55); border-left-color: #e0b56a; box-shadow: 0 10px 24px rgba(0,29,55,.18); }
  .iopfit .if-ladder li.is-on span, .iopfit .if-ladder li.is-on small { color: #fff; }
  .iopfit .if-week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 5px; }
  .iopfit .if-day { display: grid; justify-items: center; gap: 2px; padding: 8px 0; border-radius: 10px; background: var(--hw-stone, #f3f1ec); }
  .iopfit .if-day b { font-size: 12px; color: var(--hw-navy, #0b2f55); } .iopfit .if-day i { font-style: normal; font-size: 12px; color: var(--hw-slate, #55657a); }
  .iopfit .if-day.is-on { background: var(--hw-blue, #265489); } .iopfit .if-day.is-on b, .iopfit .if-day.is-on i { color: #fff; }
  .iopfit .if-tracks { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 6px; font-size: 14px; color: var(--hw-body, #22303f); }
  .iopfit .if-tracks b { color: var(--hw-navy, #0b2f55); margin-right: 6px; }
</style>
