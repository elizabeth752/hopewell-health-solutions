---
import Icon from "./Icon.astro";
import { socials } from "../data/socials";

// Full ideal IA. Live pages resolve; unbuilt ones 404 until shipped (intentional
// — lets us navigate/visualize the whole sitemap as we build it out).
const menu = [
  { label: "Programs", href: "/programs/", children: [
    { label: "IOP Overview", href: "/programs/intensive-outpatient-program/" },
    { label: "Adult Co-Occurring IOP", href: "/programs/adult-mental-health-iop/" },
    { label: "Teen IOP (13–17)", href: "/programs/teen-tween-iop/#teen" },
    { label: "Tween IOP (8–12)", href: "/programs/teen-tween-iop/#tween" },
    { label: "Women's Wellness IOP", href: "/programs/womens-wellness-iop/" },
    { label: "Women's Trauma IOP", href: "/programs/womens-trauma-iop/" },
    { label: "First Responder IOP", href: "/programs/first-responder-iop/" },
    { label: "Addiction and Substance Use IOP", href: "/programs/substance-use-iop/" },
    { label: "Partial Hospitalization (PHP)", href: "/programs/partial-hospitalization-program/" },
    { label: "Medication Management", href: "/programs/medication-management/" },
    { label: "Counseling", href: "/programs/counseling/" },
  ]},
  { label: "What We Treat", href: "/what-we-treat/", children: [
    { label: "Depression", href: "/what-we-treat/depression/" },
    { label: "Anxiety", href: "/what-we-treat/anxiety/" },
    { label: "Trauma & PTSD", href: "/what-we-treat/trauma-ptsd/" },
    { label: "ADHD", href: "/what-we-treat/adhd/" },
    { label: "OCD", href: "/what-we-treat/ocd/" },
    { label: "Bipolar Disorder", href: "/what-we-treat/bipolar/" },
    { label: "Co-Occurring Disorders", href: "/what-we-treat/co-occurring/" },
    { label: "Addiction & Substance Use (S.U.D.)", href: "/what-we-treat/substance-use-disorder/" },
    { label: "Alcohol Addiction", href: "/what-we-treat/alcohol/" },
    { label: "Drug Addiction", href: "/what-we-treat/drug/" },
    { label: "Prescription Drug Addiction", href: "/what-we-treat/prescription-drugs/" },
  ]},
  { label: "Treatments", href: "/treatment-methods/", children: [
    { label: "TMS", href: "/treatment-methods/tms/" },
    { label: "Medication-Assisted Treatment", href: "/treatment-methods/medication-assisted-treatment/" },
    { label: "EMDR", href: "/treatment-methods/emdr/" },
    { label: "DBT", href: "/treatment-methods/dbt/" },
    { label: "Group Therapy", href: "/treatment-methods/group-therapy/" },
    { label: "HHS Therapeutic Treatments", href: "/treatment-methods/therapeutic-treatments/" },
    { label: "GeneSight® Testing", href: "/treatment-methods/genesight-testing/" },
    { label: "Neuropsychological Testing", href: "/treatment-methods/neuropsychological-testing/" },
    { label: "ADHD Testing", href: "/treatment-methods/adhd-testing/" },
  ]},
  { label: "Locations", href: "/locations/", children: [
    { label: "Glastonbury — Pratt St", href: "/location/glastonbury-ct/" },
    { label: "Downtown Glastonbury — Hebron Ave", href: "/location/glastonbury-ct-2/" },
    { label: "South Glastonbury — Main St", href: "/location/glastonbury-ct-3/" },
    { label: "West Hartford", href: "/location/west-hartford-ct/" },
    { label: "East Hampton", href: "/location/east-hampton-ct/" },
    { label: "Westbrook", href: "/location/westbrook-ct/" },
  ]},
  { label: "Resources", href: "/blog/", align: "right", children: [
    { label: "Blog", href: "/blog/" },
    { label: "Testimonials", href: "/testimonials/" },
    { label: "Handouts", href: "/handouts/" },
    { label: "Media", href: "/media/" },
  ]},
  { label: "About", href: "/about-us/", align: "right", children: [
    { label: "About Us", href: "/about-us/" },
    { label: "Our Team", href: "/about-us/team/" },
    { label: "Careers", href: "/about-us/careers/" },
  ]},
  { label: "Admissions", href: "/admissions/", align: "right", children: [
    { label: "Verify Insurance", href: "/admissions/#verify" },
    { label: "Rates & Insurance", href: "/rates-and-insurance-coverage/" },
    { label: "What to Expect", href: "/admissions/#what-to-expect" },
    { label: "For Families", href: "/admissions/#for-families" },
  ]},
];

const path = Astro.url.pathname;
const isActive = (m) => path.startsWith(m.href) && m.href !== "/" || m.children.some((c) => path === c.href.split("#")[0]);
---
<header class="hdr sticky top-0 z-40">
  <!-- utility bar -->
  <div class="bg-night text-white/80 text-[13px]">
    <slot name="topbar">
    <div class="wrap flex h-9 items-center justify-between gap-4">
      <p class="hidden md:flex items-center gap-2"><Icon name="pin" class="h-3.5 w-3.5 text-azul-light" />Six offices across Glastonbury, West Hartford, East Hampton &amp; Westbrook, CT</p>
      <div class="flex items-center gap-1.5 ml-auto">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label} class:list={["grid h-6 w-6 place-items-center rounded-full text-white/75 hover:bg-white hover:text-ink transition", s.small ? "[&>svg]:h-[11px] [&>svg]:w-[11px]" : "[&>svg]:h-3 [&>svg]:w-3"]}><Fragment set:html={s.svg} /></a>
        ))}
      </div>
    </div>
    </slot>
  </div>

  <!-- main bar -->
  <div class="bg-white/95 backdrop-blur border-b border-line">
    <div class="wrap flex h-[76px] items-center justify-between gap-4">
      <a href="/" class="shrink-0" aria-label="Hopewell Health Solutions — home">
        <img src="/Assets/logo/hopewell-wave-logo-color.svg" alt="Hopewell Health Solutions" width="990" height="444" decoding="async" fetchpriority="high" class="h-11 sm:h-[52px] w-auto" />
      </a>

      <nav class="hidden lg:flex items-center gap-x-1" aria-label="Main">
        {menu.map((m) => (
          <div class="relative group">
            <a href={m.href} class:list={["flex items-center gap-1 rounded-full px-3 py-2 text-[15px] font-semibold transition", isActive(m) ? "text-azul bg-azul-light" : "text-ink hover:text-azul hover:bg-azul-light/60"]}>
              {m.label}<svg viewBox="0 0 24 24" class="h-3.5 w-3.5 opacity-60 transition group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </a>
            <div class={`invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition duration-150 absolute ${m.align === "right" ? "right-0" : "left-0"} top-full pt-3 z-50`}>
              <div class:list={["rounded-3xl border border-line bg-white p-3 shadow-[0_24px_60px_-20px_rgba(0,29,55,.35)]", m.children.length > 6 ? "w-[34rem]" : "w-72"]}>
                <a href={m.href} class="mb-1 flex items-center justify-between rounded-2xl bg-crema px-4 py-3 font-display text-lg text-ink hover:text-azul transition">{m.label}<Icon name="arrow" class="h-4 w-4 text-azul" /></a>
                <ul class:list={["grid gap-0.5", m.children.length > 6 && "grid-cols-2"]}>
                  {m.children.map((c) => (
                    <li><a href={c.href} class="flex items-center gap-2 rounded-xl px-4 py-2.5 text-[14px] font-medium text-ink hover:bg-azul-light hover:text-azul transition"><span class="h-1.5 w-1.5 shrink-0 rounded-full bg-azul/40"></span>{c.label}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </nav>

      <div class="flex items-center gap-2 shrink-0">
        <a href="tel:8607351448" class="btn btn-primary hidden xl:inline-flex"><Icon name="phone" class="h-4 w-4" />(860) 735-1448</a>
        <a href="tel:8607351448" class="xl:hidden grid h-12 w-12 place-items-center rounded-full bg-azul-bright text-white" aria-label="Call us"><Icon name="phone" class="h-5 w-5" /></a>
        <button id="mobileToggle" class="lg:hidden grid h-12 w-12 place-items-center rounded-full border border-line text-ink" aria-label="Open menu" aria-expanded="false" aria-controls="mobilePanel">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- mobile panel: accordions, every link kept -->
  <div id="mobilePanel" class="hidden lg:hidden border-b border-line bg-white max-h-[78vh] overflow-y-auto">
    <div class="wrap py-4">
      {menu.map((m) => (
        <details class="group border-b border-line">
          <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 font-display text-lg text-ink">{m.label}<svg viewBox="0 0 24 24" class="h-4 w-4 text-azul transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
          <ul class="grid grid-cols-1 gap-0.5 pb-3 sm:grid-cols-2">
            <li><a href={m.href} class="block rounded-xl bg-crema px-3 py-2 text-[15px] font-semibold text-azul">All {m.label}</a></li>
            {m.children.map((c) => <li><a href={c.href} class="block rounded-xl px-3 py-2 text-[15px] font-medium text-ink">{c.label}</a></li>)}
          </ul>
        </details>
      ))}
      <a href="tel:8607351448" class="btn btn-primary mt-5 w-full"><Icon name="phone" class="h-4 w-4" />Call (860) 735-1448</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobileToggle");
  const panel = document.getElementById("mobilePanel");
  btn?.addEventListener("click", () => {
    const open = panel?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(open));
  });
</script>
