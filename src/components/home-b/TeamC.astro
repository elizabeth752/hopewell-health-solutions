---
// Team — option C: deep-blue band with a swipeable strip of tall portrait cards (names overlaid), arrow controls on desktop.
const team = [
  ["Tracy Sibley, PMHNP-BC","Psychiatric NP","/Assets/Team%20Members/tracy-sibley-pmhnp-bc-aprn.webp","/provider/tracy-sibley-pmhnp-bc-aprn/"],
  ["Christina Lindsay, PMHNP-BC","Psychiatric NP","/Assets/Team%20Members/christina-lindsay-pmhnp-bc-aprn.webp","/provider/christina-lindsay-pmhnp-bc-aprn/"],
  ["Christopher Patenaude, PA","Physician Assistant","/Assets/Team%20Members/chris-patenaude-pa.webp","/provider/chris-patenaude-pa/"],
  ["Kristine A. Schlichting, PhD","Founder & Director","/Assets/Team%20Members/kristine-a-schlichting-phd.webp","/provider/kristine-a-schlichting-ph-d/"],
  ["Eric Schwartz, PsyD, ABPP","Psychologist","/Assets/Team%20Members/eric-schwarz-psyd-abpp.webp","/provider/eric-schwartz-psy-d-abpp/"],
  ["Laura Miller, PhD","Neuropsychologist","/Assets/Team%20Members/laura-miller-phd.webp","/provider/laura-miller-ph-d/"],
  ["Ashley Singh, PsyD","Psychologist","/Assets/Team%20Members/ashley-singh-psyd.webp","/provider/ashley-singh-psy-d/"],
];
---

<section class="hb-team-c relative isolate overflow-hidden text-white" data-hb-team-c>
  <div class="mx-auto max-w-6xl px-5 py-16 lg:py-20">
    <h2 class="font-display text-3xl sm:text-4xl text-white text-balance">Meet the People Who’ll Walk Beside You</h2>
    <p class="mt-3 text-white/80 max-w-2xl text-pretty">A diverse, board-certified team of 50+ licensed clinicians across Connecticut — prescribers, psychologists, and therapists. Real credentials. Real names. Real relationships.</p>

    <ul class="hb-team-c-track mt-10" data-track aria-label="Featured clinicians">
      {team.map(([name, role, img, href]) => (
        <li class="hb-team-c-slide">
          <a href={href} class="hb-team-c-card hb-touch">
            <img src={img} alt={name} width="768" height="1024" loading="lazy" decoding="async" />
            <span class="hb-team-c-body">
              <span class="block font-display text-xl text-white leading-tight text-balance">{name}</span>
              <span class="mt-1 block text-sm text-gold-light whitespace-nowrap">{role}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <a href="/about-us/team/" class="inline-flex items-center justify-center rounded-lg bg-white px-7 h-[45px] font-semibold text-azul hover:bg-crema transition focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-gold-light">Meet our full team →</a>
      <div class="hidden md:flex gap-3">
        <button type="button" class="hb-team-c-nav" data-dir="-1" aria-label="Previous clinicians">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
        </button>
        <button type="button" class="hb-team-c-nav" data-dir="1" aria-label="Next clinicians">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .hb-team-c { background:
    radial-gradient(45% 60% at 100% 0%, rgba(182,134,60,.18), transparent 70%),
    linear-gradient(150deg, var(--color-azul), var(--color-azul-dark) 55%, var(--color-ink)); }

  .hb-team-c-track {
    list-style: none; margin-left: 0; margin-right: 0; padding: 0 0 6px;
    display: grid; grid-auto-flow: column; grid-auto-columns: 72%; gap: 16px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .hb-team-c-track::-webkit-scrollbar { display: none; }
  @media (min-width: 640px) { .hb-team-c-track { grid-auto-columns: calc((100% - 32px) / 3); } }
  @media (min-width: 1024px) { .hb-team-c-track { grid-auto-columns: calc((100% - 60px) / 4); gap: 20px; } }
  .hb-team-c-slide { scroll-snap-align: start; }

  .hb-team-c-card { position: relative; display: block; overflow: hidden; border-radius: 22px; aspect-ratio: 3/4; background: rgba(255,255,255,.08); }
  .hb-team-c-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .6s; }
  .hb-team-c-card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,29,55,.92) 6%, rgba(0,29,55,.35) 38%, transparent 60%); }
  .hb-team-c-body { position: absolute; z-index: 1; left: 18px; right: 18px; bottom: 18px; }
  /* gold rule grows under the name */
  .hb-team-c-body::before { content: ""; display: block; width: 28px; height: 2px; margin-bottom: 12px; background: var(--color-gold-light); transition: width .4s ease; }
  :is(.hb-team-c-card:hover, .hb-team-c-card.is-active) img { transform: scale(1.05); }
  :is(.hb-team-c-card:hover, .hb-team-c-card.is-active) .hb-team-c-body::before { width: 72px; }
  .hb-team-c-card:focus-visible { outline: 3px solid var(--color-gold-light); outline-offset: 3px; }

  .hb-team-c-nav {
    display: grid; place-items: center; width: 45px; height: 45px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.5); color: #fff; transition: background .3s, color .3s, opacity .3s;
  }
  .hb-team-c-nav:hover { background: #fff; color: var(--color-azul); }
  .hb-team-c-nav:focus-visible { outline: 3px solid var(--color-gold-light); outline-offset: 2px; }
  .hb-team-c-nav:disabled { opacity: .35; cursor: default; background: transparent; color: #fff; }
  @media (prefers-reduced-motion: reduce) { .hb-team-c-track { scroll-behavior: auto; } .hb-team-c-card img, .hb-team-c-body::before { transition: none; } }
</style>

<script>
  // Arrow controls for the clinician strip; scoped to each component root.
  document.querySelectorAll<HTMLElement>("[data-hb-team-c]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-track]");
    const btns = root.querySelectorAll<HTMLButtonElement>(".hb-team-c-nav");
    if (!track) return;
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      btns.forEach((b) => (b.disabled = b.dataset.dir === "-1" ? track.scrollLeft <= 2 : track.scrollLeft >= max));
    };
    btns.forEach((b) => b.addEventListener("click", () => {
      const slide = track.querySelector<HTMLElement>(".hb-team-c-slide");
      const step = slide ? slide.offsetWidth + parseFloat(getComputedStyle(track).columnGap || "16") : track.clientWidth;
      track.scrollBy({ left: step * Number(b.dataset.dir) });
    }));
    track.addEventListener("scroll", sync, { passive: true });
    // ResizeObserver also fires when a hidden variant becomes visible.
    new ResizeObserver(sync).observe(track);
    sync();
  });
</script>
