---
// About — option B: light cream editorial. Team photo with a gold offset frame + text, stats as a ruled band below.
const stats = [
  ["14", "Years serving Central Connecticut"],
  ["50+", "Clinicians on our team"],
  ["6", "Connecticut locations"],
  ["50,000+", "Lives helped"],
];
---
<section class="bg-crema scroll-mt-20">
  <div class="mx-auto max-w-6xl px-5 py-16 lg:py-20">
    <h2 class="font-display text-3xl sm:text-4xl text-ink leading-tight text-balance max-w-3xl">Our Mission Is to Help You Live Your Best Life</h2>
    <div class="hb-about-b-grid mt-10">
      <div class="hb-about-b-photo">
        <img src="/Assets/Team%20united.webp" alt="Members of the Hopewell Health Solutions team outside one of our Connecticut offices" width="1600" height="1200" loading="lazy" decoding="async" class="hb-about-b-img w-full aspect-[4/3] object-cover rounded-3xl" />
      </div>
      <div>
        <p class="text-ink leading-relaxed text-pretty">Hopewell Health Solutions is a superior mental-health practice rooted in Glastonbury and West Hartford, Connecticut. Our board-certified specialists take an innovative, multidisciplinary approach to care for clients aged 4 and older — in a compassionate, safe environment, whether in person or by telehealth.</p>
        <p class="mt-4 text-ink leading-relaxed text-pretty">We offer DBT, CBT, play therapy, EMDR and ART, the Gottman Method for couples, trauma treatments, and mind-body approaches like mindfulness and yoga therapy. When medication is part of the plan, our prescribers build personalized psychiatric plans — never one-size-fits-all.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/about-us/" class="inline-flex items-center justify-center rounded-lg bg-azul px-6 h-[45px] font-semibold text-white hover:bg-azul-dark transition hb-about-b-btn">More about us</a>
          <a href="/about-us/team/" class="inline-flex items-center justify-center rounded-lg border border-azul px-6 h-[45px] font-semibold text-azul hover:bg-azul-light transition hb-about-b-btn">Meet the team</a>
        </div>
      </div>
    </div>
    <dl class="hb-about-b-stats mt-14">
      {stats.map(([n, l]) => (
        <div class="hb-about-b-stat hb-touch">
          <dt class="sr-only">{l}</dt>
          <dd class="font-display text-5xl text-azul leading-none whitespace-nowrap">{n}</dd>
          <dd class="mt-3 text-[12px] font-semibold uppercase tracking-wide text-muted whitespace-nowrap" aria-hidden="true">{l}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hb-about-b-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1024px) { .hb-about-b-grid { grid-template-columns: 6fr 5fr; gap: 56px; } }
  .hb-about-b-img { position: relative; z-index: 1; }
  .hb-about-b-btn:focus-visible { outline: 2px solid var(--color-azul); outline-offset: 2px; }
  .hb-about-b-photo { position: relative; padding: 0 14px 14px 0; }
  .hb-about-b-photo::before { content: ""; position: absolute; inset: 14px 0 0 14px; border: 2px solid var(--color-gold); border-radius: 24px; opacity: .55; }
  .hb-about-b-stats { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  .hb-about-b-stat { position: relative; padding: 24px 4px; border-top: 1px solid var(--color-line); }
  .hb-about-b-stat:first-child { border-top: 0; }
  .hb-about-b-stat::before { content: ""; position: absolute; left: 0; top: -1px; width: 48px; height: 3px; background: var(--color-gold); transform: scaleX(0); transform-origin: left; transition: transform .35s; }
  :is(.hb-about-b-stat:hover, .hb-about-b-stat.is-active)::before { transform: scaleX(1); }
  @media (min-width: 640px) {
    .hb-about-b-stats { grid-template-columns: 1fr 1fr; }
    .hb-about-b-stat { padding: 28px 24px; border-top: 1px solid var(--color-line); }
    .hb-about-b-stat:nth-child(-n+2) { border-top: 0; }
    .hb-about-b-stat:nth-child(even) { border-left: 1px solid var(--color-line); }
    .hb-about-b-stat::before { left: 24px; }
  }
  @media (min-width: 1280px) {
    .hb-about-b-stats { grid-template-columns: repeat(4, 1fr); }
    .hb-about-b-stat { border-top: 0; border-left: 1px solid var(--color-line); }
    .hb-about-b-stat:first-child { border-left: 0; padding-left: 4px; }
    .hb-about-b-stat:first-child::before { left: 4px; }
  }
  @media (prefers-reduced-motion: reduce) { .hb-about-b-stat::before { transition: none; } }
</style>
