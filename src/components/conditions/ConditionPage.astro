---
// What We Treat page renderer (2026 redesign, Corner Canyon layout system). Each condition page passes its own copy,
// verbatim from the previous page, as data: hero, content blocks (in page order), FAQs, insurance/locations/CTA text.
// Shared tail: levels of care (or the addiction band), programs, team, client stories, press, reviews, insurance
// (phones get the one form above it), map + offices, FAQ, conditions & treatments links, closing CTA.
import Base from "../../layouts/Base.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import Icon from "../Icon.astro";
import MediaStrip from "../MediaStrip.astro";
import ServiceHero from "../hw/ServiceHero.astro";
import Creds from "../hw/Creds.astro";
import ProgramCards from "../hw/ProgramCards.astro";
import Team from "../hw/Team.astro";
import VideoCarousel from "../hw/VideoCarousel.astro";
import Reviews from "../hw/Reviews.astro";
import Insurance from "../hw/Insurance.astro";
import Locations from "../hw/Locations.astro";
import Faq from "../hw/Faq.astro";
import ClosingCta from "../hw/ClosingCta.astro";
import AddictionLevels from "./AddictionLevels.astro";
import { PROGRAMS, LEVELS, SERVICES, ADDICTION_HIGHLIGHTS, WHO_WE_HELP } from "./catalog.js";
import { locations as OFFICES } from "../../data/locations.js";
import { STORIES } from "../../data/videos.js";
import { GOOGLE } from "../../data/site.js";
import "../../styles/pages/conditions.css";

const { quoteImg, meta, schemas = [], hero, blocks, faqs, faqHeading, insurance, locLede, cta, short, programs = [], team = [], stories = [], addiction = false, photos = [] } = Astro.props;
const progItems = programs.map((k) => PROGRAMS[k]).filter(Boolean);
const vids = [...stories.map((y) => STORIES.find((v) => v.yt === y)).filter(Boolean), ...STORIES.filter((v) => !stories.includes(v.yt))];
const bands = ["#2f76c4", "#b6863c", "#5c7c6b", "#0b2f55"];
let photoIdx = 0;
const nextPhoto = () => photos[photoIdx++ % Math.max(photos.length, 1)];
const kickFacts = hero.facts ?? [];
const highlights = addiction ? ADDICTION_HIGHLIGHTS : WHO_WE_HELP;
// Addiction is only offered at Downtown Glastonbury (300 Hebron Ave) and Westbrook — the only two offices listed on addiction pages.
const addOffices = OFFICES.filter((o) => o.addiction);
const officePhoto = { "glastonbury-ct-2": "/Assets/hhs-2026/downtown-glastonbury-sign.webp", "westbrook-ct": "/Assets/hhs-2026/westbrook-sign.webp" };
const mapsHref = (l) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Hopewell Health Solutions, ${l.street}, ${l.city}, CT ${l.zip}`)}`;
---
<Base title={meta.title} description={meta.description} canonical={meta.canonical} image={hero.image}>
  <Header />
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <main class="hw">
    <ServiceHero crumbs={[{ label: "What We Treat", href: "/what-we-treat/" }, { label: hero.crumb }]} title={hero.h1} lede={hero.tagline} bullets={hero.bullets} facts={kickFacts} image={hero.image} imagePos={hero.imagePos ?? "center"}>
      <p class="cd-hero-meta">
        <a href="#reviews" class="cd-hero-rating"><span class="g"><img src="/Assets/home-b/google-g.svg" alt="" width="16" height="16" /></span><span class="stars" aria-hidden="true">★★★★★</span>{GOOGLE.rating} · {GOOGLE.count} Google reviews</a>
        {hero.reviewer && <span class="cd-hero-rev">{hero.reviewer}</span>}
      </p>
    </ServiceHero>
    <Creds />

    <section class="section is-white cd-hl-sec" id="highlights">
      <div class="container">
        <div class="sec-head">
          <h2>{addiction ? `${short} Treatment for Adults in Connecticut` : `Who We Help With ${short}`}</h2>
          <p class="lede" set:html={addiction ? `Addiction and substance use treatment at our Downtown Glastonbury (300 Hebron Ave) and Westbrook (70 Essex Road) offices, with the <a class="inl" href="/programs/substance-use-iop/">Addiction and Substance Use IOP</a>, an addiction PHP, and step-down care after rehab.` : "Care at Hopewell is built around who you are, at every age and stage of life, with programs for adults, women, teens and first responders."} />
        </div>
        <ul class="cd-hl">
          {highlights.map((h, i) => <li class={`tone-${i}`}><span class="cd-hl-icon"><Icon name={h.icon} class="h-6 w-6" /></span><strong>{h.t}</strong><span set:html={h.d} /></li>)}
        </ul>
      </div>
    </section>

    {blocks.map((b, bi) => {
      if (b.type === "whatis") return (
        <section class="section is-white cd-what">
          <div class="container split">
            <figure class="cd-what-media">
              <img src={b.img} alt={b.alt} width="1200" height="900" loading="lazy" />
              {b.list && (
                <figcaption class="cd-what-list">
                  <strong>{b.listLabel}</strong>
                  <ul>{b.list.map((s) => <li><Icon name="check" class="h-4 w-4" />{s}</li>)}</ul>
                </figcaption>
              )}
            </figure>
            <div>
              <h2>{b.h2}</h2>
              {b.paras.map((p, i) => <p class="lede" style={i === 0 ? "margin-top:18px" : "margin-top:14px"} set:html={p} />)}
            </div>
          </div>
        </section>
      );
      if (b.type === "addiction") return <AddictionLevels condition={b.condition} />;
      if (b.type === "quote") return (
        <section class="cd-quote">
          <img src={quoteImg ?? b.img} alt="" aria-hidden="true" width="1600" height="900" loading="lazy" />
          <div class="container"><blockquote><span aria-hidden="true">“</span><p set:html={b.q.replace(/^“|”$/g, "")} /></blockquote></div>
        </section>
      );
      if (b.type === "tiles" && b.variant === "panel") return (
        <section class="section is-stone cd-panel-sec">
          <div class="container">
            <div class="sec-head"><h2>{b.h2}</h2>{b.lede && <p class="lede" set:html={b.lede} />}</div>
            <div class="cd-panel">
              <div class="cd-panel-list">
                <ul>{b.items.map((s) => <li><span class="cd-panel-tick"><Icon name="check" class="h-4 w-4" /></span><span set:html={s.t} /></li>)}</ul>
                {b.foot && <p class="cd-panel-foot" set:html={b.foot} />}
                <div class="cd-panel-ctas"><a href="#verify" class="btn btn-blue only-d">Request an appointment</a><a href="#verify-m" class="btn btn-blue only-m">Request an appointment</a><a href="tel:8607351448" class="btn btn-ghost"><Icon name="phone" />(860) 735-1448</a></div>
              </div>
              <img class="cd-panel-img" src={nextPhoto()} alt="" width="1200" height="900" loading="lazy" />
            </div>
          </div>
        </section>
      );
      if (b.type === "tiles") return (
        <section class={`section ${bi % 2 ? "is-stone" : "is-mist"} cd-tiles-sec`}>
          <div class="container">
            <div class="sec-head"><h2>{b.h2}</h2>{b.lede && <p class="lede" set:html={b.lede} />}</div>
            <ul class:list={["cd-tiles", b.items.length % 4 === 0 || b.items.length > 6 ? "cols-4" : "cols-3"]}>
              {b.items.map((s, i) => <li class={`tone-${i % 4}`}><span class="cd-tile-icon"><Icon name={s.icon ?? "check"} class="h-6 w-6" /></span><span set:html={s.t} /></li>)}
            </ul>
            {b.foot && <p class="sec-foot cd-foot" set:html={b.foot} />}
          </div>
        </section>
      );
      if (b.type === "cards") return (
        <section class={`section ${b.navy ? "is-navy" : "is-white"} cd-cards-sec`}>
          <div class="container">
            <div class="sec-head"><h2>{b.h2}</h2>{b.lede && <p class="lede" set:html={b.lede} />}</div>
            <div class:list={["cd-cards", b.items.length % 4 === 0 ? "cols-4" : "cols-3"]}>
              {b.items.map((c, i) => (
                <article class="cd-card" style={`--bar-c:${bands[i % 4]}`}>
                  <span class="cd-card-icon"><Icon name={c.icon} class="h-6 w-6" /></span>
                  <h3>{c.href ? <a href={c.href}>{c.t}</a> : c.t}</h3>
                  <p set:html={c.d} />
                </article>
              ))}
            </div>
            {b.foot && <p class="sec-foot cd-foot" set:html={b.foot} />}
          </div>
        </section>
      );
      if (b.type === "checks") return (
        <section class="section is-white cd-checks-sec">
          <div class="container cd-checks">
            <img src={nextPhoto()} alt="" width="1200" height="900" loading="lazy" />
            <div>
              <h2>{b.h2}</h2>
              {b.lede && <p class="lede" style="margin-top:14px" set:html={b.lede} />}
              <ul>{b.items.map((r) => <li><span class="cd-panel-tick"><Icon name="check" class="h-4 w-4" /></span>{r}</li>)}</ul>
              {b.foot && <p class="cd-foot" set:html={b.foot} />}
            </div>
          </div>
        </section>
      );
      return null;
    })}

    {!addiction && (
      <section class="section is-mist" id="levels">
        <div class="container">
          <div class="sec-head">
            <h2>{short} care at the level you need</h2>
            <p class="lede">A full continuum under one roof — from weekly counseling to intensive day programs. You can step up when you need more support, or step down as you heal, without ever switching teams.</p>
          </div>
          <div class="levels-grid">
            {LEVELS.map((l, i) => (
              <article class={`level-card lv-${l.tone}`}>
                <div class="level-head">
                  <div class="level-title"><span class="level-icon"><Icon name={l.icon} class="h-[22px] w-[22px]" /></span><h3>{l.t}</h3></div>
                  <p class="level-stat"><strong>{l.stat}</strong><span>{l.note}</span></p>
                  <div class="week" aria-hidden="true">{["M","T","W","T","F","S","S"].map((d, j) => <span class="week-day"><span class="week-track"><span class="week-fill" style={`--h:${(l.days[j] / 6) * 100}%`}></span></span><span class="week-label">{d}</span></span>)}</div>
                </div>
                <div class="level-body"><p set:html={l.html} /></div>
                {i < LEVELS.length - 1 && <span class="level-next" aria-hidden="true"><Icon name="arrow" class="h-5 w-5" /></span>}
              </article>
            ))}
          </div>
          <p class="levels-key"><span class="key-swatch"></span>Hours of care each day in a typical week (outpatient shown as one weekly session)</p>
        </div>
      </section>
    )}

    {progItems.length > 0 && (
      <section class="section is-white" id="programs">
        <div class="container">
          <div class="sec-head"><h2>Programs for {short.toLowerCase()} at Hopewell</h2><p class="lede">Each program below treats {short.toLowerCase()} as part of a personal plan, with the same team as you move between levels of care. See <a class="inl" href="/programs/">all programs</a>.</p></div>
          <ProgramCards items={progItems} cols={progItems.length === 3 ? 3 : 4} />
        </div>
      </section>
    )}

    {team.length > 0 && <Team slugs={team} heading={`Clinicians Who Treat ${short}`} lede={`Board-certified prescribers, psychologists and therapists across Connecticut. Real credentials, real names. <a class="inl" href="/about-us/team/">Meet our full team</a>.`} />}

    <VideoCarousel videos={vids} heading="Stories of Hope, in Their Own Words" lede="Hopewell clients and their families share what treatment was like. Watch the <a class='inl' href='/podcast/'>Hope, Health &amp; Healing podcast</a> for the full conversations." />
    <MediaStrip bg="white" heading="Our clinicians, featured across Connecticut" />
    <Reviews />
    <Insurance heading={insurance.heading} lede={insurance.lede} />
    {addiction ? (
      <section class="section is-mist" id="locations">
        <div class="container">
          <div class="sec-head"><h2>Where we treat addiction in Connecticut</h2><p class="lede" set:html={locLede} /></div>
          <div class="cd-offices">
            {addOffices.map((o) => (
              <article class="cd-office">
                <img src={officePhoto[o.slug]} alt={`Hopewell Health Solutions ${o.name} office`} width="1200" height="900" loading="lazy" />
                <div class="cd-office-body">
                  <span class="cd-office-tag">Mental health &amp; addiction care</span>
                  <h3><a href={`/location/${o.slug}/`}>{o.name}</a></h3>
                  <p class="cd-office-row"><Icon name="pin" class="h-5 w-5" />{o.street}, {o.city}, CT {o.zip}</p>
                  {o.hours && <p class="cd-office-row"><Icon name="clock" class="h-5 w-5" />{o.hours}</p>}
                  <p class="cd-office-links"><a class="inl" href={`/location/${o.slug}/`}>Office details</a><a class="inl" href={mapsHref(o)} target="_blank" rel="noopener">Get directions</a></p>
                </div>
                <iframe src={o.map} title={`Map of Hopewell Health Solutions, ${o.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
              </article>
            ))}
          </div>
        </div>
      </section>
    ) : <Locations heading="Our locations" lede={locLede} />}
    <p class="cd-contact"><Icon name="phone" class="h-4 w-4" />Reach us at <a class="inl" href="tel:8607351448">(860) 735-1448</a> · <a class="inl" href="mailto:hhs4help@gmail.com">hhs4help@gmail.com</a></p>
    <Faq faqs={faqs} heading={faqHeading} schema={false} />

    <section class="section is-white cd-services">
      <div class="container">
        <div class="sec-head"><h2>Conditions &amp; Treatments</h2></div>
        <ul class="cd-svc">
          {SERVICES.filter((s) => s.href !== meta.canonical.replace("https://www.hopewellhealthsolutions.com", "")).map((s) => <li><a href={s.href}><span class="icon-badge"><Icon name={s.icon} /></span>{s.t}<Icon name="arrow" class="h-4 w-4 cd-svc-go" /></a></li>)}
        </ul>
      </div>
    </section>

    <ClosingCta heading={cta.h2} lede={cta.p} />
  </main>
  <Footer />
</Base>
