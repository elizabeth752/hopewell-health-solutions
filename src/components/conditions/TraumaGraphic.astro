---
// "What is trauma & PTSD?" graphic (user 2026-11-18: "add a graphic instead of the group photo"). The four ways PTSD
// commonly shows up, and the path trauma care follows. Pure HTML/SVG, no image file.
import Icon from "../Icon.astro";
const signs = [
  ["refresh", "Reliving it", "Flashbacks, nightmares, intrusive memories"],
  ["shield", "Avoiding reminders", "Places, people or thoughts linked to it"],
  ["cloud", "Mood & thoughts", "Guilt, numbness, feeling cut off"],
  ["bolt", "On high alert", "Startling easily, poor sleep, irritability"],
];
const path = [["Safety", "Feel steady first"], ["Processing", "Memories lose their grip"], ["Reconnection", "Back to life and people"]];
---
<figure class="tg" aria-label="How PTSD commonly shows up, and the path trauma care follows">
  <p class="tg-h">How trauma can show up</p>
  <ul class="tg-signs">
    {signs.map(([i, t, d]) => (
      <li><span class="tg-ico"><Icon name={i} class="h-5 w-5" /></span><span><b>{t}</b><small>{d}</small></span></li>
    ))}
  </ul>
  <p class="tg-h" style="margin-top:18px">The path of trauma care</p>
  <ol class="tg-path">
    {path.map(([t, d], k) => <li><span class="tg-n">{k + 1}</span><b>{t}</b><small>{d}</small></li>)}
  </ol>
  <figcaption class="tg-foot"><Icon name="check" class="h-4 w-4" />Trauma is treatable, at a pace that feels safe</figcaption>
</figure>

<style>
  .tg { margin: 0; padding: clamp(22px, 3vw, 30px); border-radius: 28px; background: linear-gradient(160deg, #0b2f55, #12406f); color: #fff; box-shadow: 0 26px 60px rgba(0,29,55,.18); }
  .tg-h { margin: 0 0 12px; font-family: var(--hw-head); font-weight: 800; font-size: 16px; color: #9cc3ea; }
  .tg-signs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .tg-signs li { display: flex; gap: 12px; align-items: flex-start; padding: 14px; border-radius: 16px; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); }
  .tg-ico { flex: none; width: 36px; height: 36px; border-radius: 11px; display: grid; place-items: center; background: rgba(47,118,196,.5); }
  .tg-signs li:nth-child(2) .tg-ico { background: rgba(92,124,107,.75); }
  .tg-signs li:nth-child(3) .tg-ico { background: rgba(182,134,60,.7); }
  .tg-signs li:nth-child(4) .tg-ico { background: rgba(38,84,137,.9); }
  .tg-signs b, .tg-path b { display: block; font-family: var(--hw-head); font-size: 15px; line-height: 1.3; }
  .tg-signs small, .tg-path small { display: block; margin-top: 2px; font-size: 13px; line-height: 1.4; color: #c9d6e4; }
  .tg-path { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; position: relative; }
  .tg-path li { position: relative; padding: 14px 12px; border-radius: 14px; background: #fff; color: var(--hw-navy); text-align: center; }
  .tg-path small { color: var(--hw-slate); }
  .tg-n { display: grid; place-items: center; width: 26px; height: 26px; margin: 0 auto 6px; border-radius: 50%; background: #e0b56a; color: #0b2f55; font-weight: 800; font-size: 13px; }
  .tg-foot { margin-top: 14px; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 14px; font-weight: 600; color: #dce6f1; text-align: center; }
  .tg-foot :global(svg) { color: #7fd3a8; flex: none; }
  @media (max-width: 460px) { .tg-signs, .tg-path { grid-template-columns: minmax(0, 1fr); } }
</style>
