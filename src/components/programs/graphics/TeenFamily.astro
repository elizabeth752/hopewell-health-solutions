---
// Teen IOP, "Evidence-based help for struggling teens & families". Mist: the week, teens Mon–Thu and parents 1–2×.
// Simplified 2026-11-18 (user: graphics too busy): few big elements, large icon circles, little text, in the style
// of conditions/OcdGraphic.astro and the DBT wheel. Facts are in the bullets beside it. Styles: programs.css (.gx-*).
import Icon from "../../Icon.astro";
const days = ["Mon", "Tue", "Wed", "Thu"];
---
<figure class="gx t-mist" aria-label="Teens attend Monday to Thursday and parents once or twice a week, for 8 to 12 weeks at 1420 Main St, Glastonbury">
  <p class="gx-h">A teen IOP week</p>
  <div class="wk">
    <p class="wk-r"><span class="wk-l"><Icon name="users" class="h-5 w-5" />Teens</span><span class="wk-d">{days.map((d) => <i>{d}</i>)}</span></p>
    <p class="wk-r is-par"><span class="wk-l"><Icon name="heart-even" class="h-5 w-5" />Parents</span><span class="wk-d"><i>1–2× a week</i></span></p>
  </div>
  <figcaption class="gx-cap">8–12 weeks · <a class="inl" href="/location/glastonbury-ct-3/">1420 Main St, Glastonbury</a></figcaption>
</figure>
