---
// Women's Wellness IOP, "Is this program right for me?". White card, gold border: a check-in wheel of six areas.
// Simplified 2026-11-18 (user: graphics too busy): few big elements, large icon circles, little text, in the style
// of conditions/OcdGraphic.astro and the DBT wheel. Facts are in the bullets beside it. Styles: programs.css (.gx-*).
import Icon from "../../Icon.astro";
const areas = [["bolt", "Energy", "#b6863c"], ["sun", "Joy", "#5c7c6b"], ["heart-even", "Support", "#2f76c4"], ["cloud", "Honesty", "#265489"], ["alert", "Stress", "#b6863c"], ["compass", "Grounding", "#5c7c6b"]];
---
<figure class="gx t-paper a-gold" aria-label="A self check-in on energy, joy, support, honesty, stress and feeling grounded">
  <div class="wh">
    <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="37" /></svg>
    <p class="wh-c"><b>Check in</b><span>with yourself</span></p>
    {areas.map(([i, t, c], k) => <p class="wh-n" style={`--a:${k * 60}deg;--c:${c}`}><span><Icon name={i} class="h-5 w-5" /></span><b>{t}</b></p>)}
  </div>
  <figcaption class="gx-cap"><a class="inl" href="/admissions/">Take our quick screening</a></figcaption>
</figure>
