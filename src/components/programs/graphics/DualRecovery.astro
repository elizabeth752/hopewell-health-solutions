---
// Adult Mental Health IOP, "Supporting both mental health & substance-use recovery" (user: "I don't like the
// graphic"; Venn + tiles replaced). Light sky card: how MAT supports recovery in three steps.
// Simplified 2026-11-18 (user: graphics too busy): few big elements, large icon circles, little text, in the style
// of conditions/OcdGraphic.astro and the DBT wheel. Facts are in the bullets beside it. Styles: programs.css (.gx-*).
import Icon from "../../Icon.astro";
const steps = [["pill", "FDA-approved medication", "#b6863c"], ["chat", "Counseling &amp; therapy", "#5c7c6b"], ["heart-even", "Long-term recovery", "#2f76c4"]];
---
<figure class="gx t-sky" aria-label="How MAT supports recovery: FDA-approved medication, with counseling and behavioral therapy, toward long-term recovery">
  <p class="gx-h">How <a class="inl" href="/treatment-methods/medication-assisted-treatment/">MAT</a> supports recovery</p>
  <ol class="mt">{steps.map(([i, t, c]) => <li style={`--c:${c}`}><span><Icon name={i} class="h-6 w-6" /></span><b set:html={t} /></li>)}</ol>
  <figcaption class="gx-cap">Fewer cravings, less withdrawal</figcaption>
</figure>
