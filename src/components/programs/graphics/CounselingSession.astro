---
// Counseling, "What is counseling?". Stone: a session dial and the 1-in-5 people row.
// Simplified 2026-11-18 (user: graphics too busy): few big elements, large icon circles, little text, in the style
// of conditions/OcdGraphic.astro and the DBT wheel. Facts are in the bullets beside it. Styles: programs.css (.gx-*).
import Icon from "../../Icon.astro";
---
<figure class="gx t-stone" aria-label="Counseling sessions run about 60 minutes, once or twice a week. One in five adults lives with a mental health condition.">
  <div class="co-dial" aria-hidden="true">
    <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="50" class="bg" /><circle cx="60" cy="60" r="50" class="arc" /></svg>
    <p><strong>60</strong><span>minutes</span></p>
  </div>
  <p class="gx-h">Once or twice a week</p>
  <div class="co-people">
    <span aria-hidden="true">{[0, 1, 2, 3, 4].map((k) => <span class:list={[k === 2 && "on"]}><Icon name="users" class="h-7 w-7" /></span>)}</span>
    <p><strong>1 in 5</strong> adults lives with a mental health condition</p>
  </div>
</figure>
