---
// PHP, "What is a Partial Hospitalization Program?". White card: the 9 AM–3 PM day (CLAUDE.md settled fact 2) and
// four kinds of care as icon circles.
// Simplified 2026-11-18 (user: graphics too busy): few big elements, large icon circles, little text, in the style
// of conditions/OcdGraphic.astro and the DBT wheel. Facts are in the bullets beside it. Styles: programs.css (.gx-*).
import Icon from "../../Icon.astro";
const parts = [["users", "Group", "#2f76c4"], ["chat", "Individual", "#5c7c6b"], ["pill", "Medication", "#b6863c"], ["sparkles", "Wellness", "#265489"]];
---
<figure class="gx t-band" aria-label="PHP runs Monday to Friday, 9 AM to 3 PM, home every night, with group therapy, individual therapy, medication management and experiential wellness">
  <p class="gx-h">Mon–Fri</p>
  <div class="dy-bar" aria-hidden="true"><span>9 AM</span><i></i><span>3 PM</span></div>
  <ul class="gx-dots is-4">{parts.map(([i, t, c]) => <li style={`--c:${c}`}><span><Icon name={i} class="h-6 w-6" /></span>{t}</li>)}</ul>
  <figcaption class="gx-cap">Home every night</figcaption>
</figure>
