---
// PHP, "What is a Partial Hospitalization Program?" (2026-11-18, replaces the photo carousel). Where PHP sits, its
// hours (CLAUDE.md settled fact 2), and what it combines, including the experiential wellness list from the copy.
import Icon from "../../Icon.astro";
---
<figure class="gx on-dark" aria-label="PHP sits between outpatient therapy and inpatient hospitalization: Monday to Friday, 9 AM to 3 PM, home every night. It combines group therapy, individual therapy, medication management, skill-building and experiential wellness: yoga, art therapy, sound healing, weight training, hiking, Reiki, needlework and meditation.">
  <div class="gx-scale" aria-hidden="true">
    <span>Outpatient therapy</span><span class="on">PHP</span><span>Inpatient hospitalization</span>
  </div>
  <div class="gx-hub">
    <span class="gx-hub-i"><Icon name="clock" class="h-7 w-7" /></span>
    <p><strong>Mon–Fri · 9 AM–3 PM</strong><span>Several hours of care a day, home every night</span></p>
  </div>
  <ul class="gx-tiles is-php">
    <li><span class="gx-i i-b"><Icon name="users" class="h-5 w-5" /></span><a class="inl" href="/treatment-methods/group-therapy/">Group therapy</a></li>
    <li><span class="gx-i i-s"><Icon name="chat" class="h-5 w-5" /></span>Individual therapy</li>
    <li><span class="gx-i i-g"><Icon name="pill" class="h-5 w-5" /></span>Medication management</li>
    <li><span class="gx-i i-n"><Icon name="brain" class="h-5 w-5" /></span>Skill-building</li>
    <li class="is-wide"><span class="gx-i i-g"><Icon name="sparkles" class="h-5 w-5" /></span><span><b>Experiential wellness</b><small>Yoga · art therapy · sound healing · weight training · hiking · Reiki · needlework · meditation</small></span></li>
  </ul>
</figure>
