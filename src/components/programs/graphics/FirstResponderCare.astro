---
// First Responder IOP, "Specialized care for those who answer the call" (2026-11-18, replaces the photo).
// Who builds it, what happens in the room, and the three situations the copy names.
import Icon from "../../Icon.astro";
---
<figure class="gx on-dark" aria-label="Designed by first responders, for first responders. In a safe, confidential space you process your experiences, learn coping strategies and grow stronger. For people stepping down from inpatient care, needing more than weekly therapy, or navigating work while managing their mental health.">
  <div class="gx-hub">
    <span class="gx-hub-i"><Icon name="shield" class="h-7 w-7" /></span>
    <p><strong>By those who serve, for those who serve</strong><span>Care for your mental health and your career longevity</span></p>
  </div>
  <p class="gx-t">In a safe, confidential space</p>
  <ol class="gx-flow">
    <li><span class="gx-i i-b"><Icon name="chat" class="h-5 w-5" /></span><span>Process your experiences</span></li>
    <li><span class="gx-i i-s"><Icon name="brain" class="h-5 w-5" /></span><span>Learn coping strategies</span></li>
    <li><span class="gx-i i-g"><Icon name="sparkles" class="h-5 w-5" /></span><span>Grow stronger, personally &amp; professionally</span></li>
  </ol>
  <p class="gx-t">Wherever you’re starting from</p>
  <ul class="gx-rows">
    <li><Icon name="arrow" class="h-4 w-4" /><span>Stepping down from inpatient care</span></li>
    <li><Icon name="arrow" class="h-4 w-4" /><span>Needing <a class="inl" href="/post/iop-vs-outpatient-therapy-which-option-is-right-for-you/">more than weekly therapy</a></span></li>
    <li><Icon name="arrow" class="h-4 w-4" /><span>Navigating work while managing your mental health</span></li>
  </ul>
  <figcaption class="gx-foot"><Icon name="check" class="h-4 w-4" />Seeking support is a mark of strength</figcaption>
</figure>
