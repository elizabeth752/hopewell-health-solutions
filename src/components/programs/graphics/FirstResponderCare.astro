---
// First Responder IOP, "Specialized care for those who answer the call". Navy: a shield emblem and three steps.
// Simplified 2026-11-18 (user: graphics too busy): few big elements, large icon circles, little text, in the style
// of conditions/OcdGraphic.astro and the DBT wheel. Facts are in the bullets beside it. Styles: programs.css (.gx-*).
import Icon from "../../Icon.astro";
const steps = [["chat", "Process", "#2f76c4"], ["brain", "Cope", "#5c7c6b"], ["sparkles", "Grow", "#b6863c"]];
---
<figure class="gx t-navy on-dark" aria-label="Designed by first responders, for first responders: a safe, confidential space to process your experiences, learn coping strategies and grow stronger">
  <svg class="fr-shield" viewBox="0 0 64 74" aria-hidden="true"><path d="M32 3 L59 13 V36 C59 53 47 65 32 71 C17 65 5 53 5 36 V13 Z" class="sh" /><path d="M32 22 l4.6 9.4 10.4 1.5 -7.5 7.3 1.8 10.3 -9.3 -4.9 -9.3 4.9 1.8 -10.3 -7.5 -7.3 10.4 -1.5 Z" class="st" /></svg>
  <p class="gx-h">By those who serve,<br />for those who serve</p>
  <ul class="gx-dots">{steps.map(([i, t, c]) => <li style={`--c:${c}`}><span><Icon name={i} class="h-6 w-6" /></span>{t}</li>)}</ul>
  <figcaption class="gx-cap">In a safe, confidential space</figcaption>
</figure>
