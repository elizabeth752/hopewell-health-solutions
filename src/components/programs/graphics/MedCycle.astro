---
// Medication management, "What is medication management?". Navy: the care cycle around a loop (OCD-cycle style).
// Simplified 2026-11-18 (user: graphics too busy): few big elements, large icon circles, little text, in the style
// of conditions/OcdGraphic.astro and the DBT wheel. Facts are in the bullets beside it. Styles: programs.css (.gx-*).
import Icon from "../../Icon.astro";
const steps = [["clipboard", "Evaluation", "#2f76c4"], ["brain", "Diagnosis", "#5c7c6b"], ["pill", "Medication plan", "#b6863c"], ["refresh", "Follow-ups", "#265489"]];
---
<figure class="gx t-navy on-dark" aria-label="Medication management is a cycle: evaluation, diagnosis, a personalized medication plan and regular follow-ups">
  <div class="cy">
    <svg class="cy-loop" viewBox="0 0 300 300" aria-hidden="true">
      <defs><marker id="cy-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="#e0b56a" /></marker></defs>
      <path d="M150 40 A110 110 0 0 1 260 150" marker-end="url(#cy-arrow)" /><path d="M260 150 A110 110 0 0 1 150 260" marker-end="url(#cy-arrow)" />
      <path d="M150 260 A110 110 0 0 1 40 150" marker-end="url(#cy-arrow)" /><path d="M40 150 A110 110 0 0 1 150 40" marker-end="url(#cy-arrow)" />
    </svg>
    <p class="cy-c"><strong>You</strong><span>Care built around you</span></p>
    {steps.map(([i, t, c], k) => <p class={`cy-s is-${k}`} style={`--c:${c}`}><span><Icon name={i} class="h-5 w-5" /></span><b>{t}</b></p>)}
  </div>
  <figcaption class="gx-cap">Therapy is your call</figcaption>
</figure>
