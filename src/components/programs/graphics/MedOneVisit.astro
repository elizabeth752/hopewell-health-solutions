---
// Medication management, "Assessment, therapy & meds in one visit". White card, blue border: three icon circles
// that add up to one visit.
// Simplified 2026-11-18 (user: graphics too busy): few big elements, large icon circles, little text, in the style
// of conditions/OcdGraphic.astro and the DBT wheel. Facts are in the bullets beside it. Styles: programs.css (.gx-*).
import Icon from "../../Icon.astro";
const parts = [["clipboard", "Assessment", "#2f76c4"], ["chat", "Therapy", "#5c7c6b"], ["pill", "Medication", "#b6863c"]];
---
<figure class="gx t-paper a-blue" aria-label="Assessment, talk therapy and medication in a single visit, often same-day, for ages 4 and up">
  <ul class="gx-dots is-plus">{parts.map(([i, t, c]) => <li style={`--c:${c}`}><span><Icon name={i} class="h-6 w-6" /></span>{t}</li>)}</ul>
  <p class="ov-one"><strong>One visit</strong><span>Often same-day</span></p>
  <figcaption class="gx-cap">Ages 4 and up</figcaption>
</figure>
